#!/usr/bin/env bash
# The everything-works battery. Its checklist is DERIVED at run time from the five sources that
# define what this product is, never written from memory, so a key or a request added tomorrow shows
# up here as an item nobody drives rather than as nothing at all.
#
#   docs/protocol.md      every request the wire accepts
#   keys.toml             every action the key table binds
#   ui/js/Menu.js         every context menu entry
#   canvas.json           every artboard the design defines
#   keys.toml [[pointer]]  every click the pointer contract declares
#   tests/*.sh            every suite, and whether anything executable names it
#   ui/*.qml              every sidebar entry kind
#   clipboard.lua         every Omarchy SUPER chord that must keep working inside Flea
#
# Requests are driven live through the real backend against a sandbox this script creates, and need
# no display. Keys, menu entries and the Omarchy chords need a real window, so they are driven only
# under --drive: this box has one Hyprland session and several lanes queue for it, so one invocation
# presses everything rather than an exploratory loop. Without --drive they report UNDRIVEN, which is
# the honest state for a run that pressed nothing.
#
# Artboards and sidebar kinds are still derived and not driven. A key whose effect no reader outside
# the app can see is reported UNDRIVEN with the reason and the one line that would fix it, never
# given a check that would pass on a dead app.
#
# Hard rule 9: every write and delete is inside a sandbox made by tools/flea-sandbox-guard.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
REPO=$PWD
. "$REPO/tools/flea-sandbox-guard"
# Sourced for its function definitions; nothing in it touches the display until drive_all runs.
. "$REPO/tools/flea-acceptance-drive"

DRIVE=0
# A named group after --drive runs only that group, so confirming one fix costs minutes rather than
# a whole display slot. Groups: key menu omarchy pointer.
DRIVE_GROUPS=""
case "${1:-}" in
  --drive) DRIVE=1; shift; DRIVE_GROUPS="$*" ;;
  "") ;;
  *) printf 'usage: %s [--drive [key|menu|omarchy|pointer ...]]\n' "$0" >&2; exit 2 ;;
esac

BIN=${BIN:-$REPO/target/release/flea}
# The design canvas is the artboard list's only source and it lives in the omarchy repo, which is on
# the Mac. A read-only copy is kept beside this checkout on the box; both are tried and the failure
# names what is missing rather than skipping the group, because a battery that quietly drops a group
# reports a smaller checklist as a complete one.
for cand in "${CANVAS:-}" \
            "$REPO/../flea-canvas/canvas.json" \
            "$HOME/Documents/claude/omarchy/docs/reference/flea-canvas/canvas.json"; do
  [ -n "$cand" ] && [ -f "$cand" ] && { CANVAS=$cand; break; }
done
SB="$FIXTURE_ROOT/flea-acceptance-$$"
# Long enough for a worker to answer on a four-file directory, short enough that seventeen of them
# is not a coffee break.
ASYNC_WAIT_S=${ASYNC_WAIT_S:-1.5}

PASSED=0
FAILED=0
UNDRIVEN=0

pass() { printf 'PASS %-12s %s\n' "$1" "$2"; PASSED=$(( PASSED + 1 )); }
bad()  { printf 'FAIL %-12s %s: %s\n' "$1" "$2" "$3"; FAILED=$(( FAILED + 1 )); }
skip() { printf 'UNDRIVEN %-8s %s: %s\n' "$1" "$2" "$3"; UNDRIVEN=$(( UNDRIVEN + 1 )); }

die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

# A derivation that comes back empty is a broken derivation, not an empty product, and an empty
# checklist passes. Every list below goes through this.
require_list() {
  local what=$1 n=$2
  [ "$n" -gt 0 ] || die "derived 0 $what, so the checklist would pass by being empty"
}

# ---- the five derivations ----------------------------------------------------------------------

# Sample input, docs/protocol.md: "### list" between the "## Requests" and "## Responses" headings.
derive_requests() {
  awk '/^## Requests/,/^## Responses/' "$REPO/docs/protocol.md" \
    | sed -n 's/^### //p'
}

# Sample input, docs/protocol.md: "### listed" after the "## Responses" heading.
derive_responses() {
  sed -n '/^## Responses/,$p' "$REPO/docs/protocol.md" | sed -n 's/^### //p'
}

# Sample input, keys.toml: 'action = "pageDown"', plus the [digits] table below.
derive_key_actions() {
  { sed -n 's/^action = "\(.*\)"$/\1/p' "$REPO/keys.toml"
    derive_digit_actions; } | LC_ALL=C sort -u
}

# [digits] binds the printable digits from..to to prefix1..prefixN through the generated
# ui/js/Keymap.js, so nine keys are bound that no 'action =' line names. A derivation that misses
# them reports a shorter checklist as a complete one, which is the one thing this battery must not do.
# Sample input, keys.toml: [digits] holds 'from = 1', 'to = 9' and 'prefix = "tab"'.
derive_digit_actions() {
  local from to prefix n
  from=$(sed -n 's/^from = \([0-9]*\)$/\1/p' "$REPO/keys.toml")
  to=$(sed -n 's/^to = \([0-9]*\)$/\1/p' "$REPO/keys.toml")
  prefix=$(sed -n 's/^prefix = "\(.*\)"$/\1/p' "$REPO/keys.toml")
  [ -n "$from" ] && [ -n "$to" ] && [ -n "$prefix" ] || return 0
  for n in $(seq "$from" "$to"); do
    printf '%s%s\n' "$prefix" "$n"
  done
}

# Sample input, ui/js/Menu.js: 'out.push({ label: "Rename", action: "rename", glyph: "rename" })'
derive_menu_actions() {
  sed -n 's/.*action: "\([a-zA-Z][a-zA-Z]*\)".*/\1/p' "$REPO/ui/js/Menu.js" | LC_ALL=C sort -u
}

# Sample input, canvas.json: '      "file": "FleaWindow.dc.html",'
derive_artboards() {
  sed -n 's/.*"file": "\(.*\.dc\.html\)".*/\1/p' "$CANVAS" | LC_ALL=C sort -u
}

# Every suite in tests/, which is a derivation from the directory itself so a suite added tomorrow
# shows up here rather than nowhere. Sample input: the file list of tests/*.sh.
derive_suites() {
  for f in "$REPO"/tests/*.sh; do
    [ -f "$f" ] && basename "$f"
  done
}

# Which executable file, if any, names a suite. A grep is evidence about characters and not about
# invocation, so this reports what NAMES a suite and never claims the suite is run: this repo has no
# runner script and no CI at all, so every one of them is run by a person or not at all. An uninvoked
# suite reads as coverage and is not, which is how a nine-check drag suite sat unrun.
suite_named_by() {
  grep -rl "$1" "$REPO"/tests "$REPO"/tools "$REPO"/packaging "$REPO"/PKGBUILD 2>/dev/null \
    | grep -v "/tests/$1$" | sed "s|$REPO/||" | tr '\n' ' '
}

# Sample input, ui/NetworkMounts.qml: 'group: "network", kind: "share"'
# The group is what says this is a sidebar entry rather than any other object with a kind: matching
# on kind alone collected PreviewMedia.qml's default property value, "audio", as a sidebar kind. The
# shape is the filter, not a file list, so a new file that builds entries is picked up on its own.
derive_sidebar_kinds() {
  grep 'group: "' "$REPO"/ui/*.qml \
    | sed -n 's/.*kind: "\([a-z][a-z]*\)".*/\1/p' | LC_ALL=C sort -u
}

# ---- the request drivers -----------------------------------------------------------------------

# One line per request: the request name, the response type the doc says it answers with, and the
# JSON to send after the opening list. The names on the left are checked against the derived list
# below, so a request added to the doc and not to this table is reported rather than skipped, and a
# response named here that the doc does not list is reported too.
declare -a REQUEST_DRIVERS=(
  'list|listed|'
  'window|rows|{"c":"window","start":0,"count":2}'
  'sort|listed|{"c":"sort","by":"name","desc":true}'
  'search|searched|{"c":"search","path":"@SB@","query":"a","hidden":false}'
  'searchcancel|searched|{"c":"search","path":"@SB@","query":"a","hidden":false}
{"c":"searchcancel"}'
  'thumb|thumbed|{"c":"thumb","rows":[0]}'
  'thumbcancel|thumbed|{"c":"thumb","rows":[0]}
{"c":"thumbcancel","rows":[0]}'
  'dirsize|dirsized|{"c":"dirsize","rows":[0]}'
  'dirsizecancel|dirsized|{"c":"dirsize","rows":[0]}
{"c":"dirsizecancel"}'
  'transfer|transferstarted|{"c":"transfer","op":"copy","paths":["@SB@/a.txt"],"dest":"@SB@/dest"}'
  'transfercancel|transferstarted|{"c":"transfer","op":"copy","paths":["@SB@/a.txt"],"dest":"@SB@/dest"}
{"c":"transfercancel","id":1}'
  'trash|trashed|{"c":"trash","paths":["@SB@/b.txt"]}'
  'rename|renamed|{"c":"rename","path":"@SB@/a.txt","to":"renamed.txt"}'
  'duplicate|duplicated|{"c":"duplicate","path":"@SB@/a.txt"}'
  'mkdir|made|{"c":"mkdir","path":"@SB@","name":"made-here"}'
  'meta|meta|{"c":"meta","row":0,"text":true,"media":false,"archive":false}'
  'undo|undone|{"c":"trash","paths":["@SB@/b.txt"]}
@WAIT@
{"c":"undo"}'
  'quit|listed|'
)

# One backend session per request, which keeps the state trivial: list, then the request, then quit.
# An error line is a failure even when the expected type also arrived, because the wire says an
# error is the answer to a request that could not be served.
#
# What this proves and what it does not: for most requests it proves the wire accepts the request
# and answers with the documented type. For the three cancels it proves the same, and NOT that the
# work stopped, because the work they cancel finishes faster than a cancel can be typed at it. Those
# three are honest coverage of the request and not of the cancellation.
# A body's lines, with a line of @WAIT@ meaning "let the backend finish before the next one". undo
# needs it: it cannot undo an operation the backend has not recorded yet, and without the pause it
# answered "there is nothing to undo" and looked like a product defect.
emit_body() {
  local body=$1 line
  [ -n "$body" ] || return 0
  while IFS= read -r line; do
    if [ "$line" = "@WAIT@" ]; then
      sleep "$ASYNC_WAIT_S"
    else
      printf '%s\n' "$line"
    fi
  done <<< "$body"
}

# A cancel's effect is not observable on a four-file directory: the work it cancels finishes faster
# than the cancel can be typed at it. What IS reliable is that the backend accepts the request, does
# not answer an error, and is still answering afterwards, so that is what these assert. This is
# honest coverage of the request and not of the cancellation.
drive_cancel() {
  local name=$1 body=$2 out dir
  dir=$(fresh_dir "$name")
  body=${body//@SB@/$dir}
  out=$( { printf '{"c":"list","path":"%s","first":8,"hidden":true}\n' "$dir"
           emit_body "$body"
           sleep "$ASYNC_WAIT_S"
           printf '{"c":"window","start":0,"count":2}\n'
           printf '{"c":"quit"}\n'; } | "$BIN" --backend 2>&1 )
  case $out in
    *'"t":"error"'*)
      bad request "$name" "the backend answered error: $(printf '%s' "$out" | grep -m1 '"t":"error"')"
      return ;;
  esac
  case $out in
    *'"t":"rows"'*) pass request "$name" ;;
    *) bad request "$name" "the backend stopped answering after the cancel" ;;
  esac
}

drive_request() {
  local name=$1 want=$2 body=$3 out dir
  # Its own directory per request, because rename and trash and duplicate MUTATE: the first shape of
  # this shared one sandbox, rename moved a.txt out from under duplicate, and duplicate reported an
  # error that was the battery's fault and looked like the product's.
  dir=$(fresh_dir "$name")
  body=${body//@SB@/$dir}
  # The sleep is the whole reason search, dirsize and meta failed here first: they answer from a
  # worker, and a quit typed immediately behind the request closes the backend before the answer.
  out=$( { printf '{"c":"list","path":"%s","first":8,"hidden":true}\n' "$dir"
           emit_body "$body"
           sleep "$ASYNC_WAIT_S"
           printf '{"c":"quit"}\n'; } | "$BIN" --backend 2>&1 )
  case $out in
    *'"t":"error"'*)
      bad request "$name" "the backend answered error: $(printf '%s' "$out" | grep -m1 '"t":"error"')"
      return ;;
  esac
  case $out in
    *"\"t\":\"$want\""*) pass request "$name" ;;
    *) bad request "$name" "no $want line in the answer" ;;
  esac
}

# quit is the one request whose effect is the absence of an answer, so it gets its own driver: a
# second list after it must go unanswered. Sending it through the shared driver would have proved
# only that the first list was answered, which is not a test of quit at all.
drive_quit() {
  local out n dir
  dir=$(fresh_dir quit)
  out=$( { printf '{"c":"list","path":"%s","first":8,"hidden":true}\n' "$dir"
           printf '{"c":"quit"}\n'
           printf '{"c":"list","path":"%s","first":8,"hidden":true}\n' "$dir"; } | "$BIN" --backend 2>&1 )
  n=$(printf '%s\n' "$out" | grep -c '"t":"listed"')
  if [ "$n" = 1 ]; then
    pass request quit
  else
    bad request quit "the backend answered $n listed lines, so it kept reading after quit"
  fi
}

# ---- setup -------------------------------------------------------------------------------------

[ -x "$BIN" ] || die "$BIN is missing, so run cargo build --release first"
[ -f "$REPO/docs/protocol.md" ] || die "docs/protocol.md is missing, so the request list cannot be derived"
[ -n "${CANVAS:-}" ] && [ -f "$CANVAS" ] \
  || die "no canvas.json found beside the checkout or in the omarchy repo, so the artboard list cannot be derived; rsync docs/superpowers/specs/assets/flea-canvas/ to \$REPO/../flea-canvas/"

[ -r "$OMARCHY_CLIPBOARD_LUA" ] \
  || die "$OMARCHY_CLIPBOARD_LUA is missing, so the Omarchy chord list cannot be derived"

sandbox_make "$SB"
# The fixture the drive lists, inside the sandbox but a scratch of its own, so the guard's marker
# file stays up on $SB and never appears in a listing whose row count a check asserts.
DRIVE_FIXTURE="$SB/drive"
# The window goes before the sandbox it is listing does, or the teardown deletes a tree a live
# backend is still walking.
trap 'drive_stop; sandbox_remove "$SB"' EXIT INT TERM

# The same starting shape for every request, built fresh so no driver can see another's writes.
fresh_dir() {
  local d="$SB/$1"
  rm -rf "$d"
  mkdir -p "$d/dest" "$d/sub"
  printf 'alpha' > "$d/a.txt"
  printf 'beta' > "$d/b.txt"
  printf '%s' "$d"
}

echo "flea-acceptance, checklist derived at $(date -Is)"
drive_provenance
echo

# ---- requests, driven --------------------------------------------------------------------------

mapfile -t REQUESTS < <(derive_requests)
require_list "requests from docs/protocol.md" "${#REQUESTS[@]}"
mapfile -t RESPONSES < <(derive_responses)
require_list "responses from docs/protocol.md" "${#RESPONSES[@]}"

for name in "${REQUESTS[@]}"; do
  row=""
  for r in "${REQUEST_DRIVERS[@]}"; do
    case $r in "$name|"*) row=$r; break ;; esac
  done
  if [ -z "$row" ]; then
    bad request "$name" "the doc lists this request and this battery has no driver for it"
    continue
  fi
  want=${row#*|}
  want=${want%%|*}
  body=${row#*|*|}
  # A driver expecting a response the doc does not document is a driver written from memory.
  known=no
  for resp in "${RESPONSES[@]}"; do
    [ "$resp" = "$want" ] && { known=yes; break; }
  done
  if [ "$known" = no ]; then
    bad request "$name" "expects a '$want' line, which docs/protocol.md does not document"
    continue
  fi
  case $name in
    quit) drive_quit ;;
    *cancel) drive_cancel "$name" "$body" ;;
    *) drive_request "$name" "$want" "$body" ;;
  esac
done

# ---- the four groups this battery derives and does not yet drive ---------------------------------

echo
# Every derivation, not only the two the request loop needed: an empty list here is a broken
# derivation and it would report as a clean run with nothing in it.
mapfile -t KEY_ACTIONS < <(derive_key_actions)
require_list "key actions from keys.toml" "${#KEY_ACTIONS[@]}"
mapfile -t MENU_ACTIONS < <(derive_menu_actions)
require_list "menu actions from ui/js/Menu.js" "${#MENU_ACTIONS[@]}"
mapfile -t ARTBOARDS < <(derive_artboards)
require_list "artboards from canvas.json" "${#ARTBOARDS[@]}"
mapfile -t SIDEBAR_KINDS < <(derive_sidebar_kinds)
require_list "sidebar entry kinds from ui/" "${#SIDEBAR_KINDS[@]}"

mapfile -t OMARCHY_CHORDS < <(derive_omarchy_clipboard_binds)
require_list "Omarchy chords from $OMARCHY_CLIPBOARD_LUA" "${#OMARCHY_CHORDS[@]}"
mapfile -t POINTER_ROWS < <(derive_pointer)
require_list "pointer rows from keys.toml" "${#POINTER_ROWS[@]}"
mapfile -t SUITES < <(derive_suites)
require_list "test suites from tests/" "${#SUITES[@]}"

if [ "$DRIVE" = 1 ]; then
  drive_all
else
  for a in "${KEY_ACTIONS[@]}"; do
    skip key "$a" "bound in keys.toml; --drive presses it on a real window"
  done
  for a in "${MENU_ACTIONS[@]}"; do
    skip menu "$a" "an entry in ui/js/Menu.js; --drive chooses it on a real window"
  done
  # Read line by line: a chord's name carries spaces, and a $( ) loop split "SUPER + C" into three
  # items and reported twenty-six of them where there are ten.
  while IFS= read -r a; do
    skip omarchy "$a" "an Omarchy operation that must keep working inside Flea; --drive presses it"
  done < <(derive_omarchy_names)
  while IFS='|' read -r where press rowkind does; do
    skip pointer "$(pointer_name "$where" "$press" "$rowkind")" \
      "does $does; declared in keys.toml [[pointer]]; --drive clicks it on a real window"
  done < <(derive_pointer)
fi
# Reported whether or not --drive ran: this group is about what runs the product's own tests, and
# nothing here runs them. Making this battery the runner would triple its headless time and the
# suites build their own sandboxes, so that is a recommendation and not a change made at release.
for a in "${SUITES[@]}"; do
  named=$(suite_named_by "$a")
  if [ -z "$named" ]; then
    skip suite "$a" "no executable file in this repo names it, and there is no runner script and no CI, so nothing runs it but a person"
  else
    skip suite "$a" "named by ${named% }, which is not proof it is run; this repo has no runner script and no CI"
  fi
done
for a in $(derive_artboards); do
  skip artboard "$a" "an artboard in canvas.json, not driven here"
done
for a in $(derive_sidebar_kinds); do
  skip sidebar "$a" "a sidebar entry kind in ui/, not driven here"
done

echo
printf 'flea-acceptance: %s passed, %s failed, %s derived but undriven\n' "$PASSED" "$FAILED" "$UNDRIVEN"
[ "$FAILED" -eq 0 ] || exit 1
exit 0
