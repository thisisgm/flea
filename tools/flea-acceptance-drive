  k "${trashc[@]}"
  drive_wait_gone "$DRIVE_FIXTURE/op-undo.txt" \
    || { WHY="the trash this needs did not remove op-undo.txt, so undo has nothing to reverse"; return 1; }
  k "$@"
  wait_file "$DRIVE_FIXTURE/op-undo.txt" \
    || { WHY="op-undo.txt did not come back within ${TRANSFER_WAIT_S}s"; return 1; }
  [[ "$(cat "$DRIVE_FIXTURE/op-undo.txt")" == op-undo ]] || { WHY="Undo changed file bytes"; return 1; }
  return 0
}

drive_wait_gone() {
  local path=$1 attempt
  for attempt in $(seq 1 $((TRANSFER_WAIT_S * 10))); do
    [ -e "$path" ] || return 0
    sleep 0.1
  done
