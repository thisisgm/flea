#!/usr/bin/env bash
# The display half of tools/flea-acceptance, which sources this. Everything in here needs a real
# Flea window, which is why it is a separate file behind a separate flag: the request battery still
# runs headless on a box whose one display another lane is holding.
#
# Nothing here is a key list. Every chord is derived from keys.toml at run time by derive_bindings
# below, so the keymap lane's Finder chords were driven the day they landed and a key added tomorrow
# arrives as an item nobody drives rather than as nothing at all. The menu derives its rows from
# ui/js/Menu.js the same way, and the Omarchy group derives its chords from Omarchy's own
# /usr/share/omarchy/default/hypr/bindings/clipboard.lua.
#
# Every check reads a value before the chord and a value after it. An assertion whose before value
# already equals what it is about to require cannot fail, so changed_to and changed_from below
# refuse that case rather than printing a pass.
#
# Hard rule 9: every write and delete is inside the sandbox tools/flea-sandbox-guard made.

# ---- the graphical session -----------------------------------------------------------------------

# The window coalescer is 16 ms and a refill is a round trip, the same settle tests/ui.sh uses.
SETTLE_S=${FLEA_DRIVE_SETTLE_S:-0.4}
# A transfer crosses a process boundary and lands on disk, so it gets its own longer wait.
TRANSFER_WAIT_S=${FLEA_DRIVE_TRANSFER_WAIT_S:-15}
# The backend's own DRAIN_LIMIT is 25 s, the same wait tests/ui.sh gives it.
DRAIN_WAIT_S=30
DRIVE_PRESET=default
DRIVE_CONTEXT=listing
DRIVE_ROW_ID=setup
DRIVE_SHOTS=0

# omarchy-drive env omits the Qt platform theme, without which no row icon resolves; the same
# three-step recovery tests/ui.sh and tools/flea-showcase both use, ending at a live client's own
# environment, which is the only authoritative answer.
platform_theme() {
  systemctl --user show-environment | grep '^QT_QPA_PLATFORMTHEME=' | cut -d= -f2-
}

platform_theme_from_a_live_client() {
  local pid
  pid=$(pgrep -x quickshell | head -1)
  [ -n "$pid" ] || return 0
  tr '\0' '\n' < "/proc/$pid/environ" | grep '^QT_QPA_PLATFORMTHEME=' | cut -d= -f2-
}

drive_session_setup() {
  export PATH="$HOME/.local/bin:$PATH"
  command -v omarchy-drive >/dev/null || die "omarchy-drive is not on PATH, so no window can be driven"
  local session line name names=" "
  session=$(omarchy-drive env) || die "omarchy-drive env failed"
  # Sample session line: export XDG_RUNTIME_DIR=/run/user/1000.
  while IFS= read -r line; do
    name=${line%%=*}; name=${name#export }
    case "$name" in
      XDG_RUNTIME_DIR|WAYLAND_DISPLAY|HYPRLAND_INSTANCE_SIGNATURE|YDOTOOL_SOCKET|OMARCHY_PATH|QT_LINUX_ACCESSIBILITY_ALWAYS_ON) ;;
      *) die "unexpected omarchy-drive environment name: $name" ;;
    esac
    [[ "$line" == "export $name="* && "$names" != *" $name "* ]] || die "invalid or duplicate session variable: $name"
    printf -v "$name" '%s' "${line#*=}"
    export "${name?}"
    names="$names$name "
  done <<< "$session"
  for name in XDG_RUNTIME_DIR WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE YDOTOOL_SOCKET OMARCHY_PATH QT_LINUX_ACCESSIBILITY_ALWAYS_ON; do
    [[ "$names" == *" $name "* && -n "${!name}" ]] || die "session omitted $name"
  done
  [[ "$XDG_RUNTIME_DIR" == "/run/user/$(id -u)" && "$OMARCHY_PATH" == /usr/share/omarchy \
     && "$YDOTOOL_SOCKET" == "$XDG_RUNTIME_DIR/.ydotool_socket" && "$WAYLAND_DISPLAY" =~ ^wayland-[0-9]+$ ]] \
    || die "omarchy-drive returned an unexpected session"
  exec {DRIVE_LOCK}>"$XDG_RUNTIME_DIR/flea-display.lock"
  flock -n "$DRIVE_LOCK" || die "another owner holds flea-display.lock"
  [ -n "${QT_QPA_PLATFORMTHEME:-}" ] || export QT_QPA_PLATFORMTHEME="$(platform_theme)"
  [ -n "$QT_QPA_PLATFORMTHEME" ] || export QT_QPA_PLATFORMTHEME="$(platform_theme_from_a_live_client)"
  [ -n "$QT_QPA_PLATFORMTHEME" ] || die "nothing published QT_QPA_PLATFORMTHEME, so no row would draw an icon"
}

# ---- the seam into the running window --------------------------------------------------------------

ipc() {
  omarchy-drive ipc -p "$REPO/ui" flea "$@"
}

# Every keystroke goes through omarchy-drive, which focuses the window and refuses a wrong class first.
k() {
  local identity active shift_letter=""
  # omarchy-drive silently drops a -- argument and still exits 0, so a chord built with one presses
  # nothing and every check behind it fails for a reason that is not the product.
  [ "${1:-}" != -- ] || die "a -- argument is silently dropped by omarchy-drive key; pass the text bare"
  identity=$(drive_window_identity) || die "native key target lost its owned identity"
  drive_mutation_guard "$(ipc path)" || die "native key target left the owned listing"
  printf 'KEY %s' "$DRIVE_ROW_ID" >> "$DRIVE_EVIDENCE/commands.log"
  printf ' %q' "$@" >> "$DRIVE_EVIDENCE/commands.log"
  printf '\n' >> "$DRIVE_EVIDENCE/commands.log"
  if [[ "$#" == 1 && "$1" =~ ^[A-Z]$ ]]; then shift_letter=${1,,}; fi
  if [[ "$#" == 6 && "$1" == -M && "$2" == shift && "$3" == -k && "$4" =~ ^[a-z]$ && "$5" == -m && "$6" == shift ]]; then
    shift_letter=$4
  fi
  if [[ -n "$shift_letter" ]]; then
    omarchy-drive focus "$DRIVE_WINDOW_ADDRESS" || die "Shift-letter target could not receive focus"
    active=$(hyprctl activewindow -j) || die "active window unavailable before kernel input"
    jq -e --argjson owned "$identity" '.address == $owned.address and .pid == $owned.pid' <<< "$active" >/dev/null \
      || die "kernel input refused: the owned candidate does not have focus"
    printf 'ROUTE kernel Shift+%s\n' "$shift_letter" >> "$DRIVE_EVIDENCE/commands.log"
    omarchy-drive hotkey --global shift "$shift_letter" >> "$DRIVE_EVIDENCE/commands.log" 2>&1 \
      || die "native Shift-letter delivery failed for $DRIVE_ROW_ID"
    return
  fi
  omarchy-drive key --window "$DRIVE_WINDOW_ADDRESS" "$@" >> "$DRIVE_EVIDENCE/commands.log" 2>&1 \
    || die "omarchy-drive key failed for $DRIVE_ROW_ID"
}

settle() {
  sleep "$SETTLE_S"
}

park_pointer() {
  local x y
  read -r x y < <(hyprctl monitors -j | jq -er '.[0] | "\(.x) \(.y)"')
  [[ "$x" =~ ^-?[0-9]+$ && "$y" =~ ^-?[0-9]+$ ]] || die "monitor origin unavailable"
  omarchy-drive move "$x" "$y" || die "pointer parking failed"
}

# A picture of one surface, for a claim no IPC reader can carry. It is never an assertion on its own:
# the check beside it still has to read a value back.
drive_shot() {
  local output
  [[ "$1" =~ ^[a-zA-Z0-9_-]+$ ]] || die "unsafe screenshot label: $1"
  DRIVE_SHOTS=$((DRIVE_SHOTS + 1))
  output="$DRIVE_EVIDENCE/$DRIVE_ROW_ID-$DRIVE_SHOTS-$1.png"
  drive_guard "$output"
  [[ ! -e "$output" ]] || die "screenshot output already exists: $output"
  drive_window_identity >/dev/null || die "screenshot target lost ownership"
  omarchy-drive shot "$output" "$DRIVE_WINDOW_ADDRESS" || die "native screenshot failed: $output"
  [[ -s "$output" && "$(od -An -tx1 -N8 "$output" | tr -d ' \n')" == 89504e470d0a1a0a ]] \
    || die "native screenshot did not create a fresh PNG: $output"
  printf 'SHOT %s sha256=%s visual_inspection=pending\n' "$output" "$(sha256sum "$output" | cut -d' ' -f1)"
}

window_json() {
  drive_window_identity
}

# Sample input, one hyprctl client: {"address":"0x5a1c","at":[12,742],"size":[1261,686],...}
# The window is tiled and is not at the origin, so a click aimed with window-relative coordinates
# and no origin lands in whatever window happens to be above this one. This function existed only in
# tools/flea-showcase and click_row called it anyway: an undefined command inside a process
# substitution prints nothing, read leaves the variables empty, and bash arithmetic reads empty as
# zero, so the correction silently became "add nothing" and every pointer check failed.
window_geometry() {
  window_json | jq -r '"\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1]) \(.address)"'
}

flea_pids() {
  local pid
  for pid in $(pgrep -x qs || true); do
    [ -r "/proc/$pid/cmdline" ] || continue
    if tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | grep -Fq "$REPO/ui"; then
      printf '%s\n' "$pid"
    fi
  done
}

backend_pids() {
  local pid
  for pid in $(pgrep -x flea || true); do
    [ -r "/proc/$pid/cmdline" ] || continue
    if tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | grep -Fq -- "$BIN --backend"; then
      printf '%s\n' "$pid"
    fi
  done
}

# ---- the assertions ------------------------------------------------------------------------------

# The reason the last driver refused, read by the caller so one item reports once however many
# bindings it drove.
WHY=""

# An assertion whose before value already equals what it is about to require cannot fail. Both of
# these refuse that case, which is the whole difference between a check and a decoration.
changed_to() {
  local what=$1 before=$2 after=$3 want=$4
  printf 'ASSERT %s before=%q after=%q expected=%q\n' "$what" "$before" "$after" "$want"
  if [ "$before" = "$want" ]; then
    WHY="$what was already '$want' before the chord, so this check could not fail"
    return 1
  fi
  [ "$after" = "$want" ] && return 0
  WHY="$what went '$before' to '$after', wanted '$want'"
  return 1
}

changed_from() {
  local what=$1 before=$2 after=$3
  printf 'ASSERT %s before=%q after=%q expected=changed\n' "$what" "$before" "$after"
  [ "$before" != "$after" ] && return 0
  WHY="$what stayed '$before', so the chord had no effect"
  return 1
}

# ---- the chords, derived from keys.toml ----------------------------------------------------------

# Sample row: key-id|mac|gui|listing|ctrl|X| (empty action is an explicit refusal).
derive_bindings() {
  python3 - "$REPO/ui/js/Keymap.js" <<'PYTHON'
import hashlib, json, os, pathlib, re, shutil, subprocess, sys, tempfile
keymap = pathlib.Path(sys.argv[1]).resolve()
# The same derivation calls the real lookupFor under Node or the existing headless Qt runner.
script = r"""
function derive(context, Qt, emit) {
    var punctuation = { ' ': 'Space', '/': 'Slash', '?': 'Question', '.': 'Period', ',': 'Comma',
        '-': 'Minus', '_': 'Underscore', '+': 'Plus', '=': 'Equal', '>': 'Greater',
        '<': 'Less', '[': 'BracketLeft', ']': 'BracketRight' };
    function event(row) {
        var plain = !(row.mask & (Qt.ControlModifier | Qt.AltModifier | Qt.MetaModifier));
        var namedText = Object.keys(punctuation).find(function(char) { return punctuation[char] === row.key; });
        var text = row.mods === 'text' ? row.text : !plain ? '' : namedText ||
            (row.key.length === 1 ? (row.mask & Qt.ShiftModifier ? row.key : row.key.toLowerCase()) : '');
        var code = text ? 'Key_' + (punctuation[text] || text.toUpperCase()) : row.code;
        return { key: Qt[code], text: text,
            mask: row.mods === 'text' ? (/^[A-Z?_<>+]$/.test(text) ? Qt.ShiftModifier : 0) : row.mask };
    }
    var candidates = context.PRESET_KEYS.concat(context.SHARED_KEYS);
    for (var digit = context.DIGITS.from; digit <= context.DIGITS.to; digit++)
        candidates.push({ preset: 'all', mods: 'text', key: String(digit), text: String(digit), code: '', mask: 0 });
    var count = 0;
    context.PRESETS.forEach(function(preset) {
        ['gui', 'tui'].forEach(function(frontend) {
            ['listing', 'rail', 'menu', 'panel', 'preview', 'pdf', 'media', 'editor'].forEach(function(scope) {
                var seen = {};
                candidates.forEach(function(row) {
                    if (row.preset !== 'all' && row.preset !== preset) return;
                    // A listing chord also needs a refusal row in every overlay that does not bind it.
                    var identity = [preset, frontend, scope, row.mods, row.key].join('|');
                    if (seen[identity]) return;
                    seen[identity] = true;
                    var input = event(row);
                    var action = context.lookupFor(preset, input.key, input.text, input.mask, scope, frontend);
                    var fields = [preset, frontend, scope, row.mods, row.key, action];
                    if (fields.some(function(value) { return /[|\r\n]/.test(value); }))
                        throw new Error('unrepresentable key matrix field');
                    emit(fields.join('|'));
                    count++;
                });
            });
        });
    });
    emit('__DONE__|' + count);
}
"""
engine = os.environ.get('FLEA_MATRIX_ENGINE', '')
if engine not in ('', 'node', 'qml6'):
    raise SystemExit('unknown key matrix engine: ' + engine)
engine = engine or ('node' if shutil.which('node') else 'qml6')
if not shutil.which(engine):
    raise SystemExit('key matrix requires existing node or qml6')
scratch = None
try:
    if engine == 'node':
        source = re.sub(r'^\.pragma library\s*', '', keymap.read_text())
        bootstrap = r"""
const vm = require('node:vm');
const Qt = {NoModifier:0, ShiftModifier:0x02000000, ControlModifier:0x04000000,
    AltModifier:0x08000000, MetaModifier:0x10000000};
const source = SOURCE;
for (const name of new Set(source.match(/Key_[A-Za-z0-9_]+/g))) Qt[name] = name;
const context = vm.createContext({Qt});
vm.runInContext(source, context, {timeout:1000});
""".replace('SOURCE', json.dumps(source))
        body = bootstrap + script + '\nderive(context, Qt, row => console.log("FLEA_MATRIX_ROW " + row));\n'
        result = subprocess.run(['node', '-'], input=body, text=True, capture_output=True, timeout=30)
    else:
        scratch = pathlib.Path(tempfile.mkdtemp(prefix='flea-acceptance-matrix.', dir='/tmp'))
        (scratch / '.flea-matrix').write_text('owned key derivation fixture\n')
        (scratch / 'derive.js').write_text(script)
        (scratch / 'matrix.qml').write_text('import QtQuick\nimport ' + json.dumps(keymap.as_uri()) + r""" as Keymap
import "derive.js" as Matrix
QtObject {
    Component.onCompleted: {
        try { Matrix.derive(Keymap, Qt, function(row) { console.log("FLEA_MATRIX_ROW " + row); }); }
        catch (error) { console.error(error); Qt.exit(1); return; }
        Qt.quit();
    }
}
""")
        environment = dict(os.environ, QT_QPA_PLATFORM='offscreen', QT_FORCE_STDERR_LOGGING='1',
            QML_DISABLE_DISK_CACHE='1', XDG_CACHE_HOME=str(scratch / 'cache'))
        result = subprocess.run(['qml6', str(scratch / 'matrix.qml')], env=environment,
            text=True, capture_output=True, timeout=30)
    if result.returncode:
        raise SystemExit('key matrix engine failed: ' + result.stdout + result.stderr)
    rows, done = [], []
    for line in (result.stdout + result.stderr).splitlines():
        if 'FLEA_MATRIX_ROW ' not in line:
            continue
        row = line.split('FLEA_MATRIX_ROW ', 1)[1]
        if row.startswith('__DONE__|'):
            done.append(int(row.split('|')[1]))
        else:
            rows.append(row)
    if done != [len(rows)] or not rows or len(set(rows)) != len(rows):
        raise SystemExit('key matrix engine omitted its completion tally or returned duplicate rows')
    for row in rows:
        fields = row.split('|')
        if len(fields) != 6:
            raise SystemExit('invalid key matrix row: ' + row)
        identity = '|'.join(fields[:5])
        print('key-' + hashlib.sha256(identity.encode()).hexdigest()[:16] + '|' + row)
finally:
    if scratch is not None:
        if not str(scratch) or not scratch.is_absolute() or scratch.parent != pathlib.Path('/tmp') \
                or not scratch.name.startswith('flea-acceptance-matrix.') or not (scratch / '.flea-matrix').is_file():
            raise SystemExit('refusing unsafe key matrix fixture cleanup')
        shutil.rmtree(scratch)
PYTHON
}

# keys.toml names keys the way Qt does; wtype speaks xkb keysyms. A name with no row here makes its
# binding report as undriven rather than be guessed at, so a key added to the table tomorrow says it
# needs a keysym instead of silently never being pressed.
# Sample input: "Return" gives "Return", "Enter" gives "KP_Enter", "D" gives "d", "1" gives "1".
keysym_for() {
  case $1 in
    Return|Delete|Escape|Tab|Up|Down|Left|Right|F2|F10|Home|End|Insert|Menu) printf '%s' "$1" ;;
    Backtab) printf 'ISO_Left_Tab' ;;
    PageUp) printf 'Prior' ;;
    PageDown) printf 'Next' ;;
    Enter) printf 'KP_Enter' ;;
    Backspace) printf 'BackSpace' ;;
    Space) printf 'space' ;;
    Greater) printf 'greater' ;;
    Period) printf 'period' ;;
    Comma) printf 'comma' ;;
    BracketLeft) printf 'bracketleft' ;;
    BracketRight) printf 'bracketright' ;;
    Plus) printf 'plus' ;;
    Equal) printf 'equal' ;;
    Minus) printf 'minus' ;;
    Underscore) printf 'underscore' ;;
    [A-Z]) printf '%s' "$1" | tr 'A-Z' 'a-z' ;;
    [0-9]) printf '%s' "$1" ;;
    *) return 1 ;;
  esac
}

# The wtype arguments for one binding, one per line so the caller reads them into an array without a
# word split. A [[text]] row types its character; every other table is a chord on a keysym with the
# modifiers pressed around it.
chord_args() {
  local table=$1 keyname=$2 sym
  # Text goes bare because `--` is dropped; `-` uses its keysym because wtype parses it as a flag.
  if [ "$table" = text ]; then
    if [ "$keyname" = - ]; then
      printf -- '-k\nminus\n'
    else
      printf -- '%s\n' "$keyname"
    fi
    return 0
  fi
  sym=$(keysym_for "$keyname") || return 1
  case $table in
    ctrl)      printf -- '-M\nctrl\n-k\n%s\n-m\nctrl\n' "$sym" ;;
    ctrlshift) printf -- '-M\nctrl\n-M\nshift\n-k\n%s\n-m\nshift\n-m\nctrl\n' "$sym" ;;
    shift)     printf -- '-M\nshift\n-k\n%s\n-m\nshift\n' "$sym" ;;
    code|none) printf -- '-k\n%s\n' "$sym" ;;
    alt)       printf -- '-M\nalt\n-k\n%s\n-m\nalt\n' "$sym" ;;
    super)     printf -- '-M\nlogo\n-k\n%s\n-m\nlogo\n' "$sym" ;;
    supershift) printf -- '-M\nlogo\n-M\nshift\n-k\n%s\n-m\nshift\n-m\nlogo\n' "$sym" ;;
    superalt)  printf -- '-M\nlogo\n-M\nalt\n-k\n%s\n-m\nalt\n-m\nlogo\n' "$sym" ;;
    *) return 1 ;;
  esac
}

# How a chord is written in the report, so a reader can tell which of an action's keys was pressed.
chord_label() {
  case $1 in
    ctrl) printf '^%s' "$2" ;;
    ctrlshift) printf '^S-%s' "$2" ;;
    shift) printf 'S-%s' "$2" ;;
    code) printf '<%s>' "$2" ;;
    *) printf '%s' "$2" ;;
  esac
}

# The chord array for the first binding of an action, which is how the helpers below move the cursor
# and unwind state without naming a key themselves.
# Dies rather than returning empty: every action asked for here is one this battery drives, so a
# chord that cannot be resolved means keys.toml lost a binding. An empty array would send no keys at
# all and leave the checks that depend on it failing for a reason nothing names.
first_chord() {
  local action=$1 context=${2:-listing} id preset frontend scope mods keyname act wanted
  for wanted in "$action" "${action}Arm"; do
    while IFS='|' read -r id preset frontend scope mods keyname act; do
      [[ "$preset" == "$DRIVE_PRESET" && "$frontend" == gui && "$scope" == "$context" && "$act" == "$wanted" ]] || continue
      chord_args "$mods" "$keyname" || continue
      [[ "$wanted" == "$action" ]] || chord_args "$mods" "$keyname" || return 1
      return 0
    done < "$BINDINGS"
  done
  die "no deliverable $DRIVE_PRESET/gui/$context binding for setup action '$action'"
}

# ---- the fixture ---------------------------------------------------------------------------------

# Rows enough that a page step and a jump to the end both move, plus one file of every kind a
# preview or a menu row needs. Every name is generated here, so nothing personal is ever in it.
BULK_ROWS=30
HAVE_IMAGE=0
HAVE_PDF=0
HAVE_MEDIA=0
HAVE_ARCHIVE=0

drive_fixture_build() {
  local n name
  # A scratch, not a sandbox of its own: sandbox_make would drop its marker file into the very
  # directory whose row count these checks assert. The marker stays up on $SB.
  sandbox_scratch "$DRIVE_FIXTURE"
  mkdir -p "$DRIVE_FIXTURE/sub" "$DRIVE_FIXTURE/dest"
  printf 'alpha\n' > "$DRIVE_FIXTURE/a-note.txt"
  printf 'inner\n' > "$DRIVE_FIXTURE/sub/inner.txt"
  printf 'hidden\n' > "$DRIVE_FIXTURE/.a-hidden.txt"
  printf 'filter me\n' > "$DRIVE_FIXTURE/zz-unique-filter.txt"
  # One file per operation, so no two checks fight over the same row and every negative control
  # ("this is not at the destination yet") means something.
  for name in op-copy op-cut op-paste op-trash op-undo menu-trash op-rename-click \
              super-copy super-cut super-paste; do
    printf '%s\n' "$name" > "$DRIVE_FIXTURE/$name.txt"
  done
  for n in $(seq -w 1 "$BULK_ROWS"); do
    printf 'row %s\n' "$n" > "$DRIVE_FIXTURE/f-$n.txt"
  done
  # A missing tool is not a skipped check: the items needing it report undriven and name it.
  if command -v magick >/dev/null; then
    magick -size 320x200 gradient:'#0e1112-#b38956' "$DRIVE_FIXTURE/b-image.png" 2>/dev/null && HAVE_IMAGE=1
    # Each page in its own parentheses, or magick draws one annotation onto every page. The pages
    # carry different text because the page turn is asserted by reading the page back off the screen.
    magick \( -size 400x560 xc:white -fill black -font Liberation-Sans -pointsize 40 -annotate +40+80 'PAGEONE' \) \
           \( -size 400x560 xc:white -fill black -font Liberation-Sans -pointsize 40 -annotate +40+80 'PAGETWO' \) \
           \( -size 400x560 xc:white -fill black -font Liberation-Sans -pointsize 40 -annotate +40+80 'PAGETHREE' \) \
           "$DRIVE_FIXTURE/c-doc.pdf" 2>/dev/null && HAVE_PDF=1
  fi
  if command -v ffmpeg >/dev/null; then
    ffmpeg -loglevel error -y -f lavfi -i 'testsrc2=size=320x240:rate=30' -t 30 \
      -pix_fmt yuv420p "$DRIVE_FIXTURE/d-clip.mp4" 2>/dev/null && HAVE_MEDIA=1
  fi
  if command -v bsdtar >/dev/null; then
    bsdtar -a -c -f "$DRIVE_FIXTURE/e-bundle.tar.zst" -C "$DRIVE_FIXTURE/sub" . 2>/dev/null && HAVE_ARCHIVE=1
  fi
}

# ---- the window ------------------------------------------------------------------------------------

# Whatever Flea is running before this function is somebody else's, most likely the operator's own,
# and the teardown must never take it. This ran once with an indiscriminate teardown behind it and
# killed the operator's window from the very refusal path that exists to protect it: the trap is
# armed before the launch, so the refusal below still ran the teardown on its way out.
DRIVE_LAUNCHED=0
DRIVE_WINDOW_ADDRESS=""
DRIVE_BUS_PID=""

drive_guard() {
  [[ -n "$1" && "$1" == /* && -f "$SB/$SANDBOX_MARKER" ]] || die "unmarked or non-absolute acceptance mutation: $1"
  sandbox_require "$1"
  [[ "$SANDBOX_PATH" == "$SB/"* ]] || die "acceptance mutation escaped its own sandbox: $1"
}

drive_mutation_guard() {
  local path
  [[ -n "$1" && "$1" == /* && -f "$SB/$SANDBOX_MARKER" ]] || return 1
  path=$(realpath -m -- "$1") || return 1
  [[ "$path" == "$DRIVE_FIXTURE" || "$path" == "$DRIVE_FIXTURE/"* ]]
}

drive_owned_pids() {
  python3 - "$SB" "${1:-}" <<'PY'
import os, pathlib, sys
root, requested = sys.argv[1:]
for process in [pathlib.Path('/proc', requested)] if requested else pathlib.Path('/proc').iterdir():
    if not process.name.isdigit() or int(process.name) in (os.getpid(), os.getppid()):
        continue
    try:
        environment = dict(item.split(b'=', 1) for item in (process / 'environ').read_bytes().split(b'\0') if b'=' in item)
        bus, separator, guid = environment.get(b'DBUS_SESSION_BUS_ADDRESS', b'').partition(b',guid=')
        private = bus == os.fsencode('unix:path=' + root + '/bus') and (not separator or len(guid) == 32 and all(byte in b'0123456789abcdef' for byte in guid))
        private = private and environment.get(b'XDG_DATA_HOME') == os.fsencode(root + '/data')
        tagged = environment.get(b'FLEA_ACCEPTANCE_RUN') == os.fsencode(root)
        if process.stat().st_uid == os.getuid() and (tagged or private):
            print(process.name)
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        continue
PY
}

drive_window_identity() {
  python3 - "$SB" "$BIN" "$REPO/ui" "${1:-$DRIVE_WINDOW_ADDRESS}" <<'PY'
import json, os, pathlib, subprocess, sys
root, binary, ui, address = sys.argv[1:]
clients = json.loads(subprocess.check_output(['hyprctl', 'clients', '-j']))
matches = [row for row in clients if row.get('class') == 'com.thisisgm.flea' and (not address or row['address'] == address)]
if len(matches) != 1:
    raise SystemExit('owned Flea window is missing or ambiguous')
window = matches[0]
process = pathlib.Path('/proc', str(window['pid']))
environment = (process / 'environ').read_bytes().split(b'\0')
required = ['FLEA_ACCEPTANCE_RUN=' + root, 'FLEA_UI=' + ui, 'FLEA_BIN=' + binary]
if process.stat().st_uid != os.getuid() or any(os.fsencode(value) not in environment for value in required):
    raise SystemExit('Flea window environment does not belong to this candidate run')
if os.fsencode(ui) not in (process / 'cmdline').read_bytes().split(b'\0'):
    raise SystemExit('Flea window did not load the identified UI directory')
print(json.dumps(window, separators=(',', ':')))
PY
}

drive_private_state() {
  local directory
  export FLEA_ACCEPTANCE_RUN="$SB"
  export XDG_STATE_HOME="$SB/state" XDG_CONFIG_HOME="$SB/config"
  export XDG_DATA_HOME="$SB/data" XDG_CACHE_HOME="$SB/cache"
  for directory in "$XDG_STATE_HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME"; do
    drive_guard "$directory"
    mkdir -p "$directory" || die "cannot create private XDG directory: $directory"
  done
  # The native terminal uses POSIX sh, whose interactive startup file and history are fixture-owned.
  export SHELL=/bin/sh ENV="$XDG_CONFIG_HOME/terminal-env" HISTFILE="$SB/terminal-history"
  drive_guard "$ENV"
  : > "$ENV" || die "cannot create private terminal startup file"
  printf 'foot.desktop\n' > "$XDG_CONFIG_HOME/xdg-terminals.list" || die "cannot select the private native terminal"
  drive_guard "$XDG_CONFIG_HOME/foot"
  mkdir "$XDG_CONFIG_HOME/foot" || die "cannot create private foot configuration"
  printf '[main]\nshell=/bin/sh\nlogin-shell=no\n' > "$XDG_CONFIG_HOME/foot/foot.ini" || die "cannot isolate native terminal startup"
}

drive_seed_preset() {
  drive_guard "$XDG_STATE_HOME/flea"
  "$BIN" --ui-state "$(jq -cn --arg preset "$DRIVE_PRESET" '{keys:$preset,view:"list",hidden:false,sort:{key:"name",reverse:false},preview:{column:true,loadOn:"manual"},display:{textSize:{mode:"system"}},menu:{hidden:[]}}')" \
    > "$SB/state-seed-$DRIVE_PRESET.log" || die "could not seed private $DRIVE_PRESET preferences"
}

drive_bus_id() {
  gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.GetId | python3 -c 'import ast,sys; print(ast.literal_eval(sys.stdin.read())[0])'
}

drive_private_trash() {
  local parent current="" end provider_count=0 pid
  parent=$(drive_bus_id) || die "parent D-Bus identity unavailable"
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$SB/bus"
  dbus-daemon --session --nofork --address="$DBUS_SESSION_BUS_ADDRESS" > "$SB/dbus.log" 2>&1 &
  DRIVE_BUS_PID=$!
  end=$((SECONDS + 10))
  while (( SECONDS < end )); do
    current=$(drive_bus_id 2>/dev/null) && break
    kill -0 "$DRIVE_BUS_PID" 2>/dev/null || die "private D-Bus daemon exited"
    sleep 0.05
  done
  [[ -n "$current" && "$current" != "$parent" ]] || die "private D-Bus identity was not established"
  [[ "$(realpath -e "$(command -v gio)")" == /usr/bin/gio ]] || die "gio resolves to a stub"
  /usr/bin/gio list trash:/// > "$SB/initial-trash.log" || die "private GIO Trash mount failed"
  [[ ! -s "$SB/initial-trash.log" ]] || die "private Trash is not empty; refusing to exercise it"
  for pid in $(drive_owned_pids); do
    if [[ "$(cat "/proc/$pid/comm")" == gvfsd-trash ]]; then provider_count=$((provider_count + 1)); fi
  done
  [[ "$provider_count" == 1 ]] || die "expected one attributable private Trash provider, found $provider_count"
  printf 'TRASH_SESSION parent=%s private=%s daemon=%s root=%s\n' "$parent" "$current" "$DRIVE_BUS_PID" "$XDG_DATA_HOME"
}

# The product's own launcher, with both seams on the launch line so a packaged /usr/share/flea/ui can
# never outrank this tree (see the KB on installing your own package).
drive_launch() {
  if omarchy-drive wait window flea --timeout 0 >/dev/null 2>&1; then
    die "a Flea window is already open, and only one lane may hold the display"
  fi
  FLEA_UI="$REPO/ui" FLEA_BIN="$BIN" setsid nohup "$BIN" --gui "$DRIVE_FIXTURE" \
    >"$SB/flea-$DRIVE_PRESET.log" 2>&1 </dev/null &
  DRIVE_LAUNCHED=1
  omarchy-drive wait window flea --timeout 15 >/dev/null 2>&1 || die "no Flea window appeared in 15 s"
  DRIVE_WINDOW_ADDRESS=$(drive_window_identity | jq -er '.address') || die "cannot identify native candidate window"
  omarchy-drive focus "$DRIVE_WINDOW_ADDRESS" || die "owned candidate could not receive focus"
  # A window under a fixture HOME renders the fallback palette, and every colour claim off it is
  # worthless; ui/Theme.qml carries the flag for exactly this check.
  [ "$(ipc themeLoaded)" = true ] || die "themeLoaded is not true, so this window paints a fallback palette"
  wait_path "$DRIVE_FIXTURE" || die "the pane never opened the fixture"
  [[ "$(ipc keymapPreset)" == "$DRIVE_PRESET" ]] || die "live preset differs from seeded $DRIVE_PRESET"
  local pid found=0
  for pid in $(backend_pids); do
    [[ "$(drive_owned_pids "$pid")" == "$pid" ]] || continue
    [[ "$(readlink -f "/proc/$pid/exe")" == "$BIN" ]] || die "backend is not the identified candidate"
    printf 'BACKEND pid=%s binary=%s\n' "$pid" "$BIN"
    found=$((found + 1))
  done
  [[ "$found" -gt 0 ]] || die "owned candidate has no attributable backend"
  printf 'NATIVE_WINDOW preset=%s identity=%s\n' "$DRIVE_PRESET" "$(drive_window_identity)"
  park_pointer
}

# Kills only what this run started. A pid that was already there when drive_launch looked belongs to
# somebody else and is skipped by name, not by timing.
drive_teardown() {
  local pid waited
  [ "$DRIVE_LAUNCHED" = 1 ] || return 0
  for pid in $(flea_pids); do
    [[ "$(drive_owned_pids "$pid")" == "$pid" ]] || continue
    kill "$pid" 2>/dev/null
  done
  for waited in $(seq 1 $((DRAIN_WAIT_S * 20))); do
    [ -z "$(drive_product_pids)" ] && break
    sleep 0.05
  done
  [[ -z "$(drive_product_pids)" ]] || { printf 'FAIL: candidate processes did not drain after %ss\n' "$DRAIN_WAIT_S" >&2; return 1; }
  DRIVE_LAUNCHED=0
  DRIVE_WINDOW_ADDRESS=""
}

drive_product_pids() {
  local pid
  for pid in $(flea_pids) $(backend_pids); do
    [[ "$(drive_owned_pids "$pid")" != "$pid" ]] || printf '%s\n' "$pid"
  done
}

wait_path() {
  local want=$1 seen attempt
  for attempt in $(seq 1 200); do
    seen=$(ipc path)
    [ "$seen" = "$want" ] && return 0
    sleep 0.05
  done
  WHY="the pane is at '$seen', not '$want'"
  return 1
}

wait_file() {
  local want=$1 attempt
  for attempt in $(seq 1 $((TRANSFER_WAIT_S * 10))); do
    [ -e "$want" ] && return 0
    sleep 0.1
  done
  return 1
}

# ---- putting the app in a known state -------------------------------------------------------------

# Esc unwinds one thing at a time, so it is sent until every overlay reader is quiet rather than a
# fixed number of times. Then the view and the directory are put back.
reset_state() {
  local attempt state quiet end=$((SECONDS + 20))
  mapfile -t esc < <(chord_args code Escape)
  while (( SECONDS < end )); do
    state=$(ipc keyDeliveryState) || { WHY="key delivery observer unavailable during reset"; return 1; }
    quiet=$(jq -er '.searchMode == "" and (.filterTyping | not) and .filterQuery == "" and .keySequence == ""' <<< "$state")
    if [ "$(ipc contextMenuVisible)" = false ] && [ "$(ipc previewOpen)" = false ] \
       && [ "$(ipc dialogOpen)" = false ] && [ "$(ipc keymapSheetOpen)" = false ] \
       && [ "$(ipc convertOpen)" = false ] && [ "$(ipc shareBrowserOpen)" = false ] \
       && [ "$(ipc settingsOpen)" = false ] && [ "$(ipc renamingIndex)" = -1 ] \
       && [[ "$(ipc menuDialogState | jq -r .opened)" == false && "$(ipc permissionsState | jq -r .opened)" == false ]] \
       && [ "$(ipc selectionCount)" = 0 ] && [ "$(ipc focusView)" = list ] && [[ "$quiet" == true ]]; then
      break
    fi
    k "${esc[@]}"
    settle
  done
  (( SECONDS < end )) || { WHY="native Escape did not unwind all observed contexts"; return 1; }
  if [ "$(ipc viewMode)" != list ]; then
    mapfile -t chord < <(first_chord viewList)
    k "${chord[@]}"
    settle
  fi
  local tabs
  for tabs in 1 2 3 4 5 6 7 8 9; do
    [ "$(ipc tabCount)" -le 1 ] && break
    mapfile -t closech < <(first_chord tabClose)
    k "${closech[@]}"
    settle
  done
  if [[ "$(ipc path)" != "$DRIVE_FIXTURE" ]]; then
    mapfile -t chord < <(first_chord pathBar)
    k "${chord[@]}"; settle
    k -M ctrl -k a -m ctrl "$DRIVE_FIXTURE" -k Return
    wait_path "$DRIVE_FIXTURE" || return 1
  fi
  jq -e '.listFocus or .paneFocus' <<< "$(ipc keyDeliveryState)" >/dev/null \
    || { WHY="reset returned the logical listing without actual pane/list focus"; return 1; }
}

drive_expect() {
  local reader=$1 predicate=$2 state end=$((SECONDS + 15))
  while (( SECONDS < end )); do
    state=$(ipc "$reader") || { WHY="$reader observation failed"; return 1; }
    if jq -e "$predicate" <<< "$state" >/dev/null; then
      printf 'OBSERVED %s %s %s\n' "$DRIVE_ROW_ID" "$reader" "$state"
      return 0
    fi
    sleep 0.05
  done
  WHY="$reader did not satisfy $predicate; observed $state"
  return 1
}

drive_action() {
  local -a binding
  mapfile -t binding < <(first_chord "$1" "${2:-listing}")
  [[ "${#binding[@]}" -gt 0 ]] || return 1
  k "${binding[@]}"
  settle
}

# Walks the cursor to a row by name from the top, with the derived chords, so no check depends on an
# index a sort could move. Both chords are driven as their own items before anything calls this, so a
# broken one is reported plainly rather than only as every later check failing.
seek_row_named() {
  local want=$1 i
  mapfile -t firstc < <(first_chord cursorFirst)
  mapfile -t downc < <(first_chord cursorDown)
  local pass
  for pass in 1 2; do
    k "${firstc[@]}"
    settle
    for i in $(seq 1 60); do
      case "$(ipc rowAt "$(ipc cursor)")" in
        "$want|"*) return 0 ;;
      esac
      k "${downc[@]}"
    done
    # A narrowed listing is the one state that hides a row that is really there, and it is not on the
    # IPC seam, so the walk unwinds and tries once more rather than reporting the product missing it.
    mapfile -t escs < <(chord_args code Escape)
    k "${escs[@]}"; k "${escs[@]}"; k "${escs[@]}"
    settle
  done
  WHY="could not put the cursor on $want, even after unwinding, so the listing is not showing the fixture"
  return 1
}

# The status bar clears a transient after ui/StatusBar.qml's messageMs, which is 4000. Waiting for
# that empty is what keeps a message assertion honest: nine tab keys all say the same sentence, so
# without this the second one would read its own predecessor's line as the answer and pass on it.
wait_message_clear() {
  local attempt
  for attempt in $(seq 1 70); do
    [ -z "$(ipc lastMessage)" ] && return 0
    sleep 0.1
  done
  WHY="the status line never cleared, it still reads '$(ipc lastMessage)'"
  return 1
}

# Enters a directory by name and comes back, so an operation's destination is reached with the
# product's own keys rather than by telling the backend where to go.
enter_dir() {
  seek_row_named "$1" || return 1
  mapfile -t openc < <(first_chord open)
  k "${openc[@]}"
  wait_path "$DRIVE_FIXTURE/$1"
}

leave_dir() {
  mapfile -t parentc < <(first_chord parent)
  k "${parentc[@]}"
  wait_path "$DRIVE_FIXTURE"
}

# ---- the key drivers -------------------------------------------------------------------------------
#
# One function per action, named keycase_<action>, taking the chord as its arguments. Each puts the
# app in the state the action needs, reads the observable before the chord, sends it, and reads the
# observable after. None of them reports: the runner does that once per action however many bindings
# the action has, and a refusal comes back as WHY.

# -- moving the cursor --

keycase_cursorFirst() {
  local before after
  reset_state || return 1
  mapfile -t downc < <(first_chord cursorDown)
  k "${downc[@]}"; k "${downc[@]}"; k "${downc[@]}"; settle
  before=$(ipc cursor)
  k "$@"; settle
  after=$(ipc cursor)
  changed_to cursor "$before" "$after" 0
}

keycase_cursorDown() {
  local before after
  reset_state || return 1
  mapfile -t firstc < <(first_chord cursorFirst)
  k "${firstc[@]}"; settle
  before=$(ipc cursor)
  k "$@"; settle
  after=$(ipc cursor)
  changed_to cursor "$before" "$after" "$((before + 1))"
}

keycase_cursorUp() {
  local before after
  reset_state || return 1
  mapfile -t firstc < <(first_chord cursorFirst)
  mapfile -t downc < <(first_chord cursorDown)
  k "${firstc[@]}"; k "${downc[@]}"; k "${downc[@]}"; settle
  before=$(ipc cursor)
  k "$@"; settle
  after=$(ipc cursor)
  changed_to cursor "$before" "$after" "$((before - 1))"
}

keycase_cursorLast() {
  local before after total
  reset_state || return 1
  mapfile -t firstc < <(first_chord cursorFirst)
  k "${firstc[@]}"; settle
  total=$(ipc total)
  before=$(ipc cursor)
  k "$@"; settle
  after=$(ipc cursor)
  changed_to cursor "$before" "$after" "$((total - 1))"
}

keycase_pageDown() {
  local before after
  reset_state || return 1
  mapfile -t firstc < <(first_chord cursorFirst)
  k "${firstc[@]}"; settle
  before=$(ipc cursor)
  k "$@"; settle
  after=$(ipc cursor)
  changed_from cursor "$before" "$after" || return 1
  [ "$after" -gt "$before" ] && return 0
  WHY="the cursor went up, from $before to $after"
  return 1
}

keycase_pageUp() {
  local before after
  reset_state || return 1
  mapfile -t lastc < <(first_chord cursorLast)
  k "${lastc[@]}"; settle
  before=$(ipc cursor)
  k "$@"; settle
  after=$(ipc cursor)
  changed_from cursor "$before" "$after" || return 1
  [ "$after" -lt "$before" ] && return 0
  WHY="the cursor went down, from $before to $after"
  return 1
}

# -- selecting --

expect_selection() {
  local cursor=$1 members=$2 seen_cursor seen_members
  seen_cursor=$(ipc cursor) && seen_members=$(ipc selectedIndices) || return 1
  printf 'ASSERT selection cursor=%s members=%q expected_cursor=%s expected_members=%q\n' "$seen_cursor" "$seen_members" "$cursor" "$members"
  [[ "$seen_cursor" == "$cursor" && "$seen_members" == "$members" ]] \
    || { WHY="selection has cursor=$seen_cursor and members=$seen_members; expected cursor=$cursor and members=$members"; return 1; }
}

keycase_toggleSelect() {
  local cursor
  reset_state || return 1
  cursor=$(ipc cursor)
  expect_selection "$cursor" "" || return 1
  k "$@"; settle
  expect_selection "$cursor" "$cursor"
}

keycase_extendDown() {
  reset_state || return 1
  mapfile -t firstc < <(first_chord cursorFirst)
  k "${firstc[@]}"; settle
  expect_selection 0 "" || return 1
  k "$@"; settle
  expect_selection 1 "0,1"
}

keycase_extendUp() {
  local last
  reset_state || return 1
  mapfile -t lastc < <(first_chord cursorLast)
  k "${lastc[@]}"; settle
  last=$(( $(ipc total) - 1 ))
  expect_selection "$last" "" || return 1
  k "$@"; settle
  expect_selection "$((last - 1))" "$((last - 1)),$last"
}

keycase_selectAll() {
  local cursor total members
  reset_state || return 1
  cursor=$(ipc cursor); total=$(ipc total)
  expect_selection "$cursor" "" || return 1
  members=$(seq 0 "$((total - 1))" | paste -sd, -)
  k "$@"; settle
  expect_selection "$cursor" "$members"
}

keycase_escape() {
  local cursor
  reset_state || return 1
  cursor=$(ipc cursor)
  mapfile -t selc < <(first_chord toggleSelect)
  k "${selc[@]}"; settle
  expect_selection "$cursor" "$cursor" || return 1
  k "$@"; settle
  expect_selection "$cursor" ""
}

