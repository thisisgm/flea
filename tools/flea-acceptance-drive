keycase_openTerminal() {
  command -v foot >/dev/null || { WHY="native foot terminal unavailable; existing ui-tui.sh terminal matrix also requires it"; return 2; }
  reset_state || return 1
  local before terminal="" pid shell_pid="" child output end
  before=$(hyprctl clients -j | jq -c 'map(.address)') || return 1
  k "$@"
  end=$((SECONDS + 15))
  while (( SECONDS < end )); do
    terminal=$(hyprctl clients -j | jq -c --argjson before "$before" '.[] | .address as $address | select($before | index($address) | not)') || return 1
    if [[ -n "$terminal" ]]; then break; fi
    sleep 0.05
  done
  [[ -n "$terminal" && "$(jq -s length <<< "$terminal")" == 1 ]] || { WHY="terminal activation did not produce exactly one attributable native window"; return 1; }
  pid=$(jq -er '.pid' <<< "$terminal") || return 1
  [[ "$(drive_owned_pids "$pid")" == "$pid" && "$(readlink -f "/proc/$pid/exe")" == "$(realpath -e "$(command -v foot)")" ]] \
    || { WHY="new terminal window is not the owned stock foot process"; return 1; }
  while (( SECONDS < end )); do
    for child in $(pgrep -P "$pid" || true); do
      if [[ "$(drive_owned_pids "$child")" == "$child" && "$(readlink -f "/proc/$child/exe")" == "$(realpath -e /bin/sh)" ]]; then shell_pid=$child; break; fi
    done
    [[ -n "$shell_pid" ]] && break
    sleep 0.05
  done
  [[ -n "$shell_pid" && "$(readlink -f "/proc/$shell_pid/cwd")" == "$DRIVE_FIXTURE" ]] \
    || { WHY="native terminal shell did not inherit the selected directory"; return 1; }
  printf 'OBSERVED terminal=%s shell_pid=%s cwd=%s\n' "$terminal" "$shell_pid" "$(readlink -f "/proc/$shell_pid/cwd")"
  output="$DRIVE_EVIDENCE/$DRIVE_ROW_ID-terminal.png"
  drive_guard "$output"
  [[ ! -e "$output" ]] || { WHY="terminal screenshot already exists"; return 1; }
  terminal=$(jq -er .address <<< "$terminal") || return 1
  omarchy-drive shot "$output" "$terminal" || { WHY="native terminal screenshot failed"; return 1; }
  [[ -s "$output" && "$(od -An -tx1 -N8 "$output" | tr -d ' \n')" == 89504e470d0a1a0a ]] || return 1
  printf 'SHOT %s sha256=%s visual_inspection=pending\n' "$output" "$(sha256sum "$output" | cut -d' ' -f1)"
  [[ "$(drive_owned_pids "$pid")" == "$pid" && "$(drive_owned_pids "$shell_pid")" == "$shell_pid" ]] || return 1
  omarchy-drive key --window "$terminal" exit -k Return || { WHY="native terminal would not accept exit"; return 1; }
  end=$((SECONDS + 15))
  while (( SECONDS < end )); do
    [[ -z "$(drive_owned_pids "$pid")" ]] && break
    sleep 0.05
  done
  [[ -z "$(drive_owned_pids "$pid")" ]] || { WHY="native terminal remained after exit"; return 1; }
  omarchy-drive focus "$DRIVE_WINDOW_ADDRESS"
}

keycase_windowNew() {
  local before after pid
  reset_state || return 1
  before=$(hyprctl clients -j | jq '[.[] | select(.class == "com.thisisgm.flea")] | length')
  k "$@"
  local end=$((SECONDS + 15))
  while (( SECONDS < end )); do
    after=$(hyprctl clients -j | jq '[.[] | select(.class == "com.thisisgm.flea")] | length')
    [[ "$after" == "$((before + 1))" ]] && break
    sleep 0.05
  done
  [[ "$after" == "$((before + 1))" ]] || { WHY="New window did not create another native window"; return 1; }
  local second
  second=$(hyprctl clients -j | jq -er --arg first "$DRIVE_WINDOW_ADDRESS" '.[] | select(.class == "com.thisisgm.flea" and .address != $first) | .address') || return 1
  drive_window_identity "$second" || return 1
  pid=$(hyprctl clients -j | jq -er --arg address "$second" '.[] | select(.address == $address) | .pid') || return 1
  [[ "$(drive_owned_pids "$pid")" == "$pid" ]] || { WHY="new window has foreign ownership"; return 1; }
  hyprctl dispatch closewindow "address:$second" || return 1
  while (( SECONDS < end )); do
    [[ "$(hyprctl clients -j | jq '[.[] | select(.class == "com.thisisgm.flea")] | length')" == "$before" ]] && break
    sleep 0.05
  done
  [[ "$(hyprctl clients -j | jq '[.[] | select(.class == "com.thisisgm.flea")] | length')" == "$before" ]] || return 1
  omarchy-drive focus "$DRIVE_WINDOW_ADDRESS" || return 1
}

# ---- the key runner ---------------------------------------------------------------------------------

drive_inert() {
  local before after
  before=$(drive_key_snapshot) || return 1
  k "$@"; settle
  after=$(drive_key_snapshot) || return 1
  [[ "$before" == "$after" ]] || { WHY="context-refused key changed protected native state: $before / $after"; return 1; }
  printf 'OBSERVED %s refused_key_state=%s\n' "$DRIVE_ROW_ID" "$after"
}

drive_key_snapshot() {
  local state path cursor selected settings menu preview
  state=$(ipc keyDeliveryState) && path=$(ipc path) && cursor=$(ipc cursor) && selected=$(ipc selectedIndices) \
    && settings=$(ipc uiSettings) && menu=$(ipc contextMenuVisible) && preview=$(ipc previewOpen) || return 1
  jq -cn --argjson state "$state" --arg path "$path" --argjson cursor "$cursor" --arg selected "$selected" \
    --argjson settings "$settings" --argjson menu "$menu" --argjson preview "$preview" --arg context "$DRIVE_CONTEXT" \
    --argjson settingsOpen "$(ipc settingsOpen)" --argjson pathBar "$(ipc pathBarOpen)" --argjson network "$(ipc dialogOpen)" \
    '{state:($state | del(.activeFocusItem,.trashArmedAt) | if $context == "editor" then del(.paneFocus,.listFocus) else . end),
      path:$path,cursor:$cursor,selected:$selected,settings:$settings,menu:$menu,preview:$preview,
      settingsOpen:$settingsOpen,pathBar:$pathBar,network:$network}'
}

drive_refused_context() {
  reset_state || return 1
  case "$DRIVE_CONTEXT" in
    rail) drive_action focusNext && drive_expect focusView '. == "rail"' || return 1 ;;
    menu) seek_row_named a-note.txt && drive_action menu && drive_expect menuState '.opened and .snapshotReady' || return 1 ;;
    panel) drive_action settings && drive_expect settingsOpen '. == true' || return 1 ;;
    editor) seek_row_named a-note.txt && drive_action rename && drive_expect renameEditorLive '. == true' || return 1 ;;
    preview) seek_row_named zz-unique-filter.txt && drive_action preview && drive_expect previewKind '. == "text"' || return 1 ;;
    pdf) open_pdf_preview || return $? ;;
    media)
      [[ "$HAVE_MEDIA" == 1 ]] || { WHY="media refusal needs the native media fixture"; return 2; }
      seek_row_named d-clip.mp4 && drive_action preview && drive_expect previewKind '. == "video"' || return 1 ;;
    *) WHY="unknown refusal context $DRIVE_CONTEXT"; return 2 ;;
  esac
  if [[ "$DRIVE_CONTEXT" == editor ]]; then
    printf 'EDITOR before=%q\n' "$(ipc renameEditorText)"
  fi
  drive_inert "$@" || return 1
  if [[ "$DRIVE_CONTEXT" == editor ]]; then
    # Text editing and submitting the unchanged name are legal; listing actions must remain refused.
    printf 'EDITOR after=%q open=%s\n' "$(ipc renameEditorText)" "$(ipc renameEditorLive)"
    [[ -f "$DRIVE_FIXTURE/a-note.txt" ]] || { WHY="editor key changed the underlying fixture file"; return 1; }
  fi
}

drive_menu_select() {
  local target cursor count
  target=$(ipc menuState | jq -er --arg action "$1" '.entries | map(.action) | index($action)') \
    || { WHY="menu lacks required $1 entry"; return 1; }
  count=$(ipc menuState | jq -er '.entries | length') || return 1
  while (( count-- > 0 )); do
    cursor=$(ipc contextMenuCursor)
    [[ "$cursor" == "$target" ]] && return 0
    drive_action "$([[ "$cursor" -lt "$target" ]] && printf cursorDown || printf cursorUp)" menu || return 1
  done
  WHY="menu could not focus $1"
  return 1
}

drive_menu_key() {
  local action=$1 before after expected direction
  shift
  case "$action" in open|preview|escape|menuRight|parent|cursorDown|cursorUp) ;;
    *) WHY="menu $action still needs its context-specific native assertion"; return 2 ;; esac
  reset_state && seek_row_named sub && drive_action menu || return 1
  drive_expect menuState '.opened and .snapshotReady' || return 1
  case "$action" in
    open|preview)
      drive_menu_select open || return 1
      k "$@"
      wait_path "$DRIVE_FIXTURE/sub" ;;
    escape)
      k "$@"
      drive_expect menuState '.opened | not' && drive_expect keyDeliveryState '.paneFocus or .listFocus' ;;
    menuRight|parent)
      drive_menu_select sort || return 1
      [[ "$action" != parent ]] || drive_action menuRight menu || return 1
      before=$(ipc menuState | jq -r .submenu)
      k "$@"; settle
      after=$(ipc menuState | jq -r .submenu)
      changed_to "menu submenu" "$before" "$after" "$([[ "$action" == menuRight ]] && printf true || printf false)" ;;
    cursorDown|cursorUp)
      if [[ "$action" == cursorUp ]]; then drive_action cursorDown menu || return 1; direction=-1; else direction=1; fi
      before=$(ipc contextMenuCursor)
      expected=$(ipc menuState | jq -er --argjson direction "$direction" '
        .cursor as $cursor | [.entries | to_entries[] | select(.value.separator != true and .value.disabled != true) | .key] |
        if $direction > 0 then map(select(. > $cursor)) | first else map(select(. < $cursor)) | last end') || return 1
      k "$@"; settle
      after=$(ipc contextMenuCursor)
      changed_to "menu cursor" "$before" "$after" "$expected" ;;
    *) WHY="menu $action still needs its context-specific native assertion"; return 2 ;;
  esac
}

drive_rail_key() {
  local action=$1 before after total target
  shift
  case "$action" in escape|focusNext|focusPrevious|cursorFirst|cursorDown|cursorUp|cursorLast|addNetwork|menu|settings|keymapSheet|pathBar) ;;
    *) WHY="rail $action requires its own eligibility and refusal state assertion"; return 2 ;; esac
  reset_state && drive_action focusNext || return 1
  [[ "$(ipc focusView)" == rail ]] || { WHY="rail did not receive focus"; return 1; }
  case "$action" in
    escape|focusNext|focusPrevious)
      k "$@"; settle
      changed_to "rail focus returns" rail "$(ipc focusView)" list ;;
    cursorFirst|cursorDown|cursorUp|cursorLast)
      drive_action cursorFirst rail || return 1
      if [[ "$action" == cursorFirst || "$action" == cursorUp ]]; then drive_action cursorDown rail || return 1; fi
      before=$(ipc railCursor); total=$(ipc railCount)
      case "$action" in
        cursorFirst) target=0 ;;
        cursorDown) target=$((before + 1)) ;;
        cursorUp) target=$((before - 1)) ;;
        cursorLast) target=$((total - 1)) ;;
      esac
      k "$@"; settle
      after=$(ipc railCursor)
      changed_to "rail cursor" "$before" "$after" "$target" ;;
    addNetwork)
      k "$@"
      drive_expect dialogOpen '. == true' ;;
    menu)
      drive_action cursorFirst rail || return 1
      target=$(ipc railEntries | jq -er 'map(.group == "trash") | index(true)') || return 1
      total=$(ipc railCount)
      while [[ "$(ipc railCursor)" != "$target" ]] && (( total-- > 0 )); do drive_action cursorDown rail || return 1; done
      [[ "$(ipc railCursor)" == "$target" ]] || return 1
      k "$@"
      drive_expect menuState '.opened and .forRail and any(.entries[]; .action == "emptyTrash")' ;;
    settings)
      k "$@"
      drive_expect settingsOpen '. == true' ;;
    keymapSheet)
      k "$@"
      drive_expect keymapSheetOpen '. == true' ;;
    pathBar)
      k "$@"
      drive_expect pathBarOpen '. == true' ;;
    *) WHY="rail $action requires its own eligibility and refusal state assertion"; return 2 ;;
  esac
}

drive_panel_key() {
  local action=$1 before after direction expected
  shift
  case "$action" in escape|focusNext|focusPrevious|open|preview|cursorDown|cursorUp) ;;
    *) WHY="panel $action needs a named Settings control state"; return 2 ;; esac
  reset_state && drive_action settings || return 1
  drive_expect settingsOpen '. == true' || return 1
  case "$action" in
    escape)
      k "$@"
      drive_expect settingsOpen '. == false' ;;
    focusNext|focusPrevious)
      before=$(ipc settingsSide)
      k "$@"; settle
      changed_to "Settings side" "$before" "$(ipc settingsSide)" rail ;;
    open|preview)
      k -k Tab; settle
      [[ "$(ipc settingsSide)" == rail ]] || return 1
      k "$@"; settle
      changed_to "Settings activation" rail "$(ipc settingsSide)" pane ;;
    cursorDown|cursorUp)
      if [[ "$action" == cursorUp ]]; then k -k Down; settle; fi
      before=$(ipc settingsCursor)
      direction=1
      [[ "$action" != cursorUp ]] || direction=-1
      expected=$(ipc settingsModel | jq -er --argjson cursor "$before" --argjson direction "$direction" '
        [to_entries[] | select((.value.kind == "ruler" and .value.on == true) or
          (.value.kind as $kind | ["check","master","choice","action","favourite","favouriteActions"] | index($kind))) | .key] |
        if $direction > 0 then map(select(. > $cursor)) | first else map(select(. < $cursor)) | last end') \
        || { WHY="Settings has no eligible control in direction $direction"; return 1; }
      k "$@"; settle
      after=$(ipc settingsCursor)
      changed_to "Settings control cursor" "$before" "$after" "$expected" ;;
    *) WHY="panel $action needs a named Settings control state"; return 2 ;;
  esac
}

drive_preview_key() {
  local action=$1 before after
  shift
  if [[ "$DRIVE_CONTEXT" == pdf ]]; then
    case "$action" in
      zoomIn|zoomOut|expand|pageForward) "keycase_$action" "$@"; return $? ;;
      seekForward) keycase_pageForward "$@"; return $? ;;
      seekBack|parent)
        open_pdf_preview && drive_action pageForward pdf || return 1
        before=$(ipc previewPdfPage)
        k "$@"; settle
        changed_to "PDF previous page" "$before" "$(ipc previewPdfPage)" "$((before - 1))"
        return $? ;;
      *) open_pdf_preview || return $? ;;
    esac
  elif [[ "$DRIVE_CONTEXT" == media ]]; then
    case "$action" in seekBack|seekForward) "keycase_$action" "$@"; return $? ;; esac
    reset_state && seek_row_named d-clip.mp4 && drive_action preview || return 1
    drive_expect previewOpen '. == true' || return 1
    [[ "$(ipc previewKind)" == video ]] || { WHY="media context did not load the video fixture"; return 1; }
  else
    reset_state && seek_row_named zz-unique-filter.txt && drive_action preview || return 1
    [[ "$(ipc previewKind)" == text ]] || { WHY="preview context did not load text"; return 1; }
  fi
  case "$action" in
    escape)
      k "$@"
      drive_expect previewOpen '. == false' ;;
    preview)
      if [[ "$DRIVE_CONTEXT" == media ]]; then
        before=$(ipc previewState)
        [[ "$before" == playing || "$before" == paused ]] || { WHY="media did not reach a playable state"; return 1; }
        k "$@"; settle
        changed_to "media play state" "$before" "$(ipc previewState)" "$([[ "$before" == playing ]] && printf paused || printf playing)"
      elif [[ "$DRIVE_CONTEXT" == preview ]]; then
        k "$@"
        drive_expect previewOpen '. == false'
      else WHY="PDF activation requires a named focused toolbar control"; return 2; fi ;;
    cursorUp|cursorDown)
      if [[ "$DRIVE_CONTEXT" != preview ]]; then WHY="$DRIVE_CONTEXT cursor action needs scroll/playback-specific evidence"; return 2; fi
      if [[ "$action" == cursorDown ]]; then drive_action cursorUp preview || return 1; fi
      before=$(ipc cursor)
      k "$@"; settle
      after=$(ipc cursor)
      changed_to "preview follows cursor" "$before" "$after" "$((before + ($([[ "$action" == cursorDown ]] && printf 1 || printf -1))))" ;;
    *) WHY="$DRIVE_CONTEXT $action requires a focused native control assertion"; return 2 ;;
  esac
}

drive_key_row() {
  local row=$1 frontend mods keyname action rc=2 result label
  local -a chord
  IFS='|' read -r DRIVE_ROW_ID DRIVE_PRESET frontend DRIVE_CONTEXT mods keyname action <<< "$row"
  WHY=""
  label="$DRIVE_PRESET/$frontend/$DRIVE_CONTEXT/$mods:$keyname/${action:-listing-action-refused}"
  if [[ "$frontend" == tui ]]; then
    WHY="pending native terminal row in tests/ui-tui.sh $DRIVE_PRESET; GUI delivery cannot establish this result"
  elif ! chord_args "$mods" "$keyname" > "$SB/chord"; then
    WHY="no native delivery mapping for $mods:$keyname"
  else
    mapfile -t chord < "$SB/chord"
    if [[ -z "$action" && "$DRIVE_CONTEXT" != listing ]]; then
      drive_refused_context "${chord[@]}"; rc=$?
    else
    case "$DRIVE_CONTEXT" in
      listing)
        case "$action" in
          "") reset_state && drive_inert "${chord[@]}"; rc=$? ;;
          seekBack|seekForward|zoomIn|zoomOut|expand)
            reset_state && drive_inert "${chord[@]}"; rc=$? ;;
          addNetwork)
            if [[ "$mods" == text ]]; then reset_state && drive_inert "${chord[@]}"; rc=$?
            else keycase_addNetwork "${chord[@]}"; rc=$?; fi ;;
          pageForward) keycase_open "${chord[@]}"; rc=$? ;;
          *)
            if declare -F "keycase_$action" >/dev/null; then "keycase_$action" "${chord[@]}"; rc=$?
            else WHY="missing listing action driver: $action"; fi ;;
        esac ;;
      rail) drive_rail_key "$action" "${chord[@]}"; rc=$? ;;
      menu) drive_menu_key "$action" "${chord[@]}"; rc=$? ;;
      panel) drive_panel_key "$action" "${chord[@]}"; rc=$? ;;
      preview|pdf|media) drive_preview_key "$action" "${chord[@]}"; rc=$? ;;
      editor)
        if [[ "$action" == escape ]]; then
          reset_state && seek_row_named a-note.txt && drive_action rename && drive_expect renameEditorLive '. == true' \
            && k "${chord[@]}" && drive_expect renameEditorLive '. == false'
          rc=$?
        else WHY="editor binding lacks an editing/refusal driver"; fi ;;
    esac
    fi
  fi
  case "$rc" in
    0)
      result=PASS
      case "$action" in
        viewList|viewColumns|viewGrid|settings|keymapSheet|properties|togglePreview|loadPreview|focusPreview)
          drive_shot "$action" ;;
      esac
      pass key "$DRIVE_ROW_ID $label" ;;
    2) result=UNDRIVEN; skip key "$DRIVE_ROW_ID $label" "$WHY" ;;
    *) result=FAIL; bad key "$DRIVE_ROW_ID $label" "${WHY:-native assertion failed; see row log}" ;;
  esac
  jq -cn --arg row "$row" --arg status "$result" --arg reason "$WHY" --arg source "$FLEA_SOURCE_SHA" \
    --arg binary "$FLEA_BINARY_SHA256" --arg ui "$REPO/ui" --arg evidence "$DRIVE_EVIDENCE/$DRIVE_ROW_ID.log" \
    '{row:$row,status:$status,reason:$reason,source:$source,binarySha256:$binary,ui:$ui,evidence:$evidence}' >> "$DRIVE_EVIDENCE/keys.jsonl"
}

# ---- the menu ----------------------------------------------------------------------------------------

# Which row of the listing makes an entry appear at all, and what a chosen entry must then do. An
# action with no row here is reported undriven with the reason, which is the honest answer for the
# three that need a tailnet peer or a Dropbox tree this battery must not create.
menu_row_for() {
  case $1 in
    open) printf 'sub' ;;
    extract) printf 'e-bundle.tar.zst' ;;
    convert) printf 'b-image.png' ;;
    *) printf 'a-note.txt' ;;
  esac
}

# Sample inventory: ["delete", "Delete permanently", "trash", "F", "trash", "deletePermanently"].
derive_menu_actions() {
  python3 - "$REPO/ui/js/Menu.js" <<'PY'
import json, pathlib, sys
source = pathlib.Path(sys.argv[1]).read_text()
def array(name):
    start = source.index('var ' + name + ' = ') + len('var ' + name + ' = ')
    return json.JSONDecoder().raw_decode(source[start:].lstrip())[0]
seen, output = set(), []
contexts = {'F': 'file', 'B': 'background', 'T': 'trash'}
for row in array('INVENTORY'):
    if len(row) not in (5, 6) or row[0] in seen or not row[3]:
        raise SystemExit('invalid or duplicate Menu.INVENTORY row: ' + repr(row))
    seen.add(row[0])
    for context in row[3]:
        fields = [row[0], row[5] if len(row) == 6 else row[0], row[1], contexts[context]]
        if any(not value or any(char in value for char in '|\r\n') for value in fields):
            raise SystemExit('unrepresentable Menu.INVENTORY row: ' + repr(row))
        output.append('|'.join(fields))
if not seen:
    raise SystemExit('empty Menu.INVENTORY')
for key, label in array('columns'):
    output.append('|'.join(['col:' + key, 'col:' + key, label, 'header']))
print('\n'.join(output))
PY
}

# The one entry whose label is a ternary rather than a literal, so it needs its own reader.
# Sample input: '        label: showHidden ? "Hide hidden files" : "Show hidden files",'
derive_menu_toggle_labels() {
  sed -n 's/.*label: showHidden ? "\([^"]*\)" : "\([^"]*\)".*/\1\n\2/p' "$REPO/ui/js/Menu.js"
}

# Steps the menu cursor onto the row carrying one of the given labels and returns its index, using
# the derived cursorDown chord so the walk is the product's own.
menu_seek_label() {
  local wanted=$1 entries i target=-1 idx=0 label
  entries=$(ipc contextMenuEntries)
  IFS='|' read -r -a rows <<< "$entries"
  for idx in "${!rows[@]}"; do
    case "$wanted" in
      *"[${rows[$idx]}]"*) target=$idx; break ;;
    esac
  done
  if [ "$target" -lt 0 ]; then
    WHY="no row of the open menu carries a label this battery derived for it; the menu offers '$entries'"
    return 1
  fi
  mapfile -t downc < <(first_chord cursorDown)
  for i in $(seq 1 20); do
    [ "$(ipc contextMenuCursor)" = "$target" ] && { printf '%s' "$target"; return 0; }
    k "${downc[@]}"
  done
  WHY="the menu cursor would not step onto row $target"
  return 1
}

# Opens the row menu on the row an action needs and puts the menu cursor on that action's entry.
menu_open_on() {
  local action=$1 labels row cx cy
  row=$(menu_row_for "$action")
  reset_state || return 1
  if [[ "${DRIVE_MENU_CONTEXT:-file}" == background ]]; then
    enter_dir sub || return 1
    read -r cx cy <<< "$(ipc listingBackgroundCentre)"
    [[ -n "$cx" && -n "$cy" ]] || { WHY="background menu has no measured native target"; return 1; }
    click_at "$cx" "$cy" right || return 1
    drive_expect menuState '.opened and (.hasRow | not)' || return 1
  else
    seek_row_named "$row" || return 1
    mapfile -t menuc < <(first_chord menu)
    k "${menuc[@]}"; settle
  fi
  [ "$(ipc contextMenuVisible)" = true ] || { WHY="the menu did not open on $row"; return 1; }
  labels=$(menu_labels_for "$action")
  [ -n "$labels" ] || { WHY="no label for this entry could be derived from ui/js/Menu.js"; return 1; }
  menu_seek_label "$labels" >/dev/null
}

# Every label this action's entry could be drawing, each wrapped in brackets so a seek matches a
# whole label and never a substring of a longer one.
menu_labels_for() {
  local action=$1 id act label context out=""
  while IFS='|' read -r id act label context; do
    [[ "$act" == "$action" && "$context" == "${DRIVE_MENU_CONTEXT:-file}" ]] || continue
    out="${out}[$label]"
  done < <(derive_menu_actions)
  if [ "$action" = toggleHidden ]; then
    while IFS= read -r label; do
      out="${out}[$label]"
    done < <(derive_menu_toggle_labels)
  fi
  printf '%s' "$out"
}

menu_activate() {
  mapfile -t openc < <(first_chord open menu)
  k "${openc[@]}"
}

# One function per menu action, the same shape the key drivers use: state, before, choose, after.

menucase_open() {
  local before after
  menu_open_on open || return 1
  before=$(ipc path)
  menu_activate
  sleep 1
  after=$(ipc path)
  changed_to "the open directory" "$before" "$after" "$DRIVE_FIXTURE/sub"
}

menucase_rename() {
  local before after
  menu_open_on rename || return 1
  before=$(ipc renamingIndex)
  menu_activate; settle
  after=$(ipc renamingIndex)
  [ "$before" = "-1" ] || { WHY="a row was already its own editor, so this check could not fail"; return 1; }
  [ "$after" != "-1" ] && return 0
  WHY="no row became its own editor, renamingIndex is still $after"
  return 1
}

menucase_duplicate() {
  local before after
  menu_open_on duplicate || return 1
  before=$(ipc total)
  menu_activate
  sleep 2
  after=$(ipc total)
  changed_to "the row count" "$before" "$after" "$((before + 1))"
}

menucase_trash() {
  local before after
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/menu-trash.txt" ] \
    || { WHY="menu-trash.txt is not there to trash, so the check could not fail"; return 1; }
  seek_row_named menu-trash.txt || return 1
  mapfile -t menuc < <(first_chord menu)
  k "${menuc[@]}"; settle
  menu_seek_label "$(menu_labels_for trash)" >/dev/null || return 1
  menu_activate
  drive_wait_gone "$DRIVE_FIXTURE/menu-trash.txt" \
    || { WHY="menu-trash.txt is still on disk ${TRANSFER_WAIT_S}s after the entry was chosen"; return 1; }
  mapfile -t undoc < <(first_chord undo)
  k "${undoc[@]}"
  wait_file "$DRIVE_FIXTURE/menu-trash.txt" \
    || { WHY="undo did not put menu-trash.txt back, so the tree is not restored"; return 1; }
  return 0
}

menucase_newFolder() {
  local before after directory
  menu_open_on newFolder || return 1
  directory=$(ipc path)
  drive_mutation_guard "$directory" || return 1
  before=$(find "$directory" -mindepth 1 -maxdepth 1 -type d | wc -l)
  menu_activate
  sleep 2
  after=$(find "$directory" -mindepth 1 -maxdepth 1 -type d | wc -l)
  changed_to "the directory count in the fixture" "$before" "$after" "$((before + 1))"
}

menucase_toggleHidden() {
  local before after want
  menu_open_on toggleHidden || return 1
  before=$(ipc showHidden)
  want=true
  [ "$before" = true ] && want=false
  menu_activate; settle
  after=$(ipc showHidden)
  changed_to "the hidden-file flag" "$before" "$after" "$want"
}

menucase_convert() {
  local before after
  [ "$HAVE_IMAGE" = 1 ] || { WHY="no image fixture, magick is not on this box"; return 2; }
  [ "$(ipc canConvert)" = true ] || { WHY="the backend found no converter on this box, so the row is not offered"; return 2; }
  menu_open_on convert || return 1
  before=$(ipc convertOpen)
  menu_activate; settle
  after=$(ipc convertOpen)
  changed_to "the convert popup" "$before" "$after" true
}

menucase_extract() {
  local before after
  [ "$HAVE_ARCHIVE" = 1 ] || { WHY="no archive fixture, bsdtar is not on this box"; return 2; }
  menu_open_on extract || return 1
  before=$(ipc total)
  menu_activate
  sleep 3
  after=$(ipc total)
  changed_from "the row count" "$before" "$after"
}

# The one entry with a flyout: choosing it opens the format list the backend probed, and choosing a
# format there has to write an archive. Both halves are asserted, because a flyout that opens and
# writes nothing is the defect this row would have.
menucase_compress() {
  local formats before after
  formats=$(ipc archiveFormats)
  [ -n "$formats" ] || { WHY="the backend probed no archive tool on this box, so the row is not offered"; return 2; }
  menu_open_on compress || return 1
  before=$(ipc total)
  menu_activate; settle
  [ -n "$(ipc contextMenuSubmenuEntries)" ] || { WHY="the format flyout did not open"; return 1; }
  menu_activate
  sleep 4
  after=$(ipc total)
  changed_from "the row count" "$before" "$after"
}

drive_menu_action() {
  local id action label rc row=$1
  IFS='|' read -r id action label DRIVE_MENU_CONTEXT <<< "$row"
  local name="$id/$DRIVE_MENU_CONTEXT/$action"
  if [[ "$DRIVE_MENU_CONTEXT" == trash || "$DRIVE_MENU_CONTEXT" == header ]]; then
    skip menu "$name" "derived $label needs its own $DRIVE_MENU_CONTEXT native fixture and eligibility assertion"
    return
  fi
  case $action in
    taildrop)
      skip menu "$name" "the row appears only when a tailnet peer is reachable, and choosing it sends a real file to another machine, which is not this battery's to do"
      return ;;
    dropbox)
      skip menu "$name" "the row needs an authenticated Dropbox tree, and choosing it moves the file into \$HOME/Dropbox, outside the sandbox hard rule 9 allows"
      return ;;
    sharelink)
      skip menu "$name" "the row appears only for a row already inside \$HOME/Dropbox, which this battery must not create"
      return ;;
  esac
  if ! declare -F "menucase_$action" >/dev/null; then
    skip menu "$name" "an entry in ui/js/Menu.js, and this battery has no driver for it yet"
    return
  fi
  WHY=""
  "menucase_$action"
  rc=$?
  case $rc in
    0) pass menu "$name" "chosen from the open menu" ;;
    2) skip menu "$name" "$WHY" ;;
    *) bad menu "$name" "$WHY" ;;
  esac
}

# ---- the pointer contract ---------------------------------------------------------------------
#
# keys.toml grew a [[pointer]] table, so the click contract derives the way the keys do instead of
# living unnamed in ui/js/Focus.js where no derivation could see it. Every row below is an item.

# Sample input, one block of keys.toml:
#   [[pointer]]
#   where = "listing"
#   press = "left x2"
#   row = "any"
#   does = "open"
# Emits "<where>|<press>|<row>|<does>", one per block.
derive_pointer() {
  local where="" press="" rowkind="" line value intable=0
  while IFS= read -r line; do
    case $line in
      '[[pointer]]') intable=1; where=""; press=""; rowkind="" ;;
      '['*) intable=0 ;;
      'where = "'*) value=${line#*\"}; where=${value%\"} ;;
      'press = "'*) value=${line#*\"}; press=${value%\"} ;;
      'row = "'*) value=${line#*\"}; rowkind=${value%\"} ;;
      'does = "'*)
        [ "$intable" = 1 ] || continue
        value=${line#*\"}
        printf '%s|%s|%s|%s\n' "$where" "$press" "$rowkind" "${value%\"}" ;;
    esac
  done < "$REPO/keys.toml"
}

pointer_name() {
  printf '%s %s on %s' "$1" "$2" "$3"
}

# A click at a row's own centre, in screen coordinates: rowCentre answers in window space and the
# compositor wants the screen, the same correction tools/flea-showcase makes for a chrome button.
click_row() {
  local index=$1 centre cx cy wx wy landed
  shift
  # rowCentre reads the delegate actually on screen, and a ListView instantiates only what is
  # visible, so a row left scrolled out answers empty. The cursor goes home first to bring the top
  # of the listing back into view.
  mapfile -t firstc < <(first_chord cursorFirst)
  k "${firstc[@]}"
  settle
  centre=$(ipc rowCentre "$index")
  [ -n "$centre" ] || { WHY="row $index has no centre, so it is not on screen to click"; return 1; }
  read -r cx cy <<< "$centre"
  local was_at
  was_at=$(ipc path)
  click_at "$cx" "$cy" "$@" || return 1
  # An offset in this transform and a mis-hit in the product look identical from outside, so the
  # number is reported rather than the symptom. A click that opened a directory is excluded: the
  # cursor resets to 0 in the new listing, which is the row opening correctly and not a mis-hit.
  landed=$(ipc cursor)
  if [ "$landed" != "$index" ] && [ "$(ipc path)" = "$was_at" ]; then
    printf 'CLICKOFFSET aimed at row %s (centre %s,%s) and the cursor landed on %s\n' \
      "$index" "$cx" "$cy" "$landed"
  fi
}

# Clicks a point already read off the window. Separate from click_row because click_row scrolls the
# listing home first, and ui/js/Focus.js returns early while a rename editor holds the caret, so that
# keystroke would be typed into the filename instead of moving the cursor.
click_at() {
  local cx=$1 cy=$2 wx wy
  shift 2
  read -r wx wy _ww _wh _addr < <(window_geometry)
  # An empty origin is not "the window is at 0,0", it is "nothing answered", and adding it silently
  # is what turned every pointer failure into a lie about the product.
  [ -n "$wx" ] && [ -n "$wy" ] \
    || { WHY="hyprctl reported no geometry for the Flea window, so a click cannot be aimed at it"; return 1; }
  omarchy-drive click "$((cx + wx))" "$((cy + wy))" "$@" >/dev/null 2>&1 \
    || { WHY="the compositor would not accept a click at $((cx + wx)),$((cy + wy))"; return 1; }
  settle
}

# Two rows selected by keyboard first, so "drop any other selection" has something to drop and the
# check cannot pass on a listing that never had one.
pointercase_listing_left_any() {
  reset_state || return 1
  mapfile -t firstc < <(first_chord cursorFirst); k "${firstc[@]}"
  mapfile -t selc < <(first_chord toggleSelect); k "${selc[@]}"
  mapfile -t downc < <(first_chord cursorDown); k "${downc[@]}"; k "${selc[@]}"; settle
  expect_selection 1 "0,1" || return 1
  click_row 4 || return 1
  expect_selection 4 ""
}

pointercase_listing_left_x2_any() {
  local before after
  reset_state || return 1
  seek_row_named sub || return 1
  before=$(ipc path)
  click_row "$(ipc cursor)" --double || return 1
  sleep 1
  after=$(ipc path)
  changed_to "the open directory" "$before" "$after" "$DRIVE_FIXTURE/sub"
}

pointercase_listing_ctrl_left_any() {
  reset_state || return 1
  expect_selection "$(ipc cursor)" "" || return 1
  click_row 3 --mods ctrl || return 1
  expect_selection 3 "3"
}

pointercase_listing_shift_left_any() {
  reset_state || return 1
  mapfile -t firstc < <(first_chord cursorFirst); k "${firstc[@]}"; settle
  expect_selection 0 "" || return 1
  click_row 3 --mods shift || return 1
  expect_selection 3 "0,1,2,3"
}

# The whole point of these two rows: a modifier never opens, and only the first tap counts, so a
# ctrl-held double click must not toggle twice and put the selection back where it started.
pointercase_listing_ctrl_left_x2_any() {
  local cursor path_before
  reset_state || return 1
  seek_row_named sub || return 1
  path_before=$(ipc path)
  cursor=$(ipc cursor)
  expect_selection "$cursor" "" || return 1
  click_row "$cursor" --double --mods ctrl || return 1
  sleep 1
  [ "$(ipc path)" = "$path_before" ] || { WHY="the pane opened $(ipc path), but a modifier must never open"; return 1; }
  expect_selection "$cursor" "$cursor"
}

pointercase_listing_shift_left_x2_any() {
  local path_before
  reset_state || return 1
  mapfile -t firstc < <(first_chord cursorFirst); k "${firstc[@]}"; settle
  path_before=$(ipc path)
  expect_selection 0 "" || return 1
  click_row 3 --double --mods shift || return 1
  sleep 1
  [ "$(ipc path)" = "$path_before" ] || { WHY="the pane opened $(ipc path), but a modifier must never open"; return 1; }
  expect_selection 3 "0,1,2,3"
}

pointercase_listing_right_any() {
  local before after
  reset_state || return 1
  before=$(ipc contextMenuVisible)
  click_row 3 right || return 1
  after=$(ipc contextMenuVisible)
  changed_to "the context menu" "$before" "$after" true
}

# Clicking away from a rename commits it, which is one of today's fixes.
pointercase_listing_left_renaming() {
  local before after away cx cy
  reset_state || return 1
  # The point to click away at is read while the listing is still normal: once the editor is open the
  # listing must not be scrolled, and rowCentre only answers for a realised delegate anyway.
  mapfile -t firstc < <(first_chord cursorFirst); k "${firstc[@]}"; settle
  away=$(ipc rowCentre 1)
  [ -n "$away" ] || { WHY="row 1 has no centre, so there is nowhere to click away to"; return 1; }
  read -r cx cy <<< "$away"
  seek_row_named op-rename-click.txt || return 1
  mapfile -t renc < <(first_chord rename); k "${renc[@]}"; settle
  before=$(ipc renamingIndex)
  [ "$before" != "-1" ] || { WHY="no row became its own editor, so there is no rename to commit"; return 1; }
  k renamed-by-click
  settle
  click_at "$cx" "$cy" || return 1
  after=$(ipc renamingIndex)
  [ "$after" = "-1" ] || { WHY="the editor is still open on row $after, so the click did not commit it"; return 1; }
  wait_file "$DRIVE_FIXTURE/renamed-by-click.txt" \
    || { WHY="no file called renamed-by-click.txt exists, so the click closed the editor without committing"; return 1; }
  return 0
}

drive_pointer() {
  local line where press rowkind does name fn rc
  mapfile -t rows < <(derive_pointer)
  for line in "${rows[@]}"; do
    IFS='|' read -r where press rowkind does <<< "$line"
    name=$(pointer_name "$where" "$press" "$rowkind")
    case $where in
      neighbour)
        skip pointer "$name" "does $does; no IPC reader gives a neighbour column row its centre, so there is nothing to aim a click at"
        continue ;;
      rail)
        skip pointer "$name" "does $does; activating a rail row navigates out of the fixture and no IPC route comes back, so driving it would strand every later check"
        continue ;;
    esac
    fn="pointercase_$(printf '%s_%s_%s' "$where" "$press" "$rowkind" | tr ' ' '_')"
    if ! declare -F "$fn" >/dev/null; then
      skip pointer "$name" "does $does; declared in keys.toml and this battery has no driver for it yet"
      continue
    fi
    WHY=""
    "$fn"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      pass pointer "$name" "does $does"
    else
      bad pointer "$name" "$WHY"
    fi
  done
}

# ---- Omarchy's own operations, inside Flea -------------------------------------------------------
#
# The operator's requirement is that Omarchy's own chords keep working while Flea has focus. The
# mechanism, read off this box rather than assumed: Hyprland consumes every SUPER bind before any
# client sees it, and Omarchy's universal clipboard answers SUPER + C by injecting a real CTRL + C
# into the focused surface. So SUPER + C works in Flea exactly when Flea binds Ctrl+C, and the two
# instructions (match Finder with Ctrl, keep the supers working) are one chord.
#
# The assertion is never Flea's own status line, which a stray Ctrl+C would also set. Each chord is
# proved by a file that only that chord's sequence could have produced, and each is isolated: the
# copy chord is paired with Flea's own paste key, and the paste chord with Flea's own copy key, so
# neither can pass on the other.

OMARCHY_CLIPBOARD_LUA=/usr/share/omarchy/default/hypr/bindings/clipboard.lua

# Sample input, one line of that file:
#   o.bind("SUPER + C", "Universal copy", universal_clipboard_shortcut("CTRL", "C", "CTRL", "Insert"))
derive_omarchy_clipboard_binds() {
  [ -r "$OMARCHY_CLIPBOARD_LUA" ] || return 0
  sed -n 's/^o\.bind("\(SUPER[^"]*\)", "\([^"]*\)".*/\1|\2/p' "$OMARCHY_CLIPBOARD_LUA"
}

# "SUPER + CTRL + V" becomes "super_ctrl_v", which names both the driver and the chord's own parts.
omarchy_slug() {
  printf '%s' "$1" | tr -d ' ' | tr 'A-Z+' 'a-z_'
}

# Presses one derived chord as a real key the compositor sees first, which is the only route that
# fires an Omarchy bind. --global does not focus anything itself, so Flea is focused first: a chord
# aimed at Flea that lands on another surface proves nothing about Flea.
omarchy_press() {
  local slug=$1 mods key identity active
  key=${slug##*_}
  mods=${slug%_*}
  mods=$(printf '%s' "$mods" | tr '_' '+')
  identity=$(drive_window_identity) || { WHY="Omarchy chord target lost its owned identity"; return 1; }
  drive_mutation_guard "$(ipc path)" || return 1
  omarchy-drive focus "$DRIVE_WINDOW_ADDRESS" || { WHY="owned Flea would not take focus before the chord"; return 1; }
  active=$(hyprctl activewindow -j) || return 1
  jq -e --argjson owned "$identity" '.address == $owned.address and .pid == $owned.pid' <<< "$active" >/dev/null \
    || { WHY="Omarchy chord refused: owned Flea does not have focus"; return 1; }
  omarchy-drive hotkey --global "$mods" "$key" >/dev/null 2>&1 \
    || { WHY="the compositor would not accept a real $mods+$key press"; return 1; }
  settle
}

omarchycase_super_c() {
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/dest/super-copy.txt" ] \
    && { WHY="dest/super-copy.txt existed beforehand, so the check could not fail"; return 1; }
  seek_row_named super-copy.txt || return 1
  omarchy_press super_c || return 1
  enter_dir dest || return 1
  mapfile -t pastec < <(first_chord paste)
  k "${pastec[@]}"
  wait_file "$DRIVE_FIXTURE/dest/super-copy.txt" \
    || { WHY="SUPER+C put nothing on Flea's clipboard: nothing landed at dest/super-copy.txt"; leave_dir; return 1; }
  [ -e "$DRIVE_FIXTURE/super-copy.txt" ] \
    || { WHY="the source is gone, so SUPER+C reached Flea as a cut rather than a copy"; leave_dir; return 1; }
  drive_undo_transfer "$DRIVE_FIXTURE/dest/super-copy.txt"
  leave_dir
}

omarchycase_super_v() {
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/dest/super-paste.txt" ] \
    && { WHY="dest/super-paste.txt existed beforehand, so the check could not fail"; return 1; }
  seek_row_named super-paste.txt || return 1
  mapfile -t copyc < <(first_chord copy)
  k "${copyc[@]}"; settle
  enter_dir dest || return 1
  omarchy_press super_v || { leave_dir; return 1; }
  wait_file "$DRIVE_FIXTURE/dest/super-paste.txt" \
    || { WHY="SUPER+V did not paste: nothing landed at dest/super-paste.txt"; leave_dir; return 1; }
  drive_undo_transfer "$DRIVE_FIXTURE/dest/super-paste.txt"
  leave_dir
}

omarchycase_super_x() {
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/dest/super-cut.txt" ] \
    && { WHY="dest/super-cut.txt existed beforehand, so the check could not fail"; return 1; }
  seek_row_named super-cut.txt || return 1
  omarchy_press super_x || return 1
  enter_dir dest || return 1
  mapfile -t pastec < <(first_chord paste)
  k "${pastec[@]}"
  wait_file "$DRIVE_FIXTURE/dest/super-cut.txt" \
    || { WHY="SUPER+X put nothing on Flea's clipboard: nothing landed at dest/super-cut.txt"; leave_dir; return 1; }
  [ -e "$DRIVE_FIXTURE/super-cut.txt" ] \
    && { WHY="the source is still there, so SUPER+X reached Flea as a copy rather than a cut"; leave_dir; return 1; }
  drive_undo_transfer "$DRIVE_FIXTURE/dest/super-cut.txt"
  leave_dir
  wait_file "$DRIVE_FIXTURE/super-cut.txt" \
    || { WHY="undo did not put super-cut.txt back, so the tree is not restored"; return 1; }
}

# A layer surface is how every Omarchy panel arrives, so one appearing over a focused Flea is the
# proof that Flea neither swallowed the chord nor stopped the compositor acting on it.
omarchy_layer_case() {
  local slug=$1 before after restored
  reset_state || return 1
  before=$(omarchy-drive layers 2>/dev/null)
  omarchy_press "$slug" || return 1
  sleep 1
  after=$(omarchy-drive layers 2>/dev/null)
  if [ "$before" = "$after" ]; then
    WHY="no layer surface appeared over the focused Flea window, so the chord did not reach the compositor"
    return 1
  fi
  mapfile -t esc < <(chord_args code Escape)
  k "${esc[@]}"
  sleep 1
  restored=$(omarchy-drive layers 2>/dev/null)
  drive_window_identity >/dev/null && omarchy-drive focus "$DRIVE_WINDOW_ADDRESS" || return 1
  [ "$(ipc ready)" = true ] || { WHY="Flea stopped answering after the chord"; return 1; }
  [ "$restored" = "$before" ] && return 0
  WHY="the surface the chord raised is still on screen after Escape"
  return 1
}

omarchycase_super_space()   { omarchy_layer_case super_space; }
omarchycase_super_ctrl_v()  { omarchy_layer_case super_ctrl_v; }

# Fullscreen is a window state, so it is read back off the compositor and then put back the way it
# was, which is also what makes the check non-vacuous: it has to move twice.
omarchycase_super_f() {
  local before after restored
  reset_state || return 1
  before=$(window_json | jq -r '.fullscreen')
  omarchy_press super_f || return 1
  sleep 1
  after=$(window_json | jq -r '.fullscreen')
  changed_from "the window's fullscreen state" "$before" "$after" || return 1
  omarchy_press super_f || return 1
  sleep 1
  restored=$(window_json | jq -r '.fullscreen')
  [ "$restored" = "$before" ] || { WHY="the window did not come back to fullscreen=$before, it is at $restored"; return 1; }
  [ "$(ipc ready)" = true ] || { WHY="Flea stopped answering after the chord"; return 1; }
  return 0
}

# A compositor-launched terminal is not owned merely because it appeared after this chord.
omarchycase_super_return() {
  local before terminal="" pid address identity end
  reset_state || return 1
  before=$(hyprctl clients -j | jq -c 'map(.address)') || return 1
  omarchy_press super_return || return 1
  end=$((SECONDS + 15))
  while (( SECONDS < end )); do
    terminal=$(hyprctl clients -j | jq -c --argjson before "$before" '[.[] | .address as $address | select($before | index($address) | not)]') || return 1
    [[ "$terminal" != '[]' ]] && break
    sleep 0.05
  done
  [[ "$(jq length <<< "$terminal")" == 1 ]] \
    || { WHY="Super+Return did not create one attributable terminal; no new window was touched"; return 2; }
  pid=$(jq -er '.[0].pid' <<< "$terminal") && address=$(jq -er '.[0].address' <<< "$terminal") || return 1
  [[ "$(drive_owned_pids "$pid")" == "$pid" ]] \
    || { WHY="Super+Return created an unowned compositor window at $address, PID $pid; it lacks this run's sandbox identity and was left untouched"; return 2; }
  command -v foot >/dev/null && [[ "$(readlink -f "/proc/$pid/exe")" == "$(realpath -e "$(command -v foot)")" ]] \
    || { WHY="Super+Return window is not the owned stock terminal; it was left untouched"; return 2; }
  identity=$(hyprctl clients -j | jq -c --arg address "$address" '[.[] | select(.address == $address)]') || return 1
  jq -e --argjson pid "$pid" 'length == 1 and .[0].pid == $pid' <<< "$identity" >/dev/null \
    && [[ "$(drive_owned_pids "$pid")" == "$pid" ]] \
    || { WHY="terminal identity changed before close; no window was touched"; return 1; }
  hyprctl dispatch closewindow "address:$address" || return 1
  drive_window_identity >/dev/null || return 1
  omarchy-drive focus "$DRIVE_WINDOW_ADDRESS" || return 1
  [ "$(ipc ready)" = true ] || { WHY="Flea stopped answering after the chord"; return 1; }
  return 0
}

# The three invariants that decide whether any of the above can work at all, each read off the live
# box rather than off a reading of the config.

omarchy_invariant_consuming() {
  local total leaky
  total=$(hyprctl binds -j | jq '[.[] | select((.modmask / 64 | floor) % 2 == 1)] | length')
  leaky=$(hyprctl binds -j | jq '[.[] | select((.modmask / 64 | floor) % 2 == 1 and .nonConsuming == true)] | length')
  [ "$total" -gt 0 ] || { WHY="the compositor reports no SUPER binds at all, so this check could not fail"; return 1; }
  [ "$leaky" = 0 ] && { WHY="$total SUPER binds, none of them non-consuming"; return 0; }
  WHY="$leaky of $total SUPER binds are non-consuming, so they can leak into a focused client"
  return 1
}

omarchy_invariant_no_super() {
  local n
  n=$(grep -c '^\[\[super' "$REPO/keys.toml")
  [ "$n" = 0 ] && { WHY="keys.toml declares no super table, so Flea cannot shadow an Omarchy chord"; return 0; }
  WHY="keys.toml declares $n super table(s), which would shadow an Omarchy chord"
  return 1
}

# clipboard.lua branches on the window's own terminal tag, sending CTRL+Insert instead of CTRL+C to
# anything carrying it. Flea binds no Insert key at all, so a Flea window that ever picked the tag up
# would answer SUPER+C with silence. The tag is read off the live window, not off the regex.
omarchy_invariant_not_terminal() {
  local tags
  tags=$(window_json | jq -r '(.tags // []) | join(",")')
  case ",$tags," in
    *,terminal,*|*,terminal\*,*)
      WHY="the Flea window carries the terminal tag, so SUPER+C would send CTRL+Insert, which Flea does not bind"
      return 1 ;;
  esac
  WHY="the live window's tags are '${tags:-none}', so clipboard.lua sends it CTRL+C and not CTRL+Insert"
  return 0
}

drive_omarchy() {
  local line chord desc slug rc binds named
  # The clipboard chords, derived from Omarchy's own file so a renamed or added one shows up here.
  # Into an array first, for the same reason the key loop above does it.
  mapfile -t binds < <(derive_omarchy_clipboard_binds)
  for line in "${binds[@]}"; do
    chord=${line%%|*}
    desc=${line#*|}
    [ -n "$chord" ] || continue
    slug=$(omarchy_slug "$chord")
    if ! declare -F "omarchycase_$slug" >/dev/null; then
      skip omarchy "$chord" "$desc, and this battery has no driver for it yet"
      continue
    fi
    WHY=""
    "omarchycase_$slug"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      pass omarchy "$chord" "$desc, driven globally and proved by a landed file"
    else
      bad omarchy "$chord" "$WHY"
    fi
  done

  # The operator's general case: Omarchy's own operations, not only the clipboard. Each is checked
  # against the live bind table first, so a chord Omarchy no longer binds reports undriven here
  # rather than failing as though Flea had broken it.
  for named in super_space super_f super_return; do
    omarchy_general_case "$named"
  done

  omarchy_invariant_case super-binds-consuming omarchy_invariant_consuming
  omarchy_invariant_case flea-binds-no-super omarchy_invariant_no_super
  omarchy_invariant_case flea-not-tagged-terminal omarchy_invariant_not_terminal
}

omarchy_general_case() {
  local slug=$1 key mods bound rc
  key=${slug##*_}
  mods=${slug%_*}
  bound=$(hyprctl binds -j | jq --arg k "$key" \
    '[.[] | select((.modmask / 64 | floor) % 2 == 1 and (.key | ascii_downcase) == ($k | ascii_downcase))] | length')
  if [ "$bound" = 0 ]; then
    skip omarchy "$mods + $key" "Omarchy binds no such chord on this box, so there is nothing to pass through"
    return
  fi
  WHY=""
  "omarchycase_$slug"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    pass omarchy "$mods + $key" "fired over a focused Flea window, and Flea still answers"
  elif [ "$rc" -eq 2 ]; then
    skip omarchy "$mods + $key" "$WHY"
  else
    bad omarchy "$mods + $key" "$WHY"
  fi
}

omarchy_invariant_case() {
  local name=$1 fn=$2
  WHY=""
  if "$fn"; then
    pass omarchy "$name" "$WHY"
  else
    bad omarchy "$name" "$WHY"
  fi
}

# ---- is the harness itself delivering? ------------------------------------------------------------

# Four harness defects surfaced on this box in one day, every one of which produced a pass over
# nothing: send_shortcut's keysym lookup is broken for letters and digits alike, a non-global chord
# never reaches the compositor's bind table, a bare -- form typed nothing, and a showcase beat that
# had never run at all. So the instrument proves it can deliver before it judges anything.
#
# This dies rather than reporting a failed item, and the difference is the whole point: a key that
# does not arrive is the harness being broken, not the product. Fifty FAIL lines from one dead
# delivery form would read as a broken file manager and burn the one display slot this box has.
drive_delivery_probe() {
  local before after
  mapfile -t firstc < <(first_chord cursorFirst)
  # A [[code]] chord, delivered as -k <keysym>.
  k "${firstc[@]}"; settle
  before=$(ipc cursor)
  k -k Down; settle
  after=$(ipc cursor)
  [ "$after" != "$before" ] \
    || die "the harness cannot deliver a -k chord: cursor stayed at $before after -k Down, so every keyed check would fail for a reason that is not the product"
  # A [[text]] chord, delivered as -- <char>. This is the form that typed nothing elsewhere today.
  before=$(ipc cursor)
  k j; settle
  after=$(ipc cursor)
  [ "$after" != "$before" ] \
    || die "the harness cannot deliver a bare text chord: cursor stayed at $before after j, so every printable key would fail for a reason that is not the product"
  # A modified chord, which is the form the Finder keys and every Omarchy super chord depend on.
  before=$(ipc selectionCount)
  k -M ctrl -k a -m ctrl; settle
  after=$(ipc selectionCount)
  [ "$after" != "$before" ] \
    || die "the harness cannot deliver a modified chord: the selection stayed at $before after ctrl+a, so every Finder chord would fail for a reason that is not the product"
  mapfile -t esc < <(chord_args code Escape)
  k "${esc[@]}"; settle
  printf 'harness: -k, bare text and modified chords all deliver\n'
}

# ---- provenance -------------------------------------------------------------------------------------

# The five files the checklist is derived from. A run against an edited one reports on a tree that
# will never exist again, which is why the drive refuses it below.

# Printed by every run, driven or not. A result whose inputs nobody wrote down is not a result: this
# is the line that lets somebody rebuild the tree this tally came from.
drive_provenance() {
  local sha binary_sha
  sha=$(git -C "$REPO" rev-parse HEAD) || die "source identity unavailable"
  binary_sha=$(sha256sum "$BIN" | cut -d' ' -f1) || die "binary digest unavailable"
  [[ "${FLEA_SOURCE_SHA:-}" == "$sha" ]] || die "FLEA_SOURCE_SHA must match the recorded build source: $sha"
  [[ "${FLEA_BINARY_SHA256:-}" == "$binary_sha" ]] || die "FLEA_BINARY_SHA256 must match the recorded build artifact: $BIN"
  drive_require_clean_sources
  python3 - "$REPO" "$BIN" "$sha" "$binary_sha" <<'PY' > "$DRIVE_EVIDENCE/provenance.json"
import hashlib, json, pathlib, subprocess, sys
repo, binary, source, digest = sys.argv[1:]
ui = pathlib.Path(repo, 'ui')
tree = hashlib.sha256()
for path in sorted(ui.rglob('*')):
    if path.is_file():
        tree.update(str(path.relative_to(ui)).encode() + b'\0' + path.read_bytes() + b'\0')
print(json.dumps({'source':source, 'branch':subprocess.check_output(['git','-C',repo,'branch','--show-current']).decode().strip(),
    'repository':repo, 'binary':binary, 'binarySha256':digest, 'ui':str(ui), 'uiSha256':tree.hexdigest(),
    'dirty':subprocess.check_output(['git','-C',repo,'status','--porcelain']).decode()}, sort_keys=True))
PY
  [[ "$?" == 0 ]] || die "candidate provenance recording failed"
  cat "$DRIVE_EVIDENCE/provenance.json"
}

# The battery's job is to say whether the commit we are about to release works, and what we release
# is a commit rather than somebody's uncommitted buffer. Driving a tree whose derivation sources are
# mid-edit measures a state that will be amended or abandoned by morning, so it is refused here
# rather than left to a habit. Export the commit and drive that:
#   d=$(mktemp -d); git archive <sha> | tar -x -C "$d"; cp -a target "$d/target"
#   (cd "$d" && ./tools/flea-acceptance --drive)
drive_require_clean_sources() {
  local dirty
  dirty=$(git -C "$REPO" status --porcelain --untracked-files=no) || die "candidate dirty-state query failed"
  dirty+=$(git -C "$REPO" ls-files --others --exclude-standard -- ui src tools tests) || die "candidate untracked-source query failed"
  [ -z "$dirty" ] && return 0
  printf 'FAIL: the checklist is derived from these, and they are mid-edit:\n%s\n' "$dirty" >&2
  die "--drive needs a clean derivation source; export the commit and drive that, see drive_require_clean_sources"
}

# ---- the run --------------------------------------------------------------------------------------

# One invocation drives every key, every menu entry and every Omarchy chord, because the box has one
# display and four lanes queue for it. There is no exploratory mode on purpose.
# Which driven groups this invocation runs, empty meaning all of them. A re-run that only needs to
# confirm one group should not spend forty minutes and a display slot on the other three.
drive_validate_groups() {
  local group
  for group in "$@"; do
    case "$group" in
      key|menu|omarchy|pointer) ;;
      *) printf 'unknown --drive group: %s\n' "$group" >&2; return 2 ;;
    esac
  done
}

drive_wants() {
  [ -z "${DRIVE_GROUPS:-}" ] && return 0
  case " $DRIVE_GROUPS " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

drive_all() {
  local a preset row row_id row_preset frontend
  local -a groups
  read -r -a groups <<< "${DRIVE_GROUPS:-}"
  drive_validate_groups "${groups[@]}" || return 2
  if drive_wants key; then
    for preset in default vim mac windows; do
      DRIVE_PRESET=$preset
      DRIVE_ROW_ID="setup-$preset"
      drive_fixture_build
      drive_seed_preset
      drive_launch
      drive_delivery_probe
      for row in "${KEY_ROWS[@]}"; do
        IFS='|' read -r row_id row_preset frontend _ <<< "$row"
        [[ "$row_preset" == "$preset" ]] || continue
        drive_key_row "$row" > "$DRIVE_EVIDENCE/$row_id.log" 2>&1
        cat "$DRIVE_EVIDENCE/$row_id.log"
      done
      drive_teardown || die "candidate processes did not drain before the next preset"
    done
  fi
  if ! drive_wants menu && ! drive_wants omarchy && ! drive_wants pointer; then return; fi
  DRIVE_PRESET=default
  DRIVE_ROW_ID=other-groups
  drive_fixture_build
  drive_seed_preset
  drive_launch
  drive_delivery_probe
  if drive_wants menu; then
    echo
    for a in "${MENU_ACTIONS[@]}"; do
      drive_menu_action "$a"
    done
  fi

  if drive_wants omarchy; then
    echo
    drive_omarchy
  fi

  # Last, because the pointer contract is the one group whose rows can move the pane somewhere the
  # keyboard cannot bring it back from.
  if drive_wants pointer; then
    echo
    drive_pointer
  fi
}

# Every Omarchy item by name and without pressing anything, so a run that took no display still
# reports the group rather than hiding it. The clipboard half is derived; the other three chords are
# the operator's general case and are checked against the live bind table before they are driven.
derive_omarchy_names() {
  derive_omarchy_clipboard_binds | cut -d'|' -f1
  printf 'super + space\nsuper + f\nsuper + return\n'
  printf 'super-binds-consuming\nflea-binds-no-super\nflea-not-tagged-terminal\n'
}

# Called from the trap on every exit path, including a die inside the drive.
drive_stop() {
  local status=${1:-0} pid end
  if [[ "${DRIVE_LAUNCHED:-0}" == 1 ]]; then drive_teardown || status=1; fi
  for pid in $(drive_owned_pids); do
    [[ "$(drive_owned_pids "$pid")" == "$pid" ]] && kill -TERM "$pid" 2>/dev/null
  done
  end=$((SECONDS + DRAIN_WAIT_S))
  while (( SECONDS < end )); do
    [[ -z "$(drive_owned_pids)" ]] && break
    sleep 0.05
  done
  if [[ -n "$(drive_owned_pids)" ]]; then printf 'FAIL: acceptance-owned processes did not drain\n' >&2; status=1; fi
  if [[ -n "$DRIVE_BUS_PID" ]] && ! kill -0 "$DRIVE_BUS_PID" 2>/dev/null; then wait "$DRIVE_BUS_PID" 2>/dev/null || true; fi
  if [[ -f "${BINDINGS:-}" && "${DRIVE:-0}" == 1 ]] && drive_wants key; then
    python3 - "$BINDINGS" "$DRIVE_EVIDENCE/keys.jsonl" <<'PY' || status=1
import collections, json, pathlib, sys
matrix, report = map(pathlib.Path, sys.argv[1:])
results = [json.loads(line) for line in report.read_text().splitlines()] if report.exists() else []
seen = {row['row'].split('|')[0] for row in results}
if len(seen) != len(results):
    raise SystemExit('duplicate native key row result')
with report.open('a') as output:
    for row in matrix.read_text().splitlines():
        if row.split('|')[0] not in seen:
            result = {'row':row, 'status':'UNDRIVEN', 'reason':'run stopped before this native row', 'evidence':None}
            output.write(json.dumps(result) + '\n')
            results.append(result)
print('ACCEPTANCE_ROWS ' + json.dumps(dict(collections.Counter(row['status'] for row in results)), sort_keys=True))
PY
  fi
  printf 'ACCEPTANCE_EVIDENCE %s exit=%s\n' "$SB" "$status"
  return "$status"
}
