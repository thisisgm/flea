# -- the write operations, every one of them inside the sandbox --
#
# Each asserts a file that only its own chord could have produced, never a status line: a sentence in
# the bar proves a message was set and a landed file proves the operation ran. Every one puts the
# tree back with the product's own undo, so the next binding of the same action meets the same state
# and its own negative control still means something.

keycase_copy() {
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/dest/op-copy.txt" ] \
    && { WHY="dest/op-copy.txt existed before the copy, so the check could not fail"; return 1; }
  seek_row_named op-copy.txt || return 1
  k "$@"; settle
  enter_dir dest || return 1
  mapfile -t pastec < <(first_chord paste)
  k "${pastec[@]}"
  wait_file "$DRIVE_FIXTURE/dest/op-copy.txt" \
    || { WHY="nothing landed at dest/op-copy.txt within ${TRANSFER_WAIT_S}s"; leave_dir; return 1; }
  # A copy leaves the source where it was; a cut does not, and that is the whole difference.
  [ -e "$DRIVE_FIXTURE/op-copy.txt" ] \
    || { WHY="the source op-copy.txt is gone, so that chord cut rather than copied"; leave_dir; return 1; }
  drive_undo_transfer "$DRIVE_FIXTURE/dest/op-copy.txt"
  leave_dir
}

keycase_cut() {
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/dest/op-cut.txt" ] \
    && { WHY="dest/op-cut.txt existed before the cut, so the check could not fail"; return 1; }
  seek_row_named op-cut.txt || return 1
  k "$@"; settle
  enter_dir dest || return 1
  mapfile -t pastec < <(first_chord paste)
  k "${pastec[@]}"
  wait_file "$DRIVE_FIXTURE/dest/op-cut.txt" \
    || { WHY="nothing landed at dest/op-cut.txt within ${TRANSFER_WAIT_S}s"; leave_dir; return 1; }
  [ -e "$DRIVE_FIXTURE/op-cut.txt" ] \
    && { WHY="the source op-cut.txt is still there, so that chord copied rather than cut"; leave_dir; return 1; }
  drive_undo_transfer "$DRIVE_FIXTURE/dest/op-cut.txt"
  leave_dir
  # The move is undone back to the parent, so the source has to be there again for the next binding.
  wait_file "$DRIVE_FIXTURE/op-cut.txt" \
    || { WHY="undo did not put op-cut.txt back, so the tree is not restored"; return 1; }
}

keycase_paste() {
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/dest/op-paste.txt" ] \
    && { WHY="dest/op-paste.txt existed before the paste, so the check could not fail"; return 1; }
  seek_row_named op-paste.txt || return 1
  mapfile -t copyc < <(first_chord copy)
  k "${copyc[@]}"; settle
  enter_dir dest || return 1
  k "$@"
  wait_file "$DRIVE_FIXTURE/dest/op-paste.txt" \
    || { WHY="nothing landed at dest/op-paste.txt within ${TRANSFER_WAIT_S}s"; leave_dir; return 1; }
  drive_undo_transfer "$DRIVE_FIXTURE/dest/op-paste.txt"
  leave_dir
}

keycase_trash() {
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/op-trash.txt" ] \
    || { WHY="op-trash.txt is not there to trash, so the check could not fail"; return 1; }
  seek_row_named op-trash.txt || return 1
  k "$@"
  drive_wait_gone "$DRIVE_FIXTURE/op-trash.txt" \
    || { WHY="op-trash.txt is still on disk ${TRANSFER_WAIT_S}s after the chord"; return 1; }
  # Undo is what puts it back for the next binding, and its own item asserts the same journal.
  mapfile -t undoc < <(first_chord undo)
  k "${undoc[@]}"
  wait_file "$DRIVE_FIXTURE/op-trash.txt" \
    || { WHY="undo did not put op-trash.txt back, so the tree is not restored"; return 1; }
  return 0
}

keycase_undo() {
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/op-undo.txt" ] \
    || { WHY="op-undo.txt is not there, so there is nothing for undo to put back"; return 1; }
  seek_row_named op-undo.txt || return 1
  mapfile -t trashc < <(first_chord trash)
