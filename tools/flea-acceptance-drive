      drive_shot "menu-rail-row$(ipc railCursor)"
      printf 'CAPTURED the rail menu on rail row %s, offering: %s\n' \
        "$(ipc railCursor)" "$(ipc contextMenuEntries)"
      k "${esc[@]}"; settle
      return 0
    fi
  done
  printf 'NOTE no rail row on this box raises a menu, so the reported rail-menu defect had nothing to reproduce against\n'
  return 0
