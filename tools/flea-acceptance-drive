  expected=$((before + 1))
  k "$@"
  omarchy-drive wait ipc -p "$REPO/ui" flea previewPdfPage "$expected" --timeout 10 >/dev/null \
    || { WHY="the PDF page stayed at $(ipc previewPdfPage) after the chord"; return 1; }
