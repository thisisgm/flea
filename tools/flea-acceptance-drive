}

# -- narrowing and walking --

keycase_filter() {
  local before after
  reset_state || return 1
  mapfile -t firstc < <(first_chord cursorFirst)
  k "${firstc[@]}"; settle
  before=$(ipc rowAt 0)
  k "$@"; settle
  k -d 40 'zz-unique'
  settle; settle
  after=$(ipc rowAt 0)
  # Closed here as well as in reset_state: a driver that leaves a query line up hands the next check
  # a listing of one row and a caret that eats its keys.
  mapfile -t escf < <(chord_args code Escape)
  k "${escf[@]}"; k "${escf[@]}"; settle
  changed_from "the first drawn row" "$before" "$after" || return 1
  case $after in
    'zz-unique-filter.txt|'*) return 0 ;;
  esac
  WHY="the first drawn row is '$after', wanted the one file matching the query"
  return 1
}

keycase_search() {
  local before after
  reset_state || return 1
  before=$(ipc rowAt 0)
  k "$@"; settle
  k -d 40 'inner'
  mapfile -t retc < <(chord_args code Return)
  k "${retc[@]}"
  sleep 2
  after=$(ipc rowAt 0)
  changed_from "the first drawn row" "$before" "$after" || return 1
  # docs/protocol.md: the walk matches over the whole relative path, so the row is named by that
  # path and not by its base name. A driver expecting the base name reads a correct product as broken.
  case $after in
    *'inner.txt|'*) return 0 ;;
  esac
  # If search becomes a universal walk of $HOME (the operator's own defect 3), this fixture is at
  # $FIXTURE_ROOT and deliberately outside $HOME, so the walk would find nothing here and the reason
  # would look like a product defect. Say the assumption in the message rather than leave it implied.
  WHY="the first result row is '$after', wanted the one file under sub/ matching the walk; if search is now scoped to \$HOME, this fixture sits at $DRIVE_FIXTURE, outside it by hard rule 9, and the driver needs a new home rather than the product being wrong"
  return 1
}

keycase_reveal() {
  local before after
  reset_state || return 1
  mapfile -t searchc < <(first_chord search)
  k "${searchc[@]}"; settle
  k -d 40 'inner'
  mapfile -t retc < <(chord_args code Return)
  k "${retc[@]}"
  sleep 2
  case "$(ipc rowAt 0)" in
    *'inner.txt|'*) ;;
    *) WHY="the search this needs produced no inner.txt result to reveal"; return 1 ;;
  esac
  before=$(ipc path)
  k "$@"
  sleep 1
  after=$(ipc path)
  changed_to "the open directory" "$before" "$after" "$DRIVE_FIXTURE/sub"
}

# -- moving between directories --

keycase_open() {
  local before after
  reset_state || return 1
  seek_row_named sub || return 1
  before=$(ipc path)
  k "$@"
  sleep 1
  after=$(ipc path)
  changed_to "the open directory" "$before" "$after" "$DRIVE_FIXTURE/sub"
}

keycase_parent() {
  local before after
  reset_state || return 1
  enter_dir sub || return 1
  before=$(ipc path)
  k "$@"
  sleep 1
  after=$(ipc path)
  changed_to "the open directory" "$before" "$after" "$DRIVE_FIXTURE"
}

# -- the write operations, every one of them inside the sandbox --
#
# Each asserts a file that only its own chord could have produced, never a status line: a sentence in
# the bar proves a message was set and a landed file proves the operation ran. Every one puts the
# tree back with the product's own undo, so the next binding of the same action meets the same state
# and its own negative control still means something.

keycase_copy() {
  reset_state || return 1
  [ -e "$DRIVE_FIXTURE/dest/op-copy.txt" ] \
    && { WHY="dest/op-copy.txt existed before the copy, so the check could not fail"; return 1; }
  seek_row_named op-copy.txt || return 1
  k "$@"; settle
  enter_dir dest || return 1
  mapfile -t pastec < <(first_chord paste)
  k "${pastec[@]}"
  wait_file "$DRIVE_FIXTURE/dest/op-copy.txt" \
    || { WHY="nothing landed at dest/op-copy.txt within ${TRANSFER_WAIT_S}s"; leave_dir; return 1; }
  # A copy leaves the source where it was; a cut does not, and that is the whole difference.
  [ -e "$DRIVE_FIXTURE/op-copy.txt" ] \
    || { WHY="the source op-copy.txt is gone, so that chord cut rather than copied"; leave_dir; return 1; }
  cmp -s "$DRIVE_FIXTURE/op-copy.txt" "$DRIVE_FIXTURE/dest/op-copy.txt" || { WHY="Copy changed file bytes"; return 1; }
  drive_undo_transfer "$DRIVE_FIXTURE/dest/op-copy.txt" || return 1
  leave_dir
}

keycase_cut() {
  reset_state || return 1
