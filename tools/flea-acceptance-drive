# cut off, and a reproduction from a harness that is not the one fixing it is worth having.
menu_rail_route() {
  local i after
  mapfile -t tabc < <(first_chord focusNext)
  k "${tabc[@]}"; settle
  [ "$(ipc focusView)" = rail ] || { WHY="the rail would not take focus"; return 1; }
