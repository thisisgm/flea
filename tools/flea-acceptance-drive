  case $after in
    *" has nothing to eject or unmount.") ;;
    *) WHY="the rail's first row answered '$after', wanted the nothing-to-release sentence"
       return 1 ;;
  esac
  menu_rail_capture "$@"
}

menu_rail_capture() {
  local i count
  count=$(ipc railCount)
  mapfile -t downc < <(first_chord cursorDown)
  mapfile -t esc < <(chord_args code Escape)
  for i in $(seq 1 "$count"); do
    k "${downc[@]}"; settle
