drive_arm() {
  local action=$1 final=$2 row=$3 before after
  shift 3
  reset_state && seek_row_named "$row" || return 1
  before=$(ipc keyDeliveryState)
  k "$@"
  after=$(ipc keyDeliveryState)
  [[ "$(jq -c '.clipboard' <<< "$before")" == "$(jq -c '.clipboard' <<< "$after")" ]] \
    || { WHY="first $action input mutated the clipboard"; return 1; }
  if [[ "$action" == trashArm ]]; then
    jq -e '.trashArmedAt > 0' <<< "$after" >/dev/null || return 1
    [[ -e "$DRIVE_FIXTURE/$row" ]] || { WHY="first d already trashed its source"; return 1; }
  else
    jq -e --arg action "$action" '.keySequence == $action and .keySequenceIdentity != ""' <<< "$after" >/dev/null || return 1
  fi
  printf 'OBSERVED %s first-arm=%s\n' "$DRIVE_ROW_ID" "$after"
  k -k Escape
  # The ordinary action assertion then proves two consecutive inputs execute the complete operation.
  "keycase_$final" "$@" "$@"
}

