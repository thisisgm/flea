       return 2 ;;
  esac
  k "$@"
  sleep 2
  after=$(omarchy-drive ocr flea 2>/dev/null)
  case $after in
    *PAGETWO*) return 0 ;;
  esac
  WHY="the preview still does not show the second page after the chord"
  return 1
}

# ---- the key runner ---------------------------------------------------------------------------------

# Every binding keys.toml declares for one action, driven in turn. An action passes only when every
# binding that could be turned into a chord produced the effect, and a binding with no keysym is
# named in the line rather than quietly dropped, so the report says which key was actually pressed.
drive_key_action() {
  local action=$1 table keyname act driven=0 ok="" bad_bindings="" unmapped="" label rc row rows fn
  fn="keycase_$action"
  # The digit keys are named by the [digits] prefix, which is read from keys.toml rather than
  # spelled here, so renaming the prefix moves the whole range onto the shared driver with it.
  case $action in
    "$DIGIT_PREFIX"[0-9]) fn=keycase_tabDigit; TAB_DIGIT=${action#"$DIGIT_PREFIX"} ;;
  esac
  if ! declare -F "$fn" >/dev/null; then
    skip key "$action" "bound in keys.toml, and this battery has no driver for it yet"
    return
  fi
  # The bindings are read into an array first, never looped straight off the file: every iteration
  # runs omarchy-drive, and a tool that read one byte of stdin would swallow the rest of the list and
  # leave the run reporting fewer items than it derived.
  mapfile -t rows < "$BINDINGS"
  for row in "${rows[@]}"; do
    read -r table keyname act <<< "$row"
    [ "$act" = "$action" ] || continue
    label=$(chord_label "$table" "$keyname")
    mapfile -t chord < <(chord_args "$table" "$keyname")
    if [ "${#chord[@]}" -eq 0 ]; then
      unmapped="$unmapped $label"
      continue
    fi
    WHY=""
    "$fn" "${chord[@]}"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      driven=$(( driven + 1 ))
      ok="$ok $label"
    elif [ "$rc" -eq 2 ]; then
      # The driver could not observe the effect at all, which is an undriven binding and not a defect.
      unmapped="$unmapped $label(${WHY#UNREADABLE: })"
    else
      bad_bindings="$bad_bindings [$label: $WHY]"
    fi
  done
  if [ -n "$bad_bindings" ]; then
    bad key "$action" "${bad_bindings# }"
    return
  fi
  if [ "$driven" -eq 0 ]; then
    skip key "$action" "no binding of it could be driven:${unmapped:- none derived}"
    return
  fi
  pass key "$action" "driven through${ok}${unmapped:+, not driven through$unmapped}"
}

# ---- the menu ----------------------------------------------------------------------------------------

# Which row of the listing makes an entry appear at all, and what a chosen entry must then do. An
# action with no row here is reported undriven with the reason, which is the honest answer for the
# three that need a tailnet peer or a Dropbox tree this battery must not create.
menu_row_for() {
  case $1 in
    open) printf 'sub' ;;
    extract) printf 'e-bundle.tar.zst' ;;
    convert) printf 'b-image.png' ;;
    *) printf 'a-note.txt' ;;
  esac
}

# The label an entry draws, derived from ui/ContextMenu.qml so a renamed row is followed rather than
# missed. Sample input: '        out.push({ label: "Rename", action: "rename", glyph: "rename" })'
derive_menu_labels() {
  sed -n 's/.*label: "\([^"]*\)", action: "\([a-zA-Z][a-zA-Z]*\)".*/\2 \1/p' "$REPO/ui/ContextMenu.qml"
}

# The one entry whose label is a ternary rather than a literal, so it needs its own reader.
# Sample input: '            label: root.showHidden ? "Hide hidden files" : "Show hidden files",'
derive_menu_toggle_labels() {
  sed -n 's/.*label: root.showHidden ? "\([^"]*\)" : "\([^"]*\)".*/\1\n\2/p' "$REPO/ui/ContextMenu.qml"
}

# Steps the menu cursor onto the row carrying one of the given labels and returns its index, using
# the derived cursorDown chord so the walk is the product's own.
menu_seek_label() {
  local wanted=$1 entries i target=-1 idx=0 label
  entries=$(ipc contextMenuEntries)
  IFS='|' read -r -a rows <<< "$entries"
  for idx in "${!rows[@]}"; do
    case "$wanted" in
      *"[${rows[$idx]}]"*) target=$idx; break ;;
    esac
  done
  if [ "$target" -lt 0 ]; then
    WHY="no row of the open menu carries a label this battery derived for it; the menu offers '$entries'"
    return 1
  fi
  mapfile -t downc < <(first_chord cursorDown)
  for i in $(seq 1 20); do
    [ "$(ipc contextMenuCursor)" = "$target" ] && { printf '%s' "$target"; return 0; }
    k "${downc[@]}"
  done
  WHY="the menu cursor would not step onto row $target"
  return 1
}

# Opens the row menu on the row an action needs and puts the menu cursor on that action's entry.
menu_open_on() {
  local action=$1 labels row
  row=$(menu_row_for "$action")
  reset_state || return 1
  seek_row_named "$row" || return 1
  mapfile -t menuc < <(first_chord menu)
  k "${menuc[@]}"; settle
  [ "$(ipc contextMenuVisible)" = true ] || { WHY="the menu did not open on $row"; return 1; }
  labels=$(menu_labels_for "$action")
  [ -n "$labels" ] || { WHY="no label for this entry could be derived from ui/ContextMenu.qml"; return 1; }
  menu_seek_label "$labels" >/dev/null
}

# Every label this action's entry could be drawing, each wrapped in brackets so a seek matches a
# whole label and never a substring of a longer one.
menu_labels_for() {
  local action=$1 act label out=""
  while read -r act label; do
    [ "$act" = "$action" ] || continue
    out="$out[$label]"
  done < <(derive_menu_labels)
  if [ "$action" = toggleHidden ]; then
    while IFS= read -r label; do
      out="$out[$label]"
    done < <(derive_menu_toggle_labels)
  fi
  printf '%s' "$out"
}

menu_activate() {
  mapfile -t openc < <(first_chord open)
  k "${openc[@]}"
}

# One function per menu action, the same shape the key drivers use: state, before, choose, after.

