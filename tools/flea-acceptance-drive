  [ -n "$before" ] || { WHY="the PDF page reader returned no value"; return 1; }
  before_text=$(omarchy-drive ocr flea 2>/dev/null)
  case $before_text in
    *PAGEONE*) ;;
    *) WHY="UNREADABLE: the first page's text did not come back off the screen, so a page turn is not assertable here"
       return 2 ;;
