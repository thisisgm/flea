# -- the preview's own keys --

# The media transport moves on its own while it plays, so the interval is measured with no key in it
# first. A seek has to beat that drift by more than the drift itself, or the check would pass on a
# clip that was simply playing.
keycase_seek() {
  local direction=$1
  shift
  local drift_a drift_b drift before after delta
  reset_state || return 1
  [ "$HAVE_MEDIA" = 1 ] || { WHY="no media fixture, ffmpeg is not on this box"; return 1; }
  seek_row_named d-clip.mp4 || return 1
  mapfile -t prevc < <(first_chord preview)
  k "${prevc[@]}"
  sleep 2
  [ "$(ipc previewOpen)" = true ] || { WHY="the media preview did not open"; return 1; }
  if [ "$direction" = back ]; then
    mapfile -t fwdc < <(first_chord seekForward)
    k "${fwdc[@]}"; settle
  fi
  drift_a=$(ipc previewPosition)
  settle
  drift_b=$(ipc previewPosition)
  drift=$(( drift_b - drift_a )); [ "$drift" -lt 0 ] && drift=$(( -drift ))
  before=$(ipc previewPosition)
  k "$@"; settle
  after=$(ipc previewPosition)
  delta=$(( after - before )); [ "$delta" -lt 0 ] && delta=$(( -delta ))
  if [ "$delta" -le "$drift" ] || [ "$delta" -lt 3000 ]; then
    WHY="the position moved ${delta}ms against ${drift}ms of playback drift, which is not a seek"
    return 1
  fi
  if [ "$direction" = back ] && [ "$after" -ge "$before" ]; then
    WHY="the position went forward, from $before to $after"
    return 1
  fi
  if [ "$direction" = forward ] && [ "$after" -le "$before" ]; then
    WHY="the position went back, from $before to $after"
    return 1
  fi
  return 0
}

keycase_seekBack()    { keycase_seek back "$@"; }
keycase_seekForward() { keycase_seek forward "$@"; }

