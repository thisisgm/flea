  drive_wait_gone "$DRIVE_FIXTURE/op-undo.txt" \
    || { WHY="the trash this needs did not remove op-undo.txt, so undo has nothing to reverse"; return 1; }
  k "$@"
  wait_file "$DRIVE_FIXTURE/op-undo.txt" \
    || { WHY="op-undo.txt did not come back within ${TRANSFER_WAIT_S}s"; return 1; }
  return 0
}

drive_wait_gone() {
  local path=$1 attempt
  for attempt in $(seq 1 $((TRANSFER_WAIT_S * 10))); do
    [ -e "$path" ] || return 0
    sleep 0.1
  done
  return 1
}

# Puts a landed transfer back, so the next binding of the same action meets the state its own
# negative control assumes. A failure here is reported by the caller's next negative control rather
# than swallowed, which is why this returns quietly.
drive_undo_transfer() {
  mapfile -t undoc < <(first_chord undo)
  k "${undoc[@]}"
  drive_wait_gone "$1"
