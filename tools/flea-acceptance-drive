keycase_rename() {
  local before after
  reset_state || return 1
  seek_row_named a-note.txt || return 1
  before=$(ipc renamingIndex)
  k "$@"; settle
  after=$(ipc renamingIndex)
  if [ "$before" != "-1" ]; then
    WHY="a row was already its own editor before the chord, so this check could not fail"
    return 1
  fi
  [ "$after" != "-1" ] && return 0
  WHY="no row became its own editor, renamingIndex is still $after"
  return 1
}

keycase_focusNext() {
  local before after
  reset_state || return 1
  before=$(ipc focusView)
  k "$@"; settle
