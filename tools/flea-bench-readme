#!/usr/bin/env python3
"""Print one README performance table from a field bench run, versions included.

    tools/flea-bench-readme docs/bench/scale-0.3.3-20260923.csv
    tools/flea-bench-readme docs/bench/single-run-dir
    tools/flea-bench-readme selftest

Run-dir mode prints the whole Performance section body for a run directory:

    tools/flea-bench-readme section DIR [--search JSONL --search-manifest MANIFEST]
        [--flea-label LABEL] [--allow-dirty] [--with-anchor] [--docs-stem STEM]

Apply mode copies the run tables beside the stem and swaps the body in:

    tools/flea-bench-readme apply DIR --stem STEM [section options]
        [--readme PATH] [--docs PATH] [--dry]

Reads the run CSV beside its manifest, medians each GUI entrant over its runs, and prints
a markdown table with a Version column taken from the manifest, never typed by hand.
A directory argument holds exactly one CSV; pass a single CSV file when several exist.
An entrant the manifest does not version prints as unknown and exits 1 at the end.
"""
import contextlib
import csv
import difflib
import io
import json
import os
import re
import shutil
import sys
import tempfile

# Markers the harness writes instead of a measurement; dropped before any median.
MARKERS = ("-", "-1", "n/a", "", "unmeasurable")
# Raw CSV marker for a run that never settled; ranks later than every real time.
TIMEOUT = "-1"
KIB_PER_MIB = 1024
CENTISECONDS_PER_SECOND = 100
COLS = ("id", "mapped_ms", "settled_ms", "pss_kb", "cpu_tree_s", "thumbs_n")


def die(message, code=1):
    sys.stderr.write("flea-bench-readme: %s\n" % message)
    sys.exit(code)


def median(vals):
    vals = sorted(vals)
    n = len(vals)
    return vals[n // 2] if n % 2 else (vals[n // 2 - 1] + vals[n // 2]) // 2


# A timeout ranks later than every real reading; other markers drop out as no reading.
def median_time(entries):
    numbers = sorted(int(v) for v in entries if v not in MARKERS)
    timeouts = sum(1 for v in entries if v == TIMEOUT)
    total = len(numbers) + timeouts
    if total == 0:
        return None
    if total % 2:
        index = total // 2
        return numbers[index] if index < len(numbers) else float("inf")
    upper = total // 2
    if upper >= len(numbers):
        return float("inf")
    return (numbers[upper - 1] + numbers[upper]) // 2


def group(n):
    return "%s" % format(n, ",")


# Seconds match the README's existing cells, which format float milliseconds this way.
def format_seconds(ms):
    return "%s s" % format(ms / 1000, ".2f")


# Nearest tenth of a MiB, the same rounding tools/flea-bench-report uses.
def format_mib(kb):
    tenths = (kb * 10 + KIB_PER_MIB // 2) // KIB_PER_MIB
    return "%d.%d MiB" % (tenths // 10, tenths % 10)


# Sample input, a cpu_tree_s cell from matched-0.3.3-20260923.csv: 6.56
def centiseconds(s):
    whole, _, frac = s.partition(".")
    return int(whole) * CENTISECONDS_PER_SECOND + int((frac + "00")[:2])


def format_cpu(c):
    return "%d.%02d s" % (c // CENTISECONDS_PER_SECOND, c % CENTISECONDS_PER_SECOND)


def manifest_versions(path):
    text = open(path, encoding="utf-8").read()
    start = text.find("## Entrants")
    block = re.search(r"```\n(.*?)```", text[start:], re.S)
    if start < 0 or not block:
        die("no entrant block in %s" % path)
    kinds, versions = {}, {}
    for line in block.group(1).splitlines():
        # Sample manifest entrant line: nautilus   gui  nautilus 50.3.1-1
        fields = line.split()
        if len(fields) < 4:
            continue
        kinds[fields[0]], versions[fields[0]] = fields[1], fields[3]
    # Sample manifest denominator line: - thumbnailable denominator: 0, from 100000 visible entries less the 100000 above
    m = re.search(r"^- thumbnailable denominator: (\d+)", text, re.M)
    if not m:
        die("no thumbnailable denominator in %s" % path)
    return kinds, versions, int(m.group(1)) != 0


def display(entry):
    return "**Flea**" if entry == "flea" else {"pcmanfm": "PCManFM", "strata-stable": "Strata stable", "strata-nightly": "Strata nightly"}.get(entry, entry[:1].upper() + entry[1:])


def table(csv_path):
    if os.path.isdir(csv_path):
        found = sorted(f for f in os.listdir(csv_path) if f.endswith(".csv"))
        if len(found) != 1:
            die("%s holds %d CSV files (%s), pass one of them" % (csv_path, len(found), ", ".join(found)))
        csv_path = os.path.join(csv_path, found[0])
    manifest = os.path.splitext(csv_path)[0] + ".manifest.md"
    if not os.path.isfile(csv_path):
        die("no results at %s" % csv_path)
    if not os.path.isfile(manifest):
        die("no manifest beside the results at %s" % manifest)
    kinds, versions, thumbs = manifest_versions(manifest)
    rows = list(csv.DictReader(open(csv_path, encoding="utf-8")))
    if not rows:
        die("%s holds no rows" % csv_path)
    for col in COLS:
        if col not in rows[0]:
            die("the CSV header has no '%s' column" % col)
    rows = counted_only(rows, csv_path)
    # An entrant the manifest never names still prints, versioned unknown, never dropped silently.
    ids = sorted({r["id"] for r in rows if kinds.get(r["id"], "gui") == "gui"})
    if "flea" in ids:
        ids = ["flea"] + [i for i in ids if i != "flea"]
    out, unknown = [], []
    head = "| File manager | Version | First window | Settled | Window PSS | CPU |"
    align = "|---|---|---:|---:|---:|---:|"
    if thumbs:
        head += " Thumbnails |"
        align += "---:|"
    out += [head, align]
    for entry in ids:
        group_rows = [r for r in rows if r["id"] == entry]
        ints = lambda c: [int(r[c]) for r in group_rows if r[c] not in MARKERS]
        mapped_median = median_time([r["mapped_ms"] for r in group_rows])
        settled_median = median_time([r["settled_ms"] for r in group_rows])
        pss = ints("pss_kb")
        cpu = [centiseconds(r["cpu_tree_s"]) for r in group_rows if r["cpu_tree_s"] not in MARKERS]
        work = ints("thumbs_n")
        version = versions.get(entry, "unknown")
        if version == "unknown":
            unknown.append(entry)
        if mapped_median is None:
            mapped_cell = "-"
        elif mapped_median == float("inf"):
            mapped_cell = "Timed out"
        else:
            mapped_cell = group(mapped_median) + " ms"
        if settled_median is None:
            settled_cell = "-"
        elif settled_median == float("inf"):
            settled_cell = "Timed out"
        else:
            settled_cell = format_seconds(settled_median)
        cells = [display(entry), version, mapped_cell, settled_cell,
                 format_mib(median(pss)) if pss else "-", format_cpu(median(cpu)) if cpu else "-"]
        if thumbs:
            cells.append("%d" % median(work) if work else "not measured")
        out.append("| " + " | ".join(cells) + " |")
    return "\n".join(out) + "\n", unknown


# Words the public repo never prints about another app, checked case-insensitively.
NEUTRAL_RE = re.compile(
    r"\b(beat|beats|win|wins|won|lose|loses|lost|lead|leads|led|rival|rivals|bracket|"
    r"fastest|runner-up|behind|ahead)\b|first place|"
    r"\b(first|second|third|fourth|fifth|sixth|seventh) of\b", re.I)


def check_neutral(text):
    hit = NEUTRAL_RE.search(text)
    if hit:
        line = next((l for l in text.splitlines() if hit.group(0).lower() in l.lower()), text[:160])
        die("output wording check failed: matched '%s' in: %s" % (hit.group(0), line.strip()[:160]))


def median_float(vals):
    vals = sorted(vals)
    n = len(vals)
    return vals[n // 2] if n % 2 else (vals[n // 2 - 1] + vals[n // 2]) / 2


def format_search_ms(value):
    return "%g ms" % value


# Fixture facts from the manifest beside each CSV; sample entrant line: flea gui source abc1234 v0.3.9 (clean).
def manifest_section(path):
    text = open(path, encoding="utf-8").read()
    start = text.find("## Entrants")
    block = re.search(r"```\n(.*?)```", text[start:], re.S)
    if start < 0 or not block:
        die("no entrant block in %s" % path)
    entries = {}
    for line in block.group(1).splitlines():
        fields = line.split()
        if len(fields) < 4:
            continue
        entries[fields[0]] = {"kind": fields[1], "fields": fields, "raw": line}
    m = re.search(r"^- thumbnailable denominator: (\d+)", text, re.M)
    kind = re.search(r"^- fixture kind: (.+)$", text, re.M)
    payload = re.search(r"^- fixture payload: (.+)$", text, re.M)
    date = re.search(r"^- date: (\d{4}-\d{2}-\d{2})", text, re.M)
    if not m:
        die("no thumbnailable denominator in %s" % path)
    if not kind or not payload or not date:
        die("no fixture kind, payload or date in %s" % path)
    return {"entries": entries, "thumbs": int(m.group(1)) != 0,
            "kind": kind.group(1).strip(), "payload": payload.group(1).strip(),
            "date": date.group(1)}


# A DIRTY source tree is not a release number, so the section stops unless allowed.
def check_dirty(entries, manifest, allow_dirty):
    if allow_dirty:
        return
    for entry in sorted(entries):
        ent = entries[entry]
        fields = ent["fields"]
        if len(fields) > 3 and fields[2] == "source" and "(DIRTY)" in ent["raw"]:
            die("refusing DIRTY source %s %s in %s, pass --allow-dirty" % (entry, fields[3], manifest))


# The anchor tag from its manifest line, e.g. v0.3.8; anything else names the line.
def anchor_tag(ent):
    fields = ent["fields"]
    if len(fields) > 4 and fields[2] == "source":
        short = fields[4][1:] if fields[4].startswith("v") else fields[4]
        if re.match(r"^\d+\.\d+", short):
            return short
    die("no anchor version in manifest line: %s" % ent["raw"])


# The tree version beside the tool, used when the manifest tag is untagged.
def cargo_path():
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    return os.path.join(root, "Cargo.toml")


# Flea label: explicit flag, else the flea manifest tag, else the tree Cargo.toml with a tree-build suffix.
def resolve_flea_label(explicit, blocks, cargo_toml):
    if explicit:
        return explicit
    line = "no flea entrant"
    for tag in sorted(blocks):
        for side in sorted(blocks[tag]):
            ent = blocks[tag][side]["info"]["entries"].get("flea")
            if ent is None:
                continue
            line = ent["raw"]
            fields = ent["fields"]
            if len(fields) > 4 and fields[2] == "source":
                short = fields[4][1:] if fields[4].startswith("v") else fields[4]
                if re.match(r"^\d+\.\d+", short):
                    return short
    try:
        text = open(cargo_toml, encoding="utf-8").read()
    except OSError:
        text = ""
    # Sample input, the Cargo.toml line: version = "0.3.9" answers "0.3.9-tree-build".
    m = re.search(r"^version\s*=\s*\"([^\"]+)\"", text, re.M)
    if m:
        return "%s-tree-build" % m.group(1)
    die("no Flea version in the manifest line: %s" % line)


# The full version token from the manifest, never retyped; Flea names label and sha.
def section_version(entry, ent, flea_label):
    fields = ent["fields"]
    if entry in ("flea", "flea-tui") and len(fields) > 3 and fields[2] == "source":
        return "%s, source %s" % (flea_label, fields[3])
    if entry in ("flea-anchor", "flea-tui-anchor") and len(fields) > 3 and fields[2] == "source":
        return "%s, source %s" % (anchor_tag(ent), fields[3])
    return fields[3]


def section_display(entry):
    if entry == "flea-tui":
        return "Flea TUI"
    if entry == "yazi-z":
        return "Yazi"
    return display(entry)


# Display names; the anchor carries its manifest version, never a retyped one.
def display_for(entry, version):
    if entry in ("flea-anchor", "flea-tui-anchor"):
        label = "Flea TUI" if entry == "flea-tui-anchor" else "Flea"
        return "**%s %s**" % (label, version.split(",", 1)[0].strip())
    return section_display(entry)


def link_title(stem):
    if stem.startswith("gui-"):
        return "GUI " + stem[4:]
    if stem.startswith("tui-"):
        return "TUI " + stem[4:]
    return stem[:1].upper() + stem[1:]


MONTHS = ("January", "February", "March", "April", "May", "June", "July",
          "August", "September", "October", "November", "December")


def format_date(iso):
    year, month, day = iso.split("-")
    return "%d %s %s" % (int(day), MONTHS[int(month) - 1], year)


def write_run(tmp, name, csv_text, manifest_text):
    d = os.path.join(tmp, name)
    os.mkdir(d)
    open(os.path.join(d, "run.csv"), "w", encoding="utf-8").write(csv_text)
    open(os.path.join(d, "run.manifest.md"), "w", encoding="utf-8").write(manifest_text)
    return d


CORE_COLS = ("id", "run", "mapped_ms", "settled_ms", "pss_kb", "cpu_tree_s", "thumbs_n")


# Counted rows carry write_clean 1 where the column exists; sample: flea,1,424,915,73628,0.41,6936,0,1,1,1,-,0.64,-,yes,-,0.59,1.
def counted_only(rows, csv_path):
    if "write_clean" in rows[0]:
        rows = [r for r in rows if r.get("write_clean") == "1"]
    if not rows:
        die("%s holds no counted rows" % csv_path)
    return rows


def counted_rows(csv_path):
    rows = list(csv.DictReader(open(csv_path, encoding="utf-8")))
    if not rows:
        die("%s holds no rows" % csv_path)
    for col in CORE_COLS:
        if col not in rows[0]:
            die("the CSV header has no '%s' column" % col)
    return counted_only(rows, csv_path)


def section_order(ids):
    def key(entry):
        if entry == "flea":
            return (0, "")
        if entry == "flea-anchor":
            return (1, "")
        return (2, section_display(entry).lower())
    return sorted(ids, key=key)


# One speed row, same cells as the single-CSV table, split here for reuse.
def speed_row(entry, group_rows, version, thumbs):
    mapped_median = median_time([r["mapped_ms"] for r in group_rows])
    settled_median = median_time([r["settled_ms"] for r in group_rows])
    if mapped_median is None:
        mapped_cell = "-"
    elif mapped_median == float("inf"):
        mapped_cell = "Timed out"
    else:
        mapped_cell = group(mapped_median) + " ms"
    if settled_median is None:
        settled_cell = "-"
    elif settled_median == float("inf"):
        settled_cell = "Timed out"
    else:
        settled_cell = format_seconds(settled_median)
    cells = [display_for(entry, version), version, mapped_cell, settled_cell]
    if thumbs:
        work = [int(r["thumbs_n"]) for r in group_rows if r["thumbs_n"] not in MARKERS]
        cells.append("%d" % median(work) if work else "not measured")
    return "| " + " | ".join(cells) + " |"


def mem_row(entry, group_rows, version):
    pss = [int(r["pss_kb"]) for r in group_rows if r["pss_kb"] not in MARKERS]
    cpu = [centiseconds(r["cpu_tree_s"]) for r in group_rows if r["cpu_tree_s"] not in MARKERS]
    cells = [display_for(entry, version), version,
             format_mib(median(pss)) if pss else "-",
             format_cpu(median(cpu)) if cpu else "-"]
    return "| " + " | ".join(cells) + " |"


# Ids, row groups and versions for one GUI or TUI table; unknown ids print unknown.
def table_inputs(rows, entries, default_kind, want_kind, tag, flea_label, with_anchor, unknowns):
    by_id = {}
    for r in rows:
        by_id.setdefault(r["id"], []).append(r)
    ids = [i for i in by_id if entries.get(i, {}).get("kind", default_kind) == want_kind]
    if not with_anchor:
        ids = [i for i in ids if i not in ("flea-anchor", "flea-tui-anchor")]
    versions = {}
    for i in ids:
        ent = entries.get(i)
        if ent is None:
            versions[i] = "unknown"
            unknowns.append("%s:%s" % (tag, i))
        else:
            versions[i] = section_version(i, ent, flea_label)
    return section_order(ids), by_id, versions


# One speed table; a verdict other than yes stays counted and earns one quoted note.
def speed_block(ids, by_id, versions, thumbs, first_head, seen_notes):
    head = "| %s | Version | First window | Settled |" % first_head
    align = "|---|---|---:|---:|"
    if thumbs:
        head += " Thumbnails |"
        align += "---:|"
    lines = [head, align]
    for entry in ids:
        lines.append(speed_row(entry, by_id[entry], versions[entry], thumbs))
    verdict_ids = {}
    for entry in ids:
        for r in by_id[entry]:
            verdict = r.get("ranked", "yes")
            if verdict != "yes":
                verdict_ids.setdefault(verdict, [])
                if entry not in verdict_ids[verdict]:
                    verdict_ids[verdict].append(entry)
    pending = [(v, e) for v, e in verdict_ids.items() if v not in seen_notes]
    if pending:
        lines.append("")
    for verdict, ents in pending:
        seen_notes.append(verdict)
        names = ", ".join(display_for(e, versions[e]) for e in ents)
        lines.append('Note: %s: "%s".' % (names, verdict))
    return lines


def mem_block(ids, by_id, versions, first_head):
    lines = ["| %s | Version | Window PSS | CPU |" % first_head,
             "|---|---|---:|---:|"]
    for entry in ids:
        lines.append(mem_row(entry, by_id[entry], versions[entry]))
    return lines


# Sample input, the search JSONL's manifest line: {"manifest": {"date": "2026-10-06T18:50:14-04:00", "plan": {"lengths": [1, 6]}}} answers "2026-10-06".
def search_manifest_date(jsonl_path):
    for line in open(jsonl_path, encoding="utf-8"):
        line = line.strip()
        if not line:
            continue
        record = json.loads(line)
        if "manifest" in record:
            date = (record["manifest"] or {}).get("date") or ""
            m = re.match(r"(\d{4}-\d{2}-\d{2})", date)
            return m.group(1) if m else None
    return None


# Search arms at the plan longest length, a/b self-pairs merged; sample row: {"arm": "flea-038-a", "length": 6, "query": "scroll", "first_ms": 6.3}.
def search_tables(jsonl_path, field_entries, flea_label, unknowns, with_anchor=False):
    manifest = None
    rows = []
    for line in open(jsonl_path, encoding="utf-8"):
        line = line.strip()
        if not line:
            continue
        record = json.loads(line)
        if "manifest" in record:
            manifest = record["manifest"]
        else:
            rows.append(record)
    if manifest is None:
        die("no manifest line in %s" % jsonl_path)
    plan = manifest.get("plan") or {}
    lengths = plan.get("lengths") or []
    if not lengths:
        die("no plan lengths in %s" % jsonl_path)
    longest = max(lengths)
    arms = {a["id"]: a for a in plan.get("arms", [])}
    entrants = manifest.get("entrants") or {}
    fixtures = manifest.get("fixtures") or {}
    # A type-ahead popup closes on its own, so its settled cell is withheld here.
    popup = {a for a, e in entrants.items()
             if e.get("filter_kind", "").startswith("type-ahead")}
    groups = {}
    for r in rows:
        if r.get("length") != longest or "arm" not in r:
            continue
        groups.setdefault((r.get("fixture", "?"), r.get("mode", "search"), r["arm"]), []).append(r)
    per_table = {}
    for (fix, mode, arm), rs in groups.items():
        per_table.setdefault((fix, mode), {})[arm] = rs
    lines = []
    first_table = True
    for (fix, mode) in sorted(per_table):
        merged, members_of = {}, {}
        for arm in sorted(per_table[(fix, mode)]):
            if arm.endswith("-a") and arm[:-2] + "-b" in per_table[(fix, mode)]:
                continue
            if arm.endswith("-b") and arm[:-2] + "-a" in per_table[(fix, mode)]:
                a = arm[:-2] + "-a"
                merged[arm[:-2]] = per_table[(fix, mode)][a] + per_table[(fix, mode)][arm]
                members_of[arm[:-2]] = [a, arm]
            else:
                merged[arm] = per_table[(fix, mode)][arm]
                members_of[arm] = [arm]
        fix_info = fixtures.get(fix) or {}
        if fix_info.get("entries") is None:
            die("no fixture entries for %s in %s" % (fix, jsonl_path))
        heading = "#### Search, %s, %s entries" % (fix, group(fix_info["entries"]))
        if mode != "search":
            heading += ", %s" % mode
        if first_table:
            first_table = False
        else:
            lines.append("")
        lines += [heading, "",
                  "| File manager | Version | Query | First results | Results settled |",
                  "|---|---|---|---:|---:|"]
        for key in search_order(merged, members_of, entrants, arms):
            members = members_of[key]
            rs = merged[key]
            query = rs[0].get("query")
            if query is None:
                die("no query in a %s row of %s" % (key, jsonl_path))
            ent_name = (entrants.get(members[0]) or {}).get("entrant")
            if ent_name is None:
                ent_name = arms.get(members[0], {}).get("entrant")
            if ent_name is None:
                die("no entrant for search arm %s in %s" % (members[0], jsonl_path))
            if ent_name == "flea-anchor" and not with_anchor:
                continue
            first_vals = [r.get("first_ms") for r in rs]
            settled_vals = [r.get("settled_ms") for r in rs]
            if any(v is None for v in first_vals):
                first_cell = "n/a"
            else:
                first_cell = format_search_ms(median_float(first_vals)) if first_vals else "n/a"
            if any(m in popup for m in members):
                settled_cell = "n/a (find popup)"
            elif any(v is None for v in settled_vals):
                settled_cell = "n/a"
            else:
                settled_cell = format_search_ms(median_float(settled_vals)) if settled_vals else "n/a"
            ver = search_version(members, ent_name, arms, field_entries, flea_label,
                                 jsonl_path, unknowns, entrants)
            label = display_for(ent_name, ver)
            channel = arms.get(members[0], {}).get("channel")
            if channel:
                label += " " + channel
            lines.append("| %s | %s | %s | %s | %s |" % (
                label, ver, query, first_cell, settled_cell))
    return lines


def search_order(merged, members_of, entrants, arms):
    def entrant_of(key):
        members = members_of[key]
        ent = (entrants.get(members[0]) or {}).get("entrant")
        if ent is None:
            ent = arms.get(members[0], {}).get("entrant", members[0])
        return ent

    def key(key):
        ent = entrant_of(key)
        if ent == "flea":
            return (0, key)
        return (1, section_display(ent).lower())
    return sorted(merged, key=key)


# New search manifests carry measured identities; legacy records use their field receipts.
def search_version(members, ent_name, arms, field_entries, flea_label, jsonl_path, unknowns, identities=None):
    actual = (identities or {}).get(members[0], {})
    if actual.get("version"):
        version = actual["version"]
        if actual.get("build_sha"):
            version += ", source " + actual["build_sha"]
        return version
    if ent_name == "flea":
        for m in members:
            flea_dir = (arms.get(m) or {}).get("flea_dir", "").rstrip("/")
            if flea_dir:
                return "%s, source %s" % (flea_label, flea_dir.split("/")[-1])
        die("no flea_dir for search arm %s in %s" % (members[0], jsonl_path))
    ent = field_entries.get(ent_name)
    if ent is None and "-" in ent_name and ent_name != "flea-anchor":
        ent = field_entries.get(ent_name.split("-")[0])
    if ent is None:
        unknowns.append(ent_name)
        return "unknown"
    if ent_name == "flea-anchor" and len(ent["fields"]) > 3 and ent["fields"][2] == "source":
        return "%s, source %s" % (anchor_tag(ent), ent["fields"][3])
    return ent["fields"][3]


def plural(count, noun):
    return "%d %s%s" % (count, noun, "" if count == 1 else "s")


# The app count under the Speed heading; the terminal clause drops out when no terminal app ran.
def apps_sentence(gui, tui):
    text = plural(gui, "GUI app")
    if tui:
        text += " and " + plural(tui, "terminal app")
    return text + " on the same machine."


# The whole Performance section body for a run directory of field CSVs.
def section_text(dir_path, search_path=None, search_manifest_path=None, flea_label=None,
                 allow_dirty=False, with_anchor=False, docs_stem=None, cargo_toml=None):
    names = sorted(f for f in os.listdir(dir_path) if f.endswith(".csv"))
    if not names:
        die("%s holds no CSV files" % dir_path)
    missing = [os.path.join(dir_path, n[:-4] + ".manifest.md") for n in names
               if not os.path.isfile(os.path.join(dir_path, n[:-4] + ".manifest.md"))]
    if missing:
        die("no manifest beside: %s" % ", ".join(missing))
    if search_path is not None and not os.path.isfile(search_path):
        die("no search run at %s" % search_path)
    if search_manifest_path is not None and not os.path.isfile(search_manifest_path):
        die("no search manifest at %s" % search_manifest_path)
    slots = {}
    for n in names:
        stem = n[:-4]
        if stem.startswith("gui-"):
            tag, side = stem[4:], "gui"
        elif stem.startswith("tui-"):
            tag, side = stem[4:], "tui"
        else:
            tag, side = stem, "both"
        slot = slots.setdefault(tag, {})
        if side in slot or "both" in slot or (side == "both" and slot):
            die("%s has two sources for one table" % os.path.join(dir_path, n))
        slot[side] = {"csv": os.path.join(dir_path, n),
                      "manifest": os.path.join(dir_path, stem + ".manifest.md")}
    blocks = {}
    for tag in sorted(slots):
        sides = {}
        for side in ("gui", "tui", "both"):
            if side not in slots[tag]:
                continue
            rows = counted_rows(slots[tag][side]["csv"])
            info = manifest_section(slots[tag][side]["manifest"])
            check_dirty(info["entries"], slots[tag][side]["manifest"], allow_dirty)
            sides[side] = {"rows": rows, "info": info}
        blocks[tag] = sides
    if cargo_toml is None:
        cargo_toml = cargo_path()
    flea_label = resolve_flea_label(flea_label, blocks, cargo_toml)
    if docs_stem is None:
        docs_stem = flea_label
    unknowns = []
    gui_ids, tui_ids, counts = set(), set(), []
    for tag in sorted(blocks):
        for side, want, store in (("both", "gui", gui_ids), ("gui", "gui", gui_ids),
                ("both", "tui", tui_ids), ("tui", "tui", tui_ids)):
            ids, _, _ = fixture_tables(blocks[tag], side, want, tag, flea_label, with_anchor, [])
            store.update(ids)
        for side, sides in blocks[tag].items():
            by_id = {}
            for r in sides["rows"]:
                by_id.setdefault(r["id"], set()).add(r["run"])
            # Run counts cover displayed ids only; a hidden entrant never lowers N.
            shown = set()
            for want in (("gui", "tui") if side == "both" else (side,)):
                shown.update(fixture_tables(blocks[tag], side, want, tag, flea_label, with_anchor, [])[0])
            hits = [len(by_id[i]) for i in shown if i in by_id]
            counts.append(min(hits or [len(v) for v in by_id.values()]))
    dates = sorted({sides["info"]["date"] for tag in sorted(blocks) for sides in blocks[tag].values()})
    if search_path is not None:
        search_date = search_manifest_date(search_path)
        if search_date is not None and search_date not in dates:
            dates = sorted(dates + [search_date])
    out = ["Measured on **%s**, using the **%s** source tree."
           % (", ".join(format_date(d) for d in dates), flea_label),
           "Cold caches, %d runs per app, medians below. %s"
           % (min(counts), apps_sentence(len(gui_ids), len(tui_ids))),
           "", "### Speed", ""]
    for tag in sorted(blocks):
        out += fixture_heading(blocks[tag])
        seen_notes = []
        for side, want, head in (("both", "gui", "File manager"), ("gui", "gui", "File manager")):
            ids, by_id, versions = fixture_tables(blocks[tag], side, want, tag,
                                                  flea_label, with_anchor, unknowns)
            if ids:
                out += speed_block(ids, by_id, versions, heading_thumbs(blocks[tag]),
                                   head, seen_notes)
                out.append("")
        for side in ("both", "tui"):
            ids, by_id, versions = fixture_tables(blocks[tag], side, "tui", tag,
                                                  flea_label, with_anchor, unknowns)
            if ids:
                out += speed_block(ids, by_id, versions, heading_thumbs(blocks[tag]),
                                   "Terminal app", seen_notes)
                out.append("")
    if search_path is not None:
        search_info = manifest_section(search_manifest_path)
        check_dirty(search_info["entries"], search_manifest_path, allow_dirty)
        field_entries = search_info["entries"]
        out += search_tables(search_path, field_entries, flea_label, unknowns, with_anchor)
        out.append("")
    out += ["### Memory and CPU", ""]
    for tag in sorted(blocks):
        out += fixture_heading(blocks[tag])
        for side, want, head in (("both", "gui", "File manager"), ("gui", "gui", "File manager")):
            ids, by_id, versions = fixture_tables(blocks[tag], side, want, tag,
                                                  flea_label, with_anchor, unknowns)
            if ids:
                out += mem_block(ids, by_id, versions, head)
                out.append("")
        for side in ("both", "tui"):
            ids, by_id, versions = fixture_tables(blocks[tag], side, "tui", tag,
                                                  flea_label, with_anchor, unknowns)
            if ids:
                out += mem_block(ids, by_id, versions, "Terminal app")
                out.append("")
    out.append("\"First window\" records compositor registration. \"Settled\" means 500 ms "
               "without process-tree CPU activity; neither measures input readiness.")
    out.append("PSS covers the window process, excluding helpers and GPU memory. CPU is everything "
               "the app started, counted from a control group of its own, so sandboxed thumbnailers "
               "are in it. Shared libraries affect PSS. Results describe this machine and workload.")
    if search_path is not None:
        out.append("\"First results\" records the first visible change larger than one text line; "
                   "\"Results settled\" records the last such change.")
    links = ["[Method](docs/benchmarks.md)"]
    for n in names:
        stem = n[:-4]
        links.append("[%s CSV](docs/bench/%s-%s.csv)" % (link_title(stem), stem, docs_stem))
        links.append("[%s manifest](docs/bench/%s-%s.manifest.md)" % (link_title(stem), stem, docs_stem))
    out += ["", " · ".join(links)]
    text = "\n".join(out) + "\n"
    check_neutral(text)
    return text, unknowns


# Rows and versions for one side of a fixture; a missing side reads as no table.
def fixture_tables(sides, side, want_kind, tag, flea_label, with_anchor, unknowns):
    if side not in sides:
        return [], {}, {}
    default = "tui" if side == "tui" else "gui"
    return table_inputs(sides[side]["rows"], sides[side]["info"]["entries"], default,
                        want_kind, tag, flea_label, with_anchor, unknowns)


def fixture_heading(sides):
    info = sides.get("both", sides.get("gui", sides.get("tui")))["info"]
    return ["#### %s, %s" % (info["kind"], info["payload"]), ""]


def heading_thumbs(sides):
    info = sides.get("both", sides.get("gui", sides.get("tui")))["info"]
    return info["thumbs"]


# Defaults beside the tool's repo root: <root>/README.md, <root>/docs/bench.
def apply_defaults():
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    return os.path.join(root, "README.md"), os.path.join(root, "docs", "bench")


# One command: copy each table CSV and manifest beside the stem, then swap the Performance body; refusals write nothing.
def apply_run(directory, stem, readme_path, docs_path, dry,
              search=None, search_manifest=None, flea_label=None,
              allow_dirty=False, with_anchor=False, docs_stem=None):
    if docs_stem is None:
        docs_stem = stem
    if not os.path.isdir(directory):
        die("no run dir at %s" % directory)
    text, unknown = section_text(directory, search, search_manifest, flea_label,
                                 allow_dirty, with_anchor, docs_stem)
    if unknown:
        die("no version in the manifest for: %s" % ", ".join(unknown))
    check_neutral(text)
    names = sorted(f for f in os.listdir(directory) if f.endswith(".csv"))
    copies = []
    for name in names:
        table = name[:-4]
        for suffix in (".csv", ".manifest.md"):
            copies.append((os.path.join(directory, table + suffix),
                           os.path.join(docs_path, "%s-%s%s" % (table, stem, suffix))))
    for src, dest in copies:
        if os.path.isfile(dest):
            if open(dest, "rb").read() != open(src, "rb").read():
                die("refusing to overwrite differing %s" % dest)
    wanted = {"%s-%s%s" % (n[:-4], stem, s) for n in names for s in (".csv", ".manifest.md")}
    for link in re.findall(r"docs/bench/([^\s)\]]+)", text):
        if link not in wanted and not os.path.isfile(os.path.join(docs_path, link)):
            die("apply: link docs/bench/%s names no copied or existing file" % link)
    if not os.path.isfile(readme_path):
        die("no readme at %s" % readme_path)
    old = open(readme_path, encoding="utf-8").read()
    lines = old.splitlines(keepends=True)
    perf = [k for k, line in enumerate(lines) if line.strip() == "## Performance"]
    if not perf:
        die("no ## Performance heading in %s" % readme_path)
    if len(perf) > 1:
        die("two ## Performance headings in %s" % readme_path)
    following = [k for k in range(perf[0] + 1, len(lines)) if lines[k].startswith("## ")]
    if not following:
        die("no heading follows ## Performance in %s" % readme_path)
    new = "".join(lines[:perf[0] + 1]) + "\n" + text + "\n" + "".join(lines[following[0]:])
    report = ["copy %s -> %s" % (src, dest) for src, dest in copies]
    if dry:
        sys.stdout.write("\n".join(report) + "\n")
        sys.stdout.write("".join(difflib.unified_diff(
            old.splitlines(keepends=True), new.splitlines(keepends=True),
            fromfile=readme_path, tofile=readme_path)))
        return
    if not os.path.isdir(docs_path):
        os.makedirs(docs_path)
    for src, dest in copies:
        if os.path.isfile(dest):
            continue
        shutil.copyfile(src, dest)
    if new != old:
        handle, tmppath = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(readme_path)),
                                           prefix=".README-", suffix=".tmp")
        try:
            with os.fdopen(handle, "w", encoding="utf-8") as out:
                out.write(new)
            shutil.copymode(readme_path, tmppath)
            os.replace(tmppath, readme_path)
        except BaseException:
            try:
                os.unlink(tmppath)
            except OSError:
                pass
            raise
    sys.stdout.write("\n".join(report) + "\n")


