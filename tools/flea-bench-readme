def main(argv):
    if len(argv) == 2 and argv[1] == "selftest":
        sys.exit(selftest())
    if len(argv) >= 3 and argv[1] == "section":
        directory = argv[2]
        if not os.path.isdir(directory):
            die("no run dir at %s" % directory)
        search, search_manifest, flea_label = None, None, None
        allow_dirty, with_anchor, docs_stem = False, False, None
        i = 3
        while i < len(argv):
            arg = argv[i]
            if arg in ("--search", "--search-manifest", "--flea-label", "--docs-stem"):
                if i + 1 >= len(argv):
                    die("usage: flea-bench-readme section DIR [options]", code=2)
                if arg == "--search":
                    search = argv[i + 1]
                elif arg == "--search-manifest":
                    search_manifest = argv[i + 1]
                elif arg == "--flea-label":
                    flea_label = argv[i + 1]
                else:
                    docs_stem = argv[i + 1]
                i += 2
            elif arg == "--allow-dirty":
                allow_dirty = True
                i += 1
            elif arg == "--with-anchor":
                with_anchor = True
                i += 1
            else:
                die("usage: flea-bench-readme section DIR [options]", code=2)
        if bool(search) != bool(search_manifest):
            die("pass --search and --search-manifest together", code=2)
        text, unknown = section_text(directory, search, search_manifest, flea_label,
                                     allow_dirty, with_anchor, docs_stem)
        sys.stdout.write(text)
        if unknown:
            die("no version in the manifest for: %s" % ", ".join(unknown))
        return
    if len(argv) >= 3 and argv[1] == "apply":
        directory = argv[2]
        stem = None
        readme_path, docs_path = apply_defaults()
        dry = False
        search, search_manifest, flea_label = None, None, None
        allow_dirty, with_anchor, docs_stem = False, False, None
        i = 3
        while i < len(argv):
            arg = argv[i]
            if arg in ("--stem", "--readme", "--docs", "--search", "--search-manifest",
                       "--flea-label", "--docs-stem"):
                if i + 1 >= len(argv):
                    die("usage: flea-bench-readme apply DIR --stem STEM [options]", code=2)
                value = argv[i + 1]
                if arg == "--stem":
                    stem = value
                elif arg == "--readme":
                    readme_path = value
                elif arg == "--docs":
                    docs_path = value
                elif arg == "--search":
                    search = value
                elif arg == "--search-manifest":
                    search_manifest = value
                elif arg == "--flea-label":
                    flea_label = value
                else:
                    docs_stem = value
                i += 2
            elif arg == "--allow-dirty":
                allow_dirty = True
                i += 1
            elif arg == "--with-anchor":
                with_anchor = True
                i += 1
            elif arg == "--dry":
                dry = True
                i += 1
            else:
                die("usage: flea-bench-readme apply DIR --stem STEM [options]", code=2)
        if stem is None:
            die("usage: flea-bench-readme apply DIR --stem STEM [options]", code=2)
        if bool(search) != bool(search_manifest):
            die("pass --search and --search-manifest together", code=2)
        apply_run(directory, stem, readme_path, docs_path, dry, search,
                  search_manifest, flea_label, allow_dirty, with_anchor, docs_stem)
        return
    if len(argv) != 2:
        die("usage: flea-bench-readme <run.csv|run-dir>|selftest|section DIR [options]|apply DIR --stem STEM [options]", code=2)
    text, unknown = table(argv[1])
    check_neutral(text)
    sys.stdout.write(text)
    if unknown:
        die("no version in the manifest for: %s" % ", ".join(unknown))


if __name__ == "__main__":
    main(sys.argv)
