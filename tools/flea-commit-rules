#!/usr/bin/python3
# Checks one NUL-separated commit log against the shared message policy.
#   tools/flea-commit-rules COMMITS_Z OUTDIR
import os
import re
import sys

WANT_AN = "GM"
WANT_AE = "gianmarcomorales@icloud.com"
ATTR_PROVIDERS = ("claude", "anthropic", "codex", "openai", "chatgpt")
ATTR_VERBS = (r"\bgenerated (?:with|by|using)\b", r"\bbuilt with\b", r"\bco-author\w*\b",
              r"\bauthored\b", r"\bauthors?\b", r"\bwritten\b", r"\bwrote\b", r"\bcreated?\b",
              r"\bassist(?:ed|ance|ing)?\b", r"\bpair(?:ed|s|ing)?\b", r"\bcollaborat\w*\b",
              r"\bcredit to\b", r"\bgive credit\b", r"\bthanks to\b")
AI_NAMES = ("claude", "codex", "chatgpt", "openai", "anthropic")
MACHINE_BRANDS = ("chatgpt", "codex")
MACHINE_COMPOUNDS = (("claude", "code"), ("openai", "codex"))
# Sample input (a subject line): "fix(columns): keep the old preview while a folder waits"
SUBJECT_RE = re.compile(r"^[a-z]+(?:\([A-Za-z0-9_./-]+\))?: .*\S$")
# Sample input (a trailer line): "(cherry picked from commit 876774988e2051f26c26e7237617e3ae9ad77a67)"
TRAILER_RE = re.compile(r"^\(cherry picked from commit [0-9a-f]{40}\)$")
# Sample input (a credit value): "Ada Lovelace <ada@example.com>"
CREDIT_RE = re.compile(r"^Co-authored-by: ([^<>]+) <([^<>\s]+@[^<>\s]+)>$")
AI_CREDIT = ("generated with", "[bot]")
ATTRIBUTION = ("co-authored-by", "claude", "generated with", "anthropic")
EM_DASH = "\u2014"
VS16 = "\ufe0f"
ZWJ = "\u200d"


def die(msg):
    print("FAIL commit-rules could not judge the log: " + msg)
    print("commit-rules: ERROR " + msg)
    sys.exit(2)


# Sample input (one NUL record split on 0x1f): ["46e3b9c8...", "GM", "gianmarcomorales@icloud.com", "GM", "...", "a3f0434...", "test(ci): ...\n\nBody line."]
# Real git log -z ends every record in NUL and holds no empty record; anything else is unjudgeable.
def split_records(data):
    recs = []
    if not data.endswith("\0"):
        die("the log does not end in a record NUL")
    for raw in data.split("\0")[:-1]:
        if raw == "":
            die("the log holds an empty record")
        parts = raw.split("\x1f")
        if len(parts) != 7:
            die(f"one record holds {len(parts)} field(s), want 7 (H, an, ae, cn, ce, P, B)")
        recs.append(parts)
    return recs


# Sample input (a credit trailer): "Co-authored-by: Ada Lovelace <ada@example.com>"
# Identity lives in the parsed name, never the company email: brands, compounds and token counts below.
def credit_error(line):
    value = line.split(":", 1)[1].strip()
    if not CREDIT_RE.match("Co-authored-by: " + value):
        return "malformed co-authored-by trailer"
    words = [w for w in re.split(r"[\W_]+", value.split("<", 1)[0].lower()) if w]
    if not words:
        return "malformed co-authored-by trailer"
    pairs = list(zip(words, words[1:]))
    if any(w in MACHINE_BRANDS for w in words):
        return "attribution 'co-authored-by' names an AI author"
    if any(p in MACHINE_COMPOUNDS for p in pairs):
        return "attribution 'co-authored-by' names an AI author"
    if len(words) == 1 and words[0] in AI_NAMES:
        return "attribution 'co-authored-by' names an AI author"
    if sum(w in AI_NAMES for w in words) >= 2:
        return "attribution 'co-authored-by' names an AI author"
    low = value.lower()
    if any(n in low for n in AI_CREDIT):
        return "attribution 'co-authored-by' names an AI author"
    return ""


# Sample input (a full %B body): "fix(a): b\n\nFirst body line.\nSecond body line.\n\n(cherry picked from commit 876774988e2051f26c26e7237617e3ae9ad77a67)"
def body_lines(full):
    lines = full.splitlines()
    if not lines:
        return None, ["empty message"]
    if len(lines) < 2 or lines[1] != "":
        return None, ["body needs one blank line after the subject"]
    body = lines[2:]
    errs = []
    if body and TRAILER_RE.match(body[-1]):
        body = body[:-1]
        if body and body[-1] == "":
            body = body[:-1]
    while body and body[-1].lower().startswith("co-authored-by:"):
        err = credit_error(body[-1])
        if err:
            errs.append(err)
        body = body[:-1]
        if body and body[-1] == "":
            body = body[:-1]
    if not 2 <= len(body) <= 4:
        errs.append(f"body holds {len(body)} line(s), want 2 to 4")
    elif any(b == "" for b in body):
        errs.append("body holds a blank line")
    return body, errs


# Sample input (a prose line): "Generated with Claude while testing."
# Dotted filename spans are masked first, so a provider inside one never reads as a mention.
def attribution_hit(line):
    low = line.lower()
    if low.startswith("co-authored-by:"):
        return "misplaced co-authored-by line"
    if "[bot]" in low:
        return "attribution '[bot]'"
    text = re.sub(r"\w+\.\w+", " ", low)
    for provider in ATTR_PROVIDERS:
        if re.search(r"\b" + provider + r"\b", text) and any(re.search(v, text) for v in ATTR_VERBS):
            return f"attribution {provider!r}"
    return ""


