# Sample input (an emoji body): "fix(a): b\n\nFirst \U0001F600 line.\nSecond body line."
def has_emoji(text):
    for ch in text:
        o = ord(ch)
        if ch == EM_DASH:
            return "em dash U+2014"
        if ch == VS16:
            return "variation selector U+FE0F"
        if ch == ZWJ:
            return "joiner U+200D"
        if any(a <= o <= b for a, b in PRESENTATION_RUNS):
            return f"emoji U+{o:04X}"
    return ""


def is_gm(an, ae, cn, ce):
    return an == WANT_AN and ae == WANT_AE and cn == WANT_AN and ce == WANT_AE


# Sample input (a parents field): "aaa... bbb..." (two 40-hex shas, space separated)
def is_merge(parents):
    return len(parents.split()) >= 2


# Sample input (a merge subject): "Merge PR #229 from alextakitani: middle click opens a folder in a new tab"
def check_merge_subject(subject):
    fails = []
    if not subject.startswith("Merge "):
        fails.append(f"merge subject must start with 'Merge ': {subject[:80]}")
    if len(subject) > 80:
        fails.append(f"subject holds {len(subject)} char(s), want at most 80")
    return fails


# Sample input (a merge body): "Merged onto the head; kept both sides.\nSecond line."
# Empty body passes; otherwise the same 2 to 4 line rule the normal path uses.
def check_merge_body(full):
    lines = full.splitlines()
    if not lines:
        return None, ["empty message"]
    if len(lines) <= 1:
        return [], []
    body, berr = body_lines(full)
    if body == [] and len(berr) == 1 and "holds 0 line(s)" in berr[0]:
        return [], []
    return body, berr


# Sample input (a kept fail): "attribution 'claude'"
# Contributor history waives identity, subject, body shape, em dash and emoji.
def contributor_waived(one):
    if one.startswith(("identity ", "subject ", "body needs", "body holds ", "empty message")):
        return True
    if one in ("em dash U+2014",):
        return True
    if one.startswith(("emoji U+", "variation selector", "joiner")):
        return True
    return False


def check_one(sha, an, ae, cn, ce, parents, full):
    fails = []
    if is_merge(parents) and is_gm(an, ae, cn, ce):
        lines = full.splitlines()
        subject = lines[0] if lines else ""
        fails.extend(check_merge_subject(subject))
        body, berr = check_merge_body(full)
        fails.extend(berr)
        for line in [subject] + (body or []):
            hit = attribution_hit(line)
            if hit:
                fails.append(hit)
                break
        if EM_DASH in full:
            fails.append("em dash U+2014")
        else:
            em = has_emoji(full)
            if em:
                fails.append(em)
        return fails
    if an != WANT_AN or ae != WANT_AE or cn != WANT_AN or ce != WANT_AE:
        fails.append(f"identity an={an} <{ae}> cn={cn} <{ce}>, want GM <{WANT_AE}>")
    lines = full.splitlines()
    subject = lines[0] if lines else ""
    if not SUBJECT_RE.match(subject):
        fails.append(f"subject not conventional: {subject[:80]}")
    if len(subject) > 60:
        fails.append(f"subject holds {len(subject)} char(s), want at most 60")
    body, berr = body_lines(full)
    fails.extend(berr)
    for line in [subject] + (body or []):
        hit = attribution_hit(line)
        if hit:
            fails.append(hit)
            break
    if EM_DASH in full:
        fails.append("em dash U+2014")
    else:
        em = has_emoji(full)
        if em:
            fails.append(em)
    return fails


# Sample input (a range tip): the one sha no other record names as a parent.
# The tip starts the first-parent chain; an ambiguous range yields no waivers.
def range_tip(by_sha):
    mentioned = set()
    for sha, an, ae, cn, ce, parents, full in by_sha.values():
        for p in parents.split():
            mentioned.add(p)
    tips = [sha for sha in by_sha if sha not in mentioned]
    if len(tips) != 1:
        return ""
    return tips[0]


# Sample input (a chain link): tip "888..." with parents "777... 666...".
# Follows first parents only, inside the range.
def first_parent_chain(by_sha, tip):
    chain = set()
    cur = tip
    while cur and cur in by_sha:
        chain.add(cur)
        plist = by_sha[cur][5].split()
        if not plist:
            break
        cur = plist[0]
        if cur in chain:
            break
    return chain


# Sample input (a side root): second parent "555..." of a GM merge.
# Walks every parent link from each second (or later) parent of a GM merge.
def side_reachable(by_sha):
    seen = set()
    for sha, an, ae, cn, ce, parents, full in by_sha.values():
        plist = parents.split()
        if len(plist) >= 2 and is_gm(an, ae, cn, ce):
            stack = list(plist[1:])
            while stack:
                cur = stack.pop()
                if cur in seen or cur not in by_sha:
                    continue
                seen.add(cur)
                stack.extend(by_sha[cur][5].split())
    return seen


# Sample input (a known line): "8a3802bf46d7...<TAB>body holds 1 line(s), want 2 to 4"
# The recorded allowlist beside the checker waives one exact failure of one old commit.
def read_known(path):
    known = {}
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        print(f"NOTE no recorded allowlist at {path}; every failure is judged")
        return known
    except (OSError, UnicodeDecodeError) as e:
        die(f"cannot read {path}: {e}")
    for number, line in enumerate(text.splitlines(), 1):
        if not line or line.startswith("#"):
            continue
        sha, sep, rule = line.partition("\t")
        if not sep or not re.fullmatch(r"[0-9a-f]{40}", sha) or not rule.strip() or rule in known.get(sha, ()):
            die(f"{path}:{number}: want one unique 40-hex sha, a tab and the failure it records")
        known.setdefault(sha, set()).add(rule)
    return known


def main():
    if len(sys.argv) != 3:
        die("usage: flea-commit-rules COMMITS_Z OUTDIR")
    zpath, outdir = sys.argv[1], sys.argv[2]
    try:
        with open(zpath, encoding="utf-8") as f:
            data = f.read()
    except OSError as e:
        die(f"cannot read {zpath}: {e}")
    except UnicodeDecodeError as e:
        die(f"{zpath} is not valid UTF-8: {e}")
    try:
        os.makedirs(outdir, exist_ok=True)
    except OSError as e:
        die(f"cannot create {outdir}: {e}")
    if not data:
        die(f"{zpath} holds no commit records to judge")
    try:
        recs = split_records(data)
    except UnicodeDecodeError as e:
        die(f"{zpath} is not valid UTF-8: {e}")
    if not recs:
        die(f"{zpath} holds no commit records to judge")
    known = read_known(os.path.realpath(__file__) + ".known")
    fails = 0
    by_sha = {}
    for sha, an, ae, cn, ce, parents, full in recs:
        if not re.fullmatch(r"[0-9a-f]{40}", sha):
            die(f"record names no 40-hex commit: {sha[:40]}")
        by_sha[sha] = (sha, an, ae, cn, ce, parents, full)
    tip = range_tip(by_sha)
    chain = first_parent_chain(by_sha, tip) if tip else set()
    side = side_reachable(by_sha) if tip else set()
    contributors = set()
    for sha in side:
        if sha in chain:
            continue
        an, ae = by_sha[sha][1], by_sha[sha][2]
        if an != WANT_AN or ae != WANT_AE:
            contributors.add(sha)
    with open(os.path.join(outdir, "commits-findings.tsv"), "w", encoding="utf-8") as out:
        for sha, an, ae, cn, ce, parents, full in recs:
            if sha in contributors:
                all_fails = check_one(sha, an, ae, cn, ce, parents, full)
                kept = [one for one in all_fails if not contributor_waived(one)]
                for one in kept:
                    fails += 1
                    print(f"FAIL {sha[:12]} {one}")
                    out.write(f"{sha}\t{one}\n")
                if not kept:
                    print(f"ACCEPTED {sha[:12]} contributor history")
                    out.write(f"{sha}\taccepted contributor history: waived identity, subject, body-shape, em dash and emoji ({len(all_fails)} check(s) waived)\n")
                continue
            found = check_one(sha, an, ae, cn, ce, parents, full)
            for one in found:
                if one in known.get(sha, ()):
                    print(f"KNOWN {sha[:12]} {one}")
                    out.write(f"{sha}\tknown: {one}\n")
                    continue
                fails += 1
                print(f"FAIL {sha[:12]} {one}")
                out.write(f"{sha}\t{one}\n")
            for rule in sorted(known.get(sha, set()) - set(found)):
                fails += 1
                print(f"FAIL {sha[:12]} known line no longer fails: {rule}")
                out.write(f"{sha}\tstale known: {rule}\n")
    status = "FAIL" if fails else "PASS"
    print(f"commit-rules: {status} fails={fails} commits={len(recs)}")
    sys.exit(1 if fails else 0)


if __name__ == "__main__":
    main()
