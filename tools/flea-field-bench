# launch order begin
# Run r starts at place (r - 1) mod N and every other cycle reverses, so each pair leads once per order per 2N runs.
launch_rotation() {
  local run=$1 n off k cyc
  local -a ids=() rotated=()
  shift
  n=$#
  [ "$n" -gt 0 ] || return 0
  ids=("$@")
  off=$(( (run - 1) % n ))
  cyc=$(( (run - 1) / n ))
  for (( k = 0; k < n; k++ )); do rotated+=("${ids[$(( (off + k) % n ))]}"); done
  if [ $(( cyc % 2 )) -eq 1 ]; then
    for (( k = n - 1; k >= 0; k-- )); do printf '%s\n' "${rotated[$k]}"; done
  else
    printf '%s\n' "${rotated[@]}"
  fi
}
# One line per selected ENTRANTS row, "index place": present rows rotate within their kind and absent rows carry no place, "-".
run_order() {
  local run=$1 kind i place row_kind id comm
  local -a idx=() absent=()
  for kind in gui tui; do
    idx=(); absent=()
    for i in "${!ENTRANTS[@]}"; do
      IFS='|' read -r id row_kind _ comm _ <<< "${ENTRANTS[$i]}"
      [ "$row_kind" = "$kind" ] || continue
      only_has "$id" || continue
      if [ "$id" = flea ] && [ "${FIELD_FRONTEND:-qml}" = gpui ]; then
        [ -x "$FLEA_BIN" ] && [ -x "${FLEA_BIN%/*}/flea-gui" ] || { absent+=("$i"); continue; }
      elif [ "$id" = flea-tui ]; then
        [ -x "${FLEA_BIN:-}" ] || { absent+=("$i"); continue; }
      elif [ "$id" = flea-tui-anchor ]; then
        [ -x "${ANCHOR_BIN:-}" ] || { absent+=("$i"); continue; }
      elif [ "$id" = strata-nightly ]; then
        [ -x "${STRATA_NIGHTLY_BIN:-}" ] || { absent+=("$i"); continue; }
      elif [ "$id" = strata-nightly-channel ]; then
        [ -x "${STRATA_NIGHTLY_CHANNEL_BIN:-}" ] || { absent+=("$i"); continue; }
      elif [ "$id" = strata-stable ]; then
        [ -x "${STRATA_BIN:-}" ] || { absent+=("$i"); continue; }
      else
        command -v "$comm" >/dev/null 2>&1 || { absent+=("$i"); continue; }
      fi
      idx+=("$i")
    done
    place=0
    while IFS= read -r i; do
      place=$(( place + 1 ))
      printf '%s %s\n' "$i" "$place"
    done < <(launch_rotation "$run" "${idx[@]+"${idx[@]}"}")
    for i in "${absent[@]}"; do printf '%s -\n' "$i"; done
  done
}
