#!/usr/bin/env bash
HARNESS_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# Cold-cache file manager benchmark against the installed field, see AGENTS.md "Testing".
# Run from a copy outside the measured tree; NOPASSWD needs no stdin, otherwise the sudo password is stdin's first line, never argv.
# FIELD_MEMINFO and FIELD_VMSTAT point the write guard at fixture files, for tests/field-write-guard.sh only.
set -uo pipefail
# Two modes run sibling tools, so a copy without them refuses the mode before anything is set up.
if [ "${1:-}" = --thumbs ]; then
  shift
  [ -f "$HARNESS_DIR/flea-bench-thumbs" ] || { printf 'FAIL: --thumbs needs flea-bench-thumbs, which is not beside this bench in %s\n' "$HARNESS_DIR" >&2; exit 1; }
  LC_ALL=C.UTF-8 LANGUAGE= exec python3 -B "$HARNESS_DIR/flea-bench-thumbs" "$@"
fi
if [ "${FIELD_PROFILE:-field}" = engine ] \
  && ! LC_ALL=C.UTF-8 LANGUAGE= python3 -B "$HARNESS_DIR/flea-bench-gate" map-event --help >/dev/null 2>&1; then
  printf 'FAIL: the engine profile needs flea-bench-gate with map-event beside this bench in %s\n' "$HARNESS_DIR" >&2
  exit 1
fi

# Kitty's byte dump and child scopes are part of the measured TUI contract.
if [ "${TUI_TERM:-kitty}" != kitty ]; then
  printf 'FAIL: the field bench requires kitty; TUI_TERM=%s is unsupported (the bench uses Kitty --class, --dump-bytes and child scopes)\n' "$TUI_TERM" >&2
  exit 1
fi
if ! PATH="${B5_BENCH_PATH:-$HOME/.local/bin:$PATH}" command -v kitty >/dev/null 2>&1; then
  printf 'FAIL: the field bench requires kitty on the benchmark PATH; install kitty before running the TUI entrants\n' >&2
  exit 1
fi

# This one runs from a copy outside the tree, and the guard and sibling tools are read from the copy's
# own directory, so the copy carries all of tools/. The guard owns FIXTURE_ROOT and checks every path this script writes or deletes.
# Exported, and overridable: tools/flea-bench-manifest is a child process that defaults to this
# same path, so an unexported value left it reporting a different tree than the run measured.
FLEA_REPO=$(readlink -f "${FLEA_REPO:-$HOME/Work/claude/flea}") || { printf 'FAIL: cannot resolve FLEA_REPO\n' >&2; exit 1; }
export FLEA_REPO
. "$HARNESS_DIR/flea-sandbox-guard"

# The CPU column needs a leaf cgroup, which only a delegated user scope may make; see AGENTS.md "Testing".
# Sample input: /proc/self/cgroup "0::/user.slice/user-1000.slice/user@1000.service/app.slice/flea-field-bench-123.scope"
case "$(cut -d: -f3 /proc/self/cgroup)" in
  */flea-field-bench-*.scope) ;;
  *)
    if [ -n "${FLEA_BENCH_REENTERED:-}" ]; then
      printf 'FAIL: systemd-run did not place this bench in a scope of its own\n' >&2
      exit 1
    fi
    export FLEA_BENCH_REENTERED=1
    # A scope execs in this same process and never reads stdin, measured, so the password below still arrives.
    exec systemd-run --user --scope --quiet --working-directory="$PWD" -p Delegate=yes "--unit=flea-field-bench-$$" -- bash "$0" "$@"
    ;;
esac

# First statement after the re-entry: nothing else may touch stdin before the password is taken.
SUDO_NOPASSWD=no
# The probe is the real drop with the cache ignored, so a cached timestamp never passes for the rule.
if sudo -k -n /usr/bin/sysctl -w vm.drop_caches=3 > /dev/null 2>&1; then SUDO_NOPASSWD=yes; fi
if [ "$SUDO_NOPASSWD" = yes ]; then exec </dev/null; else
  read -r -s SUDO_PW || true
  [ -n "${SUDO_PW:-}" ] || { printf 'FAIL: no sudo password arrived on stdin\n' >&2; exit 1; }
fi

export PATH="${B5_BENCH_PATH:-$HOME/.local/bin:$PATH}"
eval "$(LC_ALL=C.UTF-8 LANGUAGE= omarchy-drive env)"
# omarchy-drive env omits the Qt platform theme, so without this the field benches a Flea that resolves no icon.
export QT_QPA_PLATFORMTHEME="$(LC_ALL=C.UTF-8 LANGUAGE= systemctl --user show-environment | LC_ALL=C.UTF-8 LANGUAGE= grep '^QT_QPA_PLATFORMTHEME=' | cut -d= -f2-)"
# Omarchy sets this with hl.env in envs.lua, so it reaches a Hyprland-launched client and is not in
# the systemd user environment at all; a live client is the only authoritative reader. Same fallback
# ~/tmp/flea-launch.sh already uses.
if [ -z "$QT_QPA_PLATFORMTHEME" ]; then
  barpid=$(LC_ALL=C.UTF-8 LANGUAGE= pgrep -x quickshell | head -1)
  [ -n "$barpid" ] && export QT_QPA_PLATFORMTHEME=$(LC_ALL=C.UTF-8 LANGUAGE= tr "\0" "\n" < "/proc/$barpid/environ" | LC_ALL=C.UTF-8 LANGUAGE= grep "^QT_QPA_PLATFORMTHEME=" | cut -d= -f2-)
fi
[ -n "$QT_QPA_PLATFORMTHEME" ] || { printf 'FAIL: no live client published QT_QPA_PLATFORMTHEME either, so every Qt entrant would be benched with no icon theme\n' >&2; exit 1; }

FIXTURE=${FIXTURE:-$FIXTURE_ROOT/flea-bench-btrfs}
# nas is a gvfs FUSE SMB mount and usb a removable stick; neither carries the btrfs marker checks.
FIXTURE_KIND=${FIXTURE_KIND:-}
# The PAYLOAD count, which is what a fixture is for and does not move when a marker is added. The
# total was a literal here and broke the moment .flea-bench-fixture landed; a count that has to be
# re-derived by hand after an unrelated change is the same defect with a different constant.
EXPECT_FILES=${EXPECT_FILES:-100000}
DROP_THUMBS=${DROP_THUMBS:-no}
export FLEA_UI="$FLEA_REPO/ui"
export FLEA_BIN="${FLEA_BIN:-$FLEA_REPO/target/release/flea}"
FIELD_FRONTEND=${FIELD_FRONTEND:-${FLEA_FRONTEND:-gpui}}
FLEA_FRONTEND=${FLEA_FRONTEND:-$FIELD_FRONTEND}
[ "$FIELD_FRONTEND" = "$FLEA_FRONTEND" ] || { printf 'FAIL: frontend variables disagree\n' >&2; exit 1; }
FIELD_PROFILE=${FIELD_PROFILE:-field}
case $FIELD_FRONTEND in gpui|qml) ;; *) printf 'FAIL: invalid frontend\n' >&2; exit 1 ;; esac
case $FIELD_PROFILE in field|engine) ;; *) printf 'FAIL: invalid profile\n' >&2; exit 1 ;; esac
export FIELD_FRONTEND FLEA_FRONTEND FIELD_PROFILE
# The tested Flea's own QML disk cache, in its build tree: a sandbox arm never grows the user's ~/.cache/quickshell/qmlcache.
export FLEA_QMLCACHE="${BENCH_TMP_ROOT:-/tmp}/flea-unused-qmlcache"
# The anchor entrant runs only against a separate tree, so a default run never benches one build twice.

# anchor setup begin
export ANCHOR_REPO="${ANCHOR_REPO:-}"
if [ -n "$ANCHOR_REPO" ]; then
  ANCHOR_REPO=$(readlink -f "$ANCHOR_REPO") || { printf 'FAIL: cannot resolve ANCHOR_REPO\n' >&2; exit 1; }
fi
WITH_ANCHOR=no
if [ -n "$ANCHOR_REPO" ] && [ "$ANCHOR_REPO" != "$FLEA_REPO" ]; then WITH_ANCHOR=yes; fi
export ANCHOR_BIN="${ANCHOR_BIN:-$ANCHOR_REPO/target/release/flea}"
export ANCHOR_UI="${ANCHOR_UI:-$ANCHOR_REPO/ui}"
export ANCHOR_QMLCACHE="$ANCHOR_REPO/target/qmlcache"
# anchor setup end

# Source freshness checks and manifest source rows require a binary under the selected tree.
require_source_binary() {
  local binary repo
  binary=$(readlink -m "$1") || return 1
  repo=$(readlink -f "$2") || return 1
  case $binary in
    "$repo"/*) return 0 ;;
    *) printf 'FAIL: %s is outside its source tree %s\n' "$1" "$2" >&2; return 1 ;;
  esac
}
require_source_binary "$FLEA_BIN" "$FLEA_REPO" || exit 1
if [ "$WITH_ANCHOR" = yes ]; then require_source_binary "$ANCHOR_BIN" "$ANCHOR_REPO" || exit 1; fi

# manifest selection begin

# A sibling manifest tool wins only when it carries the tree tool's provenance marker.
MANIFEST_TOOL=$(dirname "$0")/flea-bench-manifest
[ -x "$MANIFEST_TOOL" ] && LC_ALL=C.UTF-8 LANGUAGE= grep -q '^manifest_tool_marker() {' "$MANIFEST_TOOL" || MANIFEST_TOOL="$FLEA_REPO/tools/flea-bench-manifest"
MANIFEST_TOOL=$(readlink -f "$MANIFEST_TOOL")
# manifest selection end

export STRATA_BIN=${STRATA_STABLE_BIN:-${STRATA_BIN:-${STRATA_STABLE:-}}}
STRATA_SRC=${STRATA_SRC:-}
export STRATA_NIGHTLY_BIN=${STRATA_NIGHTLY_BIN:-${STRATA_NIGHTLY:-}}
export STRATA_NIGHTLY_SRC=${STRATA_NIGHTLY_SRC:-}
export STRATA_NIGHTLY_CHANNEL_BIN=${STRATA_NIGHTLY_CHANNEL_BIN:-${STRATA_NIGHTLY_CHANNEL:-}}
B5_RIVAL_MANIFEST=${B5_RIVAL_MANIFEST:-${FLEA_RIVAL_MANIFEST:-}}
FLEA_RIVAL_MANIFEST=${FLEA_RIVAL_MANIFEST:-$B5_RIVAL_MANIFEST}
[ "$B5_RIVAL_MANIFEST" = "$FLEA_RIVAL_MANIFEST" ] || { printf 'FAIL: rival receipts disagree\n' >&2; exit 1; }
export B5_RIVAL_MANIFEST FLEA_RIVAL_MANIFEST
# The harness's own file, so the manifest can record its sha256 and whether a copy was patched.
HARNESS_TOOL=$(readlink -f "$0")
export ANCHOR_REPO ANCHOR_BIN ANCHOR_UI ANCHOR_QMLCACHE HARNESS_TOOL MANIFEST_TOOL
# The one entrant here that persists no thumbnail. strata renders each one in a sandboxed helper
# that writes result.png into /tmp/strata-preview-<pid>-<n> and deletes the directory on drop, so it
# fills the screen and leaves the cache this harness counts empty. Same two names, and the same live
# watch, as tools/flea-bench-capability.
TRANSIENT_ID=${TRANSIENT_ID:-strata}
TRANSIENT_PREFIX=${TRANSIENT_PREFIX:-/tmp/strata-preview-}
# The TUI group's own XDG_CONFIG_HOME: a copy of the committed configuration in a mktemp -d of
# this run's own, so an entrant reads the bench's settings and never the operator's, this repo never
# collects the state files entrants write, and each run starts from the same clean tree. Provenance
# per entrant is in tools/flea-bench-tui/README.md.
TUI_CONF_SRC="$HARNESS_DIR/flea-bench-tui"
TUI_CONF=""
# Cleared before the trap, so the cleanup can never remove a directory the caller named in its environment.
FLEA_STATE=""
# The anchor's own state directory: its older build reads and writes an older ui-state schema.
ANCHOR_STATE=""
BENCH_TMP_ROOT=${BENCH_TMP_ROOT:-/tmp}
# This entrant's place in its kind's order for the current run, written to its CSV row by run_one.
LAUNCH_POS=-
# Set at the first launch, so the cleanup never kills an operator's window the start-up refusal left alone.
ENTRANT_LAUNCHED=""
# Only this invocation assigns the warm job pid, never the caller's environment.
WARM_PID=""
WARM_STARTING=""
WARM_PREVIOUS_PID=""
MAP_PID=""
# The group's terminal, named once. foot is sixel only and every entrant here that previews at all
# prefers the Kitty protocol, so the old group's zero across all eight was this choice and not a
# result about the entrants.
TUI_TERM=kitty
# A class of its own, so the kill list can find this run's terminals without touching the operator's.
TUI_CLASS=flea-bench-kitty
RUNS=${RUNS:-3}
# A gvfs fixture's quiet gap must outlast the server wait in which nothing on the box ticks.
# Sample input: settle_gap_for "/run/user/1000/gvfs/smb-share:server=nas,share=data" answers 2000.
settle_gap_for() {
  case $1 in
    /run/user/*/gvfs/*) printf '2000' ;;
    *) printf '500' ;;
  esac
}
# An explicit gap wins; `settled` stays the last tick, so the gap never inflates it.
if [ -z "${SETTLE_GAP_MS:-}" ]; then SETTLE_GAP_MS=$(settle_gap_for "$FIXTURE"); fi
# In hundredths, because /proc/loadavg is always two decimals and this shell has no floats. An idle
# box is a run condition: a cargo suite or a browser inside the window moves every settle number.
# 150 was too loose, measured: a scale run started at 1.10 and its mapped column came out 205 ms
# above the previous baseline with nothing in the diff that could account for it. A field that
# competes on 200 ms differences cannot start under a load of one.
BENCH_MAX_LOAD_HUNDREDTHS=${BENCH_MAX_LOAD_HUNDREDTHS:-50}
# How long to WAIT for the box to go idle before refusing. A bare refusal at 50 would make the
# refusal the normal case, because the one-minute average on a 12-core box takes minutes to fall
# after a run, and an operator who keeps fighting refusals raises the threshold, which is how 150
# happened. Waiting is the answer; refusing after a bounded wait is the backstop.
BENCH_IDLE_WAIT_S=${BENCH_IDLE_WAIT_S:-900}
# How long the run actually waited, recorded rather than remembered.
BENCH_IDLE_WAITED=0
# How long the preview pass waits before calling it no preview. Three entrants have no image preview
# feature at all, so this is the time each of them costs the run.
PREVIEW_TIMEOUT_MS=${PREVIEW_TIMEOUT_MS:-15000}
# Unique colours in the band, above which it holds an image rather than text. Text is a handful of
# palette entries however much of it there is; a photograph is tens of thousands. Measured on this
# box with a named fixture image as the cursor file, on the real 2000 file fixture:
#   no preview  broot 6, mc 472, ranger 536, xplr 538
#   preview     yazi 121598, spf 420753, nnn 431030, lf 447285
# So this clears the busiest text UI by 9x and the smallest real preview by 24x. PNG compression
# density was the first shape of this and it was WRONG: xplr's file table on 2000 entries reads 163
# against yazi's 307, under 2x, and a threshold derived from a three file directory did not survive
# the fixture the bench actually runs on.
PREVIEW_MIN_COLOURS=${PREVIEW_MIN_COLOURS:-5000}
LAUNCH_TIMEOUT_MS=${LAUNCH_TIMEOUT_MS:-120000}
POLL_SLEEP=0.02
OUT="${1:-$HOME/bench/results.csv}"
# The key sets an entrant produced, kept beside the CSV. A total cannot tell a format an entrant
# skipped from work it had not done yet, and these can be classified after the run; a count cannot.
KEYS_DIR="${OUT%.csv}.keys"
KEY_MAP="$KEYS_DIR/fixture.map"
THUMBS="$HOME/.cache/thumbnails"
# The cache is the operator's own and never becomes a sandbox, so the guard asserts only that this
# is a real path under it: an unset HOME would otherwise make the drop below rm -rf /.cache.
sandbox_cache_require "$THUMBS"
# Named once because the orphan check globs on it and the park path is this prefix with one pid appended.
THUMBS_PARKED_PREFIX="$HOME/.cache/thumbnails-parked-"
THUMBS_PARKED="$THUMBS_PARKED_PREFIX$$"
sandbox_cache_require "$THUMBS_PARKED"
THUMBS_PARKED_OK=no
# Flea's prefetch list (src/prefetch.rs) is the operator's too, and it names the files of whichever Flea ran last.
PREFETCH="$HOME/.cache/flea/prefetch"
sandbox_cache_require "$PREFETCH"
PREFETCH_PARKED_PREFIX="$HOME/.cache/flea/prefetch-parked-"
PREFETCH_PARKED="$PREFETCH_PARKED_PREFIX$$"
sandbox_cache_require "$PREFETCH_PARKED"
PREFETCH_PARKED_OK=no

fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
# Both parks work under ~/.cache, which Flea and the thumbnailers write to only while XDG_CACHE_HOME is unset or names it.
[ "${XDG_CACHE_HOME:-$HOME/.cache}" = "$HOME/.cache" ] || fail "XDG_CACHE_HOME is $XDG_CACHE_HOME, but the thumbnail and prefetch parks work under $HOME/.cache, so the caches the tested Flea reads would stay in place"

# The scope the re-entry above made; every entrant run gets a leaf of its own under it.
BENCH_CG="/sys/fs/cgroup$(cut -d: -f3 /proc/self/cgroup)"
[ -w "$BENCH_CG" ] || fail "the bench scope $BENCH_CG is not writable, so no run could be given a control group of its own"
RUN_CG=""
ENTRANT_SCOPE=""
ROWS_PID=""
# Unique to this invocation, and exported only into each launch; sweep_token ends what carries it.
BENCH_TOKEN="$$-$EPOCHSECONDS"
SWEEP_TERM_POLLS=20
SWEEP_KILL_POLLS=20
HELPER_TICKS=0
HELPER_SIDE=""

# EPOCHREALTIME avoids a fork per sample, which a 20 ms poll loop cannot afford.
NOW_MS=0
now_ms() {
  local t=$EPOCHREALTIME s us
  s=${t%.*}
  us=${t#*.}
  NOW_MS=$(( s * 1000 + 10#${us:0:3} ))
}

# write guard begin
# A timed launch starts on a disk that is not writing; the night kit's night-lib.sh keeps a copy, compared by NIGHT_LIB=<path> bash tests/field-write-guard.sh.
FIELD_MEMINFO=${FIELD_MEMINFO:-/proc/meminfo}
FIELD_VMSTAT=${FIELD_VMSTAT:-/proc/vmstat}
# Clean before launch: Dirty plus Writeback at most this many kB, and at most this many kB paged out in the window.
WRITE_DIRTY_WB_MAX_KB=16384
WRITE_PRE_PGPGOUT_MAX_KB=1024
WRITE_WINDOW_S=0.2

# Sample input: /proc/meminfo "Dirty:               312 kB" and /proc/vmstat "pgpgout 5821776", one key and one number a line.
# mapfile takes the whole file at one position, because a line by line read of a seq_file tears.
write_guard_read() {
  local line
  local -a lines=() f=()
  WG_VAL=""
  mapfile -t lines 2>/dev/null < "$1"
  for line in "${lines[@]}"; do
    f=( ${line/:/ } )
    [ "${f[0]:-}" = "$2" ] || continue
    [[ ${f[1]:-} =~ ^[0-9]+$ ]] || return 1
    WG_VAL=${f[1]}
    return 0
  done
  return 1
}

# Dirty plus Writeback in kB, into WG_DIRTY_WB_KB.
write_guard_dirty_wb() {
  local dirty
  write_guard_read "$FIELD_MEMINFO" Dirty || return 1
  dirty=$WG_VAL
  write_guard_read "$FIELD_MEMINFO" Writeback || return 1
  WG_DIRTY_WB_KB=$(( dirty + WG_VAL ))
}

# Right before a timed launch: sync, pgpgout across a quiet window, then Dirty and Writeback; sets WG_DIRTY_WB_KB, WG_PGPGOUT_PRE_KB, WG_PGPGOUT_BASE and WG_PRE_CLEAN.
write_guard_pre() {
  local start
  sync
  write_guard_read "$FIELD_VMSTAT" pgpgout || return 1
  start=$WG_VAL
  sleep "$WRITE_WINDOW_S"
  write_guard_read "$FIELD_VMSTAT" pgpgout || return 1
  WG_PGPGOUT_BASE=$WG_VAL
  WG_PGPGOUT_PRE_KB=$(( WG_PGPGOUT_BASE - start ))
  [ "$WG_PGPGOUT_PRE_KB" -ge 0 ] || return 1
  write_guard_dirty_wb || return 1
  WG_PRE_CLEAN=0
  if [ "$WG_DIRTY_WB_KB" -le "$WRITE_DIRTY_WB_MAX_KB" ] && [ "$WG_PGPGOUT_PRE_KB" -le "$WRITE_PRE_PGPGOUT_MAX_KB" ]; then
    WG_PRE_CLEAN=1
  fi
}

# The second pgpgout read, when the measurement ends: kept in the row, never part of the clean call, because the entrant's own writes land in it.
write_guard_launch_end() {
  write_guard_read "$FIELD_VMSTAT" pgpgout || return 1
  WG_PGPGOUT_LAUNCH_KB=$(( WG_VAL - WG_PGPGOUT_BASE ))
  [ "$WG_PGPGOUT_LAUNCH_KB" -ge 0 ] || return 1
  WG_CLEAN=$WG_PRE_CLEAN
}
# write guard end

# Repeats a contaminated launch gets, at most; each repeat is a row of its own with rerun=N.
WRITE_RERUNS=2
# Set by the loop that runs an entrant: 0 for the first launch, then the attempt number of each repeat.
RERUN_N=0
WG_CLEAN=""

# The ranked cell: a clean row's comes back unchanged; a contaminated row never ranks, and the cell says why. No comma, it lands in a CSV column.
# Sample input: write_guard_ranked yes answers "unranked: writes in flight (dirty_wb 20480 kB pgpgout_pre 3 kB pgpgout_launch 9000 kB)".
write_guard_ranked() {
  [ "$WG_CLEAN" = 1 ] && { printf '%s' "$1"; return 0; }
  local why="unranked: writes in flight (dirty_wb $WG_DIRTY_WB_KB kB pgpgout_pre $WG_PGPGOUT_PRE_KB kB pgpgout_launch $WG_PGPGOUT_LAUNCH_KB kB)"
  case $1 in
    yes) printf '%s' "$why" ;;
    *) printf '%s; %s' "$1" "$why" ;;
  esac
}

# Sample input: a results CSV whose header holds write_clean. Every row stays in the file; only write_clean=1 rows count.
# A row with no write_clean cell, the short ERROR row, is left out too, because it was not found clean.
write_guard_summary() {
  local -a head=() f=() order=()
  local -A n=() k=()
  local line id i col=-1 kk nn
  {
    IFS= read -r line || true
    IFS=, read -r -a head <<< "$line"
    for i in "${!head[@]}"; do
      if [ "${head[$i]}" = write_clean ]; then col=$i; break; fi
    done
    if [ "$col" -lt 0 ]; then
      printf 'write guard: the CSV header has no write_clean column, so no row can count\n' >&2
      return 1
    fi
    while IFS= read -r line || [ -n "$line" ]; do
      IFS=, read -r -a f <<< "$line"
      id=${f[0]:-}
      [ -n "$id" ] || continue
      [ -n "${n[$id]+x}" ] || order+=("$id")
      n[$id]=$(( ${n[$id]:-0} + 1 ))
      if [ "${f[$col]:-}" = 1 ]; then k[$id]=$(( ${k[$id]:-0} + 1 )); fi
    done
  } < "$1"
  for id in "${order[@]+"${order[@]}"}"; do
    kk=${k[$id]:-0}; nn=${n[$id]}
    printf 'write guard: %s counts %d of %d rows, left out %d\n' "$id" "$kk" "$nn" "$(( nn - kk ))"
  done
}

# One entrant run: a launch found contaminated is repeated up to WRITE_RERUNS times, each repeat a row of its own.
run_guarded() {
  RERUN_N=0
  # A TUI's first rows come from a launch of their own with kitty's dump on, so no measured launch pays the dump's parse.
  FIRST_ROWS_PROBE=-
  if [ "$2" = tui ]; then FIRST_ROWS_PROBE=-1; RUN_MODE=rows; run_one "$@" > /dev/null; RUN_MODE=measure; fi
  while :; do
    WG_CLEAN=""
    run_one "$@" >> "$OUT"
    tail -1 "$OUT"
    # Only a launch that was measured and found contaminated is repeated, and its row stays in the CSV.
    [ "$WG_CLEAN" = 0 ] || break
    if [ "$RERUN_N" -ge "$WRITE_RERUNS" ]; then
      printf 'WRITE-DIRTY: %s run %s was still contaminated after %s repeats, so none of its rows rank\n' "$1" "$RUN_INDEX" "$RERUN_N" >&2
      break
    fi
    RERUN_N=$(( RERUN_N + 1 ))
    printf 'RERUN: %s run %s had writes in flight (dirty_wb %s kB, pgpgout pre %s kB, launch %s kB), repeat %s of %s\n' \
      "$1" "$RUN_INDEX" "$WG_DIRTY_WB_KB" "$WG_PGPGOUT_PRE_KB" "$WG_PGPGOUT_LAUNCH_KB" "$RERUN_N" "$WRITE_RERUNS" >&2
  done
}

drop_caches() {
  if [ "$SUDO_NOPASSWD" = yes ]; then
    /usr/bin/sync
    sudo -n /usr/bin/sysctl -w vm.drop_caches=3 > /dev/null || fail "could not drop caches"
  else
    printf '%s\n' "$SUDO_PW" | sudo -S -k -p "" sh -c "sync; echo 3 > /proc/sys/vm/drop_caches" \
      || fail "could not drop caches"
  fi
}

# The thumbnail cache belongs to the user, so it is moved exactly once and moved back once.
park_thumbs() {
  local orphan
  # A glob that matches nothing comes back as the literal pattern, so each candidate is tested before it is believed.
  for orphan in "$THUMBS_PARKED_PREFIX"*; do
    [ -e "$orphan" ] || continue
    fail "$orphan was parked by an invocation that was killed before its restore ran, the operator's own cache may be inside it, so this run will not park on top of it"
  done
  # Below the orphan check, so a DROP_THUMBS=no invocation still reports what a killed one left behind.
  [ "$DROP_THUMBS" = yes ] || return 0
  if [ -d "$THUMBS" ]; then
    mv "$THUMBS" "$THUMBS_PARKED" || fail "could not park $THUMBS"
  fi
  THUMBS_PARKED_OK=yes
}

# Only ever removes the empty tree this script made, because park_thumbs ran first.
drop_thumbs() {
  [ "$DROP_THUMBS" = yes ] || return 0
  [ "$THUMBS_PARKED_OK" = yes ] || fail "drop_thumbs ran before park_thumbs"
  rm -rf "$THUMBS"
  mkdir -p "$THUMBS/large" "$THUMBS/fail"
  # A crashed run can leave a populated cache behind, and the run then reports cache hits as a result.
  local d
  for d in "$THUMBS"/*/; do
    [ "$(LC_ALL=C.UTF-8 LANGUAGE= ls -A "$d" | wc -l)" = 0 ] || fail "the scratch thumbnail cache is not empty at the start of a cold run: $d"
  done
}

# Sample input: ~/.cache/thumbnails holds large/, normal/, fail/ and any other size an entrant asks for.
# Counting large/ alone reads a structural zero for an entrant that asks for a smaller size; see AGENTS.md "Testing".
count_thumbs() {
  local d name n
  THUMBS_N=0
  THUMBS_BY_DIR=""
  for d in "$THUMBS"/*/; do
    [ -d "$d" ] || continue
    name=${d%/}; name=${name##*/}
    n=$(LC_ALL=C.UTF-8 LANGUAGE= find "$d" -type f | wc -l)
    # fail/ holds one marker per file a thumbnailer refused, so it is reported and never added to the total.
    [ "$name" = fail ] || THUMBS_N=$(( THUMBS_N + n ))
    THUMBS_BY_DIR="${THUMBS_BY_DIR:+$THUMBS_BY_DIR;}$name=$n"
  done
  [ -n "$THUMBS_BY_DIR" ] || THUMBS_BY_DIR=none
}

WATCH_PIDS=()
WATCH_RENDERS=""
WATCH_OPENS=""
WATCH_RENDERED=""
WATCH_N=0
# Why the last watch_stop could not count, empty when it could; it holds no comma because it lands in a CSV column.
WATCH_REFUSED=""
# How long to wait for inotifywait to report its watches up. /tmp is walked recursively, so this is
# a real wait, and a render that lands before the watch is armed is invisible to the count.
WATCH_ARM_TIMEOUT_MS=${WATCH_ARM_TIMEOUT_MS:-30000}

# Sample input, the line inotifywait writes to stderr once it is ready: "Watches established."
watch_armed() {
  local err=$1 deadline
  now_ms; deadline=$(( NOW_MS + WATCH_ARM_TIMEOUT_MS ))
  while ! LC_ALL=C.UTF-8 LANGUAGE= grep -q 'Watches established' "$err" 2>/dev/null; do
    now_ms
    [ "$NOW_MS" -gt "$deadline" ] && return 1
    sleep 0.05
  done
}

# Two watches, because neither answers both questions: /tmp records a render finishing and the
# fixture records which file earned it. bwrap binds the input into the helper's namespace without
# moving the dentry, so the helper's open still reports against the fixture's own directory watch.
watch_start() {
  local id=$1
  WATCH_RENDERS="$KEYS_DIR/$id-run$RUN_INDEX.renders"
  WATCH_OPENS="$KEYS_DIR/$id-run$RUN_INDEX.opens"
  WATCH_RENDERED="$KEYS_DIR/$id-run$RUN_INDEX.rendered"
  : > "$WATCH_RENDERS"
  : > "$WATCH_OPENS"
  : > "$WATCH_RENDERS.err"
  : > "$WATCH_OPENS.err"
  LC_ALL=C.UTF-8 LANGUAGE= inotifywait -m -r -e close_write --format '%w%f' /tmp > "$WATCH_RENDERS" 2> "$WATCH_RENDERS.err" &
  WATCH_PIDS=("$!")
  LC_ALL=C.UTF-8 LANGUAGE= inotifywait -m -e open --format '%f' "$FIXTURE" > "$WATCH_OPENS" 2> "$WATCH_OPENS.err" &
  WATCH_PIDS+=("$!")
  watch_armed "$WATCH_RENDERS.err" || fail "the render watch never armed on /tmp"
  watch_armed "$WATCH_OPENS.err" || fail "the fixture watch never armed on $FIXTURE"
}

# Kills the watches without reading them, for a run that never reached its count.
watch_kill() {
  local pid
  for pid in ${WATCH_PIDS[*]:-}; do kill "$pid" 2>/dev/null; done
  WATCH_PIDS=()
}

# Sample input, one render line: /tmp/strata-preview-1145070-38/result.png
# Sample input, one open line: clip_1006.mp4
watch_stop() {
  local id=$1 pid pids opens_n
  for pid in ${WATCH_PIDS[*]:-}; do
    kill -0 "$pid" 2>/dev/null || fail "a $id watch died during the run, so nothing it wrote is a count"
  done
  watch_kill
  WATCH_N=$(LC_ALL=C LANGUAGE= grep -c "^$TRANSIENT_PREFIX[0-9]*-[0-9]*/result\.png\$" "$WATCH_RENDERS") # locale-bytes: count raw event paths
  # Two entrant processes in one window would let one run's renders be counted for another.
  pids=$(LC_ALL=C.UTF-8 LANGUAGE= grep -o "^$TRANSIENT_PREFIX[0-9]*" "$WATCH_RENDERS" | LC_ALL=C.UTF-8 LANGUAGE= sort -u | LC_ALL=C.UTF-8 LANGUAGE= grep -c .)
  [ "$pids" -le 1 ] || fail "$pids $id processes wrote renders in this run, so no count from it is attributable"
  opens_n=$(LC_ALL=C LANGUAGE= grep -c . "$WATCH_OPENS") # locale-bytes: count nonempty raw filename records
  WATCH_REFUSED=""
  # corner: the pairing holds for a strata that renders one file at a time into a per-render dir, and v0.19.0's reused workers write none.
  if [ "$opens_n" -lt "$WATCH_N" ] || [ $(( opens_n - WATCH_N )) -gt 1 ]; then
    WATCH_REFUSED="its watches saw $WATCH_N renders for $opens_n opened fixture files so neither is a count"
    return 0
  fi
  LC_ALL=C LANGUAGE= grep . "$WATCH_OPENS" | head -n "$WATCH_N" > "$WATCH_RENDERED" # locale-bytes: select raw filename records for comparison
}

# The extension of every name the entrant rendered, in the fixture map's own extension order, so a
# format it never reached still gets a zero row exactly as flea-bench-keys classify gives one.
watch_classify() {
  local name ext n out="" total=0
  local -A count=()
  while IFS= read -r name; do
    case $name in *.*) ext=${name##*.} ;; *) ext=none ;; esac
    count[$ext]=$(( ${count[$ext]:-0} + 1 ))
  done < "$WATCH_RENDERED"
  for ext in $(cut -d' ' -f2 "$KEY_MAP" | LC_ALL=C.UTF-8 LANGUAGE= sort -u); do
    n=${count[$ext]:-0}
    out="${out:+$out;}$ext=$n"
    total=$(( total + n ))
  done
  # A name the fixture map does not explain is work on something else, named and never folded in.
  printf '%s;unknown=%s\n' "$out" "$(( WATCH_N - total ))"
}

# The thumbnails a format string credits to the fixture's own formats, so work on files the fixture does not hold proves nothing.
# Sample input: "jpg=0;mp4=3;unknown=1" answers 3, and "unmeasurable" answers 0.
known_formats() {
  local cell n=0
  local -a cells
  IFS=';' read -r -a cells <<< "$1"
  for cell in ${cells[*]:-}; do
    case $cell in unknown=*) continue ;; esac
    [[ $cell =~ ^[^=]+=([0-9]+)$ ]] && n=$(( n + BASH_REMATCH[1] ))
  done
  printf '%s\n' "$n"
}

# Unique colours in the preview band. An empty answer is a failed capture and counts as no preview,
# because a preview nobody could see was not measured.
preview_colours() {
  grim -g "$PREVIEW_REGION" "$PREVIEW_SHOT" 2>/dev/null || return 1
  LC_ALL=C.UTF-8 LANGUAGE= magick "$PREVIEW_SHOT" -format %k info: 2>/dev/null
}

# The TUI group's number: time from launch to the cursor file's preview being on screen. It runs
# in its own launch, so the settle pass never pays for a screen capture, and it points the entrant
# at a named fixture image, because the file that sorts first here is a video and almost nothing
# previews one. Two consecutive polls, so a torn frame mid-redraw cannot pass for a preview.
measure_preview() {
  local id=$1 cmd=$2 t0 deadline hits=0 colours first_hit=0 launch
  # A fixture with no image in it cannot answer this question at all, and that is not the same
  # answer as an entrant that had one and drew nothing. The scale fixture holds no image.
  PREVIEW_MS=-
  [ -n "$PREVIEW_TARGET" ] || return 0
  PREVIEW_MS=-1
  # A bare file path makes ranger OPEN the file and exit, so it draws nothing and the window is gone
  # before the first poll. --selectfile is ranger's own flag for landing the cursor on a file.
  case $id in
    ranger) launch=${cmd//$FIXTURE/--selectfile=$PREVIEW_TARGET} ;;
    *) launch=${cmd//$FIXTURE/$PREVIEW_TARGET} ;;
  esac
  clean_bench
  : > "$TUI_DUMP"
  now_ms; t0=$NOW_MS
  deadline=$(( t0 + PREVIEW_TIMEOUT_MS ))
  { export FLEA_FIELD_BENCH=$BENCH_TOKEN; eval "$launch"; } >/dev/null 2>&1 &
  wait_for_window "$TUI_CLASS" "$deadline" "$TUI_TERM" "--class $TUI_CLASS" || { clean_bench; return 0; }
  while :; do
    now_ms
    [ "$NOW_MS" -gt "$deadline" ] && break
    colours=$(preview_colours)
    if [ -n "$colours" ] && [ "$colours" -ge "$PREVIEW_MIN_COLOURS" ]; then
      hits=$(( hits + 1 ))
      [ "$hits" = 1 ] && first_hit=$NOW_MS
      [ "$hits" -ge 2 ] && { PREVIEW_MS=$(( first_hit - t0 )); break; }
    else
      hits=0
    fi
    sleep 0.2
  done
  clean_bench
}

# The keys an entrant produced, unique and sorted for join. fail/ is excluded the same way
# count_thumbs excludes it: a refusal marker is a refusal, never a thumbnail, and it is captured to
# its own file because "refused" and "never attempted" are the two things a bare zero conflates.
capture_keys() {
  local id=$1
  KEYS_FILE="$KEYS_DIR/$id-run$RUN_INDEX.keys"
  LC_ALL=C.UTF-8 LANGUAGE= find "$THUMBS" -type f -name '*.png' -not -path "$THUMBS/fail/*" -printf '%f\n' 2>/dev/null \
    | LC_ALL=C.UTF-8 LANGUAGE= sed 's/\.png$//' | LC_ALL=C.UTF-8 LANGUAGE= sort -u > "$KEYS_FILE"
  LC_ALL=C.UTF-8 LANGUAGE= find "$THUMBS/fail" -type f -name '*.png' -printf '%f\n' 2>/dev/null \
    | LC_ALL=C.UTF-8 LANGUAGE= sed 's/\.png$//' | LC_ALL=C.UTF-8 LANGUAGE= sort -u > "$KEYS_DIR/$id-run$RUN_INDEX.fail.keys"
}

# A plain mv moves the parked cache INTO a recreated $THUMBS, so -T closes that race and the refusal makes it loud.
restore_thumbs() {
  [ "$THUMBS_PARKED_OK" = yes ] || return 0
  rm -rf "$THUMBS"
  [ -e "$THUMBS" ] && fail "$THUMBS was recreated under the restore, refusing to bury $THUMBS_PARKED"
  if [ -d "$THUMBS_PARKED" ]; then
    mv -T "$THUMBS_PARKED" "$THUMBS" || fail "could not restore $THUMBS_PARKED to $THUMBS, so the operator's cache is still parked there"
  fi
  THUMBS_PARKED_OK=no
}

# prefetch park begin
# The operator's list leaves for the run, so every timed launch reads a list the tested Flea recorded.
park_prefetch() {
  local orphan
  for orphan in "$PREFETCH_PARKED_PREFIX"*; do
    [ -e "$orphan" ] || continue
    fail "$orphan was parked by an invocation that was killed before its restore ran, so this run will not park on top of it"
  done
  if [ -e "$PREFETCH" ]; then
    mv -T "$PREFETCH" "$PREFETCH_PARKED" || fail "could not park $PREFETCH"
  fi
  PREFETCH_PARKED_OK=yes
}

# The tested Flea's last list goes, and the operator's comes back, or none when the operator had none.
restore_prefetch() {
  [ "$PREFETCH_PARKED_OK" = yes ] || return 0
  # Cleared first, so a restore that fails here is not tried again by the EXIT trap.
  PREFETCH_PARKED_OK=no
  rm -f "$PREFETCH"
  if [ -e "$PREFETCH_PARKED" ]; then
    mv -T "$PREFETCH_PARKED" "$PREFETCH" || fail "could not restore $PREFETCH_PARKED to $PREFETCH, so the operator's list is still parked there"
  fi
}
# prefetch park end

# prefetch slots begin
# Two Flea builds alternate in one run and each keeps its own list in its own tree; flea-tui shares flea's.
PREFETCH_ARM=""
FLEA_PREFETCH_SLOT="$FLEA_REPO/target/prefetch-list"
ANCHOR_PREFETCH_SLOT=""
if [ "$WITH_ANCHOR" = yes ]; then ANCHOR_PREFETCH_SLOT="$ANCHOR_REPO/target/prefetch-list"; fi
# The list the last launch recorded goes back to the slot of the build that recorded it.
prefetch_keep() {
  [ -n "$PREFETCH_ARM" ] || return 0
  if [ -e "$PREFETCH" ]; then
    cp -p "$PREFETCH" "$PREFETCH_ARM.bench-tmp" && mv -f "$PREFETCH_ARM.bench-tmp" "$PREFETCH_ARM" || fail "could not keep $PREFETCH as $PREFETCH_ARM"
  else
    rm -f "$PREFETCH_ARM"
  fi
  PREFETCH_ARM=""
}
# The slot's list becomes the shared path's list before a launch of that build; nothing changes within one build.
prefetch_for() {
  local slot=$1
  [ "$PREFETCH_ARM" = "$slot" ] && return 0
  prefetch_keep
  rm -f "$PREFETCH"
  if [ -e "$slot" ]; then
    cp -p "$slot" "$PREFETCH.bench-tmp" && mv -f "$PREFETCH.bench-tmp" "$PREFETCH" || fail "could not put $slot at $PREFETCH"
  fi
  PREFETCH_ARM=$slot
}
# prefetch slots end

# entrant sweep begin
# Sample input: /proc/123/environ "HOME=/root\0FLEA_FIELD_BENCH=4242-1760000000\0..."
# Every launch exports the token and every child inherits it wherever it goes, so only the bench's own processes match.
token_pids() {
  local f
  TOKEN_PIDS=()
  while IFS= read -r f; do
    f=${f#/proc/}
    TOKEN_PIDS+=("${f%/environ}")
  done < <(LC_ALL=C.UTF-8 LANGUAGE= grep -lzsx -- "FLEA_FIELD_BENCH=$1" /proc/[0-9]*/environ)
}

# Ends what the kill list missed, names each process in the log, and fails when one outlives SIGKILL.
sweep_token() {
  local pid polls=0
  token_pids "$BENCH_TOKEN"
  [ ${#TOKEN_PIDS[@]} -eq 0 ] && return 0
  for pid in "${TOKEN_PIDS[@]}"; do
    printf 'LEFTOVER: pid %s (%s) in %s carried the bench token past the kill list\n' \
      "$pid" "$(cat "/proc/$pid/comm" 2>/dev/null)" "$(cut -d: -f3 "/proc/$pid/cgroup" 2>/dev/null)" >&2
    kill "$pid" 2>/dev/null
  done
  # In tenths of a second, a grace for SIGTERM and then for SIGKILL; a zombie has an empty environ and drops out.
  while token_pids "$BENCH_TOKEN"; [ ${#TOKEN_PIDS[@]} -gt 0 ] && [ "$polls" -lt "$SWEEP_TERM_POLLS" ]; do
    sleep 0.1; polls=$(( polls + 1 ))
  done
  [ ${#TOKEN_PIDS[@]} -gt 0 ] && kill -9 "${TOKEN_PIDS[@]}" 2>/dev/null
  polls=0
  while token_pids "$BENCH_TOKEN"; [ ${#TOKEN_PIDS[@]} -gt 0 ] && [ "$polls" -lt "$SWEEP_KILL_POLLS" ]; do
    sleep 0.1; polls=$(( polls + 1 ))
  done
  [ ${#TOKEN_PIDS[@]} -eq 0 ] || fail "pid ${TOKEN_PIDS[*]} carried the bench token and outlived SIGKILL, so it would run into the next launch"
}
# entrant sweep end

# tui frame begin
# Sample input: kitty's --dump-bytes file, the child's raw output "\e[?1049h\e[1;1H ... some_file_name_000001 ...".
# The first output naming a fixture entry is the TUI's first listing; only a rows probe launch writes the dump, never a measured one.
TUI_ROWS_POLL_S=0.005
tui_first_rows() {
  local t0=$1 deadline=$2 size=0 last=0
  FIRST_ROWS_MS=-1
  while :; do
    size=$(stat -c %s "$TUI_DUMP" 2>/dev/null || echo 0)
    now_ms
    if [ "$size" -gt "$last" ]; then
      last=$size
      LC_ALL=C.UTF-8 LANGUAGE= grep -qaFf "$TUI_NAMES" "$TUI_DUMP" && { FIRST_ROWS_MS=$(( NOW_MS - t0 )); return 0; }
    fi
    [ "$NOW_MS" -gt "$deadline" ] && return 1
    sleep "$TUI_ROWS_POLL_S"
  done
}
# tui frame end

# Sample input: /proc/123/stat "... (qs) S 1 ... 14 3 0 0 20 ..." fields 14 to 17 are utime, stime, cutime and cstime.
# CPU_TICKS is the process alone; CPU_TREE_TICKS adds the reaped subtree, which is where a decode two levels down lands.
cpu_ticks() {
  local pid=$1 line
  read -r line < "/proc/$pid/stat" 2>/dev/null || { CPU_TICKS=-1; CPU_TREE_TICKS=-1; return 1; }
  # The comm field can contain spaces, so cut everything up to the closing paren first.
  local rest=${line##*") "}
  local -a f
  read -r -a f <<< "$rest"
  CPU_TICKS=$(( ${f[11]} + ${f[12]} ))
  CPU_TREE_TICKS=$(( CPU_TICKS + ${f[13]} + ${f[14]} ))
}

# Per-daemon baselines, so a daemon that exits mid-run keeps its own start.
declare -A MOUNT_START=()
MOUNT_DTICKS=0
MOUNT_LOST=""
mount_ticks_start() {
  local mount_pid
  MOUNT_START=()
  MOUNT_LOST=""
  for mount_pid in ${MOUNT_PIDS[*]:-}; do
    if cpu_ticks "$mount_pid"; then
      MOUNT_START[$mount_pid]=$CPU_TICKS
    else
      MOUNT_START[$mount_pid]=-1
    fi
  done
}
# Sums each daemon's own delta; a pid lost at either end fails the row.
mount_ticks_delta() {
  local mount_pid now start
  MOUNT_DTICKS=0
  MOUNT_LOST=""
  for mount_pid in ${MOUNT_PIDS[*]:-}; do
    start=${MOUNT_START[$mount_pid]:--1}
    [ "$start" -ge 0 ] || { MOUNT_LOST=$mount_pid; return 1; }
    cpu_ticks "$mount_pid" || { MOUNT_LOST=$mount_pid; return 1; }
    now=$CPU_TICKS
    [ "$now" -ge "$start" ] || { MOUNT_LOST=$mount_pid; return 1; }
    MOUNT_DTICKS=$(( MOUNT_DTICKS + now - start ))
  done
}
# The cpu_sys_s formula in one place, so the suite tests it directly.
sys_seconds() {
  LC_ALL=C.UTF-8 LANGUAGE= awk -v c="$1" -v d="$2" -v hz="$3" 'BEGIN { printf "%.2f", c + d / hz }'
}

# The helper is the second process an entrant does its work in, declared per entrant and resolved after launch.
HELPER_COMM=""
HELPER_TOKEN=""
HELPER_PID=""
HELPER_POLLS_LEFT=0
# The ticks of helpers that already exited this run, so a helper replaced mid-run keeps its share of cpu_tree_s.
HELPER_DONE_TICKS=0
# find_helper forks pgrep, so the search runs on one poll in 25 instead of every one; its period is 25 poll bodies and is not a wall clock guarantee.
HELPER_SEARCH_POLLS=25
find_helper() {
  [ -n "$HELPER_COMM" ] || return 0
  # A cached pid that stops being readable is a helper that exited, so forget it and look again.
  if [ -n "$HELPER_PID" ] && [ ! -r "/proc/$HELPER_PID/stat" ]; then HELPER_DONE_TICKS=${HELPER_TICKS:-0}; HELPER_PID=""; fi
  [ -n "$HELPER_PID" ] && return 0
  HELPER_POLLS_LEFT=$(( HELPER_POLLS_LEFT - 1 ))
  [ "$HELPER_POLLS_LEFT" -gt 0 ] && return 0
  HELPER_POLLS_LEFT=$HELPER_SEARCH_POLLS
  pids_for "$HELPER_COMM" "$HELPER_TOKEN"
  [ ${#PIDS[@]} -eq 0 ] && return 0
  HELPER_PID=${PIDS[0]}
  return 0
}

# ENTRANT_TICKS is the entrant alone for cpu_s and TREE_TICKS is the watched set, which is also the settle clock.
# WATCHED is that same set keyed by pid, published so the descendant walk reads one list and cannot drift from the CPU signal.
declare -A WATCHED=()
settle_ticks() {
  local pid=$1
  cpu_ticks "$pid" || return 1
  ENTRANT_TICKS=$CPU_TICKS
  TREE_TICKS=$CPU_TREE_TICKS
  WATCHED=( [$pid]=1 )
  # A gvfs listing runs in gvfsd-fuse and gvfsd-smb, outside every entrant's tree, so their ticks join the clock, never cpu_s.
  local mount_pid
  for mount_pid in ${MOUNT_PIDS[*]:-}; do
    cpu_ticks "$mount_pid" && TREE_TICKS=$(( TREE_TICKS + CPU_TICKS ))
  done
  find_helper
  if [ -n "$HELPER_PID" ] && cpu_ticks "$HELPER_PID"; then
    TREE_TICKS=$(( TREE_TICKS + CPU_TREE_TICKS ))
    HELPER_TICKS=$(( ${HELPER_DONE_TICKS:-0} + CPU_TREE_TICKS ))
    WATCHED[$HELPER_PID]=1
    # Flea's backend is forked inside the run's leaf and tumblerd is activated outside it, so only the second is added to the leaf's total.
    # Sample input: /proc/456/cgroup "0::/user.slice/user-1000.slice/user@1000.service/app.slice/flea-field-bench-123.scope/run-flea-1"
    if [ -z "$HELPER_SIDE" ]; then
      HELPER_SIDE=outside
      # An if and not an &&: this is the function's last command, and an && list's false for tumblerd read as thunar gone.
      if LC_ALL=C.UTF-8 LANGUAGE= grep -qx "0::${RUN_CG#/sys/fs/cgroup}" "/proc/$HELPER_PID/cgroup" 2>/dev/null; then HELPER_SIDE=inside; fi
    fi
  fi
}

# Sample input: <leaf>/cpu.stat "usage_usec 1021252", the first of its key and value lines.
# usage_usec counts every process that ever ran in the leaf, reaped or reparented or still alive.
cgroup_usage_usec() {
  local key value
  CG_USEC=-1
  while read -r key value; do
    [ "$key" = usage_usec ] && { CG_USEC=$value; return 0; }
  done < "$1/cpu.stat"
  return 1
}

# Sample input: /proc/456/cgroup "0::/user.slice/user-1000.slice/user@1000.service/app.slice/kitty-455-1.scope"
# kitty moves each child into a scope named for kitty's pid (/usr/lib/kitty/kitty/child.py), so a TUI entrant counts there if that kitty is in the leaf.
entrant_cg() {
  local pid=$1 kind=$2 line name kitty_pid
  # The 2>/dev/null goes first: a redirect that fails is reported before any redirect after it applies.
  read -r line 2>/dev/null < "/proc/$pid/cgroup" || return 1
  ENTRANT_CG=/sys/fs/cgroup${line#0::}
  [ "$ENTRANT_CG" = "$RUN_CG" ] && return 0
  [ "$kind" = tui ] || return 1
  name=${ENTRANT_CG##*/}
  case "$name" in kitty-*-*.scope) ;; *) return 1 ;; esac
  kitty_pid=${name#kitty-}
  kitty_pid=${kitty_pid%%-*}
  LC_ALL=C.UTF-8 LANGUAGE= grep -qx "0::${RUN_CG#/sys/fs/cgroup}" "/proc/$kitty_pid/cgroup" 2>/dev/null || return 1
  ENTRANT_SCOPE=$ENTRANT_CG
}

# cgroupfs reports every file as size 0, so emptiness is a read and never test -s.
cg_empty() {
  local pid
  read -r pid 2>/dev/null < "$1/cgroup.procs" && return 1
  return 0
}

# Anything still in control group $1 after its grace outlived the kill list, so it is named and ended by the group rather than left resident through the next entrant.
sweep_cg() {
  local cg=$1 pid n=0 polls=0
  # In tenths of a second: a process still exiting when clean_bench returns is not a leftover, and the group kill gets ten seconds.
  local grace_polls=10 kill_polls=100
  while ! cg_empty "$cg" && [ "$polls" -lt "$grace_polls" ]; do sleep 0.1; polls=$(( polls + 1 )); done
  [ -r "$cg/cgroup.procs" ] || return 0
  while read -r pid; do
    printf 'LEFTOVER: pid %s (%s) outlived the kill list in %s\n' "$pid" "$(cat "/proc/$pid/comm" 2>/dev/null)" "$cg" >&2
    n=$(( n + 1 ))
  done < "$cg/cgroup.procs"
  [ "$n" -gt 0 ] && echo 1 > "$cg/cgroup.kill"
  polls=0
  while ! cg_empty "$cg" && [ "$polls" -lt "$kill_polls" ]; do sleep 0.1; polls=$(( polls + 1 )); done
}

# The leaf, and a TUI's kitty scope beside it, are swept; systemd removes the scope once it is empty, and the leaf is ours to remove.
release_run_cg() {
  [ -n "$RUN_CG" ] || return 0
  case "$RUN_CG" in
    "$BENCH_CG"/run-*) ;;
    *) printf 'WARNING: not removing control group %s, it is not a run leaf of this bench\n' "$RUN_CG" >&2; return 1 ;;
  esac
  sweep_cg "$RUN_CG"
  [ -n "$ENTRANT_SCOPE" ] && sweep_cg "$ENTRANT_SCOPE"
  ENTRANT_SCOPE=""
  rmdir "$RUN_CG" 2>/dev/null || printf 'WARNING: control group %s could not be removed\n' "$RUN_CG" >&2
  RUN_CG=""
}

# Sample input: /proc/123/task/456/children holds "789 1011 ", space separated, with NO trailing newline.
# cutime and cstime hold only the children a watched pid has REAPED, so a decode still running is invisible to them.
descendant_ticks() {
  local pid kid t line rest
  local -a queue=("${!WATCHED[@]}") kids=() f=()
  DESC_TICKS=0
  # Breadth first over the whole tree, because flea's decode is two levels down: the backend forks prlimit which execs bwrap, and the thumbnailer runs under bwrap's namespace init.
  while [ ${#queue[@]} -gt 0 ]; do
    pid=${queue[0]}; queue=("${queue[@]:1}")
    for t in "/proc/$pid/task"/*; do
      [ -r "$t/children" ] || continue
      # A thread can exit between the test and the open, which leaves mapfile unrun, so the array is emptied first; and redirections apply left to right, so the discard goes before the path.
      kids=(); mapfile -t kids 2>/dev/null < "$t/children"
      for kid in ${kids[*]:-}; do
        # A watched pid is not a descendant: its ticks are already in TREE_TICKS, and flea's backend is a child of qs.
        [ -n "${WATCHED[$kid]:-}" ] && continue
        # Sample input: /proc/789/stat "789 (bwrap) S 456 ... 14 3 0 0 20 ...", the same format cpu_ticks consumes, fields 14 to 17 being utime, stime, cutime and cstime.
        read -r line 2>/dev/null < "/proc/$kid/stat" || continue
        # The comm field can hold spaces and parens, so everything up to the closing paren goes first, exactly as cpu_ticks does.
        rest=${line##*") "}
        # An array assignment splits the fields the way drm_kb does, and it is 15x cheaper than the here-string form because that one goes through a temporary.
        f=( $rest )
        # A zombie is counted too, because its ticks move into its parent's cutime at the reap and this total has to stay continuous, and a missing field contributes 0 rather than aborting the run under set -u.
        DESC_TICKS=$(( DESC_TICKS + ${f[11]:-0} + ${f[12]:-0} + ${f[13]:-0} + ${f[14]:-0} ))
        queue+=("$kid")
      done
    done
  done
}

# Sample input: /proc/123/smaps_rollup "Pss:              342220 kB", one key and one value a line.
# mapfile takes the whole file at one position, because a line by line read of a seq_file tears; see AGENTS.md "Testing".
pss_kb() {
  local pid=$1 l k v seen=0 pclean=0 pdirty=0
  local -a lines=()
  PSS_KB=0; PSS_ANON_KB=0; USS_KB=0
  mapfile -t lines < "/proc/$pid/smaps_rollup" 2>/dev/null
  for l in "${lines[@]}"; do
    k=${l%%:*}
    v=${l#*:}; v=${v// /}; v=${v%kB}
    case "$k" in
      Pss) PSS_KB=$v; seen=1 ;;
      Pss_Anon) PSS_ANON_KB=$v ;;
      Private_Clean) pclean=$v ;;
      Private_Dirty) pdirty=$v ;;
    esac
  done
  USS_KB=$(( pclean + pdirty ))
  [ "$seen" = 1 ] || return 1
}

# Sample input: /proc/123/fdinfo/35 holds "drm-client-id:\t14" then "drm-resident-system0:\t55124 KiB".
# Several file descriptors share one drm client, so the client id is what de-duplicates them.
drm_kb() {
  local pid=$1 file line id device amount unit key
  local -a lines=() word=()
  local -A seen=()
  DRM_KB=unmeasurable
  for file in "${DRM_PROC_ROOT:-/proc}/$pid/fdinfo/"*; do
    [ -r "$file" ] || continue
    # mapfile for the same reason pss_kb uses it: this is a seq_file and a line by line read tears.
    mapfile -t lines < "$file" 2>/dev/null
    id=""; device=""; amount=""; unit=""
    for line in "${lines[@]}"; do
      word=( $line )
      case "${word[0]:-}" in
        "drm-client-id:") id=${word[1]} ;;
        "drm-pdev:") device=${word[1]} ;;
        "drm-resident-system0:") amount=${word[1]}; unit=${word[2]:-} ;;
      esac
    done
    [ -n "$id" ] && [[ $amount =~ ^[0-9]+$ ]] || continue
    # The kernel prints 0 and any size not a whole KiB in bytes with no unit; those round up to KiB.
    case $unit in "") amount=$(( (amount + 1023) / 1024 )) ;; KiB) ;; MiB) amount=$(( amount * 1024 )) ;; GiB) amount=$(( amount * 1048576 )) ;; *) continue ;; esac
    key="$device:$id"
    [ -n "${seen[$key]:-}" ] && continue
    seen[$key]=1
    [ "$DRM_KB" = unmeasurable ] && DRM_KB=0
    DRM_KB=$(( DRM_KB + amount ))
  done
  # NVIDIA's driver publishes no drm-resident key, so a process holding /dev/nvidiaN would read as the 0 of an idle iGPU client.
  [ -n "$(LC_ALL=C.UTF-8 LANGUAGE= find "${DRM_PROC_ROOT:-/proc}/$pid/fd" -maxdepth 1 -lname '/dev/nvidia[0-9]*' -print -quit 2>/dev/null)" ] || return 0
  # Sample input: "4242, 68", one line per GPU the pid holds memory on, used_memory in MiB.
  local mib
  mib=$(LC_ALL=C.UTF-8 LANGUAGE= "${NVIDIA_SMI:-nvidia-smi}" --query-compute-apps=pid,used_memory --format=csv,noheader,nounits 2>/dev/null \
    | LC_ALL=C.UTF-8 LANGUAGE= awk -F', *' -v p="$pid" '$1 == p && $2 ~ /^[0-9]+$/ { s += $2; n++ } END { if (n) print s }')
  # A process on the NVIDIA device whose memory the driver will not name has no honest total.
  [ -n "$mib" ] || { DRM_KB=unmeasurable; return 0; }
  [ "$DRM_KB" = unmeasurable ] && DRM_KB=0
  DRM_KB=$(( DRM_KB + mib * 1024 ))
}

# Resolve every live pid whose comm matches exactly, optionally requiring a cmdline token.
pids_for() {
  local comm=$1 token=${2:-} pid c
  PIDS=()
  for pid in $(LC_ALL=C.UTF-8 LANGUAGE= pgrep -x "$comm" 2>/dev/null); do
    [ -r "/proc/$pid/cmdline" ] || continue
    if [ -n "$token" ]; then
      c=$(LC_ALL=C.UTF-8 LANGUAGE= tr '\0' ' ' < "/proc/$pid/cmdline")
      case "$c" in *"$token"*) ;; *) continue ;; esac
    fi
    PIDS+=("$pid")
  done
}

kill_entrant() {
  local comm=$1 token=${2:-} pid
  for _round in $(seq 1 200); do
    pids_for "$comm" "$token"
    [ ${#PIDS[@]} -eq 0 ] && return 0
    for pid in "${PIDS[@]}"; do kill "$pid" 2>/dev/null; done
    sleep 0.05
  done
  for pid in "${PIDS[@]}"; do kill -9 "$pid" 2>/dev/null; done
  sleep 0.5
  pids_for "$comm" "$token"
  [ ${#PIDS[@]} -eq 0 ] || fail "$comm would not die"
}

# The same roster scopes ONLY before setup and builds launch commands again once the temporary paths exist.
build_entrants() {
  local strata_id=strata-stable
  local FLEA_FRONTEND=${FLEA_FRONTEND:-gpui}
  local flea_class=com.thisisgm.flea flea_comm=qs flea_token=$FLEA_UI
  if [ "$FLEA_FRONTEND" = gpui ]; then flea_comm=flea-gui; flea_token=$(dirname "$FLEA_BIN")/flea-gui; fi
  # Fields: id|kind|class|comm|token|helper_comm|helper_token|command; the command holds any later pipe, and its \$TUI_DUMP_FLAG is read by each launch's eval.
  declare -ga ENTRANTS=(
    # Flea's real launcher sets prctl before exec; FLEA_UI avoids an installed shell overriding the checkout, and rows name any helper doing their work, Flea's backend or thunar's D-Bus activated tumblerd.
    "flea|gui|$flea_class|$flea_comm|$flea_token|flea|--backend|FLEA_FRONTEND=$FLEA_FRONTEND FLEA_BIN=$FLEA_BIN FLEA_UI=$FLEA_UI QML_DISK_CACHE_PATH=$FLEA_QMLCACHE XDG_STATE_HOME=$FLEA_STATE setsid nohup $FLEA_BIN --gui $FIXTURE"
    "nautilus|gui|org.gnome.Nautilus|nautilus||||setsid nohup nautilus --new-window $FIXTURE"
    "thunar|gui|thunar|thunar||tumblerd||setsid nohup thunar $FIXTURE"
    "pcmanfm|gui|pcmanfm|pcmanfm||||setsid nohup pcmanfm $FIXTURE"
    "nemo|gui|nemo|nemo||||setsid nohup nemo $FIXTURE"
    "dolphin|gui|org.kde.dolphin|dolphin||||setsid nohup dolphin $FIXTURE"
    "$strata_id|gui|io.github.lgse.Strata|strata||||setsid nohup $STRATA_BIN $FIXTURE"
    # Every previewing entrant prefers Kitty's protocol to foot's sixel, which caused the old zero across all eight; flea-tui uses the same terminal and the bench's own XDG_CONFIG_HOME.
    "flea-tui|tui|$TUI_CLASS|flea||||XDG_CONFIG_HOME=$TUI_CONF XDG_STATE_HOME=$FLEA_STATE setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG $FLEA_BIN --tui $FIXTURE"
    "yazi|tui|$TUI_CLASS|yazi||||XDG_CONFIG_HOME=$TUI_CONF setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG yazi $FIXTURE"
    "mc|tui|$TUI_CLASS|mc||||XDG_CONFIG_HOME=$TUI_CONF setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG mc $FIXTURE"
    "broot|tui|$TUI_CLASS|broot||||XDG_CONFIG_HOME=$TUI_CONF setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG broot $FIXTURE"
    # preview-tui's shipped header requires -a to create NNN_FIFO and -P p to load the preview plugin at startup.
    "nnn|tui|$TUI_CLASS|nnn||||XDG_CONFIG_HOME=$TUI_CONF NNN_PLUG=p:preview-tui setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG nnn -a -P p $FIXTURE"
    "lf|tui|$TUI_CLASS|lf||||XDG_CONFIG_HOME=$TUI_CONF setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG lf $FIXTURE"
    "ranger|tui|$TUI_CLASS|ranger||||XDG_CONFIG_HOME=$TUI_CONF setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG ranger $FIXTURE"
    "xplr|tui|$TUI_CLASS|xplr||||XDG_CONFIG_HOME=$TUI_CONF setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG xplr $FIXTURE"
    "superfile|tui|$TUI_CLASS|spf||||XDG_CONFIG_HOME=$TUI_CONF setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG spf $FIXTURE"
  )
  ENTRANTS+=("strata-nightly|gui|io.github.lgse.Strata|strata||||setsid nohup ${STRATA_NIGHTLY_BIN:-} $FIXTURE")
  if [ -n "${STRATA_NIGHTLY_CHANNEL_BIN:-}" ]; then
    ENTRANTS+=("strata-nightly-channel|gui|*|strata|$FIXTURE|||setsid nohup $STRATA_NIGHTLY_CHANNEL_BIN $FIXTURE")
  fi
  if [ -n "${FLEA_RIVAL_MANIFEST:-}" ]; then
    local i id kind comm helper helper_token command
    for i in "${!ENTRANTS[@]}"; do
      case ${ENTRANTS[$i]%%|*} in strata-stable|strata-nightly|strata-nightly-channel)
        IFS='|' read -r id kind _ comm _ helper helper_token command <<< "${ENTRANTS[$i]}"
        ENTRANTS[$i]="$id|$kind|*|$comm|$FIXTURE|$helper|$helper_token|$command" ;;
      esac
    done
  fi
  # The anchor entrant is the flea row with the anchor tree in place of the Flea tree, interleaved for the rank.
  if [ "$WITH_ANCHOR" = yes ]; then ENTRANTS=("${ENTRANTS[0]}" "flea-anchor|gui|com.thisisgm.flea|qs|$ANCHOR_UI|flea|--backend|FLEA_FRONTEND=qml FLEA_BIN=$ANCHOR_BIN FLEA_UI=$ANCHOR_UI QML_DISK_CACHE_PATH=$ANCHOR_QMLCACHE XDG_STATE_HOME=$ANCHOR_STATE setsid nohup $ANCHOR_BIN --gui $FIXTURE" "${ENTRANTS[@]:1}"); fi
  if [ "$WITH_ANCHOR" = yes ]; then
    ENTRANTS+=("flea-tui-anchor|tui|$TUI_CLASS|flea||||XDG_CONFIG_HOME=$TUI_CONF XDG_STATE_HOME=$ANCHOR_STATE setsid nohup $TUI_TERM --class $TUI_CLASS \$TUI_DUMP_FLAG $ANCHOR_BIN --tui $FIXTURE")
  fi
}
build_entrants

# Fields: comm|token, in kill order, so clean_bench and the start-up refusal read one list and cannot drift apart.
declare -a KILL_TARGETS=(
  "qs|$FLEA_UI"
  "flea-gui|$(dirname "${FLEA_BIN:-/nonexistent-flea-bench/flea}")/flea-gui"
  "flea|--backend"
  # The group's terminal, matched by the class this run gives it: a bare kitty target would name
  # every terminal the operator has open.
  "$TUI_TERM|--class $TUI_CLASS"
  # The previewers the as-intended configuration brings with it, none of which is a descendant the
  # settle walk would have reaped.
  "ueberzugpp|"
  "kitten|"
  "preview-tui|"
  "nautilus|"
  # The nautilus previewer, whose comm the kernel truncates to 15 characters.
  "org.gnome.Nauti|"
  "thunar|"
  "pcmanfm|"
  "nemo|"
  # Single instance: a second launch hands off to the running one and exits, so it must die between runs.
  "dolphin|"
  # Single instance too: a GApplication with an id hands a second launch to the running one and exits.
  "strata|"
  "yazi|"
  "mc|"
  "broot|"
  "nnn|"
  "lf|"
  "ranger|"
  "xplr|"
  "spf|"
  # Hyprland's Application Not Responding dialog, which pcmanfm leaves behind on the media fixture every run.
  "hyprland-dialog|"
  # D-Bus activated by an entrant, outlives it, and writes to the shared cache, so a survivor lands in the next run's cold arm.
  "tumblerd|"
  # nautilus starts its indexer over D-Bus and it outlives it: on 2026-09-25 it crawled $HOME for two hours, 14.5 GB, under every later entrant's cold launch.
  "localsearch-3|"
  # The indexer's extractor, whose comm the kernel truncates to 15 characters.
  "localsearch-ext|"
)
# The anchor's qs carries ANCHOR_UI as its token, so an anchor run gives it a row of its own.
if [ "$WITH_ANCHOR" = yes ]; then KILL_TARGETS=("${KILL_TARGETS[0]}" "qs|$ANCHOR_UI" "${KILL_TARGETS[@]:1}"); fi

# The processes in KILL_TARGETS one entrant owns. Two ids are not named after their own process.
kill_comms_for() {
  case $1 in
    flea) if [ "${FLEA_FRONTEND:-gpui}" = gpui ]; then printf 'flea-gui\nflea\n'; else printf 'qs\nflea\n'; fi ;;
    flea-anchor) printf 'qs\nflea\n' ;;
    strata-stable|strata-nightly|strata-nightly-channel) printf 'strata\n' ;;
    # tumblerd outlives thunar by 300 s, and a full-field start refuses to begin beside it.
    thunar) printf 'thunar\ntumblerd\n' ;;
    # The indexer nautilus starts outlives it the same way, so ONLY=nautilus ends it too.
    nautilus) printf 'nautilus\nlocalsearch-3\nlocalsearch-ext\n' ;;
    superfile) printf 'spf\n' ;;
    strata-stable|strata-nightly) printf 'strata\n' ;;
    # The Flea TUI front end runs as comm flea, so ONLY=flea-tui scopes the flea kill row.
    flea-tui|flea-tui-anchor) printf 'flea\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# ONLY is split once with globbing off, so every membership test below reads one array.
set -f
ONLY_IDS=(${ONLY:-})
set +f
# Membership reads the split above, so a tab or a glob word scopes the kill and the launch alike.
only_has() { [ ${#ONLY_IDS[@]} -eq 0 ] && return 0; local o; for o in "${ONLY_IDS[@]}"; do [ "$o" = "$1" ] && return 0; done; return 1; }

# Reject every unknown word against the same rows the launch loop reads, before any kill target is scoped.
validate_only() {
  local id row known
  for id in "${ONLY_IDS[@]}"; do
    known=no
    for row in "${ENTRANTS[@]}"; do
      if [ "${row%%|*}" = "$id" ]; then known=yes; break; fi
    done
    [ "$known" = yes ] || fail "ONLY names unknown entrant '$id'"
  done
}
# only scope begin

# An ONLY naming the anchor without an anchor tree would silently run nothing of it.
for one_only in "${ONLY_IDS[@]}"; do { [ "$one_only" = flea-anchor ] || [ "$one_only" = flea-tui-anchor ]; } && [ "$WITH_ANCHOR" = no ] && fail "ONLY names $one_only but ANCHOR_REPO is not a separate tree, so that arm would never launch"; done
validate_only
# Validate before run_order can filter absent entries out of its rotation.
require_selected_entrants() {
  local row id kind class comm token helper helper_token command binary
  for row in "${ENTRANTS[@]}"; do
    IFS='|' read -r id kind class comm token helper helper_token command <<< "$row"
    only_has "$id" || continue
    case $id in
      flea|flea-tui) binary=$FLEA_BIN ;;
      flea-anchor|flea-tui-anchor) binary=$ANCHOR_BIN ;;
      strata-stable) binary=$STRATA_BIN ;;
      strata-nightly) binary=$STRATA_NIGHTLY_BIN ;;
      strata-nightly-channel) binary=$STRATA_NIGHTLY_CHANNEL_BIN ;;
      *) binary=$(command -v "$comm") || fail "required entrant is absent: $id" ;;
    esac
    [ -n "$binary" ] && [ -x "$binary" ] || fail "required entrant executable is absent: $id"
    if [ "$id" = flea ] && [ "$FIELD_FRONTEND" = gpui ]; then
      [ -x "${FLEA_BIN%/*}/flea-gui" ] || fail "candidate sibling flea-gui is absent"
    fi
  done
}
require_selected_entrants
# ONLY scopes both the kill list and the startup refusal, so the operator's other windows are never this run's to close.
if [ ${#ONLY_IDS[@]} -gt 0 ]; then
  declare -a scoped_targets=()
  for one_only in "${ONLY_IDS[@]}"; do
    while IFS= read -r only_comm; do
      for kill_row in "${KILL_TARGETS[@]}"; do
        [ "${kill_row%%|*}" = "$only_comm" ] && scoped_targets+=("$kill_row")
      done
    done < <(kill_comms_for "$one_only")
  done
  [ ${#scoped_targets[@]} -gt 0 ] \
    || fail "ONLY=$ONLY names no process in the kill list, so this run could not clean up after itself"
  KILL_TARGETS=("${scoped_targets[@]}")
fi
# only scope end


clean_bench() {
  local row comm token
  for row in "${KILL_TARGETS[@]}"; do
    IFS='|' read -r comm token <<< "$row"
    kill_entrant "$comm" "$token"
  done
  sweep_token
  close_entrant_dialogs
}

# warm launch begin
# One untimed launch on the run's fixture compiles the units a timed launch loads, stale ones included, from a fresh copy of the shipped defaults; done once the window is up and no unit is written for WARM_QUIET_POLLS polls.
WARM_POLL_S=0.1
WARM_QUIET_POLLS=20
WARM_MAX_POLLS=600
WARM_KILL_POLLS=100
WARM_JOIN_POLL_S=0.01
WARM_MAP_MS=60000
warm_qml_cache() {
  [ "${FLEA_FRONTEND:-gpui}" = gpui ] && return 0
  local state quiet=0 polls=0 n pid cg="$BENCH_CG/run-warm"
  [ -e "$PREFETCH" ] && fail "a prefetch list is already at $PREFETCH before the warm launch, so the warm guard could pass from a stale list"
  mkdir -p "$FLEA_QMLCACHE" || fail "cannot make $FLEA_QMLCACHE"
  state=$(mktemp -d "$FLEA_STATE/warm-state.XXXXXX") || fail "no warm state directory under $FLEA_STATE"
  cp -a "$FLEA_STATE/flea" "$state/" || fail "cannot copy the shipped defaults into $state"
  : > "$state/polled" || fail "cannot write the poll marker in $state"
  # A leaf of its own, as a timed run has, so warm_stop can end everything it starts, sandboxed decoders in their own sessions included.
  mkdir "$cg" || fail "could not make the control group $cg"
  # The parent also marks the launch before starting this job, so its EXIT trap sweeps an interrupted warm Flea.
  ENTRANT_LAUNCHED=yes
  { printf '%s\n' "$BASHPID" > "$cg/cgroup.procs" \
      || { printf 'FAIL: could not join %s, so the warm launch was not started\n' "$cg" >&2; exit 1; }
    FLEA_FRONTEND=qml FLEA_BIN=$FLEA_BIN FLEA_UI=$FLEA_UI QML_DISK_CACHE_PATH=$FLEA_QMLCACHE XDG_STATE_HOME=$state FLEA_FIELD_BENCH=$BENCH_TOKEN \
      exec setsid nohup "$FLEA_BIN" --gui "$FIXTURE" > /dev/null 2>&1; } &
  pid=$!
  # Out of the job table, so the shell never prints the killed job into the run log.
  disown "$pid"
  # The launch keeps its pid through exec, so it is seen in the group once joined, or gone if the join failed.
  until LC_ALL=C.UTF-8 LANGUAGE= grep -qx "$pid" "$cg/cgroup.procs" 2> /dev/null; do
    kill -0 "$pid" 2> /dev/null || { warm_stop "$cg"; fail "the warm launch left before it joined $cg"; }
    sleep "$WARM_JOIN_POLL_S"
  done
  now_ms
  if ! wait_for_window com.thisisgm.flea "$(( NOW_MS + WARM_MAP_MS ))" qs "$FLEA_UI"; then
    warm_stop "$cg"
    fail "the warm launch mapped no window in $WARM_MAP_MS ms, so the first timed launch could compile"
  fi
  # The next marker is touched before the scan, so a unit written during the scan is newer than it and counts next poll.
  while [ "$polls" -lt "$WARM_MAX_POLLS" ] && [ "$quiet" -lt "$WARM_QUIET_POLLS" ]; do
    sleep "$WARM_POLL_S"; polls=$(( polls + 1 ))
    : > "$state/polling"
    if [ -n "$(LC_ALL=C.UTF-8 LANGUAGE= find "$FLEA_QMLCACHE" -newer "$state/polled" -print -quit)" ]; then quiet=0; else quiet=$(( quiet + 1 )); fi
    mv "$state/polling" "$state/polled"
  done
  warm_stop "$cg"
  [ "$quiet" -ge "$WARM_QUIET_POLLS" ] \
    || fail "the warm launch was still writing QML units into $FLEA_QMLCACHE after $WARM_MAX_POLLS polls, so the first timed launch could compile"
  n=$(LC_ALL=C.UTF-8 LANGUAGE= ls -A "$FLEA_QMLCACHE" | wc -l)
  [ "$n" -gt 0 ] || fail "the warm launch compiled nothing into $FLEA_QMLCACHE, so the first timed launch would compile"
  [ -s "$PREFETCH" ] || fail "the warm launch recorded no prefetch list at $PREFETCH, so the first timed launch would run without one"
  printf 'WARM: %s QML units in %s, prefetch list of %s lines\n' "$n" "$FLEA_QMLCACHE" "$(wc -l < "$PREFETCH")" >&2
}

# Closes the warm Flea as clean_bench closes a timed one, kills whatever is left in its control group, and fails if the group will not empty.
warm_stop() {
  local cg=$1 polls=0
  kill_entrant qs "$FLEA_UI"
  kill_entrant flea --backend
  echo 1 > "$cg/cgroup.kill" || fail "could not kill the control group $cg"
  while ! cg_empty "$cg" && [ "$polls" -lt "$WARM_KILL_POLLS" ]; do sleep "$WARM_POLL_S"; polls=$(( polls + 1 )); done
  cg_empty "$cg" || fail "the warm launch's control group $cg did not empty, so it could run into the timed launches"
  rmdir "$cg" || fail "could not remove the control group $cg"
}

# Stop the warm shell and its setup children before restoring caches, even if no Flea launched yet.
stop_warm_job() {
  local pid=${WARM_PID:-} polls=0 pgid parent
  # A signal can arrive after the fork but before WARM_PID is assigned; the previous job is never this launch.
  if [ -z "$pid" ] && [ "${WARM_STARTING:-}" = yes ]; then
    pid=${!:-}
    [ -n "$pid" ] && [ "$pid" != "${WARM_PREVIOUS_PID:-}" ] || return 0
    # Sample input: ps -o pgid=,ppid= -p 4242 prints "4242 4100" for the warm group leader and its bench parent.
    read -r pgid parent < <(LC_ALL=C.UTF-8 LANGUAGE= ps -o pgid=,ppid= -p "$pid") || return 0
    [ "$pgid" = "$pid" ] && [ "$parent" = "$$" ] \
      && cmp -s "/proc/$pid/cmdline" "/proc/$$/cmdline" || return 0
  fi
  [ -n "$pid" ] || return 0
  kill -TERM -- "-$pid" 2>/dev/null || true
  while kill -0 -- "-$pid" 2>/dev/null && [ "$polls" -lt "$SWEEP_TERM_POLLS" ]; do sleep "$WARM_POLL_S"; polls=$(( polls + 1 )); done
  kill -KILL -- "-$pid" 2>/dev/null || true
  polls=0
  while kill -0 -- "-$pid" 2>/dev/null && [ "$polls" -lt "$SWEEP_KILL_POLLS" ]; do sleep "$WARM_POLL_S"; polls=$(( polls + 1 )); done
  if kill -0 -- "-$pid" 2>/dev/null; then
    printf 'WARNING: warm job process group %s outlived SIGKILL\n' "$pid" >&2
    return 1
  fi
  wait "$pid" 2>/dev/null || true
  WARM_PID=""
  WARM_STARTING=""
}
# warm launch end

# A killed entrant can leave Hyprland's not-responding dialog over every entrant after it, and the text ends with the window's class.
# Sample input: hyprland-dialog's cmdline "--title Application Not Responding --text An application flea-media-btrfs - pcmanfm is not responding. ..."
close_entrant_dialogs() {
  local pid text row id kind class rest
  for pid in $(LC_ALL=C.UTF-8 LANGUAGE= pgrep -x hyprland-dialog 2>/dev/null); do
    text=$(LC_ALL=C.UTF-8 LANGUAGE= tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
    for row in "${ENTRANTS[@]}"; do
      IFS='|' read -r id kind class rest <<< "$row"
      case "$text" in *" - $class is not responding"*) ;; *) continue ;; esac
      printf 'closing the not-responding dialog %s that %s left behind\n' "$pid" "$id" >&2
      kill "$pid" 2>/dev/null
      break
    done
  done
}

# This run kills everything in KILL_TARGETS and, with DROP_THUMBS=yes, removes the shared cache out from under it.
require_bench_idle() {
  local row comm token pid n=0 load load_hundredths waited=0
  # Sample input: /proc/loadavg "0.44 0.19 0.30 1/595 2585811", and the first field is the minute.
  while :; do
    load=$(cut -d' ' -f1 /proc/loadavg)
    load_hundredths=$(( 10#${load/./} ))
    [ "$load_hundredths" -le "$BENCH_MAX_LOAD_HUNDREDTHS" ] && break
    [ "$waited" -ge "$BENCH_IDLE_WAIT_S" ] \
      && fail "the one-minute load average is still $load after ${waited}s, over the $BENCH_MAX_LOAD_HUNDREDTHS hundredths this run allows, so something else is using the box"
    [ "$waited" = 0 ] && printf 'waiting for the box to go idle: load %s, this run needs %s hundredths\n' "$load" "$BENCH_MAX_LOAD_HUNDREDTHS" >&2
    sleep 10
    waited=$(( waited + 10 ))
  done
  BENCH_IDLE_WAITED=$waited
  # Any dialog on screen floats over the entrants and takes their focus, and one this run did not cause is not its to close.
  LC_ALL=C.UTF-8 LANGUAGE= pgrep -x hyprland-dialog >/dev/null && fail "a hyprland-dialog is on screen, and it would float over and take focus from every entrant"
  [ "$waited" -gt 0 ] && printf 'the box settled after %ss at load %s\n' "$waited" "$load" >&2
  for row in "${KILL_TARGETS[@]}"; do
    IFS='|' read -r comm token <<< "$row"
    pids_for "$comm" "$token"
    for pid in "${PIDS[@]}"; do
      printf 'FAIL: pid %s is already alive and this run would kill it: %s\n' "$pid" "$(LC_ALL=C.UTF-8 LANGUAGE= tr '\0' ' ' < "/proc/$pid/cmdline")" >&2
      n=$(( n + 1 ))
    done
  done
  # A process from an earlier invocation that was killed before its sweep ran still carries that invocation's token.
  token_pids '.*'
  for pid in "${TOKEN_PIDS[@]}"; do
    printf 'FAIL: pid %s (%s) outlived an earlier field run: %s\n' "$pid" "$(cat "/proc/$pid/comm" 2>/dev/null)" "$(LC_ALL=C.UTF-8 LANGUAGE= tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" >&2
    n=$(( n + 1 ))
  done
  [ "$n" -eq 0 ] || fail "the $n process(es) named above would be killed by this run, so it refuses to start"
}

wait_for_pid() {
  local comm=$1 token=${2:-} deadline=$3
  while :; do
    pids_for "$comm" "$token"
    [ ${#PIDS[@]} -ge 1 ] && { ENTRANT_PID=${PIDS[0]}; return 0; }
    now_ms
    [ "$NOW_MS" -gt "$deadline" ] && return 1
    sleep 0.01
  done
}

# True when a client pid is this run's own: its comm, and its command line carrying the token when one is given.
window_owned() {
  local pid=$1 comm=$2 token=$3 c
  [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "$comm" ] || return 1
  [ -n "$token" ] || return 0
  c=$(LC_ALL=C.UTF-8 LANGUAGE= tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
  case "$c" in *"$token"*) return 0 ;; esac
  return 1
}

# A window of this class that this run does not own is named once, so a wrong owner rule never fails silently.
declare -A FOREIGN_SEEN=()
note_foreign_window() {
  local pid=$1 class=$2 owner_comm=$3 owner_token=$4
  [ -n "${FOREIGN_SEEN[$pid]:-}" ] && return 0
  FOREIGN_SEEN[$pid]=1
  printf 'FOREIGN WINDOW: pid %s (%s) holds class %s, and this run waits for %s %s\n' \
    "$pid" "$(cat "/proc/$pid/comm" 2>/dev/null)" "$class" "$owner_comm" "$owner_token" >&2
}

# Mapped when a client of this class is owned by this run's entrant, polled directly because omarchy-drive waits at 50 ms.
wait_for_window() {
  local class=$1 deadline=$2 owner_comm=$3 owner_token=$4 clients pid seen
  while :; do
    clients=$(LC_ALL=C.UTF-8 LANGUAGE= hyprctl -j clients 2>/dev/null)
    # Stamped before the ownership check, so its forks never reach mapped_ms and every entrant pays the same.
    now_ms
    seen=$NOW_MS
    # The cheap match first, so a poll with no such window costs what it always did and jq runs only once one exists.
    if [ "$class" = '*' ]; then
      for pid in $(printf '%s' "$clients" | jq -r '.[].pid'); do
        if window_owned "$pid" "$owner_comm" "$owner_token"; then WINDOW_PID=$pid; NOW_MS=$seen; return 0; fi
      done
    else
    case $clients in
      *"\"class\": \"$class\""*)
        # Sample input, one client of hyprctl -j clients: {"class": "com.thisisgm.flea", "pid": 12345, ...}
        for pid in $(printf '%s' "$clients" | jq -r --arg c "$class" '.[] | select(.class == $c) | .pid'); do
          if window_owned "$pid" "$owner_comm" "$owner_token"; then
            WINDOW_PID=$pid
            NOW_MS=$seen
            return 0
          fi
          note_foreign_window "$pid" "$class" "$owner_comm" "$owner_token"
        done
        ;;
    esac
    fi
    [ "$seen" -gt "$deadline" ] && return 1
    sleep 0.01
  done
}

# A nas run's receive bytes, recorded beside its time; empty for every other fixture.
NET_IFACE=""
# Sample input, one /proc/net/dev line: "  eth0: 123456 789 ..." where the first number is receive bytes.
net_rx_bytes() {
  local v
  v=$(LC_ALL=C.UTF-8 LANGUAGE= grep "^ *$1:" /proc/net/dev 2>/dev/null | LC_ALL=C.UTF-8 LANGUAGE= tr -s ' ' | LC_ALL=C.UTF-8 LANGUAGE= sed 's/^ //' | cut -d' ' -f2)
  printf '%s' "${v:-0}"
}

# The engine comparison samples memory three seconds after map, independently of the CPU quiet gap.
engine_memory_sample() {
  local pid=$1 child_pid
  # The cold sample may land after the post-settle readings, which the row prints, so it restores them.
  local keep_drm=${DRM_KB:-} keep_pss=${PSS_KB:-} keep_anon=${PSS_ANON_KB:-} keep_uss=${USS_KB:-}
  pss_kb "$pid" || fail "cannot read cold PSS"
  COLD_PSS=$PSS_KB
  drm_kb "$pid"; COLD_DRM=$DRM_KB
  COLD_CHILD_PSS=0
  if [ -n "$HELPER_COMM" ]; then
    pids_for "$HELPER_COMM" "$HELPER_TOKEN"
    for child_pid in "${PIDS[@]}"; do
      pss_kb "$child_pid" || fail "cannot read cold child PSS"
      COLD_CHILD_PSS=$(( COLD_CHILD_PSS + PSS_KB ))
    done
  fi
  DRM_KB=$keep_drm PSS_KB=$keep_pss PSS_ANON_KB=$keep_anon USS_KB=$keep_uss
}

# One run of one entrant: cold caches, launch, then poll until neither the watched set nor its live descendants earn a tick for a whole gap.
run_one() {
  local id=$1 kind=$2 class=$3 comm=$4 token=$5 shift_cmd=$8
  local TRANSIENT_ID=${TRANSIENT_ID:-strata-stable}
  case "$id" in strata-stable|strata-nightly|strata-nightly-channel) TRANSIENT_ID=$id ;; esac
  local t0 deadline mapped=-1 settled=-1 last_settle=-1 last_change=0 best_pss=0 pid
  # A GUI entrant is judged on its thumbnails and never enters the preview pass, so its column reads
  # not-applicable rather than -1, which in a TUI row means the preview never arrived.
  local preview_ms=-
  local best_anon=0 best_uss=0 last_entrant=0 last_tree=0 last_desc=0 last_helper=0
  local cold_pss=- cold_drm=- cold_child_pss=- cold_sample_ms=- memory_wait

  HELPER_COMM=$6
  HELPER_TOKEN=$7
  HELPER_PID=""
  HELPER_POLLS_LEFT=0
  HELPER_TICKS=0
  HELPER_DONE_TICKS=0
  HELPER_SIDE=""

  clean_bench
  # Above drop_caches, not below it: arming the watch walks /tmp and opens the fixture directory, so
  # the cache that costs has to be dropped with everything else rather than handed to this entrant.
  [ "$DROP_THUMBS" = yes ] && { [ "$id" = "$TRANSIENT_ID" ] || [[ $id = strata-nightly* ]]; } && watch_start "$id"
  # PRE_LAUNCH evens out gvfsd's own listing memory, which drop_caches never reaches.
  if [ -n "${PRE_LAUNCH:-}" ]; then bash -c "$PRE_LAUNCH" > /dev/null 2>&1 || fail "PRE_LAUNCH failed: $PRE_LAUNCH"; fi
  # The build's own list is in place before its launch, and the cache drop below does not touch it.
  case $id in
    flea|flea-tui) prefetch_for "$FLEA_PREFETCH_SLOT" ;;
    flea-anchor|flea-tui-anchor) prefetch_for "$ANCHOR_PREFETCH_SLOT" ;;
  esac
  drop_caches
  drop_thumbs
  if [ "$FIELD_PROFILE" = engine ]; then sleep 3; fi

  # Only a rows probe runs kitty with --dump-bytes, which parses through Python for every drawn character and command.
  TUI_DUMP_FLAG=""
  # kitty writes its dump from the start of the file, but a dump left by the last probe would name rows before this one drew any.
  if [ "$kind" = tui ] && [ "$RUN_MODE" = rows ]; then : > "$TUI_DUMP"; TUI_DUMP_FLAG="--dump-bytes $TUI_DUMP"; fi
  # kitty writes every byte its child sends into the dump; on a disk-backed directory that would count as the probe's own writes.
  [ -n "$TUI_DUMP_FLAG" ] && [ "$TUI_CONF_FS" != tmpfs ] && fail "$TUI_CONF is $TUI_CONF_FS, not tmpfs, so kitty's dump would add disk writes to the TUI probe"
  # The last step before the clock: a launch never starts on a disk that is still writing, and the row says whether it did.
  write_guard_pre || fail "the write guard could not read $FIELD_MEMINFO or $FIELD_VMSTAT, so this launch cannot be called clean"

  NET_RX0=$(net_rx_bytes "$NET_IFACE")
  # Baselines are per daemon, so a lost daemon cannot hide in a sum.
  mount_ticks_start
  # A leaf of this run's own, entered by the launching shell before it forks the entrant, so the entrant and everything it ever starts are in it.
  local leaf="$BENCH_CG/run-$id-$RUN_INDEX"
  [ "$RERUN_N" = 0 ] || leaf="$leaf-r$RERUN_N"
  [ "$RUN_MODE" = rows ] && leaf="$leaf-rows"
  mkdir "$leaf" || fail "could not make the control group $leaf"
  RUN_CG=$leaf
  if [ "$FIELD_PROFILE" = engine ]; then
    MAP_EVENT="$TUI_CONF/map-event"
    rm -f -- "$MAP_EVENT" "$MAP_EVENT.ready"
    "$HARNESS_DIR/flea-bench-gate" map-event "$MAP_EVENT" "$class" "$(( LAUNCH_TIMEOUT_MS / 1000 ))" &
    MAP_PID=$!
    for (( map_poll=0; map_poll<200; map_poll++ )); do
      [ -f "$MAP_EVENT.ready" ] && break
      kill -0 "$MAP_PID" 2>/dev/null || fail "the map event reader exited before arming"
      sleep 0.01
    done
    [ -f "$MAP_EVENT.ready" ] || fail "the map event reader did not arm"
  fi
  ENTRANT_LAUNCHED=yes
  now_ms; t0=$NOW_MS
  deadline=$(( t0 + LAUNCH_TIMEOUT_MS ))
  { printf '%s\n' "$BASHPID" > "$RUN_CG/cgroup.procs" \
      || { printf 'FAIL: could not join %s, so %s was not launched\n' "$RUN_CG" "$id" >&2; exit 1; }
    export FLEA_FIELD_BENCH=$BENCH_TOKEN
    eval "$shift_cmd" >/dev/null 2>&1; } &

  # A TUI row's window belongs to its terminal, which the class this run gives it already names.
  local owner_comm=$comm owner_token=$token
  if [ "$kind" = tui ]; then
    owner_comm=$TUI_TERM
    owner_token="--class $TUI_CLASS"
  fi
  local first_rows=-
  WINDOW_PID=""
  ROWS_PID=""
  if [ "$kind" = tui ] && [ "$RUN_MODE" = rows ]; then
    first_rows=-1
    : > "$TUI_CONF/.first-rows"
    { tui_first_rows "$t0" "$deadline"; printf '%s\n' "$FIRST_ROWS_MS" > "$TUI_CONF/.first-rows"; } &
    ROWS_PID=$!
  elif [ "$kind" = tui ]; then
    first_rows=$FIRST_ROWS_PROBE
  fi
  if [ "$class" != "-" ]; then
    wait_for_window "$class" "$deadline" "$owner_comm" "$owner_token" && mapped=$(( NOW_MS - t0 ))
  fi
  if [ "$FIELD_PROFILE" = engine ]; then
    wait "$MAP_PID" || fail "no matching openwindow event arrived"
    MAP_PID=""
    read -r map_stamp map_address < "$MAP_EVENT" || fail "no map event timestamp"
    mapped=$(( map_stamp - t0 ))
    [ "$mapped" -ge 0 ] && window_owned "$WINDOW_PID" "$owner_comm" "$owner_token" \
      || fail "map event did not belong to this launch"
    map_owner=$(LC_ALL=C.UTF-8 LANGUAGE= hyprctl -j clients | LC_ALL=C.UTF-8 LANGUAGE= jq -r --arg address "0x$map_address" '.[] | select(.address == $address) | .pid')
    [ "$map_owner" = "$WINDOW_PID" ] || fail "map event address belongs to another window"
  fi
  if [ -n "$ROWS_PID" ]; then
    wait "$ROWS_PID"
    ROWS_PID=""
    read -r first_rows < "$TUI_CONF/.first-rows" || first_rows=-1
    # Rows in the terminal before its window maps are not on screen yet, and a window that never mapped showed none.
    if [ "$mapped" -lt 0 ]; then first_rows=-1; elif [ "$first_rows" -ge 0 ] && [ "$mapped" -gt "$first_rows" ]; then first_rows=$mapped; fi
    [ "$first_rows" -lt 0 ] && [ "$mapped" -ge 0 ] && echo "$id run $RUN_INDEX: no fixture entry name reached kitty's output by the deadline, so first_rows_ms is -1" >&2
  fi
  if [ "$RUN_MODE" = rows ]; then
    FIRST_ROWS_PROBE=$first_rows
    watch_kill; clean_bench; release_run_cg
    return 0
  fi

  wait_for_pid "$comm" "$token" "$deadline" || { watch_kill; printf '%s,%s,ERROR,no-process\n' "$id" "$RUN_INDEX"; clean_bench; release_run_cg; return 1; }
  pid=$ENTRANT_PID
  entrant_cg "$pid" "$kind" \
    || fail "$id pid $pid is not in its control group $RUN_CG, so its CPU column would count nothing"

  while :; do
    if ! settle_ticks "$pid"; then break; fi
    now_ms
    last_entrant=$ENTRANT_TICKS
    last_tree=$TREE_TICKS
    last_helper=$HELPER_TICKS
    if [ "$TREE_TICKS" -ne "$last_settle" ]; then
      last_settle=$TREE_TICKS
      last_change=$NOW_MS
    else
      # The walk costs a read per thread and per descendant, so it runs only on a poll the watched set earned no tick on.
      descendant_ticks
      # last_desc starts at 0 and not at -1, or an entrant with no descendants is stamped once for free and every settle in the field carries a spare poll.
      if [ "$DESC_TICKS" -ne "$last_desc" ]; then
        last_desc=$DESC_TICKS
        last_change=$NOW_MS
      fi
    fi
    if pss_kb "$pid" && [ "$PSS_KB" -gt "$best_pss" ]; then
      best_pss=$PSS_KB; best_anon=$PSS_ANON_KB; best_uss=$USS_KB
    fi
    if [ "$FIELD_PROFILE" = engine ] && [ "$cold_sample_ms" = - ] && [ "$NOW_MS" -ge "$(( t0 + mapped + 3000 ))" ]; then
      cold_sample_ms=$(( NOW_MS - t0 - mapped ))
      engine_memory_sample "$pid"
      cold_pss=$COLD_PSS; cold_drm=$COLD_DRM; cold_child_pss=$COLD_CHILD_PSS
    fi
    if [ "$last_change" -gt 0 ] && [ $(( NOW_MS - last_change )) -ge "$SETTLE_GAP_MS" ]; then
      settled=$(( last_change - t0 ))
      break
    fi
    [ "$NOW_MS" -gt "$deadline" ] && { settled=-1; break; }
    sleep "$POLL_SLEEP"
  done
  # The measurement is over: what the disk wrote during the launch, read before anything below can write.
  write_guard_launch_end || fail "the write guard could not read $FIELD_VMSTAT at the end of the launch"

  # n/a and not 0: a run that never counted must stay tellable from one that counted and found none.
  local cpu_s cpu_main_s cpu_tree_s cpu_sys_s cpu_reaped_s helper_add=0 child_pss=0 thumbs_n=n/a thumbs_dirs=- thumbs_fmt=- ranked=yes
  # drm-resident-system0 is RAM that PSS cannot see, read once after settle because fdinfo is too costly to poll.
  drm_kb "$pid"
  # cpu.stat counts microseconds and /proc/<pid>/stat counts USER_HZ ticks, 100 a second on this kernel.
  local usec_per_second=1000000 ticks_per_second=100
  cpu_main_s=$(LC_ALL=C.UTF-8 LANGUAGE= awk -v t="$last_entrant" -v hz="$ticks_per_second" 'BEGIN { printf "%.2f", t / hz }')
  # The old reading, kept so a table from before the leaf can still be compared: a sandboxed decode never reaches it, see AGENTS.md "Testing".
  cpu_reaped_s=$(LC_ALL=C.UTF-8 LANGUAGE= awk -v t="$last_tree" -v hz="$ticks_per_second" 'BEGIN { printf "%.2f", t / hz }')
  cgroup_usage_usec "$RUN_CG" || fail "no usage_usec in $RUN_CG/cpu.stat, so this row has no CPU column"
  local run_usec=$CG_USEC
  # Read at settle and not at launch: kitty's move can land after the launch check, and its scope leaves with the child.
  if [ "$kind" = tui ]; then
    entrant_cg "$pid" "$kind" || fail "$id pid $pid is in no control group of this run at settle, so its CPU column would lose its own share"
    if [ "$ENTRANT_CG" != "$RUN_CG" ]; then
      cgroup_usage_usec "$ENTRANT_CG" || fail "no usage_usec in $ENTRANT_CG/cpu.stat, so this row has no CPU column"
      run_usec=$(( run_usec + CG_USEC ))
    fi
  fi
  [ "$HELPER_SIDE" = outside ] && helper_add=$last_helper
  cpu_tree_s=$(LC_ALL=C.UTF-8 LANGUAGE= awk -v u="$run_usec" -v us="$usec_per_second" -v t="$helper_add" -v hz="$ticks_per_second" 'BEGIN { printf "%.2f", u / us + t / hz }')
  cpu_s=$cpu_tree_s
  if [ "$FIELD_PROFILE" = engine ] && [ "$cold_sample_ms" = - ]; then
    now_ms
    memory_wait=$(( t0 + mapped + 3000 - NOW_MS ))
    [ "$memory_wait" -le 0 ] || sleep "$(LC_ALL=C.UTF-8 LANGUAGE= awk -v ms="$memory_wait" 'BEGIN {print ms / 1000}')"
    now_ms; cold_sample_ms=$(( NOW_MS - t0 - mapped ))
    engine_memory_sample "$pid"
    cold_pss=$COLD_PSS; cold_drm=$COLD_DRM; cold_child_pss=$COLD_CHILD_PSS
  fi
  if mount_ticks_delta; then
    cpu_sys_s=$(sys_seconds "$cpu_tree_s" "$MOUNT_DTICKS" "$ticks_per_second")
  else
    cpu_sys_s=unmeasurable
    printf 'MOUNT %s %s: gvfs daemon %s was not readable for the whole run, so cpu_sys_s is unmeasurable\n' "$id" "$RUN_INDEX" "$MOUNT_LOST" >&2
  fi
  # Evidence that the media run actually exercised thumbnail generation, not just a warm cache.
  if [ "$DROP_THUMBS" = yes ]; then
    count_thumbs
    thumbs_n=$THUMBS_N
    thumbs_dirs=$THUMBS_BY_DIR
    if [ "$id" = "$TRANSIENT_ID" ] || [[ $id = strata-nightly* ]]; then
      # The cache reading above stays in thumbs_by_dir, where it is a true statement about the cache
      # and a false one about this entrant; the count and the formats come off the live watch.
      watch_stop "$id"
      # A count the watches cannot vouch for leaves this row unranked rather than ending every row after it.
      if [ -n "$WATCH_REFUSED" ]; then
        thumbs_n=unmeasurable
        thumbs_fmt=unmeasurable
        ranked="unranked: $WATCH_REFUSED"
        printf 'UNRANKED: %s %s, so its work was not measured and its time is not a result\n' "$id" "$WATCH_REFUSED" >&2
      else
        thumbs_n=$WATCH_N
        thumbs_fmt=$(watch_classify)
      fi
    else
      capture_keys "$id"
      thumbs_fmt=$("$HARNESS_DIR/flea-bench-keys" classify "$KEY_MAP" "$KEYS_FILE")
    fi
    # A nas or usb run may go on without a key map, so its formats are unknown, never "no fixture file".
    [ "${KEY_MAP_OK:-yes}" = yes ] || [ "$thumbs_fmt" = unmeasurable ] || thumbs_fmt=unclassified
    if [ "$kind" = tui ]; then
      # A TUI previews the cursor file, it never fills a grid, and the terminal decides whether it
      # can draw an image at all. A 0 here reads as a slow thumbnailer and it is neither slow nor a
      # thumbnailer, so the column says so and names the terminal that would have had to draw it.
      thumbs_n=n/a
      thumbs_fmt=n/a
      ranked="n/a: tui in $TUI_TERM"
    elif [ "$thumbs_n" = 0 ]; then
      # This is the live watch's count for transient entrants, the cache count for everyone else.
      # Neither zero proves media work. Only the report's verified synthetic fixture permits it.
      thumbs_n=unmeasurable
      thumbs_fmt=unmeasurable
      ranked="unranked: no thumbnail work was measured"
      printf 'UNRANKED: %s produced no measured thumbnails, so its time is not a media result\n' "$id" >&2
    elif [ "$ranked" = yes ] && [ "${KEY_MAP_OK:-yes}" = yes ] && [ "$(known_formats "$thumbs_fmt")" = 0 ]; then
      # The count stays as read; none of it is a fixture file, so it is not this fixture's media work.
      ranked="unranked: none of its thumbnails were of a fixture file"
      printf 'UNRANKED: %s rendered %s thumbnails and none of a fixture file, so its time is not a media result\n' "$id" "$thumbs_n" >&2
    fi
    # A media run that never mapped or never settled stopped part way, so its count is of unfinished work.
    if [ "$kind" != tui ] && [ "$ranked" = yes ]; then
      if [ "$mapped" -lt 0 ]; then
        ranked="unranked: its window never mapped so its media work did not finish"
      elif [ "$settled" -lt 0 ]; then
        ranked="unranked: it never settled so its media work did not finish"
      fi
      [ "$ranked" = yes ] || printf 'UNRANKED: %s run %s %s\n' "$id" "$RUN_INDEX" "${ranked#unranked: }" >&2
    fi
  fi

  # A second launch, after every number above is taken, so the settle pass is never measured under
  # a screen capture. A GUI entrant is judged on its thumbnails and never comes here.
  if [ "$kind" = tui ]; then
    measure_preview "$id" "$shift_cmd"
    preview_ms=$PREVIEW_MS
  fi

  if [ -n "$HELPER_COMM" ]; then
    pids_for "$HELPER_COMM" "$HELPER_TOKEN"
    for child_pid in "${PIDS[@]}"; do
      pss_kb "$child_pid" || fail "cannot read helper PSS"
      child_pss=$(( child_pss + PSS_KB ))
    done
  fi

  # To the log, never a CSV column, so no parser moves.
  if [ -n "$NET_IFACE" ]; then
    printf 'NET %s %s %s\n' "$id" "$RUN_INDEX" "$(( ($(net_rx_bytes "$NET_IFACE") - NET_RX0) / 1048576 ))" >&2
  fi
  # A contaminated row stays in the CSV and never ranks: the cell says why, and the columns carry the numbers.
  ranked=$(write_guard_ranked "$ranked")
  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' "$id" "$RUN_INDEX" "$mapped" "$settled" "$best_pss" "$cpu_s" "$child_pss" "$thumbs_n" "$best_anon" "$best_uss" "$DRM_KB" "$thumbs_dirs" "$cpu_tree_s" "$thumbs_fmt" "$ranked" "$preview_ms" "$cpu_reaped_s" "$cpu_sys_s" "$WG_DIRTY_WB_KB" "$WG_PGPGOUT_PRE_KB" "$WG_PGPGOUT_LAUNCH_KB" "$WG_CLEAN" "$RERUN_N" "$first_rows" "$cpu_main_s" "$cold_pss" "$cold_drm" "$cold_child_pss" "$cold_sample_ms" "$LAUNCH_POS"
  clean_bench
  release_run_cg
}

# Two checks, because one count cannot do both jobs. The payload is what the fixture is for, and a
# bare ls would hide a stray dotfile from a check whose whole job is to refuse an altered fixture,
# so the dotfiles are judged by NAME rather than folded into a total nobody can re-derive.
case $FIXTURE_KIND in ""|nas|usb) ;; *) fail "FIXTURE_KIND=$FIXTURE_KIND names no known fixture kind (nas, usb)" ;; esac
