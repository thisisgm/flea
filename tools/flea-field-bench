# strata provenance begin
# STRATA_SRC defaults to the cargo target/release tree that built STRATA_BIN; the binary must report that tree's version exactly.
# Sample input: Cargo.toml has version = "1.0.0", and STRATA_BIN --version prints "strata 1.0.0".
strata_provenance() {
  local ver out
  if [ -z "${STRATA_SRC:-}" ]; then
    case $STRATA_BIN in
      */target/release/strata) STRATA_SRC=${STRATA_BIN%/target/release/strata} ;;
      *) fail "STRATA_BIN=$STRATA_BIN is not in a cargo target/release, so the tree it was built from is unknown: set STRATA_SRC" ;;
    esac
  fi
  [ -f "$STRATA_SRC/Cargo.toml" ] || fail "STRATA_SRC=$STRATA_SRC has no Cargo.toml, so it is not the tree that built $STRATA_BIN"
  ver=$(LC_ALL=C.UTF-8 LANGUAGE= sed -n 's/^version = "\(.*\)"$/\1/p' "$STRATA_SRC/Cargo.toml" | head -1)
  [ -n "$ver" ] || fail "$STRATA_SRC/Cargo.toml names no version, so STRATA_SRC cannot be checked against $STRATA_BIN"
  out=$(LC_ALL=C.UTF-8 LANGUAGE= "$STRATA_BIN" --version 2>&1 | head -1) || true
  [ "${out##* }" = "$ver" ] \
    || fail "$STRATA_BIN reports '${out:-nothing}', not version $ver of STRATA_SRC=$STRATA_SRC, so the manifest would name the wrong source"
  export STRATA_SRC
}
