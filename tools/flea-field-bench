# Everything this run made and nothing else: parks go back and only this run's marked mktemp dirs are removed.
bench_cleanup() {
  # A prior nonzero exit stands; a failed teardown step is itself the nonzero result only when nothing failed before it.
  local prior=$? cleanup_rc=0
  stop_warm_job || cleanup_rc=1
  # A run that fails mid-entrant ends that entrant here, or it stays resident through every run after it.
  watch_kill
  if [ -n "${MAP_PID:-}" ]; then kill "$MAP_PID" 2>/dev/null || true; wait "$MAP_PID" 2>/dev/null || true; fi
  [ -n "$ROWS_PID" ] && kill "$ROWS_PID" 2>/dev/null
  # Subshells, because each of these can fail and an exit inside this trap would skip every step after it.
  if [ -n "$ENTRANT_LAUNCHED" ]; then ( clean_bench ) || cleanup_rc=1; fi
  if [ -d "$BENCH_CG/run-warm" ]; then ( warm_stop "$BENCH_CG/run-warm" ) || cleanup_rc=1; fi
  release_run_cg || cleanup_rc=1
  ( restore_thumbs ) || cleanup_rc=1
  # Keeps the list of the build that ran last, before the operator's list comes back over the shared path.
  ( prefetch_keep ) || cleanup_rc=1
  ( restore_prefetch ) || cleanup_rc=1
  case ${TUI_CONF:-} in "") ;; *) safe_rm_tmpdir "$TUI_CONF" "TUI config" || cleanup_rc=1 ;; esac
  case ${FLEA_STATE:-} in "${BENCH_TMP_ROOT:-/tmp}"/flea-bench-state.*) safe_rm_tmpdir "$FLEA_STATE" "Flea state" || cleanup_rc=1 ;; "") ;; *) printf 'WARNING: not removing Flea state path %s, it is not the mktemp directory this run made\n' "$FLEA_STATE" >&2; cleanup_rc=1 ;; esac
