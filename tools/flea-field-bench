# Removes one directory this run made: absolute, two deep, a real directory and not a symlink, marked by this run.
safe_rm_tmpdir() {
  local dir=$1 kind=$2 mark
  case ${dir:-} in /*/*) ;; *) printf 'WARNING: not removing %s path %s, it is not an absolute path two deep\n' "$kind" "${dir:-}" >&2; return 1 ;; esac
  [ -e "$dir" ] || return 0
  [ -L "$dir" ] && { printf 'WARNING: not removing %s path %s, it is a symlink\n' "$kind" "$dir" >&2; return 1; }
  [ -d "$dir" ] || { printf 'WARNING: not removing %s path %s, it is not a directory\n' "$kind" "$dir" >&2; return 1; }
  [ -f "$dir/$PERF_TMP_MARK" ] || { printf 'WARNING: not removing %s path %s, it carries no marker\n' "$kind" "$dir" >&2; return 1; }
  [ -L "$dir/$PERF_TMP_MARK" ] && { printf 'WARNING: not removing %s path %s, its marker is a symlink\n' "$kind" "$dir" >&2; return 1; }
  mark=$(cat "$dir/$PERF_TMP_MARK" 2>/dev/null) || { printf 'WARNING: not removing %s path %s, its marker is unreadable\n' "$kind" "$dir" >&2; return 1; }
  [ "$mark" = "owner=$$" ] || { printf 'WARNING: not removing %s path %s, its marker names another owner\n' "$kind" "$dir" >&2; return 1; }
  rm -rf "$dir" || { printf 'WARNING: could not remove %s path %s\n' "$kind" "$dir" >&2; return 1; }
}
