    TUI_CONFIG_DIR="$TUI_CONF" PREVIEW_TARGET="$PREVIEW_TARGET" \
    BENCH_IDLE_WAITED="$BENCH_IDLE_WAITED" FIXTURE_KIND="$FIXTURE_KIND" \
    SETTLE_GAP_MS="$SETTLE_GAP_MS" SETTLE_WATCH_PIDS="${MOUNT_PIDS[*]:-none}" NET_IFACE="$NET_IFACE" \
    LAUNCH_ORDER="$LAUNCH_ORDER" DROP_THUMBS="$DROP_THUMBS" \
    "$MANIFEST_TOOL" "$MANIFEST" "$FIXTURE" \
  || fail "the manifest did not write, so this run would produce numbers nobody can cite"
echo "manifest: $MANIFEST"

# Only a run that drops the cache produces a comparable key set, and on the 100k fixture this map
# would be 100k md5 calls for a question that run does not ask.
mkdir -p "$KEYS_DIR" || fail "could not make the key directory at $KEYS_DIR"
if [ "$DROP_THUMBS" = yes ]; then
  KEY_MAP_OK=yes
  "$HARNESS_DIR/flea-bench-keys" map "$FIXTURE" "$KEY_MAP" \
    || { KEY_MAP_OK=no; [ -n "$FIXTURE_KIND" ]; } || fail "the fixture key map did not build, so no thumbnail count in this run could be classified"
  echo "key map: $KEY_MAP, $(wc -l < "$KEY_MAP") keys"
fi

# warm jobs begin
# Monitor mode gives each warm shell its own process group; its foreground setup children stay in that group with monitor mode off.
if [ "${FIELD_FRONTEND:-qml}" = qml ] && only_has flea; then
  prefetch_for "$FLEA_PREFETCH_SLOT"
  ENTRANT_LAUNCHED=yes
  set -m
  WARM_PREVIOUS_PID=${!:-}
  WARM_STARTING=yes
  ( set +m; warm_qml_cache ) &
  WARM_PID=$!
  WARM_STARTING=""
  set +m
  wait "$WARM_PID" || exit 1
  WARM_PID=""
fi
if [ "$WITH_ANCHOR" = yes ] && only_has flea-anchor; then
  prefetch_for "$ANCHOR_PREFETCH_SLOT"
  ENTRANT_LAUNCHED=yes
  set -m
  WARM_PREVIOUS_PID=${!:-}
  WARM_STARTING=yes
  ( set +m; FLEA_FRONTEND=qml FLEA_BIN=$ANCHOR_BIN FLEA_UI=$ANCHOR_UI FLEA_QMLCACHE=$ANCHOR_QMLCACHE FLEA_STATE=$ANCHOR_STATE warm_qml_cache ) &
  WARM_PID=$!
  WARM_STARTING=""
  set +m
  wait "$WARM_PID" || exit 1
  WARM_PID=""
fi

# warm jobs end

# entrant runs begin
# Every row names a kind that launches, so a typo row fails here rather than vanishing from every run.
for row in "${ENTRANTS[@]}"; do IFS='|' read -r _ row_kind _ <<< "$row"; case $row_kind in gui|tui) ;; *) fail "an entrant row has a kind other than gui or tui, so it would never launch";; esac; done
for RUN_INDEX in $(seq 1 "$RUNS"); do
  mapfile -t RUN_ORDER < <(run_order "$RUN_INDEX")
  for line in "${RUN_ORDER[@]}"; do
    read -r i LAUNCH_POS <<< "$line"
    IFS='|' read -r id kind class comm token helper_comm helper_token cmd <<< "${ENTRANTS[$i]}"
    only_has "$id" || continue
    # An absent entrant is named and skipped, never silently dropped from the table, see hard rule 7.
    if [ "$id" = flea ] && [ "$FIELD_FRONTEND" = gpui ]; then
      [ -x "${FLEA_BIN%/*}/flea-gui" ] || fail "flea-gui is missing"
    elif [ "$id" = flea-tui ]; then
      [ -x "${FLEA_BIN:-}" ] || fail "required entrant executable is absent: $id"
    elif [ "$id" = flea-tui-anchor ]; then
      [ -x "${ANCHOR_BIN:-}" ] || fail "required entrant executable is absent: $id"
    elif [ "$id" = strata-nightly ]; then
      [ -x "$STRATA_NIGHTLY_BIN" ] || { fail 'Strata nightly is missing'; }
    elif [ "$id" = strata-nightly-channel ]; then
      [ -x "$STRATA_NIGHTLY_CHANNEL_BIN" ] || { fail 'additional Strata channel is missing'; }
    elif [ "$id" = strata-stable ]; then
      [ -x "$STRATA_BIN" ] || { fail "Strata stable is missing: $STRATA_BIN"; }
    else
      command -v "$comm" >/dev/null 2>&1 || { fail "required entrant is absent: $id"; }
    fi
    run_guarded "$id" "$kind" "$class" "$comm" "$token" "$helper_comm" "$helper_token" "$cmd"
  done
done

# entrant runs end

clean_bench
restore_thumbs
# In this shell, not a subshell: it clears PREFETCH_ARM, so the EXIT trap never copies the operator's list into a slot.
prefetch_keep
restore_prefetch
# Every row is in the CSV; this names how many of each entrant's rows the ranks may use.
write_guard_summary "$OUT"
# What the run turned out to be: the capability each entrant demonstrated, and every row this
# harness refuses to rank, written where the versions are rather than left for a reader to infer.
"$MANIFEST_TOOL" "$MANIFEST" close "$OUT" \
  || fail "manifest did not close; results remain unaccepted"
echo "done, results in $OUT"
