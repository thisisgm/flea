def journeys_of(sessions):
    """Every journey id a part's sessions time, for the dry check and the selftest."""
    out = set()
    for s in sessions:
        v = s.get("view")
        for sp in s.get("series", []):
            t = sp["type"]
            if t == "pairs":
                for a, b in sp["pairs"]:
                    out |= {"nav.%s.%s" % (v, CHORD_NAMES[a]), "nav.%s.%s" % (v, CHORD_NAMES[b])}
            elif t in ("scroll", "wheel", "fling"):
                out.add("nav.%s.%s" % (v, {"scroll": "down-scroll"}.get(t, t)))
            elif t == "held":
                out.add("nav.%s.held-j-sweep" % v)
            elif t == "cycle":
                for st in sp["steps"]:
                    if st.get("journey"):
                        out.add(st["journey"])
                        if sp.get("first_suffix"):
                            out.add(st["journey"] + sp["first_suffix"])
            elif t == "views":
                out |= {"view.switch.%s-%s" % p for p in zip(VIEW_CIRCUIT, VIEW_CIRCUIT[1:])}
            elif t == "land":
                out |= {"open.cols-preview.%s%s" % (kk, x) for kk in sp["kinds"] for x in ("", ".first")}
            elif t == "ql":
                out |= {"open.ql.%s%s" % (kk, x) for kk in sp["kinds"] for x in ("", ".first")}
            elif t == "search":
                out.add("search.type-to-first-result")
            elif t == "op":
                out.add(sp["op"])
    return out


def journey_filter(pattern):
    """A predicate over journey ids for --only REGEX (re.search); None keeps every journey. A bad regex is a usage error."""
    if pattern is None:
        return lambda journey: True
    try:
        rx = re.compile(pattern)
    except re.error as e:
        print("--only %r is not a regular expression: %s" % (pattern, e), file=sys.stderr)
        raise SystemExit(2)
    return lambda journey: rx.search(journey) is not None


def only_series(sessions, pattern):
    """The sessions cut to the series with a journey that matches pattern; a session left with none is dropped."""
    keep = journey_filter(pattern)
    out = []
    for s in sessions:
        series = [sp for sp in s.get("series", []) if any(keep(j) for j in journeys_of([dict(s, series=[sp])]))]
        if series:
            out.append(dict(s, series=series))
    return out


