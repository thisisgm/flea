PLAN_FX = {"root": "/home/flea-sandbox/x", "nav": {"nav500": 500}, "usb": "/run/media/u/s/flea-instant-1",
           "nas": "/run/user/1/gvfs/n/f-2"}


def planned_counts(part, samples=20, fx=None, only=None):
    """Rows per (journey, view, fixture) one part writes at samples; the minima gate checks. only: a --only REGEX."""
    out = {}

    def add(journey, view, fixture, n):
        out[(journey, view, fixture)] = out.get((journey, view, fixture), 0) + n

    for s in parts(fx or PLAN_FX, samples).get(part, []):
        if s.get("missing") or not s.get("series"):
            continue
        view, n, where = s.get("view"), s.get("n", samples), s.get("where", "local")
        fixture = where + ("+load-" + s["load"] if s.get("load") else "")
        for sp in s["series"]:
            t = sp["type"]
            r = SERIES_ROWS_PER_SAMPLE[t]
            if t == "pairs":
                for a, b in sp["pairs"]:
                    add("nav.%s.%s" % (view, CHORD_NAMES[a]), view, fixture, n * r)
                    add("nav.%s.%s" % (view, CHORD_NAMES[b]), view, fixture, n * r)
            elif t == "scroll":
                add("nav.%s.down-scroll" % view, view, fixture, n * r)
            elif t == "wheel":
                add("nav.%s.wheel" % view, view, fixture, n * r)
            elif t == "fling":
                add("nav.%s.fling" % view, view, fixture, n * r)
            elif t == "held":
                add("nav.%s.held-j-sweep" % view, view, fixture, n * r)
            elif t == "search":
                add("search.type-to-first-result", view, fixture, n * r)
            elif t == "views":
                for a, b in zip(VIEW_CIRCUIT, VIEW_CIRCUIT[1:]):
                    add("view.switch.%s-%s" % (a, b), view, fixture, n * r)
            elif t == "cycle":
                for st in sp["steps"]:
                    if not st.get("journey"):
                        continue
                    if sp.get("first_suffix"):
                        add(st["journey"], view, fixture, n * r - FIRST_ROWS)
                        add(st["journey"] + sp["first_suffix"], view, fixture, FIRST_ROWS)
                    else:
                        add(st["journey"], view, fixture, n * r)
            elif t == "land":
                for kk in sp["kinds"]:
                    add("open.cols-preview.%s" % kk, view, fixture, n * r)
                    add("open.cols-preview.%s.first" % kk, view, fixture, FIRST_ROWS)
            elif t == "ql":
                for kk in sp["kinds"]:
                    add("open.ql.%s" % kk, view, fixture, n * r)
                    add("open.ql.%s.first" % kk, view, fixture, FIRST_ROWS)
            elif t == "op":
                add(sp["op"], view, fixture, n * r)
    keep = journey_filter(only)
    return {key: n for key, n in out.items() if keep(key[0])}


