def k(*chord):
    return ("key", chord)


def cyc(steps, **kw):
    return dict({"type": "cycle", "steps": steps}, **kw)


def open_close(journey, key_in, close=("esc",)):
    return cyc([{"journey": journey, "in": key_in}, {"in": k(*close), "quiet": 1.0, "cap": 3}])


RENAME_PAIRS = 3  # j and k pairs timed in a row on each side of the rename
RENAME_LETTERS = ("a", "b")  # typed at the end of the stem, so the new name sorts into the old name's slot
NAV500_NAME = "f_%04d.txt"  # tools/flea-nav-fixture's name for file i of nav500


def rename_cycle(view, names):
    """p8-rename for one view: j and k pairs, the cursor row renamed, the same pairs again, the rename undone."""
    def pairs(side):
        return [{"journey": "nav.%s.%s-rename-%s" % (view, side, key), "in": k(key)}
                for _ in range(RENAME_PAIRS) for key in ("j", "k")]

    def edit(*keys):
        typed = [{"in": k(c), "quiet": 0.3, "cap": 2} for c in keys]
        return [{"in": k("r")}, {"in": k("right")}] + typed + [{"in": k("enter")}]
    undo = ("backspace",) * len(RENAME_LETTERS)
    return cyc(pairs("pre") + edit(*RENAME_LETTERS) + pairs("after") + edit(*undo),
               setup=[k("ctrl", "d")] * 3, restores=names, typed="".join(RENAME_LETTERS))


def enter_back(view, fixture="local"):
    return cyc([{"journey": "nav.%s.enter" % view, "in": k("enter")},
                {"journey": "nav.%s.back" % view, "in": k("backspace")}], to_folder=True, fixture=fixture)


