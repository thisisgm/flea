def files(d, n, fmt, size):
    os.makedirs(d, exist_ok=True)
    blob = os.urandom(size) if size else b""
    for i in range(n):
        with open(os.path.join(d, fmt % i), "wb") as f:
            f.write(blob)


def random_file(path, mib):
    with open(path, "wb") as f:
        for _ in range(mib):
            f.write(os.urandom(1 << 20))


def new_root(parent):
    """A fresh mktemp -d under parent with the marker; the shared flea-perf bench fixture is refused."""
