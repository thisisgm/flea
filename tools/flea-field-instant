def series_search(sess, spec, n):
    """search.type-to-first-result: f opens the search, the query is typed at 150 ms a key, the final key is timed."""
    rows = sess.taken
    for i in range(n * SERIES_ROWS_PER_SAMPLE["search"]):
        sess.send(("key", ("f",)))
        sess.settle(1.0, 3)
        times = S.type_keys(sess.keys, spec["query"], 0.15)
        sess.rec.wait_quiet(int(QUIET[4] * NS), times[-1], int(CAP[4] * NS))
        rows.append(sess.columns("search.type-to-first-result", times[-1], 4, extra={"query": spec["query"]}))
        sess.send(("key", ("esc",)))
        sess.settle(1.0, 3)
    return rows


def menu_to(sess, label):
    """Open the context menu on the cursor row and walk its cursor to label; False when the row is absent."""
    sess.send(("key", ("m",)))
    sess.settle(1.0, 3)
    entries = sess.ipc("contextMenuEntries").split("|")
    if label not in entries:
        sess.send(("key", ("esc",)))
        sess.settle(1.0, 3)
        return False
    want = entries.index(label)
    for _ in range(len(entries) + 2):
        if sess.ipc_int("contextMenuCursor") == want:
            return True
        sess.keys.chord("down")
        time.sleep(0.1)
    return sess.ipc_int("contextMenuCursor") == want


def wait_until(pred, cap_s):
    t0 = time.monotonic()
    while time.monotonic() - t0 < cap_s:
        if pred():
            return round(time.monotonic() - t0, 2)
        time.sleep(0.1)
    return None


# Op isolation: a sample starts on a status bar with no queued error and no activity, or it is an error row.
ISOLATE_PASTE_CAP_S = 20  # s a sample may spend dismissing queued errors before its input
ISOLATE_CANCEL_CAP_S = 60  # s a cancelled transfer may take to leave the activity list
ISOLATE_POLL_S = 0.3  # s between status reads, at most one Esc per read
ISOLATE_CANCEL_GAP_S = 5.0  # s before a cancel that left the transfer running is pressed again


def activity_state(sess):
    """statusActivityState (ui/Ipc.qml) as a dict, or None when the call gave nothing parseable."""
    try:
        got = json.loads(sess.ipc("statusActivityState"))
    except (ValueError, subprocess.TimeoutExpired):
        return None
    return got if isinstance(got, dict) else None


def busy_reason(state, escs):
    """What an unclear status bar still holds, for the error row."""
    if state is None:
        return "the status bar is not idle: statusActivityState gave no reading"
    if state.get("errors"):
        return "the status bar is not idle: %d queued errors after %d Esc" % (state["errors"], escs)
    acts = state.get("activities") or []
    return "the status bar is not idle: %d activities after %d Esc, the first %r" % (
        len(acts), escs, acts[0].get("text") if acts else "")


def isolate(read, esc, cap_s, poll_s=ISOLATE_POLL_S, now=None, sleep=None):
    """Esc until read() shows no queued error and no activity; (Esc count, last reading, why), why None when clear.

    Esc dismisses the oldest queued error before it cancels anything (ui/StatusBar.qml escapePressed), so errors are
    pressed away first, one Esc per read; a running transfer that is not already cancelling gets one cancel Esc, repeated
    after ISOLATE_CANCEL_GAP_S if it is still running. A read of None (the IPC call failed) is waited out like a busy bar."""
    now, sleep = now or time.monotonic, sleep or time.sleep
    t0, escs, cancelled_at, st = now(), 0, None, None
    while True:
        st = read()
        if st is not None:
            acts, errs = st.get("activities") or [], st.get("errors") or 0
            if not acts and not errs:
                return escs, st, None
            if errs:
                esc()
                escs += 1
            elif any(a.get("running") and not a.get("cancelling") for a in acts) and (
                    cancelled_at is None or now() - cancelled_at >= ISOLATE_CANCEL_GAP_S):
                esc()
                escs += 1
                cancelled_at = now()
        if now() - t0 >= cap_s:
            return escs, st, busy_reason(st, escs)
        sleep(poll_s)


def wait_idle(sess, cap_s):
    """(Esc count, idle reading) once the status bar is clear; a RuntimeError naming what stays when it is not."""
    escs, st, why = isolate(lambda: activity_state(sess), lambda: sess.keys.chord("esc"), cap_s)
    if why:
        raise RuntimeError(why)
    return escs, st


def cancel_op(sess):
    """Esc a transfer that outlived its wait and give it ISOLATE_CANCEL_CAP_S to leave the activity list."""
    escs, _, why = isolate(lambda: activity_state(sess), lambda: sess.keys.chord("esc"), ISOLATE_CANCEL_CAP_S)
    return dict({"cancel_escs": escs}, **({"cancel_failed": why} if why else {}))


def op_state_fields(before, after):
    """errors_before, errors_after, activity_after, notice_before, notice_after and refused of an op row, from two
    statusActivityState readings (None: no reading). refused is True when the paste left more queued errors than it found;
    notice_before is what the copy or cut before it said ("Copied 0 items" is a paste of nothing)."""
    eb = None if before is None else before.get("errors")
    ea = None if after is None else after.get("errors")
    acts = None if after is None else [{k: a.get(k) for k in ("text", "running", "cancelling")}
                                       for a in after.get("activities") or []]
    return {"errors_before": eb, "errors_after": ea, "activity_after": acts,
            "notice_before": None if before is None else before.get("notice"),
            "notice_after": None if after is None else after.get("notice"),
            "refused": None if eb is None or ea is None else ea > eb}


# Op navigation: a sample starts in the folder sample 0 started in, read off the pane, never assumed from keys sent blind.
LISTING_CAP_S = 10  # s a listing may take to land before a key is judged lost
NAV_STEPS = 6  # keys a walk back to the source or the destination may spend
TAKE_CAP_S = 5.0  # s the clipboard may take to hold the copied or cut paths
HARNESS_FAULTS_STOP = 3  # consecutive harness faults after which an op series stops
ROW_SCAN_CAP = 64  # rows row_index reads off the pane before it calls a row missing


class HarnessFault(RuntimeError):
    """The tool could not give a sample the state sample 0 started from: a row of its own, never a refusal or a miss."""


def listing_landed(sess, cap_s=None):
    """Wait until the pane has no listing in flight (listInFlight), since a key pressed before is refused (ui/js/Nav.js)."""
    cap_s = LISTING_CAP_S if cap_s is None else cap_s
    t0 = time.monotonic()
    while sess.ipc("listInFlight").strip().lower() != "false":
        if time.monotonic() - t0 >= cap_s:
            raise HarnessFault("the listing did not land in %g s" % cap_s)
        time.sleep(0.1)


def nav_key(sess, *chord):
    """One navigation key, sent only on a landed listing and followed by the listing it starts."""
    listing_landed(sess)
    sess.keys.chord(*chord)
    time.sleep(0.25)
    listing_landed(sess)


def same_dir(a, b):
    return bool(a) and os.path.realpath(a) == os.path.realpath(b)


def row_index(sess, name):
    """The listing index of the row called name, or None: a symlink to a folder is listed after the folders, so find it by name."""
    for i in range(min(sess.ipc_int("total") or 0, ROW_SCAN_CAP)):
        if sess.ipc("visibleRowName", i) == name:
            return i
    return None


def enter_row(sess, name):
    """Put the cursor on the row called name and press Enter, checking the cursor before it."""
    i = row_index(sess, name)
    if i is None:
        raise HarnessFault("no row %r in %s" % (name, sess.ipc("path")))
    nav_key(sess, "home")
    for _ in range(i):
        nav_key(sess, "down")
    if sess.ipc_int("cursor") != i:
        raise HarnessFault("the cursor is on row %s, not on %r (row %d)" % (sess.ipc("cursor"), name, i))
    nav_key(sess, "enter")


def reach(sess, want, base, via, kids):
    """Walk the pane to want: from a folder in kids Backspace climbs to base (Nav.js parent cuts the pane path), Enter on via goes down."""
    base_real = os.path.realpath(base)
    initial = sess.ipc("path")
    extra_parents = max(
        0, os.path.normpath(initial).count(os.sep) - os.path.normpath(base).count(os.sep) - 1,
        os.path.realpath(initial).count(os.sep) - base_real.count(os.sep) - 1)
    max_steps = NAV_STEPS + extra_parents
    for _ in range(max_steps):
        here = sess.ipc("path")
        if same_dir(here, want):
            return
        if same_dir(here, base):
            enter_row(sess, via)
        elif os.path.realpath(here) in kids or os.path.dirname(os.path.realpath(here)) == base_real:
            nav_key(sess, "backspace")
        else:
            raise HarnessFault("the pane is at %r, outside %s" % (here, base))
    here = sess.ipc("path")
    if same_dir(here, want):
        return
    raise HarnessFault("the pane did not reach %s in %d keys, it is at %r" % (want, max_steps, here))


def listed_total(sess, count, cap_s=None):
    """Wait until the pane lists exactly count rows: Flea has seen the folder the tool just filled or emptied."""
    cap_s = LISTING_CAP_S if cap_s is None else cap_s
    t0 = time.monotonic()
    while sess.ipc_int("total") != count:
        if time.monotonic() - t0 >= cap_s:
            raise HarnessFault("%s lists %s rows, not %d" % (sess.ipc("path"), sess.ipc("total"), count))
        time.sleep(0.1)


def clipboard_holds(sess, paths, moving, cap_s=None):
    """Wait until the pane clipboard (fileClipboard) holds exactly these paths, real, with the right verb."""
    cap_s = TAKE_CAP_S if cap_s is None else cap_s
    t0, got = time.monotonic(), None
    while True:
        try:
            got = json.loads(sess.ipc("fileClipboard"))
        except ValueError:
            got = None
        held = sorted(os.path.realpath(p) for p in got.get("paths") or []) if isinstance(got, dict) else None
        if held == sorted(os.path.realpath(p) for p in paths) and bool(got.get("moving")) == moving:
            return
        if time.monotonic() - t0 >= cap_s:
            raise HarnessFault("the clipboard holds %s paths (moving %s), not the %d of this sample (moving %s)" % (
                len(held) if held is not None else "no reading", got.get("moving") if held is not None else "-",
                len(paths), moving))
        time.sleep(0.1)


# Each op: its source under ROOT/ops, the chord that starts it, and whether its destination is on the USB stick.
OPS = {
    "op.copy.many": {"src": "src-many", "take": ("ctrl", "c"), "usb": False, "count": COPY_MANY},
    "op.copy.large": {"src": None, "file": "large.bin", "take": ("ctrl", "c"), "usb": False, "count": 1},
    "op.copy.long": {"src": None, "file": "long.bin", "take": ("ctrl", "c"), "usb": True, "count": 1, "long": True},
    "op.move.cross-fs": {"src": "src-move", "take": ("ctrl", "x"), "usb": True, "count": MOVE_FILES},
}


def series_op(sess, spec, n):
    """One op journey, n samples, each from a reset source and an idle status bar: the key that starts it to the first changed pixel."""
    name, roots, ctx = spec["op"], sess.ctx["roots"], sess.ctx
    base = ctx["op_base"]  # ROOT/ops/run/<op>, holding a-dst and b-src; Flea opens in b-src
    dst, src = os.path.join(base, "a-dst"), os.path.join(base, "b-src")
    rows = sess.taken
    for i in range(n * SERIES_ROWS_PER_SAMPLE["op"]):
        ev = "%s-%s-%d" % (ctx["tag"], name, i) if i < FIRST_ROWS and ctx.get("evidence") else None
        try:
            escs, before = wait_idle(sess, ISOLATE_PASTE_CAP_S)  # before any folder is emptied under a job that may still run
            if name in OPS:
                o = OPS[name]
                real_dst, real_src = os.path.realpath(dst), os.path.realpath(src)
                kids = (real_src, real_dst)
                reach(sess, real_src, base, "b-src", kids)  # sample 0 starts here; later samples are walked back
                empty_dir(real_dst, roots)
                empty_dir(src, roots)
                if o["src"]:
                    reflink(os.path.join(ctx["root"], "ops", o["src"], "."), src)
                else:
                    reflink(os.path.join(ctx["root"], "ops", o["file"]), src)
                sess.settle(2.0, 10)
                listed_total(sess, o["count"])  # the pane lists what the tool just put there
                for c in (("ctrl", "a"), o["take"]):
                    nav_key(sess, *c)
                clipboard_holds(sess, [os.path.join(real_src, n) for n in os.listdir(real_src)], o["take"] == ("ctrl", "x"))
                reach(sess, real_dst, base, "a-dst", kids)
                listed_total(sess, 0)  # the destination is clear in the pane and on the disk
                if os.listdir(real_dst):
                    raise HarnessFault("the destination %s is not clear" % real_dst)
                sess.settle(1.0, 5)
                more, before = wait_idle(sess, ISOLATE_PASTE_CAP_S)  # the keys above may have queued an error
                escs += more
                t = sess.keys.chord("ctrl", "v")
                if ev:
                    sess.rec.armed_ns = t
                extra = {"sample": i}
                if o.get("long"):
                    while time.monotonic_ns() < t + 11 * NS:
                        time.sleep(0.05)
                    extra["evidence_11s"] = (sess.keep_dump_now("%s-%s-11s" % (ctx["tag"], name))
                                             if sess.rec.proc.poll() is None else None)
                    extra["activity_11s"] = sess.ipc("statusActivityState")
                want = os.path.getsize(os.path.join(ctx["root"], "ops", o["file"])) if o.get("file") else None

                def done():
                    names = os.listdir(real_dst)
                    if len(names) < o["count"]:
                        return False
                    if want is not None:
                        return os.path.getsize(os.path.join(real_dst, names[0])) >= want
                    return name != "op.move.cross-fs" or not os.listdir(src)
                waited = wait_until(done, 900 if o.get("long") else 120)
                extra["op_s"] = None if waited is None else round((time.monotonic_ns() - t) / NS, 2)
                sess.rec.wait_quiet(int(QUIET[6] * NS), t, int(CAP[6] * NS))
                extra.update(op_state_fields(before, activity_state(sess)), esc_before=escs)
                row = sess.columns(name, t, 6, evidence=ev, extra=extra)
                if extra["op_s"] is None:
                    row.update(cancel_op(sess))  # the next sample must not start under this job
                rows.append(row)
            elif name == "op.trash":
                empty_dir(src, roots)
                reflink(os.path.join(ctx["root"], "ops", "src-trash", "t_00.txt"), src)
                sess.settle(2.0, 10)
                sess.keys.chord("home")
                sess.settle(1.0, 3)
                row = sess.sample(name, ("key", ("delete",)), 6, ev, {"sample": i})
                row["op_s"] = wait_until(lambda: not os.path.exists(os.path.join(src, "t_00.txt")), 30)
                row.update(op_state_fields(before, activity_state(sess)), esc_before=escs)
                rows.append(row)
            elif name in ("op.size.recursive", "op.archive"):
                label = "Properties" if name == "op.size.recursive" else "Compress"
                present = set(os.listdir(src))
                sess.keys.chord("home")
                sess.settle(1.0, 3)
                if not menu_to(sess, label):
                    rows.append({"journey": name, "row": 6, "view": sess.view, "first_ms": "no instrument",
                                 "note": "the context menu holds no %s row here" % label})
                    break
                if name == "op.archive":
                    sess.send(("key", ("right",)))
                    sess.settle(1.0, 3)
                row = sess.sample(name, ("key", ("enter",)), 6, ev, {"sample": i})
                if name == "op.archive":
                    row["op_s"] = wait_until(lambda: set(os.listdir(src)) - present, 60)
                    for extra_name in set(os.listdir(src)) - present:
                        sess.settle(2.0, 60)
                        sandbox_rm(os.path.join(src, extra_name), roots)
                row.update(op_state_fields(before, activity_state(sess)), esc_before=escs)
                rows.append(row)
                sess.send(("key", ("esc",)))
                sess.settle(1.0, 5)
        except HarnessFault as e:
            rows.append({"journey": name, "row": 6, "view": sess.view, "sample": i, "harness_fault": True,
                         "error": "%s: %s" % (type(e).__name__, e)})
            if all(r.get("harness_fault") for r in rows[-HARNESS_FAULTS_STOP:]) and len(rows) >= HARNESS_FAULTS_STOP:
                break  # the tool cannot reach the state sample 0 had: more samples would only repeat it
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            rows.append({"journey": name, "row": 6, "view": sess.view, "error": "%s: %s" % (type(e).__name__, e)})
    return rows


