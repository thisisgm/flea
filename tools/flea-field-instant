            """The pane of the sample's folders: a symlink to a folder is listed among the files, so after b-src."""

            def __init__(self, base, cwd, link_enters=True, stale=False, late=0, ghost=None, resolves=False):
                self.base, self.cwd, self.cursor, self.sel, self.clip = base, cwd, 0, [], {"paths": [], "moving": False}
                self.link_enters, self.stale, self.pastes = link_enters, stale, []
                self.busy, self.late, self.ghost, self.resolves = 0, late, ghost, resolves
                if ghost:
                    self.clip = {"paths": [ghost], "moving": False}

            def rows(self):
                names = sorted(os.listdir(self.cwd))
                folders = [n for n in names if os.path.isdir(os.path.join(self.cwd, n)) and not os.path.islink(os.path.join(self.cwd, n))]
                return folders + [n for n in names if n not in folders]

            def key(self, chord):
                rows = self.rows()
                if self.busy:
                    return
                if chord == ("home",):
                    self.cursor = 0
                elif chord == ("end",):
                    self.cursor = max(len(rows) - 1, 0)
                elif chord == ("down",):
                    self.cursor = min(self.cursor + 1, max(len(rows) - 1, 0))
                elif chord == ("backspace",):
                    self.cwd, self.cursor = os.path.dirname(os.path.realpath(self.cwd) if self.resolves else self.cwd), 0
                elif chord == ("enter",) and rows:
                    row = os.path.join(self.cwd, rows[self.cursor])
                    if os.path.isdir(row) and (self.link_enters or not os.path.islink(row)):
                        self.cwd, self.cursor = row, 0
                elif chord == ("ctrl", "a"):
                    self.sel = [] if self.stale else [os.path.join(self.cwd, n) for n in rows]
                elif chord in (("ctrl", "c"), ("ctrl", "x")) and not self.ghost:
                    self.clip = {"paths": list(self.sel), "moving": chord == ("ctrl", "x")}
                elif chord == ("ctrl", "v"):
                    self.pastes.append((os.path.realpath(self.cwd), len(self.clip["paths"])))

