def drop_root(path):
    """Remove one fixture root: absolute, not a link, at least three levels deep, and carrying the marker."""
    if not path or not os.path.isabs(path) or os.path.realpath(path) != path or path.rstrip("/").count("/") < 3:
        raise SystemExit("refusing to remove %r: not an absolute, real path three levels deep" % path)
    if not marked(path):
        raise SystemExit("refusing to remove %s: carries no %s" % (path, MARKER))
    shutil.rmtree(path)
    print("removed", path)


def clean(root):
    """Remove the local root and the stick and share roots its fixtures.json names, each only if marked."""
    real = os.path.realpath(root)
    with open(os.path.join(real, "fixtures.json")) as f:
        facts = json.load(f)
    for key in ("usb", "nas"):
        r = facts.get(key)
        if r and os.path.basename(r).startswith("flea-instant-"):
            drop_root(r)
    if not real.startswith(LOCAL_PARENT + "/"):
        print("refusing to remove local root %s: not under %s" % (real, LOCAL_PARENT), file=sys.stderr)
        return 1
    drop_root(real)
    return 0


# A session: one Flea window on one fixture and view, a recorder over one region, and the IPC seam for setup reads.

QUIET = {1: 1.0, 2: 2.0, 3: 1.0, 4: 1.0, 5: 2.0, 6: 2.0}  # s of quiet that ends a sample, per budget row
CAP = {1: 3, 2: 15, 3: 3, 4: 3, 5: 8, 6: 30}  # s after the input a sample may keep changing
PACE_MS = N.CURSOR_PACE_MS  # cursor series, a steady hand pace
HOLD_REPEATS = 70  # repeat periods a held sweep spans after the delay
CHROME_TOP = 56  # Flea's content region margins, the ones tools/flea-field-search measured
CHROME_BOTTOM = 34
RAIL = 192
PANE_SPLIT = 0.6  # share of the content width kept left of the preview column


def window_at(address):
    """The mapped client at address, or a RuntimeError when it has gone, so a window lost mid-setup is an error row."""
    for c in S.clients():
        if c.get("address") == address:
            return c
    raise RuntimeError("the window %s closed before its geometry was read" % address)


def win_rect(win, kind):
    """A watched rectangle (x, y, w, h) of a window (x, y, w, h): the whole window, the preview column, dual's left pane, else the content."""
    wx, wy, ww, wh = win
    content = (wx + RAIL, wy + CHROME_TOP, ww - RAIL, wh - CHROME_TOP - CHROME_BOTTOM)
    if kind == "window":
        return (wx, wy, ww, wh)
    if kind == "pane":  # the preview column, the right 40 percent of the content region
        cx, cy, cw, ch = content
        return (cx + int(cw * PANE_SPLIT), cy, cw - int(cw * PANE_SPLIT), ch)
    if kind == "left":  # the left pane of dual
        cx, cy, cw, ch = content
        return (cx, cy, cw // 2, ch)
    return content


def scroll_point(view, region, left):
    """The pointer point of a wheel or stroke: dual's left pane centre, because the content centre is the hairline no pane owns."""
    x, y, w, h = left if view == "dual" else region
    return x + w // 2, y + h // 2


def external_clients(clients, owned):
    """The mapped clients that are not Flea's: Flea's are of class S.FLEA_CLASS and owned by a pid under the launched process."""
    return [c for c in clients if c.get("mapped", True) and not (c.get("class") == S.FLEA_CLASS and c.get("pid") in owned)]


class ExternalWindow(Exception):
    """A window that is not this session's Flea mapped during a sample; row is the sample's row, with its error."""

    def __init__(self, row):
        super().__init__(row["error"])
        self.row = row


class Session:
    def __init__(self, ctx, fixture, view, region="content", right=None, log=None, ui=None):
        self.ctx, self.view, self.fixture = ctx, view, fixture
        self.keys = ctx["keys"]
        release_all(self.keys)
        self.patch, self.taken = dict(ui_patch(view, fixture, right), **(ui or {})), []
        state = flea_state(ctx, self.patch)
        tree = ctx["tree"]
        env = dict(S.ENV, FLEA_BIN=ctx.get("binary") or tree + "/target/release/flea",
                   FLEA_FRONTEND=ctx.get("frontend", S.Product.frontend({})), FLEA_UI=tree + "/ui", XDG_STATE_HOME=state,
                   QML_DISK_CACHE_PATH=tree + "/target/qmlcache", HOME=ctx["sbx"] + "/home",
                   XDG_DATA_HOME=ctx["sbx"] + "/data", XDG_CACHE_HOME=ctx["sbx"] + "/cache",
                   XDG_CONFIG_HOME=ctx["config_home"])
        os.makedirs(env["QML_DISK_CACHE_PATH"], exist_ok=True)
        self.log = open(log or os.devnull, "a")
        self.proc = subprocess.Popen([env["FLEA_BIN"], "--gui", fixture], env=env, stdout=self.log,
                                     stderr=subprocess.STDOUT, start_new_session=True)
        self.rec = None
        try:
            t0 = time.monotonic()
            win = None
            while win is None and time.monotonic() - t0 < 60:
                owned = S.descendants(self.proc.pid)
                win = next((c for c in S.clients() if c.get("class") == S.Product.window_class({"frontend": env["FLEA_FRONTEND"]}) and c.get("pid") in owned), None)
                time.sleep(0.05)
            if win is None:
                raise RuntimeError("no Flea window mapped in 60 s")
            self.address = win["address"]
            S.focus_window(self.address)
            S.park_cursor()
            time.sleep(0.5)
            win = window_at(self.address)
            (wx, wy), (ww, wh) = win["at"], win["size"]
            self.win = (wx, wy, ww, wh)
            self.known = set(self.outsiders())
            self.ipc_client = Client(env["FLEA_BIN"], frontend=env["FLEA_FRONTEND"])
            self.qs_pid = qs_pid(ctx, self.proc, self.ipc_client)
            self.set_region(region)
        except BaseException:
            self.close()
            raise

    def rect(self, kind):
        return win_rect(self.win, kind)

    def set_region(self, kind):
        if self.rec:
            self.rec.stop()
        self.region = self.rect(kind)
        dump_dir = os.path.join(self.ctx["out_dir"], "dumps")
        os.makedirs(dump_dir, exist_ok=True)
        self.rec = EvRecorder(self.ctx["rec_bin"], self.region, (), os.path.join(dump_dir, "d"), self.win)
        self.rec.wait_quiet(int(1.5 * NS), time.monotonic_ns(), 30 * NS)

    def ipc(self, fn, *args):
        out = subprocess.run(self.ipc_client.command("--pid", self.qs_pid, "call", "flea", fn) + [str(a) for a in args],
                             env=self.ipc_client.environment(S.parsed_env(S.ENV)), capture_output=True, text=True, timeout=10)
        return out.stdout.strip()

    def ipc_int(self, fn, *args):
        try:
            return int(self.ipc(fn, *args))
        except ValueError:
            return None

    def point(self, target):
        """Output coordinates of an IPC target: ("chrome", glyph) or ("row", index)."""
        kind, arg = target
        text = self.ipc("chromeButtonCentre" if kind == "chrome" else "rowCentre", arg)
        if not text:
            raise RuntimeError("IPC gave no centre for %s %s" % target)
        # Sample input, the IPC centre text: "412 96"
        x, y = (int(v) for v in text.split())
        return self.win[0] + x, self.win[1] + y

    def send(self, inp):
        """One untimed or timed input; the CLOCK_MONOTONIC ns before its write."""
        kind = inp[0]
        if kind == "key":
            return self.keys.chord(*inp[1])
        if kind in ("click", "rclick"):
            x, y = self.point(inp[1])
            pointer_to(self.keys, x, y)
            self.rec.wait_quiet(int(0.5 * NS), time.monotonic_ns(), 3 * NS)
            return click(self.keys, BTN_LEFT if kind == "click" else BTN_RIGHT)
        raise ValueError(inp)

    def settle(self, quiet_s, cap_s, since=None):
        return self.rec.wait_quiet(int(quiet_s * NS), since or time.monotonic_ns(), int(cap_s * NS))

    def outsiders(self):
        """The addresses of the mapped windows that are not this session's Flea."""
        owned = S.descendants(self.proc.pid)
        return {c["address"]: c for c in external_clients(S.clients(), owned)}

    load = None  # the Load beside the series, or None
    load_reads = None  # the probe read before each paced input

    def load_read(self):
        return self.load.probe() if self.load else None

    def load_ready(self):
        """The probe read that shows a renewed load moving (a load that cannot be renewed: its read now), or None with no load; a probe that never moves raises."""
        ld = self.load
        if ld is None:
            return None
        if ld.renew_fn is None:
            return ld.probe()
        base = ld.probe()
        ld.renew(True)
        t0 = time.monotonic()
        while True:
            now = ld.probe()
            if load_moved(base, now):
                return now
            if time.monotonic() - t0 > LOAD_START_S:
                raise RuntimeError("the load did not start")
            time.sleep(LOAD_POLL_S)

    def sample(self, journey, inp, row, evidence=None, extra=None):
        """One timed input and its columns (pre_quiet: the region was quiet before it), with the load's probe read before it and after its quiet; a window mapped since the baseline that is not Flea's raises ExternalWindow."""
        quiet_s, cap_s = QUIET[row], CAP[row]
        if inp[0] == "key":
            S.hide_cursor(self.keys, 0)
        pre = self.settle(0.3, 2)
        if inp[0] in ("click", "rclick"):
            x, y = self.point(inp[1])
            pointer_to(self.keys, x, y)
            pre = self.settle(0.5, 3)
            p_in = self.load_ready()
            t = click(self.keys, BTN_LEFT if inp[0] == "click" else BTN_RIGHT)
        else:
            p_in = self.load_ready()
            t = self.send(inp)
        if evidence:
            self.rec.armed_ns = t
        self.rec.wait_quiet(int(quiet_s * NS), t, int(cap_s * NS))
        p_out = self.load_read()
        out = self.columns(journey, t, row, pre, evidence, extra)
        if self.load:
            out.update(load_evidence(p_in, p_out))
        opened = {a: c for a, c in self.outsiders().items() if a not in self.known}
        if opened:
            out.update(error="an external window opened",
                       external=[{"class": c.get("class"), "title": c.get("title"), "pid": c.get("pid")}
                                 for c in opened.values()])
            raise ExternalWindow(out)
        return out

    def columns(self, journey, t, row, pre=True, evidence=None, extra=None, quiet_s=None, cap_s=None):
        quiet_ns, cap_ns = int((quiet_s or QUIET[row]) * NS), int((cap_s or CAP[row]) * NS)
        frames = self.rec.snapshot()
        cols = S.search_columns(frames, [t], time.monotonic_ns(), quiet_ns, cap_ns)
        any_first = S.first_change_after(S.changes_of(frames), t)
        out = {"journey": journey, "row": row, "view": self.view, "first_ms": cols["first_ms"],
               "first_any_ms": None if any_first is None else round((any_first - t) / MS, 1),
               "settled_ms": cols["settled_ms"], "capped": cols["capped"], "pre_quiet": pre,
               "blank_frames_skipped": cols["blank_frames_skipped"]}
        if evidence:
            out["evidence"] = self.keep_dump(evidence)
        if extra:
            out.update(extra)
        return out

    def keep_dump(self, stem):
        """The newest dump as a PNG with the watched region outlined, or None."""
        t0 = time.monotonic()
        while not self.rec.dumps and time.monotonic() - t0 < 2:
            time.sleep(0.05)
        if not self.rec.dumps:
            return None
        ppm = self.rec.dumps.pop()
        png = os.path.join(self.ctx["out_dir"], stem + ".png")
        S.ppm_to_png(ppm, png, self.rec.boxes(self.region, ()))
        return png

    def require_window(self):
        if not any(c.get("address") == self.address for c in S.clients()):
            raise RuntimeError("the Flea window was gone before the series ended")

    def close(self):
        if self.rec:
            self.rec.stop()
        N.end_proc(self.proc)
        release_all(self.keys)
        self.log.close()


# The shipped menu.hidden (src/uischema.rs DEFAULTS) shows Properties; op.size.recursive's session pins that list.
MENU_HIDDEN = ["delete", "openTerminal", "placeMenu", "runScript", "moveto", "copyto",
               "copyAs", "pasteAs", "invertSelection", "extThumbs", "run", "openAsText", "openAgent",
               "toggleHidden", "toggleLangMarks"]
SIZE_UI = {"menu": {"hidden": list(MENU_HIDDEN)}}


def ui_patch(view, fixture, right=None):
    """The ui-state patch of a session: name sort, folders first and the view; dual names both pane paths."""
    patch = {"sort": {"key": "name", "reverse": False}, "foldersFirst": True, "view": view}
    if view == "dual":
        patch["dual"] = {"paths": [fixture, right or fixture], "focus": 0}
    return patch


def flea_state(ctx, patch):
    """A state directory with Flea's shipped defaults and the patch applied."""
    key = json.dumps(patch, sort_keys=True)
    if key not in ctx["states"]:
        d = tempfile.mkdtemp(prefix="state-", dir=os.path.join(ctx["sbx"], "states"))
        os.makedirs(d + "/no-config", exist_ok=True)
        subprocess.run([ctx.get("binary") or ctx["tree"] + "/target/release/flea", "--ui-state", json.dumps(patch)],
                       env=dict(S.ENV, XDG_STATE_HOME=d, XDG_CONFIG_HOME=d + "/no-config"),
                       capture_output=True, check=True)
        ctx["states"][key] = d
    return ctx["states"][key]


def qs_pid(ctx, proc, ipc_client):
    """The pid of the one qs running this tree's ui under the launched process, the only exact IPC selector."""
    want = ctx["tree"] + "/ui/boot/shell.qml"
    t0 = time.monotonic()
    while time.monotonic() - t0 < 10:
        out = subprocess.run(ipc_client.command("list", "--all"), env=ipc_client.environment(S.parsed_env(S.ENV)), capture_output=True, text=True, timeout=10).stdout
        pid, found = None, []
        # Sample input: "  Process ID: 1318508" (qs list --all indents two spaces).
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("Instance "):
                pid = None
            elif line.startswith("Process ID:"):
                pid = int(line.split(":", 1)[1])
            elif line.startswith("Config path:") and line.split(":", 1)[1].strip() == want and pid:
                found.append(pid)
        owned = S.descendants(proc.pid)
        mine = [p for p in found if p in owned]
        if len(mine) == 1:
            return mine[0]
        time.sleep(0.2)
    raise RuntimeError("no single qs instance of %s under pid %d" % (want, proc.pid))


# Series. Each takes a session and a spec and returns rows; a spec is plain data so the parts below stay a table.

CHORD_NAMES = {("down",): "down", ("up",): "up", ("j",): "j", ("k",): "k", ("pagedown",): "pagedown",
               ("pageup",): "pageup", ("ctrl", "d"): "ctrl-d", ("ctrl", "u"): "ctrl-u", ("home",): "home",
               ("end",): "end", ("g",): "g", ("shift", "g"): "G", ("left",): "left", ("right",): "right",
               ("h",): "h", ("l",): "l"}
# Cursor-moving chords of the default preset; each pair leaves row 0, then returns.
PAIRS = [(("down",), ("up",)), (("j",), ("k",)), (("pagedown",), ("pageup",)), (("ctrl", "d"), ("ctrl", "u")),
         (("end",), ("home",)), (("shift", "g"), ("g",))]
# The grid alone steps sideways on the bare arrows and on h and l (ui/js/Focus.js lookup, ui/js/Grid.js).
GRID_PAIRS = [(("right",), ("left",)), (("l",), ("h",))]
VIEW_KEYS = {"list": ("ctrl", "1"), "columns": ("ctrl", "2"), "grid": ("ctrl", "3")}  # keys.toml preset default
# An Euler circuit of the 12 ordered view pairs; dual has no chord, so it is reached by its chrome button.
VIEW_CIRCUIT = ["list", "columns", "grid", "dual", "list", "grid", "columns", "dual", "grid", "list", "dual",
                "columns", "list"]


def paced(sess, chords, pace_ms, times=None):
    """Chords on an absolute schedule; their CLOCK_MONOTONIC ns, in times as each is sent, the load probe read before each in sess.load_reads, the load renewed after each when its gap has passed."""
    times = [] if times is None else times
    reads = sess.load_reads = []
    first = sess.load_ready()
    start = time.monotonic_ns()
    for i, c in enumerate(chords):
        due = start + int(i * pace_ms * MS)
        while time.monotonic_ns() < due - 2 * MS:
            time.sleep(0.001)
        while time.monotonic_ns() < due:
            pass
        reads.append(first if i == 0 else sess.load_read())
        times.append(c() if callable(c) else sess.keys.chord(*c))
        if sess.load:
            sess.load.renew()
    return times


def per_key_rows(sess, times, names, extra=None):
    """One row per input from the per-key first change; names labels each input's journey."""
    sess.settle(N.NAV_QUIET_NS / NS, 15, times[-1])
    frames = sess.rec.snapshot()
    end = time.monotonic_ns()
    cols = S.search_columns(frames, times, end, N.NAV_QUIET_NS, N.NAV_CAP_NS)
    changes = S.changes_of(frames)
    reads = sess.load_reads[:len(times)] if sess.load else []
    ends = reads[1:] + [sess.load_read()]
    rows = []
    for i, (t, name) in enumerate(zip(times, names)):
        nxt = times[i + 1] if i + 1 < len(times) else end
        a = S.first_change_after(changes, t)
        rows.append(dict({"journey": name, "row": 1, "view": sess.view, "first_ms": cols["per_key_first_ms"][i],
                          "first_any_ms": None if a is None or a > nxt else round((a - t) / MS, 1)}, **(extra or {})))
        if sess.load:
            rows[-1].update(load_evidence(reads[i], ends[i]))
    return rows


def paced_rows(sess, chords, names, pace_ms, extra=None):
    """The rows of paced inputs; an error mid-run keeps the rows of the inputs already sent in sess.taken."""
    times = []
    try:
        paced(sess, chords, pace_ms, times)
    except (RuntimeError, OSError, ValueError, subprocess.CalledProcessError):
        if times:
            sess.taken += per_key_rows(sess, times, names[:len(times)], extra)
        raise
    return per_key_rows(sess, times, names, extra)


def series_pairs(sess, spec, n):
    rows = sess.taken
    for a, b in spec["pairs"]:
        sess.keys.chord("home")
        sess.settle(1.0, 5)
        chords = [a, b] * (n * SERIES_ROWS_PER_SAMPLE["pairs"])
        names = ["nav.%s.%s" % (sess.view, CHORD_NAMES[c]) for c in chords]
        rows += paced_rows(sess, chords, names, PACE_MS)
    return rows


def series_scroll(sess, spec, n):
    sess.keys.chord("home")
    sess.settle(1.0, 5)
    pre = N.preroll_count(sess.region[3])
    paced(sess, [("down",)] * pre, N.SCROLL_PREROLL_PACE_MS)
    sess.settle(2.0, 15)
    count = n * SERIES_ROWS_PER_SAMPLE["scroll"]
    return paced_rows(sess, [("down",)] * count, ["nav.%s.down-scroll" % sess.view] * count, PACE_MS, {"preroll": pre})


def series_wheel(sess, spec, n):
    pointer_to(sess.keys, *scroll_point(sess.view, sess.region, sess.rect("left")))
    sess.settle(1.0, 5)
    half = SERIES_ROWS_PER_SAMPLE["wheel"] // 2
    sends = [lambda: wheel(sess.keys, -1)] * (n * half) + [lambda: wheel(sess.keys, 1)] * (n * half)
    rows = sess.taken
    rows += paced_rows(sess, sends, ["nav.%s.wheel" % sess.view] * (n * SERIES_ROWS_PER_SAMPLE["wheel"]), PACE_MS)
    S.park_cursor()
    return rows


def series_fling(sess, spec, n):
    T, why = touchpad()
    if T is None:
        return [{"journey": "nav.%s.fling" % sess.view, "row": 1, "view": sess.view, "first_ms": "no instrument",
                 "note": why}]
    pointer_to(sess.keys, *scroll_point(sess.view, sess.region, sess.rect("left")))
    fd = T.create()
    rows = sess.taken
    try:
        time.sleep(T.CREATE_SETTLE_S)
        sess.settle(1.0, 5)
        for i in range(n * SERIES_ROWS_PER_SAMPLE["fling"]):
            t = stroke(T, fd, -40 if i % 2 == 0 else 40, 120)
            sess.rec.wait_quiet(N.NAV_QUIET_NS, t, N.NAV_CAP_NS)
            rows.append(sess.columns("nav.%s.fling" % sess.view, t, 1, quiet_s=2, cap_s=15))
    finally:
        drop_touchpad(T, fd)
        S.park_cursor()
    return rows


def series_held(sess, spec, n):
    """Held j sweeps: the repeat slots drawn, the gap between drawn frames, and overshoot against the idle bound."""
    delay, rate = sess.ctx["repeat"]["delay_ms"], sess.ctx["repeat"]["rate"]
    interval = 1000.0 / rate
    hold_ns = int((delay + interval * HOLD_REPEATS + interval / 2) * MS)
    stride = sess.ipc_int("gridColumns") if sess.view == "grid" else 1
    bound = sess.ctx["repeat"].get("max_events")
    rows = sess.taken
    code = N.keycode("j")
    for i in range(n * SERIES_ROWS_PER_SAMPLE["held"]):
        sess.keys.chord("home")
        sess.settle(1.0, 5)
        start = sess.ipc_int("cursor")
        sess.settle(0.5, 3)
        t_down = time.monotonic_ns()
        sess.keys._key(code, 1)
        while time.monotonic_ns() < t_down + hold_ns - 2 * MS:
            time.sleep(0.001)
        while time.monotonic_ns() < t_down + hold_ns:
            pass
        t_up = time.monotonic_ns()
        sess.keys._key(code, 0)
        sess.rec.wait_quiet(N.NAV_QUIET_NS, t_up, N.NAV_CAP_NS)
        final = sess.ipc_int("cursor")
        h = held_analysis(sess.rec.snapshot(), t_down, t_up, delay, interval)
        over, behind = overshoot(start, final, stride, bound)
        h.update({"start_index": start, "final_index": final, "stride": stride, "idle_max_events": bound,
                  "overshoot": over, "steps_behind": behind, "hold_ms": round((t_up - t_down) / MS, 1)})
        rows.append({"journey": "nav.%s.held-j-sweep" % sess.view, "row": 2, "view": sess.view,
                     "first_ms": h["max_gap_ms"], "held": h})
    return rows


def folder_setup(patch, path):
    """The keys that put the cursor on the first folder of path."""
    if patch.get("foldersFirst") is not True:
        raise RuntimeError("the Enter target assumes folders first, and this session does not set foldersFirst to true")
    if not any(e.is_dir() for e in os.scandir(path) if not e.name.startswith(".")):
        raise RuntimeError("no folder in %s for Enter to enter" % path)
    return [k("home")]  # folders first puts the first folder at row 0


def names_off(fixture, want):
    """Names that differ between a fixture directory and its expected names, sorted."""
    return sorted(set(os.listdir(fixture)) ^ set(want))


def put_back(fixture, want, typed):
    """Rename each file whose stem grew by typed back to the expected name it came from."""
    have, want = set(os.listdir(fixture)), set(want)
    for name in sorted(have - want):
        stem, ext = os.path.splitext(name)
        old = name
        if typed and stem.endswith(typed):
            old = stem[:len(stem) - len(typed)] + ext
        elif typed:
            for w in sorted(want):
                wstem, wext = os.path.splitext(w)
                if w not in have and ext == wext and stem.startswith(wstem) and 0 < len(stem) - len(wstem) <= len(typed):
                    old = w
                    break
        if old in want and old not in have:
            os.rename(os.path.join(fixture, name), os.path.join(fixture, old))


def series_cycle(sess, spec, n):
    """Repeated steps, a step with a journey timed; to_folder aims Enter at a folder, first_suffix renames cycle 0's journeys."""
    # restores: the fixture's expected names; typed: what the cycle appends to a stem, to put a failed run back.
    want = spec.get("restores")
    if want is not None and names_off(sess.fixture, want):
        raise RuntimeError("the fixture %s starts off its expected names: %s"
                           % (sess.fixture, ", ".join(names_off(sess.fixture, want)[:4])))
    rows = sess.taken
    try:
        for inp in folder_setup(sess.patch, sess.fixture) if spec.get("to_folder") else spec.get("setup", []):
            sess.send(inp)
            sess.settle(1.0, CAP[3])
        for i in range(n * SERIES_ROWS_PER_SAMPLE["cycle"]):
            for step in spec["steps"]:
                j = step.get("journey")
                if j is None:
                    sess.send(step["in"])
                    sess.settle(step.get("quiet", 1.0), step.get("cap", 3))
                    continue
                if i < FIRST_ROWS and spec.get("first_suffix"):
                    j += spec["first_suffix"]
                ev = "%s-%s-%d" % (sess.ctx["tag"], j, i) if i < FIRST_ROWS and sess.ctx.get("evidence") else None
                rows.append(sess.sample(j, step["in"], row_of(j, spec.get("fixture", "local")) or 4, ev,
                                        {"cycle": i}))
        sess.require_window()
    finally:
        left = names_off(sess.fixture, want) if want is not None else []
        if left:
            put_back(sess.fixture, want, spec["typed"])
    if left:
        raise RuntimeError("the cycle left these names changed in %s: %s" % (sess.fixture, ", ".join(left[:4])))
    return rows


def series_views(sess, spec, n):
    """The view circuit, every ordered pair timed once per lap."""
    rows = sess.taken
    for lap in range(n * SERIES_ROWS_PER_SAMPLE["views"]):
        for a, b in zip(VIEW_CIRCUIT, VIEW_CIRCUIT[1:]):
            inp = ("click", ("chrome", "dual")) if b == "dual" else ("key", VIEW_KEYS[b])
            rows.append(sess.sample("view.switch.%s-%s" % (a, b), inp, 3, None, {"lap": lap}))
            S.park_cursor()
    sess.require_window()
    return rows


def series_land(sess, spec, n):
    """Columns preview: the cursor key that lands on the file, from its neighbour, cycle 0 named .first."""
    names = sorted(x for x in os.listdir(sess.fixture) if not x.startswith("."))
    rows = sess.taken
    for kind in spec["kinds"]:
        idx = names.index(KINDS[kind])
        go, back = (("down",), ("up",)) if idx > 0 else (("up",), ("down",))
        sess.keys.chord("home")
        time.sleep(0.2)
        for _ in range(idx - 1 if idx > 0 else 1):
            sess.keys.chord("down")
            time.sleep(0.15)
        sess.settle(2.0, 10)
        for i in range(n * SERIES_ROWS_PER_SAMPLE["land"] + FIRST_ROWS):
            j = "open.cols-preview.%s%s" % (kind, ".first" if i < FIRST_ROWS else "")
            ev = "%s-%s" % (sess.ctx["tag"], j) if i < FIRST_ROWS and sess.ctx.get("evidence") else None
            rows.append(sess.sample(j, ("key", go), row_of(j, spec.get("fixture", "local")), ev, {"cycle": i}))
            sess.send(("key", back))
            sess.settle(QUIET[5], CAP[5])
    return rows


def series_ql(sess, spec, n):
    """Quick Look of each kind: Space opens, Space closes; cycle 0 is the uncached open, named .first."""
    names = sorted(x for x in os.listdir(sess.fixture) if not x.startswith("."))
    rows = sess.taken
    for kind in spec["kinds"]:
        idx = names.index(KINDS[kind])
        sess.keys.chord("home")
        time.sleep(0.2)
        for _ in range(idx):
            sess.keys.chord("down")
            time.sleep(0.15)
        sess.settle(2.0, 10)
        for i in range(n * SERIES_ROWS_PER_SAMPLE["ql"] + FIRST_ROWS):
            j = "open.ql.%s%s" % (kind, ".first" if i < FIRST_ROWS else "")
            row = row_of(j, spec.get("fixture", "local"))
            ev = "%s-%s" % (sess.ctx["tag"], j) if i < FIRST_ROWS and sess.ctx.get("evidence") else None
            rows.append(sess.sample(j, ("key", ("space",)), row, ev, {"cycle": i}))
            sess.send(("key", ("space",)))
