        inodes = {os.stat(os.path.join(src, x)).st_ino for x in names}
        check("cold_links_share_inodes", all(os.stat(os.path.join(dst, x)).st_ino in inodes for x in first + second), True)
        check("cold_links_distinct", (len(first), len(second), len(listing)), (3, 3, 11))
        part = []
        with mock.patch.object(os, "link", link_failing_at(3)):
            try:
                link_cold(src, names, dst, seq, 5, part)
                fail.append("cold_links_failure_propagates: a failing os.link raised nothing")
            except OSError:
                pass
        check("cold_links_name_only_what_exists", (len(part), all(os.path.lexists(x) for x in part)), (2, True))
    # Load a's renewal swaps the previous batch for a new one, so the right folder keeps its size through the run, and removes only inside a marked root.
    with tempfile.TemporaryDirectory() as td:
        open(os.path.join(td, MARKER), "w").close()
        cold, right = os.path.join(td, "load", "cold-src"), os.path.join(td, "load", "cold-x")
        os.makedirs(cold)
        os.makedirs(right)
        for i in range(1, 6):
            open(os.path.join(cold, "c_%05d.jpg" % i), "w").close()
            os.link(os.path.join(cold, "c_%05d.jpg" % i), os.path.join(right, "c_%05d.jpg" % i))
        renew_a = load_renew(types.SimpleNamespace(right=right), "a", {"root": td, "roots": [td]})
        sizes, seen = [], set()
        for _ in range(4):
            renew_a()
            sizes.append(len(os.listdir(right)))
            seen |= set(os.listdir(right))
        check("load_a_renewals_keep_the_folder_size", (sizes, len(os.listdir(cold))), ([5 + COLD_BATCH] * 4, 5))
        check("load_a_renewals_never_reuse_a_name", len(seen), 5 + 4 * COLD_BATCH)
        # A link that fails on the tenth of a batch leaves the folder at its five pictures, and the next renewal links a whole batch.
        base = ["c_%05d.jpg" % i for i in range(1, 6)]
        with mock.patch.object(os, "link", link_failing_at(10)):
            try:
                renew_a()
                fail.append("load_a_failed_renewal_propagates: a failing os.link raised nothing")
            except OSError:
                pass
        check("load_a_failed_renewal_leaves_no_partial_batch", sorted(os.listdir(right)), base)
        renew_a()
        check("load_a_renewal_recovers_after_a_failed_one", len(os.listdir(right)), 5 + COLD_BATCH)
    # With no marker on the root the renewal refuses before it removes anything, so the batch it linked is all still there.
    with tempfile.TemporaryDirectory() as bare:
        cold, other = os.path.join(bare, "load", "cold-src"), os.path.join(bare, "load", "cold-y")
        os.makedirs(cold)
        os.makedirs(other)
        open(os.path.join(cold, "c_00001.jpg"), "w").close()
        os.link(os.path.join(cold, "c_00001.jpg"), os.path.join(other, "c_00001.jpg"))
        unmarked = load_renew(types.SimpleNamespace(right=other), "a", {"root": bare, "roots": [bare]})
        unmarked()
        linked = sorted(os.listdir(other))
        try:
            unmarked()
            fail.append("load_a_renewal_refuses_outside_a_marked_root: a batch was removed with no marked root")
        except SystemExit:
            pass
        check("load_a_refused_renewal_removes_nothing", (len(linked), sorted(os.listdir(other)) == linked), (1 + COLD_BATCH, True))
    # A forced renewal waits out the load's gap since the last one, so load c's folder mtime has moved by the time the probe is read.
    stamps = []
    gap_load = Load("c", "stub", lambda: len(stamps), lambda: stamps.append(time.monotonic()), 0.2)
    gap_session = load_session(None)
    gap_session.load = gap_load
    check("load_renew_inside_the_gap_is_skipped", (gap_load.renew(), gap_load.renew(), len(stamps)), (True, False, 1))
    gap_session.load_ready()
    check("load_forced_renewal_waits_out_the_gap", (len(stamps), stamps[1] - stamps[0] >= 0.2 - 0.01), (2, True))
    # Load c's probe is the right pane's request count and listing flag, never a process tick count; the sample is dualState's shape (ui/Ipc.qml:126).
    ipc = {"out": '{"active": true, "focused": 0, "panes": [{"path": "/a", "total": 3, "cursor": 0, "loading": false, "selected": [], "focused": true, "listRequests": 4}, {"path": "/nas/stream", "total": 5000, "cursor": 0, "loading": true, "selected": [], "focused": false, "listRequests": 7}]}'}
    stub = types.SimpleNamespace(ipc=lambda name, *a: ipc["out"])
    probe_c, note_c = load_start(stub, "c", {"roots": []})
    check("load_c_probe", (probe_c(), note_c), ((7, True), "NAS listing streaming in the right pane"))
    # The probe reads the fields the producer writes: a pane built from the keys of dualState's own object literal.
    with open(os.path.join(REPO, "ui", "Ipc.qml")) as f:
        qml = f.read()
    literal = qml[qml.index("function dualState()"):]
    literal = literal[:literal.index("} : null")]
    keys = re.findall(r"(\w+):", literal.split("return pane ? {", 1)[1])
    ipc["out"] = json.dumps({"panes": [None, {k: 7 for k in keys}]})
    check("load_c_probe_reads_the_producers_fields", (probe_c(), "listRequests" in keys, "loading" in keys),
          ((7, True), True, True))
    ipc["out"] = "{"
    check("load_c_probe_unreadable", probe_c(), (None, False))
    ipc["out"] = '{"panes": [{"listRequests": 4, "loading": false}]}'
    check("load_c_probe_one_pane", probe_c(), (None, False))
    ipc["out"] = '{"active": true, "focused": 0, "panes": [{"listRequests": 4, "loading": false}, null]}'
    check("load_c_probe_null_pane", probe_c(), (None, False))
    # The gate: a load group passes only when every sample's load_active is true.
    idle = [dict(r) for r in full]
    next(r for r in idle if r["journey"] == "nav.dual.down" and where(r) == "local+load-a")["load_active"] = False
    code, gtext = run_gate(idle, "p7-load", 20)
    check("gate_load_inactive_code", code, 2)
    check("gate_load_inactive_line",
          "GATE MISSING nav.dual.down dual local+load-a load inactive in 1 of 20 samples" in gtext, True)
    check("gate_load_inactive_only_that_group", gtext.count("load inactive"), 1)
    code, gtext = run_gate([{k: v for k, v in r.items() if k != "load_active"} for r in full], "p7-load", 20)
    check("gate_load_unproved_is_inactive", (code, "load inactive in 20 of 20 samples" in gtext), (2, True))
    code, gtext = run_gate(full, "p7-load", 20)
    check("gate_load_all_active", (code, "load inactive" in gtext), (0, False))
    # Rows come only from a cycle that leaves the fixture as found; a rename or an exception fails the series and is put back; a dirty start refuses.
    with tempfile.TemporaryDirectory() as td:
        def fresh(name):
            for old in os.listdir(td):
                os.remove(os.path.join(td, old))
            open(os.path.join(td, name), "w").close()
        fresh("f_0001.txt")

        def rename_away(*_):
            os.rename(os.path.join(td, "f_0001.txt"), os.path.join(td, "f_0001ab.txt"))
            return {}

        def rename_then_raise(*_):
            rename_away()
            raise OSError("boom")
        sampled = []
        fake = types.SimpleNamespace(fixture=td, ctx={}, taken=[], send=lambda inp: None, settle=lambda *a: True,
                                     sample=lambda *a: sampled.append(a) or {}, require_window=lambda: None)
        spec = {"steps": [{"journey": "nav.list.pre-rename-j", "in": k("j")}], "restores": ["f_0001.txt"],
                "typed": "ab"}
        check("restores_kept", len(series_cycle(fake, spec, 1)), 1)
        fake.sample = rename_away
        try:
            series_cycle(fake, spec, 1)
            fail.append("restores_changed: a renamed file was not refused")
        except RuntimeError as e:
            check("restores_changed", "f_0001.txt, f_0001ab.txt" in str(e), True)
        check("restores_put_back", sorted(os.listdir(td)), ["f_0001.txt"])
        fresh("f_0001.txt")
        fake.sample = rename_then_raise
        try:
            series_cycle(fake, spec, 1)
            fail.append("restores_raise: the exception did not reach the caller")
        except OSError as e:
            check("restores_raise", str(e), "boom")
        check("restores_raise_put_back", sorted(os.listdir(td)), ["f_0001.txt"])
        fresh("f_0001.txt")

        def rename_partial(*_):
            os.rename(os.path.join(td, "f_0001.txt"), os.path.join(td, "f_0001a.txt"))
            return {}
        fake.sample = rename_partial
        try:
            series_cycle(fake, spec, 1)
            fail.append("restores_partial: a partial-suffix rename was not refused")
        except RuntimeError as e:
            check("restores_partial", "f_0001.txt, f_0001a.txt" in str(e), True)
        check("restores_partial_put_back", sorted(os.listdir(td)), ["f_0001.txt"])
        fresh("f_0001ab.txt")
        fake.sample = lambda *a: sampled.append(a) or {}
        del sampled[:]
        try:
            series_cycle(fake, spec, 1)
            fail.append("restores_drifted: a fixture off its names was not refused")
        except RuntimeError as e:
            check("restores_drifted", ("starts off its expected names" in str(e), sampled), (True, []))
        check("restores_drifted_untouched", sorted(os.listdir(td)), ["f_0001ab.txt"])
    if fail:
        print("\n".join("FAIL " + f for f in fail))
        return 1
    print("plan cases: full planned set passes, one row short is MISSING, a miss p95 is a BREACH")
    print("expected-set cases: p1 without p4 is MISSING part p4-open, no paths is usage error")
    print("samples cases: samples=2 is MISSING plan samples 2, defined 20, floor holds except .first")
    print("rows cases: wheel 2 and first 1 share SERIES_ROWS_PER_SAMPLE with planned_counts")
    print("clean-outside cases: own parent and outside run under every parent, skip is failure")
    print("isolation cases: Esc count over running, cancelling and queued errors, refused pastes marked, an unclear bar is an error row")
    print("op navigation cases: every sample of a move or copy pastes in a-dst whatever the symlink sorts as, the old blind keys paste in b-src and take nothing from a-dst, "
          "a pane left in a-dst is walked back, an unreachable a-dst, an empty take and a listing that never lands are harness fault rows, "
          "a series stops after repeated faults, a take waits for a late listing, a foreign clipboard of the right size is a fault, a resolved climb is named, Backspace climbs the pane path as Nav.js cuts it, op.size.recursive shows the Properties row, the report names a harness fault")
    print("fling floor cases: medians and ranges from fixed arrays, the client wheel line on the harness clock, the floor beside the fling rows, "
          "a floor kept past trailing text, a named file that gives none says why, calibrate survives any probe error")
    print("load cases: the probe is read per sample and per paced key, a load that stops reads inactive from there, a renewed load is awaited before the input and waits out its gap, a renewal swaps its batch inside a marked root, the c probe reads the fields ui/Ipc.qml writes, the gate names an inactive load group")
    print("target cases: dual pointer in the left pane, Enter row from the listing, --only plans, an error or an external window keeps the rows built before it, folders first pinned")
    print("SELFTEST ok (%d journeys across %d parts)" % (len(cover), len(PARTS)))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]

    def opt(name, default=None):
        return rest[rest.index(name) + 1] if name in rest else default

    def jsonl_paths(args):
        """Existing .jsonl files past --out FILE and --part PART; anything else fails loud."""
        paths, skip = [], False
        for a in args:
            if skip:
                skip = False
                continue
            if a in ("--out", "--part", "--only", "--calibrate"):
                skip = True
                continue
            if not a.endswith(".jsonl") or not os.path.isfile(a):
                print("need an existing .jsonl file, not %r" % a, file=sys.stderr)
                raise SystemExit(2)
            paths.append(a)
        return paths

    if cmd == "selftest":
        return selftest()
    if cmd == "budget":
        return budget_json()
    if cmd == "report":
        paths = jsonl_paths(rest)
        calib = opt("--calibrate")
        named = calib is not None
        if calib is None and paths:  # the census script writes calibrate.json into the same out dir
            calib = os.path.join(os.path.dirname(os.path.abspath(paths[0])), "calibrate.json")
        floor, why = fling_floor_of(calib) if calib else (None, None)
        if floor is None and named:  # a file the operator named says why it gave no floor
            floor = {"error": why}
        return report(paths, opt("--out"), floor)
    if cmd == "gate":
        only = []
        for i, a in enumerate(rest):
            if a == "--part":
                raw = rest[i + 1] if i + 1 < len(rest) else None
                hit = resolve_part(raw) if raw else None
                if hit is None:
                    print("unknown part %r, want one of %s" % (raw, ", ".join(PARTS)), file=sys.stderr)
                    raise SystemExit(2)
                only.append(hit)
        return gate(jsonl_paths(rest), opt("--out"), None if not only else only, opt("--only"))
    if cmd == "fixtures":
        print(json.dumps(build_fixtures(rest[0], opt("--usb"), opt("--nas")), indent=1))
        return 0
    if cmd == "clean":
        return clean(rest[0])
    if cmd == "calibrate":
        return calibrate(int(opt("--runs", 10)))
    if cmd == "run":
        return run_part(rest[0], opt("--root"), opt("--flea"), opt("--out"), int(opt("--samples", 20)),
                        "--dry" in rest, "--no-evidence" not in rest, opt("--only"), opt("--frontend"), opt("--bin"))
    if cmd == "measure":
        with open(rest[0]) as f:
            plan = json.load(f)
        return run_part(plan["part"], plan["root"], plan["flea"], plan["out"], plan.get("samples", 20),
                        plan.get("dry", False), plan.get("evidence", True), plan.get("only"),
                        plan.get("frontend"), plan.get("flea_bin"))
    print("unknown command " + cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
