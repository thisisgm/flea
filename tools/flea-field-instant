def row_of(journey, fixture="local"):
    """The budget row of a journey on a fixture, or None when no pattern names it."""
    for pat, row in JOURNEYS:
        if re.match(pat, journey):
            return 5 if fixture in ("usb", "nas") and row != 2 else row
    return None


def p95(vals):
    """Nearest-rank p95; a miss (None) sorts above every number."""
    if not vals:
        return None
    ordered = sorted(vals, key=lambda v: math.inf if v is None else v)
    return ordered[max(0, math.ceil(0.95 * len(ordered)) - 1)]


def p50(vals):
    if not vals:
        return None
    ordered = sorted(vals, key=lambda v: math.inf if v is None else v)
    return ordered[(len(ordered) - 1) // 2]


def judge(row, firsts, settled=None, video=False, held=None):
    """TARGET, CEILING-OK or BREACH for one series, from the BUDGET row."""
    b = BUDGET[row]
    if row == 2:
        if not held or any(h.get("overshoot") is None for h in held):
            return "NO-READ"
        if any(h["overshoot"] > 0 for h in held):
            return "BREACH"
        return "TARGET" if all(h["slots_missed"] == 0 for h in held) else "CEILING-OK"
    f95 = p95(firsts)
    if f95 is None:
        return "BREACH" if firsts else "NO-READ"  # a miss ranks above every reading; empty stays NO-READ
    if row == 5:
        s95 = None if video else p95(settled or [])
        if f95 > b["ceiling_ms"] or (not video and (s95 is None or s95 > b["content_ceiling_ms"])):
            return "BREACH"
        if video:
            return "TARGET" if f95 <= b["target_ms"] else "CEILING-OK"
        return "TARGET" if s95 <= b["target_ms"] else "CEILING-OK"
    if f95 <= b["target_ms"]:
        return "TARGET"
    return "CEILING-OK" if f95 <= b["ceiling_ms"] else "BREACH"


# Held-key analysis: pure functions over the recorder's (presentation ns, changed rows, ink) frames.


def repeats_due(t_down, t_up, delay_ms, interval_ms):
    """Repeats a client schedules strictly before the release: due at delay, delay + interval, ..."""
    n, t = 0, t_down + delay_ms * MS
    while t < t_up:
        n += 1
        t += interval_ms * MS
    return n


def held_analysis(frames, t_down, t_up, delay_ms, interval_ms):
    """Repeat slots drawn, the largest gap between changed frames in the hold, and the first repeat's latency."""
    changes = S.changes_of(frames)
    n_rep = repeats_due(t_down, t_up, delay_ms, interval_ms)
    press = S.first_change_after(changes, t_down)
    anchor = S.first_change_after(changes, t_down + delay_ms * MS)
    out = {"repeats_due": n_rep, "press_first_ms": None if press is None else round((press - t_down) / MS, 1),
           "first_repeat_ms": None, "slots_missed": n_rep, "max_gap_ms": None}
    if anchor is None or anchor > t_up + interval_ms * MS:
        return out
    out["first_repeat_ms"] = round((anchor - t_down - delay_ms * MS) / MS, 1)
    half = interval_ms * MS / 2
    missed = 0
    for k in range(1, n_rep):
        lo, hi = anchor + k * interval_ms * MS - half, anchor + k * interval_ms * MS + half
        if not any(lo <= t < hi for t in changes):
            missed += 1
    out["slots_missed"] = missed
    inside = [t for t in changes if anchor <= t <= t_up]
    gaps = [(b - a) / MS for a, b in zip(inside, inside[1:])]
    out["max_gap_ms"] = round(max(gaps), 1) if gaps else None
    return out


def overshoot(start_idx, final_idx, stride, max_events):
    """(rows past the idle client's event count, rows short of it); None when a read failed."""
    if start_idx is None or final_idx is None or not stride or max_events is None:
        return None, None
    steps = (final_idx - start_idx) // stride
    return max(0, steps - max_events), max(0, max_events - steps)


