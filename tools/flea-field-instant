def calibrate_gate(neg, rep):
    # Pass on a clean negative control, the 50 ms row, an unspent delay-0 capture and every row median in one frame.
    rows = rep.get("rows", [])
    if "frame_ms" not in rep:
        print("no frame_ms", file=sys.stderr)
        return 1
    frame = rep["frame_ms"]
    fifty = next((r for r in rows if r.get("delay_ms") == 50), None)
    if fifty is None:
        print("no 50 ms row", file=sys.stderr)
        return 1
    if "within_one_frame" not in fifty:
        print("50 ms row unscored", file=sys.stderr)
        return 1
    ok = bool(neg.get("clean", False)) and bool(fifty.get("within_one_frame", False))
    if not fifty.get("within_one_frame", False):
        errs = fifty.get("error_vs_client_ms", [])
        med = "%.1f" % statistics.median(errs) if errs else "none"
        print("fifty_outside_one_frame delay=50 median=%s runs=%s" % (
            med, [i + 1 for i, e in enumerate(errs) if abs(e) > frame]), file=sys.stderr)
    # A delay-0 result after another commit was read a recorder round trip late, so the floor it sets is not the floor.
    zero = next((r for r in rows if r.get("delay_ms") == 0), None)
    spent = [i + 1 for i, n in enumerate((zero or {}).get("frames_before_result", [])) if n > 0]
    if spent:
        print("capture_spent delay=0 runs=%s" % spent, file=sys.stderr)
        ok = False
    for r in rows:
        if r.get("delay_ms") == 50 or r.get("within_one_frame", False):
            continue
        if "error_vs_client_ms" not in r or "within_one_frame" not in r:
            print("unscored delay=%s" % (r.get("delay_ms"),), file=sys.stderr)
            continue
        errs = r.get("error_vs_client_ms", [])
        # A row whose median misses by more than a frame is an instrument error, not a stray run.
        if errs and abs(statistics.median(errs)) > frame:
            print("median_outside_one_frame delay=%s median=%.1f" % (r.get("delay_ms"), statistics.median(errs)),
                  file=sys.stderr)
            ok = False
        bad = [i + 1 for i, e in enumerate(errs) if abs(e) > frame]
        print("outside_one_frame delay=%s runs=%s error_vs_client_ms=%s" % (
            r.get("delay_ms"), bad, [errs[i - 1] for i in bad]), file=sys.stderr)
    return 0 if ok else 1


def calibrate(runs):
    """Also prints the fling floor (fling_probe) under "fling", which never changes the verdict. Pass when the negative control is clean, the 50 ms row is within one frame, no delay-0 result followed another commit and every scored row's median error is within one frame; each other run outside one frame prints to stderr as outside_one_frame with its delay, runs and error_vs_client_ms without failing the gate."""
    S.ENV = S.session_env()
    os.environ.update(S.ENV)
    neg = negative_control(3)
    print(json.dumps({"negative_control": neg}, indent=1), flush=True)
    rep = S.calibrate([0, 50, 200], runs)
    keys = N.NavKeys()
    rp = repeat_probe(keys, repeat_settings({}), 3)
    print(json.dumps({"repeat_probe": rp}, indent=1), flush=True)
    # The fling floor is reported, never judged: no failure here changes the exit code.
    try:
        fling = fling_probe(runs, keys)
    except Exception as e:
        fling = {"error": "%s: %s" % (type(e).__name__, e)}
    print(json.dumps({"fling": fling}, indent=1))
    return calibrate_gate(neg, rep)


