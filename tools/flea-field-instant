# Height of the calibration client's header, kept out of the results region.
CALIB_HEADER_PX = 48


def calib_window(work, delay):
    """tests/search-calib.qml under qs: (client, results region, query mask, log path)."""
    cfg = os.path.join(work, "cfg")
    os.makedirs(cfg, exist_ok=True)
    shutil.copyfile(os.path.join(REPO, "tests", "search-calib.qml"), os.path.join(cfg, "shell.qml"))
    logp = os.path.join(work, "client-%d-%d.log" % (delay, time.monotonic_ns()))
    logf = open(logp, "w")
    client = subprocess.Popen(["qs", "-p", cfg, "-n"], env=dict(S.ENV, CALIB_DELAY_MS=str(delay),
                              QT_FORCE_STDERR_LOGGING="1"), stdout=logf, stderr=subprocess.STDOUT)
    logf.close()
    win = S.window_by_pid({client.pid} | S.descendants(client.pid), 20)
    if win is None:
        client.terminate()
        raise RuntimeError("the calibration window never mapped")
    S.focus_window(win["address"])
    S.park_cursor()
    time.sleep(1.0)
    win = window_at(win["address"])
    (x, y), (w, h) = win["at"], win["size"]
    return client, (x, y + CALIB_HEADER_PX, w, h - CALIB_HEADER_PX), [(x, y, w, CALIB_HEADER_PX)], logp


def end_client(client):
    client.terminate()
    try:
        client.wait(5)
    except subprocess.TimeoutExpired:
        client.kill()
    time.sleep(0.5)


def repeat_probe(keys, rep, runs=5):
    """The key events an idle Qt client receives for the held sweep's exact hold: the overshoot bound."""
    interval = 1000.0 / rep["rate"]
    hold_ns = int((rep["delay_ms"] + interval * HOLD_REPEATS + interval / 2) * MS)
    counts = []
    with tempfile.TemporaryDirectory(prefix="flea-instant-repeat-") as work:
        for _ in range(runs):
            client, region, masks, logp = calib_window(work, 0)
            try:
                code = N.keycode("a")
                t = time.monotonic_ns()
                keys._key(code, 1)
                while time.monotonic_ns() < t + hold_ns:
                    pass
                keys._key(code, 0)
                time.sleep(1.0)
            finally:
                end_client(client)
            with open(logp) as f:
                counts.append(sum(1 for line in f if "CALIB key" in line))
    return {"counts": counts, "max_events": max(counts), "hold_ms": round(hold_ns / MS, 1),
            "expected": 1 + repeats_due(0, hold_ns, rep["delay_ms"], interval)}


def negative_control(runs, cap_s=3):
    """No key sent: the recorder over the calibration client's results region must see no change within cap_s."""
    out = []
    with tempfile.TemporaryDirectory(prefix="flea-instant-neg-") as work:
        rec_bin = S.build_recorder(os.path.join(work, "rec"))
        for _ in range(runs):
            client, region, masks, _ = calib_window(work, 0)
            try:
                rec = S.Recorder(rec_bin, region, masks)
                time.sleep(0.6)
                t0 = time.monotonic_ns()
                time.sleep(cap_s)
                changed = [f for f in rec.snapshot() if f[0] > t0 and f[1] > 0]
                rec.stop()
            finally:
                end_client(client)
            out.append(len(changed))
    return {"runs": runs, "cap_s": cap_s, "changed_frames": out, "clean": all(c == 0 for c in out)}


FLING_MM, FLING_MS = -40, 120  # the stroke series_fling plays first
FLING_AIM_QUIET_CAP_NS = 5 * NS  # longest wait for the recorder to go quiet after the pointer is aimed
FLING_QUIET_CAP_NS = 3 * NS  # longest wait for the recorder to go quiet after the stroke
CLOCK_OFFSET_READS = 20  # back to back clock reads clock_offset_ns takes the tightest of
WHEEL_LINE = re.compile(r"CALIB wheel at=(\d+) px=(-?\d+)")


def clock_offset_ns():
    """CLOCK_REALTIME minus CLOCK_MONOTONIC in ns, from the tightest of CLOCK_OFFSET_READS back to back reads."""
    best = None
    for _ in range(CLOCK_OFFSET_READS):
        m0 = time.monotonic_ns()
        w = time.time_ns()
        m1 = time.monotonic_ns()
        if best is None or m1 - m0 < best[0]:
            best = (m1 - m0, w - (m0 + m1) // 2)
    return best[1]


def wheel_ms_of(lines, t_first_ns, offset_ns):
    """ms from the stroke's first motion report (CLOCK_MONOTONIC ns) to the client's first pixel-carrying wheel event, read
    from its log lines on the wall clock; None when it logged none. The client's clock floors to a ms, so this reads up to 1 ms early."""
    for line in lines:
        m = WHEEL_LINE.search(line)
        if m:
            return round(int(m.group(1)) - (t_first_ns + offset_ns) / MS, 1)
    return None


def spread(vals):
    """Count, median and range of the numbers in vals; None entries are reads that failed."""
    nums = [v for v in vals if v is not None]
    if not nums:
        return {"n": 0, "median": None, "min": None, "max": None}
    return {"n": len(nums), "median": round(statistics.median(nums), 1), "min": round(min(nums), 1),
            "max": round(max(nums), 1)}


def fling_floor(wheel_ms, frame_ms):
    """The fling floor of a calibrate run: the medians and ranges of the stroke to the idle client's first wheel event and first frame."""
    return {"stroke": {"dy_mm": FLING_MM, "ms": FLING_MS}, "runs": len(frame_ms), "first_wheel_ms": spread(wheel_ms),
            "first_frame_ms": spread(frame_ms), "wheel_ms": wheel_ms, "frame_ms": frame_ms}


def fling_probe(runs, keys=None):
    """What a fling costs before Flea: the census stroke over tests/search-calib.qml, an idle Qt client, read to the client's
    first pixel-carrying wheel event (its log) and to its first changed frame (the recorder, as the census reads it)."""
    T, why = touchpad()
    if T is None:
        return {"skipped": why}
    keys = keys or N.NavKeys()
    work = tempfile.mkdtemp(prefix="flea-instant-fling-")
    rec_bin = S.build_recorder(os.path.join(work, "rec"))
    wheel_ms, frame_ms = [], []
    fd = T.create()
    try:
        time.sleep(T.CREATE_SETTLE_S)
        for _ in range(runs):
            client, region, masks, logp = calib_window(work, 0)
            rec = None
            try:
                rec = S.Recorder(rec_bin, region, masks)
                pointer_to(keys, region[0] + region[2] // 2, region[1] + region[3] // 2)
                rec.wait_quiet(NS, time.monotonic_ns(), FLING_AIM_QUIET_CAP_NS)
                offset = clock_offset_ns()
                t = stroke(T, fd, FLING_MM, FLING_MS)
                rec.wait_quiet(NS, t, FLING_QUIET_CAP_NS)
                frame_ms.append(S.search_columns(rec.snapshot(), [t], time.monotonic_ns(), NS, FLING_QUIET_CAP_NS)["first_ms"])
                with open(logp) as f:
                    wheel_ms.append(wheel_ms_of(f.read().splitlines(), t, offset))
            finally:
                if rec is not None:
                    rec.stop()
                end_client(client)
    finally:
        drop_touchpad(T, fd)
        S.park_cursor()
    return dict(fling_floor(wheel_ms, frame_ms), workdir=work)


# Loads: the probe of each is read per sample, see the docstring.

LOAD_START_S = 30  # how long a renewed load may take to show its first progress
LOAD_POLL_S = 0.02  # between probe reads while a renewed load is awaited
COLD_BATCH = 48  # pictures linked per renewal of load a, a little over the rows the right pane shows at 2560x1440
COLD_SEQ = 1000000  # the numbers in load a's link names count down from here, so no name is used twice
LOAD_GAP_S = {"a": 0.3, "c": 1.0}  # least time between two renewals, a forced one waits it out; c's folder mtime has second resolution


def load_progress(p):
    """The count of a probe value: a bare number, or the first of a (count, busy) pair."""
    return p[0] if isinstance(p, (tuple, list)) else p


def load_busy(p):
    """True when a probe value says work was in flight at that read; only a (count, busy) pair can."""
    return bool(p[1]) if isinstance(p, (tuple, list)) else False


def load_moved(p0, p1):
    """True when the load progressed since the read p0: its count changed, or it is busy at p1; an unread probe moved nothing."""
    a, b = load_progress(p0), load_progress(p1)
    return a is not None and b is not None and (a != b or load_busy(p1))


def load_active(p_in, p_out):
    """True when the load ran during a sample: it progressed between the read before the input and the read after its quiet, or was busy at the first."""
    return load_moved(p_in, p_out) or (load_progress(p_in) is not None and load_busy(p_in))


def load_evidence(p_in, p_out):
    """The two columns a row carries for its load."""
    return {"load_probe": [p_in, p_out], "load_active": load_active(p_in, p_out)}


class Load:
    """A load beside a series: probe() reads its progress, renew() starts it again (renew_fn None: it runs on its own)."""

    def __init__(self, name, note, probe, renew_fn=None, gap_s=0.0):
        self.name, self.note, self.probe, self.renew_fn, self.gap_s, self.at = name, note, probe, renew_fn, gap_s, None

    def renew(self, force=False):
        """Start the load again; False when gap_s has not passed since the last time, unless force: that waits out the rest of the gap."""
        if self.renew_fn is None:
            return False
        wait = 0.0 if self.at is None else self.gap_s - (time.monotonic() - self.at)
        if wait > 0:
            if not force:
                return False
            time.sleep(wait)
        self.at = time.monotonic()
        self.renew_fn()
        return True


def link_cold(src, names, dst, seq, n, linked=None):
    """Link n cold pictures into dst under names that sort just after the first name there; seq[0] counts down across calls so no name repeats. Returns the new paths; linked, when given, is that list and names only the links that exist when a link fails."""
    stem = os.path.splitext(min(os.listdir(dst)))[0]  # the right pane's cursor stays on its first row and a re-read keeps that row's screen y, so the new rows must fall below it
    linked = [] if linked is None else linked
    for _ in range(n):
        seq[0] -= 1
        name = names[seq[0] % len(names)]
        path = os.path.join(dst, "%s.k%06d%s" % (stem, seq[0], os.path.splitext(name)[1]))
        os.link(os.path.join(src, name), path)
        linked.append(path)
    return linked


def load_renew(sess, load, ctx):
    """The function that starts load a or c again, or None: a swaps the batch of pictures linked into the right folder for a fresh one, c changes the NAS folder's mtime."""
    if load == "a":
        cold = os.path.join(ctx["root"], "load", "cold-src")
        names, seq, batch = sorted(os.listdir(cold)), [COLD_SEQ], []

        def drop():
            while batch:  # the right folder keeps its size, so every sample re-reads the same load; batch names only what is left
                sandbox_rm(batch[-1], ctx["roots"])
                batch.pop()

        def renew():
            if not names:
                raise RuntimeError("no cold images in %s" % cold)
            drop()
            try:
                link_cold(cold, names, sess.right, seq, COLD_BATCH, batch)
            except OSError:  # a link that failed midway leaves no partial batch in the folder
                drop()
                raise
        return renew
    if load == "c":
        mark = os.path.join(sess.right, ".restart")

        def renew():
            open(mark, "w").close()
            sandbox_rm(mark, ctx["roots"])
        return renew
    return None


LOAD_D_NAME = "load-d.bin"
LOAD_D_MIB = 4000  # bs=4M count=1000, the size of load b's file


def load_d_command(sink):
    """Load d's writer: direct 4 MiB writes, so the stick's own rate is the load and the page cache holds none of it."""
    return ["dd", "if=/dev/zero", "of=" + sink, "bs=4M", "count=1000", "oflag=direct"]


def load_stop(sess):
    """End a load-d writer still running, so no write reaches the stick once the session's series is over."""
    proc = getattr(sess, "load_proc", None)
    if proc is None or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(10)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()


def load_start(sess, load, ctx):
    """Start a load in the right pane; (probe, note). probe() changes while the load runs."""
    roots = ctx["roots"]
    if load == "a":
        thumbs = os.path.join(ctx["sbx"], "cache", "thumbnails")

        def probe():
            return sum(len(fs) for _, _, fs in os.walk(thumbs)) if os.path.isdir(thumbs) else 0
        return probe, "thumbnails of a cold image folder in the right pane"
    if load == "b":
        dst = os.path.realpath(sess.right)
        empty_dir(dst, roots)
        for c in (("end",), ("ctrl", "c"), ("tab",), ("ctrl", "v"), ("tab",), ("home",)):
            sess.keys.chord(*c)
            time.sleep(0.3)

        def probe():
            return sum(os.path.getsize(os.path.join(dst, f)) for f in os.listdir(dst))
        return probe, "copy of a %d MiB file to the USB stick from the right pane" % LONG_MIB
    if load == "d":
        sink = os.path.join(os.path.realpath(sess.right), LOAD_D_NAME)
        sess.load_proc = subprocess.Popen(load_d_command(sink), stdin=subprocess.DEVNULL,
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def probe():
            return os.path.getsize(sink) if os.path.exists(sink) else 0
        return probe, "dd of %d MiB to the USB stick, no Flea copy, the right pane lists its folder" % LOAD_D_MIB

    def right_listing():
        """(list requests, listing in flight) of the right pane, from the dualState IPC; (None, False) when unreadable."""
        try:
            # Sample input: {"active": true, "focused": 0, "panes": [{"path": "/a", "total": 3, "cursor": 0, "loading": false, "selected": [], "focused": true, "listRequests": 4}, null]} (ui/Ipc.qml dualState)
            panes = json.loads(sess.ipc("dualState") or "{}").get("panes") or []
            right = panes[1] or {}
            return right.get("listRequests"), bool(right.get("loading"))
        except (ValueError, IndexError, AttributeError, OSError, subprocess.SubprocessError):
            return None, False
    return right_listing, "NAS listing streaming in the right pane"


def run_series(sess, sp, n):
    """A series' rows; an error or an outside window ends it with the rows already built plus its error row; under a load every row names it and says whether it ran during that sample."""
    sess.taken = []  # the series build their rows in this list, so a failure keeps them
    try:
        rows = SERIES[sp["type"]](sess, sp, n)
    except ExternalWindow as e:
        rows = sess.taken + [e.row]
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as e:
        rows = sess.taken + [{"journey": sp["type"], "view": sess.view, "error": "%s: %s" % (type(e).__name__, e)}]
    for r in rows if sess.load else ():
        r.update({"load": sess.load.name, "load_note": sess.load.note})
        r.setdefault("load_probe", None)
        r.setdefault("load_active", False)
    return rows


def run_session(spec, ctx, out):
    """One session's series; rows go to out as they finish. A failure is an error row, never a gap."""
    where = spec.get("where", "local")
    right = None
    try:
        if spec.get("op"):
            setup_op_dirs(spec, ctx)
        fixture = spec["fixture"]
        if spec.get("load"):
            right = load_right(spec["load"], ctx)
            if right is None:
                raise RuntimeError("load %s needs a %s fixture" % (spec["load"], "USB" if spec["load"] in ("b", "d") else "NAS"))
        sess = Session(ctx, fixture, spec["view"], spec["region"], right,
                       os.path.join(ctx["out_dir"], "flea-%s.log" % ctx["tag"]), ui=spec.get("ui"))
    except (RuntimeError, OSError, subprocess.SubprocessError) as e:
        emit(out, {"journey": "session", "view": spec.get("view"), "fixture": where,
                   "error": "%s: %s" % (type(e).__name__, e)})
        if spec.get("load") in ("b", "d") and right is not None:
            drop_load_dst(right, ctx["roots"])
        return
    sess.right = right
    try:
        if spec.get("load"):
            probe, note = load_start(sess, spec["load"], ctx)
            sess.load = Load(spec["load"], note, probe, load_renew(sess, spec["load"], ctx), LOAD_GAP_S.get(spec["load"], 0.0))
            sess.settle(1.0, 5)
        for sp in spec["series"]:
            for r in run_series(sess, sp, spec["n"]):
                r.setdefault("fixture", where)
                emit(out, r)
    finally:
        load_stop(sess)
        sess.close()
        if spec.get("load") in ("b", "d") and right is not None:
            drop_load_dst(right, ctx["roots"])


def setup_op_dirs(spec, ctx):
    """ROOT/ops/run/<op>/{a-dst,b-src}; a-dst links to a fresh dir on the USB stick for a cross-fs op."""
    base = spec["fixture"]
    os.makedirs(os.path.join(base, "b-src"), exist_ok=True)
    name = spec["op"]
    dst = os.path.join(base, "a-dst")
    if name in OPS and OPS[name]["usb"]:
        if not ctx["fx"].get("usb"):
            raise RuntimeError("%s needs the USB fixture" % name)
        if not os.path.lexists(dst):
            os.symlink(tempfile.mkdtemp(prefix="dst-", dir=os.path.join(ctx["fx"]["usb"], "dst")), dst)
    else:
        os.makedirs(dst, exist_ok=True)
    if name == "op.size.recursive" and not os.path.exists(os.path.join(base, "b-src", "tree")):
        reflink(os.path.join(ctx["root"], "ops", "size", "tree"), os.path.join(base, "b-src"))
    if name == "op.archive" and not os.path.exists(os.path.join(base, "b-src", "src-dir")):
        reflink(os.path.join(ctx["root"], "ops", "src-archive", "src-dir"), os.path.join(base, "b-src"))
    spec["fixture"] = os.path.join(base, "b-src")
    ctx["op_base"] = base


def drop_load_dst(path, roots):
    """Remove a load-b or load-d session's own dst directory, by the same checks as every sandbox removal."""
    if not os.path.basename(path).startswith("dst-"):
        raise SystemExit("refusing to remove %s: not a load-b or load-d dst directory" % path)
    sandbox_rm(path, roots)


def load_right(load, ctx):
    """The right pane's path for a load: a fresh cold image copy, a USB destination, or the NAS stream folder."""
    if load == "a":
        d = tempfile.mkdtemp(prefix="cold-", dir=os.path.join(ctx["root"], "load"))
        for f in os.listdir(os.path.join(ctx["root"], "load", "cold-src")):
            os.link(os.path.join(ctx["root"], "load", "cold-src", f), os.path.join(d, f))
        return d
    if load in ("b", "d"):
        return tempfile.mkdtemp(prefix="dst-", dir=os.path.join(ctx["fx"]["usb"], "dst")) if ctx["fx"].get("usb") else None
    return os.path.join(ctx["fx"]["nas"], "stream") if ctx["fx"].get("nas") else None


def emit(out, row):
    out.write(json.dumps(row) + "\n")
    out.flush()


def dry_targets(sessions):
    """Per session, the pointer of a wheel or stroke and the Enter row of a folder cycle, resolved on a nominal 2560x1440 window."""
    nominal = (0, 0, 2560, 1440)
    out, bad = [], 0
    for s in sessions:
        if s.get("missing"):
            continue
        view, region = s.get("view"), win_rect(nominal, s.get("region", "content"))
        for sp in s["series"]:
            t = {"view": view, "fixture": os.path.basename(s["fixture"]), "series": sp["type"]}
            if sp["type"] in ("wheel", "fling"):
                t["pointer"] = list(scroll_point(view, region, win_rect(nominal, "left")))
                t["aim"] = "centre of the left pane" if view == "dual" else "centre of the watched region"
            elif sp["type"] == "cycle" and sp.get("to_folder"):
                try:
                    keys = folder_setup(ui_patch(view, s["fixture"]), s["fixture"])
                    t["enter_index"] = len(keys) - 1
                    t["aim"] = "the first folder, row 0 with folders first"
                    t["setup"] = [c[1][0] for c in keys]
                except (RuntimeError, OSError) as e:
                    t["enter_index"], t["error"] = None, "%s: %s" % (type(e).__name__, e)
                    bad += 1
            else:
                continue
            if s.get("load"):
                t["load"] = s["load"]
            out.append(t)
    return out, bad


def run_part(part, root, tree, out_dir, samples=20, dry=False, evidence=True, only=None, frontend=None, binary=None):
    with open(os.path.join(os.path.realpath(root), "fixtures.json")) as f:
        fx = json.load(f)
    sessions = parts(fx, samples)[part]
    if only is not None:
        sessions = only_series(sessions, only)
        if not sessions:
            print("--only %r matches no journey of part %s" % (only, part), file=sys.stderr)
            return 2
    if dry:
        js = sorted(journeys_of(sessions))
        unmapped = [j for j in js if row_of(j) is None]
        targets, bad = dry_targets(sessions)
        print(json.dumps({"part": part, "only": only, "sessions": len(sessions), "journeys": js, "unmapped": unmapped,
                          "targets": targets, "estimate_min": ESTIMATE_MIN[part]}, indent=1))
        return 1 if unmapped or bad else 0
    os.makedirs(out_dir, exist_ok=True)
    S.ENV = S.session_env()
    os.environ.update(S.ENV)
    S.UI_TOKENS[:] = [tree + "/ui"]
    S.GUI_BINARIES[:] = S.flea_gui_binaries([{"entrant": "flea", "flea_dir": tree, "flea_bin": binary}])
    S.require_idle()
    keys = N.NavKeys()
    ctx = {"tree": tree, "root": fx["root"], "fx": fx, "sbx": fx["root"], "out_dir": out_dir, "keys": keys,
           "states": {}, "evidence": evidence, "frontend": frontend or S.Product.frontend({}), "binary": binary, "config_home": os.environ.get("XDG_CONFIG_HOME") or
           os.path.expanduser("~/.config"),
           "roots": [fx["root"]] + [fx[x] for x in ("usb", "nas") if fx.get(x)]}
    ctx["rec_bin"] = S.build_recorder(os.path.join(out_dir, "rec"))
    plan = {"part": part, "root": root, "flea": tree, "out": out_dir, "samples": samples}
    if only is not None:
        plan["only"] = only
    ctx["repeat"] = repeat_settings(plan)
    if part in ("p2-held", "smoke"):
        ctx["repeat"].update(repeat_probe(keys, ctx["repeat"]))
    mon = S.monitor()
    rev = subprocess.run(["git", "-C", tree, "rev-parse", "HEAD"], capture_output=True, text=True, env=S.parsed_env())
    head = rev.stdout.strip()
    if rev.returncode != 0 or not head:
        raise SystemExit("flea tree %s is not a git tree, git rev-parse HEAD says: %s" % (tree, rev.stderr.strip() or "nothing"))
    out_path = os.path.join(out_dir, "census-%s.jsonl" % part)
    with open(out_path, "x") as out:
        emit(out, {"manifest": {"date": time.strftime("%Y-%m-%d %H:%M:%S"), "host": socket.gethostname(),
                                "plan": plan, "flea_head": head, "repeat": ctx["repeat"],
                                "product": S.arm_identity({"entrant": "flea", "flea_dir": tree,
                                                           "flea_bin": binary, "frontend": ctx["frontend"]}),
                                "monitor": {x: mon.get(x) for x in ("name", "width", "height", "refreshRate", "scale")},
                                "quiet_s": QUIET, "cap_s": CAP, "pace_ms": PACE_MS, "budget": BUDGET}})
        for i, spec in enumerate(sessions):
            if spec.get("missing"):
                emit(out, {"journey": "fixture", "fixture": spec["missing"], "first_ms": "no instrument",
                           "note": "no %s fixture in fixtures.json" % spec["missing"]})
                continue
            ctx["tag"] = "%s-s%02d" % (part, i)
            t0 = time.monotonic()
            run_session(dict(spec), ctx, out)
            print("%s session %d/%d %s %s done in %.0f s" % (part, i + 1, len(sessions), spec.get("view"),
                                                            os.path.basename(spec["fixture"]), time.monotonic() - t0),
                  flush=True)
    print(out_path)
    return 0


# Report.


def fmt(v):
    return "miss" if v is None else ("%.1f" % v)


GATE_MIN_SAMPLES = 20  # rows per journey at 20 samples when no manifest names the part


def aggregate(paths):
    """Census JSONL paths into grouped numeric rows, notes, errors and manifests, shared by report and gate."""
    rows, manifests = [], []
    for p in paths:
        with open(p) as f:
            for line in f:
                d = json.loads(line)
                (manifests.append(d["manifest"]) if "manifest" in d else rows.append(d))
    groups, notes, errors = {}, [], []
    for r in rows:
        if "error" in r:
            errors.append(r)
            continue
        if isinstance(r.get("first_ms"), str):
            notes.append(r)
            continue
        fixture = r.get("fixture", "local") + ("+load-" + r["load"] if r.get("load") else "")
        groups.setdefault((r["journey"], r.get("view", "-"), fixture), []).append(r)
    return groups, notes, errors, manifests


def case_of(key, g):
    """One grouped journey with its budget verdict, the numbers both report and gate print."""
    journey, view, fixture = key
    row = row_of(journey, fixture.split("+")[0]) or g[0].get("row")
    firsts = [r.get("first_ms") for r in g]
    settled = [r.get("settled_ms") for r in g]
    held = [r["held"] for r in g if r.get("held")]
    video = journey.split(".")[-1] == "video" or journey.endswith("video.first")
    return {"key": key, "journey": journey, "view": view, "fixture": fixture, "row": row, "firsts": firsts,
            "settled": settled, "held": held, "video": video,
            "verdict": judge(row, firsts, settled, video, held)}


def fling_floor_of(path):
    """(floor, why) from a calibrate output of concatenated JSON objects: its last "fling" object, kept when a later part does not
    parse; floor is None and why names the file and the cause when the file is unreadable, holds no fling object or does not parse."""
    try:
        with open(path, errors="replace") as f:
            text = f.read()
    except OSError as e:
        return None, "%s: %s" % (path, e.strerror or e)
    dec, i, found, bad = json.JSONDecoder(), 0, None, None
    while True:
        while i < len(text) and text[i].isspace():
            i += 1
        if i >= len(text):
            break
        try:
            obj, i = dec.raw_decode(text, i)
        except json.JSONDecodeError as e:
            bad = e.pos
            break
        if isinstance(obj, dict) and isinstance(obj.get("fling"), dict):
            found = obj["fling"]
    if found is not None:
        return found, None
    return None, "%s: %s" % (path, "no fling object" if bad is None else "parse error at offset %d" % bad)


def fling_floor_note(floor):
    """The fling floor as a report note, beside the fling rows; the ceiling less the floor is the room left for Flea. Never judged."""
    if not floor:
        return None
    if "first_frame_ms" not in floor:
        return "fling floor not read (%s)" % (floor.get("skipped") or floor.get("error") or "no runs")
    w, f = floor["first_wheel_ms"], floor["first_frame_ms"]
    if f["median"] is None:
        return "fling floor not read: no run drew a frame"
    left = BUDGET[1]["ceiling_ms"] - f["median"]
    return ("idle client floor, stroke to first wheel event p50 %s (%s to %s), to first frame p50 %s (%s to %s) over %d runs, "
            "%.1f left under the %s ms ceiling, not subtracted" % (
                fmt(w["median"]), fmt(w["min"]), fmt(w["max"]), fmt(f["median"]), fmt(f["min"]), fmt(f["max"]),
                floor["runs"], left, BUDGET[1]["ceiling_ms"]))


def report(paths, out=None, floor=None):
    """The census table: one line per (journey, view, fixture, load), with the budget row's target and verdict; floor is a calibrate "fling" object."""
    groups, notes, errors, manifests = aggregate(paths)
    lines = ["# Instant budget census", ""]
    for m in manifests:
        lines.append("- %s on %s, Flea %s, part %s, repeat %s ms delay at %s a second (%s)" % (
            m.get("date"), m.get("host"), (m.get("flea_head") or "?")[:10], m["plan"]["part"],
            m["repeat"]["delay_ms"], m["repeat"]["rate"], m["repeat"].get("source")))
    lines += ["", "Times are ms from the input to the first frame whose watched region changes with ink (first_ms), "
              "p50 and p95 nearest rank, a miss (nothing drawn before the next input or the cap) ranked above "
              "every number. Row 2 lists the largest gap between drawn frames in each sweep; its verdict reads the "
              "repeat slots and the overshoot. Row 5 lists first_ms; its verdict also reads settled_ms.", "",
              "| row | journey | view | fixture | n | p50 | p95 | max | target | ceiling | verdict | notes |",
              "|---|---|---|---|---|---|---|---|---|---|---|---|"]
    order = sorted(groups, key=lambda g: (row_of(g[0], g[2].split("+")[0]) or 9, g[0], g[1], g[2]))
    tally = {}
    for key in order:
        g = groups[key]
        c = case_of(key, g)
        journey, view, fixture = c["journey"], c["view"], c["fixture"]
        row, firsts, settled, held, video, verdict = c["row"], c["firsts"], c["settled"], c["held"], c["video"], c["verdict"]
        tally[verdict] = tally.get(verdict, 0) + 1
        b = BUDGET[row]
        note = []
        missed = sum(1 for v in firsts if v is None)
        if missed:
            note.append("%d miss" % missed)
        if any(r.get("refused") for r in g):
            note.append("%d refused" % sum(1 for r in g if r.get("refused")))
        if any(r.get("capped") for r in g):
            note.append("%d capped" % sum(1 for r in g if r.get("capped")))
        if any(r.get("pre_quiet") is False for r in g):
            note.append("%d not quiet before" % sum(1 for r in g if r.get("pre_quiet") is False))
        if row == 2:
            note.append("slots missed %s, overshoot %s, behind %s" % (
                ",".join(str(h["slots_missed"]) for h in held), ",".join(str(h["overshoot"]) for h in held),
                ",".join(str(h["steps_behind"]) for h in held)))
        if row in (5, 6):
            st = [v for v in settled if v is not None]
            if st:
                note.append("settled p95 %s" % fmt(p95(settled)))
        if journey.endswith(".fling") and fling_floor_note(floor):
            note.append(fling_floor_note(floor))
        if any(r.get("load") for r in g):
            note.append("load active %d/%d" % (sum(1 for r in g if r.get("load_active")), len(g)))
        if any(r.get("evidence") for r in g):
            note.append("evidence %s" % os.path.basename(next(r["evidence"] for r in g if r.get("evidence"))))
        if any(r.get("evidence_11s") for r in g):
            note.append("11 s frame %s" % os.path.basename(next(r["evidence_11s"] for r in g if r.get("evidence_11s"))))
        target = b["target_ms"] if row != 2 else "25 slots"
        ceiling = b["ceiling_ms"] if row not in (2, 5) else ("0 overshoot" if row == 2 else "100 / 1000")
        lines.append("| %d | %s | %s | %s | %d | %s | %s | %s | %s | %s | %s | %s |" % (
            row, journey, view, fixture, len(g), fmt(p50(firsts)), fmt(p95(firsts)),
            fmt(max(firsts, key=lambda v: math.inf if v is None else v)), target, ceiling, verdict, "; ".join(note)))
    lines += ["", "Verdicts: " + ", ".join("%s %d" % kv for kv in sorted(tally.items()))]
    for r in notes:
        lines.append("- %s %s %s: %s (%s)" % (r.get("journey"), r.get("view", ""), r.get("fixture", ""),
                                             r["first_ms"], r.get("note", "")))
    for r in errors:
        lines.append("- %s %s %s %s: %s" % ("harness fault" if r.get("harness_fault") else "error", r.get("journey"),
                                          r.get("view", ""), r.get("fixture", ""), r["error"]))
    text = "\n".join(lines) + "\n"
    if out:
        with open(out, "w") as f:
            f.write(text)
    print(text, end="")
    return 0


def gate_ceiling(row, case):
    """Numeric ceiling of a BREACH line: row 5 names the settled limit when only it is over."""
    if row == 2:
        return 0
    if row == 5:
        f95 = p95(case["firsts"])
        if f95 is not None and f95 <= BUDGET[5]["ceiling_ms"]:
            return BUDGET[5]["content_ceiling_ms"]
        return BUDGET[5]["ceiling_ms"]
    return BUDGET[row]["ceiling_ms"]


def gate_shown_p95(row, case):
    """p95 of a BREACH line: row 5 names the settled p95 when only it is over."""
    if row == 5:
        f95 = p95(case["firsts"])
        if f95 is not None and f95 <= BUDGET[5]["ceiling_ms"]:
            return p95(case["settled"])
    return p95(case["firsts"])


def resolve_part(name):
    """A part name from --part: a full PARTS name or a pN short form; None when unknown."""
    if name in PARTS:
        return name
    hits = [p for p in PARTS if p.startswith(name + "-")]
    return hits[0] if len(hits) == 1 else None


def gate(paths, out=None, only=None, pattern=None):
    """Pass or fail the census against the budget ceilings; a missing journey never passes, except one a --only pattern drops."""
    if not paths:
        print("need census .jsonl files, got none", file=sys.stderr)
        return 2
    # A part named twice (p1 and p1-cursor) is planned once, so its minima never double.
    expected = PARTS if only is None else list(dict.fromkeys(resolve_part(p) or p for p in only))
    groups, notes, errors, manifests = aggregate(paths)
    order = sorted(groups, key=lambda g: (row_of(g[0], g[2].split("+")[0]) or 9, g[0], g[1], g[2]))
    need = {}
    for part in expected:
        for key, n in planned_counts(part, GATE_MIN_SAMPLES, PLAN_FX, pattern).items():
            need[key] = need.get(key, 0) + n
    seen_parts, sample_lines = set(), []
    part_manifests = {}
    for m in manifests:
        plan = m.get("plan", {})
        part = plan.get("part")
        if part in PARTS:
            seen_parts.add(part)
            part_manifests[part] = part_manifests.get(part, 0) + 1
            if not m.get("flea_head"):
                sample_lines.append("GATE MISSING %s manifest has an empty flea_head" % part)
            s = plan.get("samples", GATE_MIN_SAMPLES)
            if s < GATE_MIN_SAMPLES:
                sample_lines.append("GATE MISSING %s plan samples %s, under the defined %s" % (part, s, GATE_MIN_SAMPLES))
    for part in sorted(part_manifests):
        if part_manifests[part] > 1:
            sample_lines.append("GATE MISSING part %s has %d manifests, so its rows came from more than one run" % (part, part_manifests[part]))
    breaches, missing, seen = [], list(sample_lines), set()
    for part in expected:
        if part not in seen_parts:
            missing.append("GATE MISSING part %s" % part)
    for key in order:
        g = groups[key]
        seen.add(key)
        c = case_of(key, g)
        want = need.get(key, GATE_MIN_SAMPLES)
        if len(g) < want:
            missing.append("GATE MISSING %s %s %s n=%d needs %d" % (
                c["journey"], c["view"], c["fixture"], len(g), want))
            continue
        if c["verdict"] == "NO-READ":
            missing.append("GATE MISSING %s %s %s no readable samples n=%d" % (
                c["journey"], c["view"], c["fixture"], len(g)))
            continue
        idle = sum(1 for r in g if not r.get("load_active")) if "+load-" in c["fixture"] else 0
        if idle:
            missing.append("GATE MISSING %s %s %s load inactive in %d of %d samples" % (
                c["journey"], c["view"], c["fixture"], idle, len(g)))
        if c["verdict"] == "BREACH":
            breaches.append("GATE BREACH %s %s %s p95=%s ceiling=%s" % (
                c["journey"], c["view"], c["fixture"], fmt(gate_shown_p95(c["row"], c)), gate_ceiling(c["row"], c)))
    for r in notes:
        key = (r.get("journey", "?"), r.get("view", ""), r.get("fixture", ""))
        seen.add(key)
        missing.append("GATE MISSING %s %s %s %s (%s)" % (key[0], key[1], key[2], r.get("first_ms"), r.get("note", "")))
    for r in errors:
        key = (r.get("journey", "?"), r.get("view", ""), r.get("fixture", ""))
        seen.add(key)
        missing.append("GATE MISSING %s %s %s error %s" % (key[0], key[1], key[2], r.get("error")))
    for key in sorted(need, key=lambda g: (row_of(g[0], g[2].split("+")[0]) or 9, g[0], g[1], g[2])):
        if key not in seen:
            missing.append("GATE MISSING %s %s %s n=0 needs %d" % (key[0], key[1], key[2], need[key]))
    if breaches or missing:
        summary = "GATE FAIL breaches=%d journeys=%d" % (len(breaches), len(seen))
        code = 2 if missing else 1
    else:
        summary = "GATE PASS journeys=%d" % len(seen)
        code = 0
    text = "\n".join(breaches + missing + [summary]) + "\n"
    if out:
        with open(out, "w") as f:
            f.write(text)
    print(text, end="")
    return code


