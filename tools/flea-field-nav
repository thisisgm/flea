def keycode(name):
    if name in S.KEYCODES:
        return S.KEYCODES[name]
    return EXTRA_KEYCODES[name]


class NavKeys(S.Keys):
    def chord(self, *names):
        """Press the names in order, release in reverse; the CLOCK_MONOTONIC ns before the last key-down."""
        codes = [keycode(n) for n in names]
        for c in codes[:-1]:
            self._key(c, 1)
        t = time.monotonic_ns()
        self._key(codes[-1], 1)
        self._key(codes[-1], 0)
        for c in reversed(codes[:-1]):
            self._key(c, 0)
        return t


