    ql_plan = os.path.join(ql_dir, "plan.json")
    with open(ql_plan, "w") as f:
        json.dump({"out": ql_out, "runs": 2, "fixtures": {"qltable": ql_dir},
                   "arms": [{"id": "f", "entrant": "flea"}], "columns": ["ql"]}, f)
    globals()["run_ql"] = fake_ql
    S.arm_identity = lambda arm: {"version": "fixture"}
    globals()["make_ctx"] = fake_ctx
    S.require_idle = lambda: None
    S.fixture_facts = lambda p: {}
    S.monitor = lambda: {"name": "t", "width": 1, "height": 1, "refreshRate": 60, "scale": 1}
    try:
        with redirect_stdout(io.StringIO()):
            measure(ql_plan)
        check("ql_rotates", [k for _, k in seen], [QL_KINDS, QL_KINDS[1:] + QL_KINDS[:1]])
        check("ql_root", {q for q, _ in seen}, {ql_dir})
    finally:
        globals()["run_ql"] = saved_ql
        globals().update(saved_fns2)
        S.arm_identity = saved_identity
        S.require_idle, S.fixture_facts, S.monitor = saved_s[:3]
        S.UI_TOKENS[:] = saved_s[3]
        if os.path.isabs(ql_dir) and ql_dir.startswith(tempfile.gettempdir() + os.sep) and "nav-ql-" in ql_dir:
            shutil.rmtree(ql_dir)
    # View arms: a known flea view passes, an unknown one refuses, a rival plans default.
    check("view_ok", check_arm_view({"id": "f", "entrant": "flea", "view": "grid"}), None)
    try:
        check_arm_view({"id": "f", "entrant": "flea", "view": "wall"})
        fail.append("view_wall: no refusal for an unknown view")
    except SystemExit:
        pass
    check("view_rival", check_arm_view({"id": "n", "entrant": "nautilus", "view": "grid"}), None)
    # explore ends every target the search table names, so it refuses over a running one as measure does.
    explore_ran, saved_idle, saved_explore = [], S.require_idle, {n: globals()[n] for n in ("make_ctx", "run_cursor")}

    def busy():
        explore_ran.append("idle")
        raise SystemExit("already running")
    S.require_idle = busy
    globals()["make_ctx"] = lambda out: explore_ran.append("ctx") or {"keys": None}
    globals()["run_cursor"] = lambda *a: explore_ran.append("cursor") or []
    try:
        with redirect_stdout(io.StringIO()):
            explore(["flea", "fixture", "cursor"])
        fail.append("explore_idle: explore started over a running target")
    except SystemExit as stop:
        check("explore_idle_refusal", str(stop), "already running")
    finally:
        S.require_idle = saved_idle
        globals().update(saved_explore)
    check("explore_idle_ran", explore_ran, ["idle"])
    # Settle from the rows wait end: quiet history falls back, a busy run caps there.
    det = [(1100 * ms, 0, 50, 0, 0, 50, 50, 60), (1200 * ms, 0, 200, 110, 300, 120, 700, 10)]
    cols = launch_columns(det, 1000 * ms, win, content, 20000 * ms, settle_from_ns=5000 * ms)
    check("settle_from_fallback", cols["settled_ms"], 200.0)
    det = [(t * ms, 0, 3, 210, 500, 160, 700, 30) for t in range(1000, 40000, 500)]
    cols = launch_columns(det, 500 * ms, win, content, 40000 * ms, settle_from_ns=1000 * ms)
    check("settle_from_cap", (cols["settled_ms"], cols["capped"]), (15500.0, True))
    # Measure refuses an existing output instead of appending a second manifest.
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as tf:
        tf.write("{}\n")
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as pf:
        json.dump({"out": tf.name, "runs": 1, "fixtures": {}, "arms": []}, pf)
    try:
        measure(pf.name)
        fail.append("out_refuse: measure appended to an existing out")
    except SystemExit as e:
        if "refusing to append to existing" not in str(e.code):
            fail.append("out_refuse: measure stopped for another reason: %s" % e.code)
    finally:
        os.unlink(tf.name)
        os.unlink(pf.name)
    # Pane mode opens and checks the panel before the walk: a key stub records chords, and captures of striped rows hold a panel block from a known edge.
    class ChordKeys:
        def __init__(self):
            self.chords = []
            self.now = 1000 * ms
        def chord(self, *names):
            self.chords.append(list(names))
            self.now += 10 * ms
            return self.now
    class PanelRec:
        def __init__(self, frames, edges):
            self.frames = frames
            self.edges = list(edges)
        def wait_quiet(self, *args):
            return True
        def snapshot(self):
            return list(self.frames)
        def dump(self):
            return panel_ppm(self.edges.pop(0))
    def panel_ppm(edge, w=100, h=60):
        path = os.path.join(tmp_dir, "panel-%s-%d.ppm" % (edge, len(os.listdir(tmp_dir))))
        row = [bytes((240, 240, 240) if (y // 5) % 2 else (230, 230, 230)) for y in range(h)]
        with open(path, "wb") as f:
            f.write(b"P6\n%d %d\n255\n" % (w, h))
            for y in range(h):
                f.write(b"".join(row[y] if edge is None or x < edge else bytes((120, 130, 160))
                                 for x in range(w)))
        return path
    tmp_dir = tempfile.mkdtemp()
    stub = ChordKeys()
    panel_at = stub.now + 100 * ms
    t_panel = ensure_pane_panel(stub, PanelRec([(panel_at, 5, 40)], [None, 70]), "dolphin")
    check("pane_chord", stub.chords, [["f11"]])
    check("pane_panel_after_key", t_panel < panel_at, True)
    check("pane_edge_none", panel_edge(100, 60, S.read_ppm(panel_ppm(None))[2]), None)
    check("pane_edge_at", panel_edge(100, 60, S.read_ppm(panel_ppm(70))[2]), 70)
    # A panel saved open: the key closes it, a second press reopens it, and that second press is timed.
    stub = ChordKeys()
    t_panel = ensure_pane_panel(stub, PanelRec([(stub.now + 100 * ms, 5, 40)], [70, None, 70]), "dolphin")
    check("pane_reopen_chords", stub.chords, [["f11"], ["f11"]])
    check("pane_reopen_timed_second", t_panel, stub.now)
    # Each refusal names the pane walk: no change frame, a stale frame, a frame with no ink, no edge, an edge both times, a close that stays closed, a reopen elsewhere.
    refused = {
        "pane_shut": (PanelRec([(100 * ms, 0, -1)], [None, None]), "dolphin"),
        "pane_stale": (PanelRec([(100 * ms, 5, 40)], [None, 70]), "dolphin"),
        "pane_noink": (PanelRec([(1500 * ms, 5, 0)], [None, 70]), "dolphin"),
        "pane_flat": (PanelRec([(1500 * ms, 5, 40)], [None, None]), "dolphin"),
        "pane_still": (PanelRec([(1500 * ms, 5, 40)], [70, 70]), "dolphin"),
        "pane_stays_closed": (PanelRec([(1500 * ms, 5, 40)], [70, None, None]), "dolphin"),
        "pane_moved": (PanelRec([(1500 * ms, 5, 40)], [70, None, 50]), "dolphin"),
        "pane_nokey": (PanelRec([], []), "thunar"),
    }
    # A forced quicklook on an entrant with no quicklook key is a named refusal, not an IndexError from an empty chord.
    try:
        run_preview({"id": "d", "entrant": "dolphin"}, "/none", None, None, "default", "quicklook", ["table"], {})
        fail.append("quicklook_nokey: no refusal")
    except Exception as e:
        check("quicklook_nokey_names", str(e), "no quicklook key for dolphin, so the quicklook preview cannot open")
    for name, (rec, who) in refused.items():
        try:
            ensure_pane_panel(ChordKeys(), rec, who)
            fail.append(name + ": no refusal")
        except RuntimeError as e:
            check(name + "_names", "pane" in str(e) or "no panel key" in str(e), True)
    nocap = PanelRec([], [])
    nocap.dump = lambda: None
    try:
        ensure_pane_panel(ChordKeys(), nocap, "dolphin")
        fail.append("pane_nocapture: no refusal")
    except RuntimeError as e:
        check("pane_nocapture_names", "no capture" in str(e), True)
    # An arm with preview null or empty records the mode it measures, not null.
    for off in (None, ""):
        got = manifest_entrants([{"id": "a", "entrant": "flea", "preview": off}])["a"]["preview"]
        check("manifest_preview_%r" % off, got, preview_default("flea"))
    shutil.rmtree(tmp_dir)
    if fail:
        print("\n".join("FAIL " + f for f in fail))
        return 1
    print("SELFTEST ok")
    return 0


def preflight():
    """Core needs, entrant binaries and fixture makers, one ok/MISSING line each; exit 0 always."""
    for tool in ("qs", "hyprctl", "gcc", "wayland-scanner", "ydotool", "ffmpeg", "kitty",
                 "nautilus", "thunar", "nemo", "dolphin", "pcmanfm", "convert", "magick"):
        path = shutil.which(tool)
        print("%-8s %-12s %s" % ("ok" if path else "MISSING", tool, path or ""))
    base = os.environ.get("WAYLAND_PROTOCOLS", "/usr/share/wayland-protocols") + "/staging/"
    for x in S.PREFLIGHT_XML:
        have = os.access(base + x + ".xml", os.R_OK)
        print("%-8s %-12s %s" % ("ok" if have else "MISSING", "protocol xml", base + x + ".xml"))
    try:
        sbin = S.strata_bin()
        good = os.access(sbin, os.X_OK)
        print("%-8s %-12s %s" % ("ok" if good else "MISSING", "strata", sbin))
    except SystemExit as e:
        print("MISSING   strata %s" % e)
    sock = os.environ.get("YDOTOOL_SOCKET") or os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), ".ydotool_socket")
    print("%-8s %-12s %s" % ("ok" if os.path.exists(sock) else "MISSING", "ydotool socket", sock))
    return 0


def explore(argv):
    """explore ENTRANT FIXTURE COLUMN: COLUMN is cursor (in view), scroll, enter, back, preview [--kind K] or
    launch [--size S]; [--view V] [--flea TREE] [--preview MODE] [--out DIR] [--json FILE] qualify it."""
    ent, fixture, column = argv[0], argv[1], argv[2]
    if ent not in NAV:
        raise SystemExit("explore names an entrant the key table does not hold: " + ent)
    flea = argv[argv.index("--flea") + 1] if "--flea" in argv else None
    out = argv[argv.index("--out") + 1] if "--out" in argv else os.path.join(
        os.environ.get("TMPDIR", "."), "flea-navexplore")
    view = argv[argv.index("--view") + 1] if "--view" in argv else arm_view({"entrant": ent})
    mode = argv[argv.index("--preview") + 1] if "--preview" in argv else None
    arm = {"id": ent, "entrant": ent, "flea_dir": flea, "view": view}
    check_arm_view(arm)
    if flea:
        S.UI_TOKENS.append(flea + "/ui")
    S.require_idle()
    ctx = make_ctx(out)
    keys = ctx["keys"]
    opts = {"tag": "x", "evidence": True, "inview_steps": INVIEW_STEPS, "scroll_steps": SCROLL_STEPS,
            "pace_ms": CURSOR_PACE_MS}
    if column == "cursor":
        rows = run_cursor(arm, fixture, ctx, keys, view, opts)
    elif column == "scroll":
        rows = run_cursor_scroll(arm, fixture, ctx, keys, view, opts)
    elif column in ("enter", "back"):
        rows = [r for r in run_enter_back(arm, fixture, ctx, keys, view, opts)
                if r["column"] == "nav." + column + "." + view]
    elif column == "preview":
        kind = argv[argv.index("--kind") + 1] if "--kind" in argv else "jpg"
        mode = mode or preview_default(ent)
        rows = run_preview(arm, fixture, ctx, keys, view, mode, [kind], opts)
    elif column == "launch":
        size = argv[argv.index("--size") + 1] if "--size" in argv else "10k"
        opts = dict(opts, cache="warm", ink_rows=INK_ROWS)
        rows = run_launch(arm, fixture, ctx, view, size, opts)
    else:
        raise SystemExit("explore wants cursor, scroll, enter, back, preview or launch, not " + column)
    for r in rows:
        r.pop("key_times_ns", None)
    text = json.dumps(rows, indent=1)
    if "--json" in argv:
        with open(argv[argv.index("--json") + 1], "w") as f:
            f.write(text + "\n")
    else:
        print(text)
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[0]
    if cmd == "selftest":
        return selftest()
    if cmd == "preflight":
        return preflight()
    if cmd == "report":
        return report(argv[1])
    if cmd == "calibrate":
        delays, runs = [0, 50, 200], 10
        rest = argv[1:]
        while rest:
            if rest[0] == "--delays":
                delays = [int(v) for v in rest[1].split(",")]
            elif rest[0] == "--runs":
                runs = int(rest[1])
            else:
                print("unknown option " + rest[0], file=sys.stderr)
                return 2
            rest = rest[2:]
        S.ENV = S.session_env()
        os.environ.update(S.ENV)
        rep = S.calibrate(delays, runs)
        ok = all(r.get("within_one_frame", False) for r in rep["rows"])
        return 0 if ok else 1
    S.ENV = S.session_env()
    os.environ.update(S.ENV)
    if cmd == "measure":
        return measure(argv[1])
    if cmd == "explore":
        return explore(argv[1:])
    print("unknown command " + cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
