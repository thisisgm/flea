def flea_state(ctx, arm):
    """A state directory holding Flea's shipped defaults and the arm's view, made once per (tree, view)."""
    view = arm.get("view", "list")
    key = (Product.flea_binary(arm), Product.frontend(arm), view)
    if key not in ctx["states"]:
        d = tempfile.mkdtemp(prefix="flea-search-state-", dir=ctx["out_dir"])
        os.makedirs(d + "/no-config", exist_ok=True)
        patch = json.dumps({"sort": {"key": "name", "reverse": False}, "view": view})
        subprocess.run([Product.flea_binary(arm), "--ui-state", patch],
                       env=dict(ENV, XDG_STATE_HOME=d, XDG_CONFIG_HOME=d + "/no-config"), capture_output=True, check=True)
        ctx["states"][key] = d
    return ctx["states"][key]


# The harness's own state: the run ledger and a QML cache per binary, which persists across runs as the tree's did.
STATE_ROOT = os.environ.get("FLEA_FIELD_STATE") or os.path.expanduser("~/.local/state/flea-field")
_BINARY_SHA = {}


def qml_cache(binary):
    """A persistent QML disk cache keyed by the binary's sha256, so round 0 is not a cold-cache outlier."""
    path = os.path.realpath(binary)
    if path not in _BINARY_SHA:
        with open(path, "rb") as stream:
            _BINARY_SHA[path] = hashlib.file_digest(stream, "sha256").hexdigest()
    return os.path.join(STATE_ROOT, "qmlcache", _BINARY_SHA[path])


def strata_bin(arm=None):
    """Each release channel names its installed binary explicitly."""
    path = (arm or {}).get("strata_bin") or os.environ.get("STRATA_BIN")
    if not path or not os.access(path, os.X_OK):
        raise SystemExit("set strata_bin on each Strata arm (or STRATA_BIN) to an executable")
    return path


def entrant_spec(arm):
    spec = dict(ENTRANTS[arm["entrant"]])
    if arm["entrant"] == "flea":
        spec["cls"] = Product.window_class(arm)
    return spec


def arm_identity(arm):
    entrant = arm["entrant"]
    if entrant == "flea":
        binary = Product.flea_binary(arm)
    elif entrant == "strata":
        binary = strata_bin(arm)
    else:
        binary = "yazi" if entrant == "yazi-z" else entrant
    return Product.identity(arm, [binary])


