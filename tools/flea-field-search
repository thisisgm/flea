    # Old libwayland brackets are CLOCK_REALTIME microseconds modulo 2^32 as ms.us, so they convert through the realtime offset.
    off = (1_700_000_000 * NS) // wrap_ns * wrap_ns + 404635000 * 1000 - 7000 * MS
    rt_lines = []
    for t_ms in (7000, 7010, 7020, 7100, 7110):
        us = (404635000 + (t_ms - 7000) * 1000) % (1 << 32)
        rt_lines.append("[%7d.%03d]  -> wl_surface@23.attach(wl_buffer@41, 0, 0)" % (us // 1000, us % 1000))
