        state = flea_state(ctx, arm)
        env = {"FLEA_BIN": Product.flea_binary(arm), "FLEA_FRONTEND": Product.frontend(arm),
               "XDG_STATE_HOME": state, "QML_DISK_CACHE_PATH": qml_cache(Product.flea_binary(arm))}
        if arm.get("flea_dir"):
            env["FLEA_UI"] = arm["flea_dir"] + "/ui"
        os.makedirs(env["QML_DISK_CACHE_PATH"], exist_ok=True)
        return [env["FLEA_BIN"], "--gui", fixture], env
    if e == "nautilus":
        return ["nautilus", "--new-window", fixture], {}
    if e == "dolphin":
        # Dolphin's session restore is off through tools/xdg-dolphin, leaving ~/.config alone.
        xdg = os.path.join(HERE, "xdg-dolphin")
        if not os.path.isfile(os.path.join(xdg, "dolphinrc")):
            raise SystemExit("the dolphin arm needs %s/dolphinrc, and it is missing" % xdg)
        return [e, fixture], {"XDG_CONFIG_DIRS": xdg + ":" + os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg")}
    if e in ("thunar", "nemo", "pcmanfm"):
        return [e, fixture], {}
    if e == "strata":
        return [strata_bin(arm), fixture], {}
    tui = ["kitty", "--class", TUI_CLASS, "-o", "cursor_blink_interval=0"]
    env = {"XDG_CONFIG_HOME": ctx["tui_conf"]}
    if e == "yazi-z":
        return tui + ["yazi", fixture], env
    if e == "broot":
        return tui + ["broot", fixture], env
    raise SystemExit("no launch line for entrant " + e)


# comm, cmdline token, the same table as tools/flea-field-bench's KILL_TARGETS; a bare qs or flea-gui is never matched.
KILL_TARGETS = [("flea-gui", ""), ("qs", "/ui"), ("flea", "--backend"), ("kitty", "--class " + TUI_CLASS), ("nautilus", ""),
                ("org.gnome.Nauti", ""), ("thunar", ""), ("tumblerd", ""), ("pcmanfm", ""), ("nemo", ""),
                ("dolphin", ""), ("strata", ""), ("yazi", ""), ("broot", ""), ("fzf", ""), ("localsearch-3", ""),
                ("localsearch-ext", ""), ("hyprland-dialog", "")]


def pids_for(comm, token=""):
    out = []
    for p in subprocess.run(["pgrep", "-x", comm], capture_output=True, text=True, env=parsed_env()).stdout.split():
        try:
            with open("/proc/%s/cmdline" % p) as f:
                cmd = f.read().replace("\0", " ")
        except OSError:
            continue
        if not token or token in cmd:
            out.append(int(p))
    return out


# The ui directories of the Flea trees this run launches; qs is matched by them and never bare.
UI_TOKENS = []
# The flea-gui beside each Flea binary this run launches; a flea-gui is matched by its executable and never bare.
GUI_BINARIES = []


def flea_gui_binaries(arms):
    return [os.path.realpath(os.path.join(os.path.dirname(Product.flea_binary(a)), "flea-gui"))
            for a in arms if a.get("entrant") == "flea"]


def pids_for_exe(comm, binaries):
    out = []
    for p in pids_for(comm):
        try:
            # A running copy whose file was replaced reads "<path> (deleted)".
            exe = os.path.realpath(os.readlink("/proc/%d/exe" % p).removesuffix(" (deleted)"))
        except OSError:
            continue
        if exe in binaries:
            out.append(p)
    return out


def alive_targets():
    out = []
    for c, t in KILL_TARGETS:
        if c == "qs":
            out += [(c, p) for tok in UI_TOKENS for p in pids_for(c, tok)]
        elif c == "flea-gui":
            out += [(c, p) for p in pids_for_exe(c, GUI_BINARIES)]
        else:
            out += [(c, p) for p in pids_for(c, t)]
    return out


# Control groups, memory and frame gaps.


# Sample input, one /proc/self/cgroup line: "0::/user.slice/user-1000.slice/session-3.scope" (hierarchy, controllers, path).
def own_cgroup():
    with open("/proc/self/cgroup") as f:
        return "/sys/fs/cgroup" + f.read().strip().split(":", 2)[2]


SCOPE_UNIT = "flea-field-search"  # substring the delegated scope's cgroup path carries


def ensure_scope():
    """Re-enter this tool under systemd-run --user --scope -p Delegate=yes, as tools/flea-field-bench does."""
    with open("/proc/self/cgroup") as f:
        cg = f.read()
    if SCOPE_UNIT + "-" in cg and ".scope" in cg:
        return False
    if os.environ.get("FLEA_SEARCH_REENTERED"):
        print("flea-field-search: re-entry did not land in a scope of its own, CPU is refused", file=sys.stderr)
        return True
    os.environ["FLEA_SEARCH_REENTERED"] = "1"
    try:
        os.execvp("systemd-run", ["systemd-run", "--user", "--scope", "--quiet", "--working-directory=" + os.getcwd(), "-p", "Delegate=yes",
                                  "--unit=%s-%d" % (SCOPE_UNIT, os.getpid()), "--",
                                  sys.executable, os.path.abspath(__file__), *sys.argv[1:]])
    except OSError as e:
        print("flea-field-search: no delegated scope (%s), CPU is refused" % e, file=sys.stderr)
        return True
    return True


class Leaf:
    """A control group of one run, so CPU is read from cpu.stat whatever the entrant forks. Without a delegated scope the leaf stays None and the row refuses CPU; ticks never stand in."""

    def __init__(self, name):
        self.path = None
        base = own_cgroup()
        if os.access(base, os.W_OK) and "flea-field-search" in base:
            p = os.path.join(base, "run-" + name)
            os.makedirs(p, exist_ok=True)
            self.path = p

    def join_in_child(self):
        path = self.path

        def f():
            if path:
                with open(path + "/cgroup.procs", "w") as g:
                    g.write(str(os.getpid()))
        return f

    def pids(self):
        if not self.path:
            return []
        try:
            with open(self.path + "/cgroup.procs") as f:
                return [int(v) for v in f.read().split()]
        except OSError:
            return []

    # Sample input, one cpu.stat line: "usage_usec 123456789" (key, microseconds).
    def usage_s(self):
        if not self.path:
            return None
        with open(self.path + "/cpu.stat") as f:
            for line in f:
                k, v = line.split()
                if k == "usage_usec":
                    return int(v) / 1e6
        return None

    def kill(self):
        if self.path:
            try:
                with open(self.path + "/cgroup.kill", "w") as f:
                    f.write("1")
            except OSError:
                pass
            for _ in range(100):
                if not self.pids():
                    break
                time.sleep(0.1)
            try:
                os.rmdir(self.path)
            except OSError:
                pass


# Sample input, one smaps_rollup line: "Pss: 1234 kB" (key, value, unit).
def smaps(pid):
    """Pss, Pss_Anon and USS in kB from /proc/pid/smaps_rollup, or None."""
    try:
        with open("/proc/%d/smaps_rollup" % pid) as f:
            kv = {}
            for line in f:
                k, _, v = line.partition(":")
                parts = v.split()
                if parts:
                    kv[k] = int(parts[0])
        with open("/proc/%d/comm" % pid) as f:
            comm = f.read().strip()
        return {"pid": pid, "comm": comm, "pss_kb": kv.get("Pss", 0), "pss_anon_kb": kv.get("Pss_Anon", 0),
                "uss_kb": kv.get("Private_Clean", 0) + kv.get("Private_Dirty", 0)}
    except OSError:
        return None


def mem_snapshot(pids):
    rows = [r for r in (smaps(p) for p in sorted(pids)) if r]
    return {"procs": rows, "pss_kb": sum(r["pss_kb"] for r in rows), "pss_anon_kb": sum(r["pss_anon_kb"] for r in rows),
            "uss_kb": sum(r["uss_kb"] for r in rows)}


# Sample input, one WAYLAND_DEBUG=client line: "[15:15:36.027928] {mesa vk display queue}  -> wl_surface#37.attach(wl_buffer#81, 0, 0)" (a time of day, put on the monotonic clock through the offset read now).
def attach_gaps(lines, t0_ns, t1_ns, rt_minus_mono_ns=None):
    """Largest and p95 gap, in ms, between buffer attaches of the busiest wl_surface between t0 and t1."""
    rx = re.compile(r"^\[\s*([0-9:.]+)\]\s+(?:\{[^}]*\}\s+)?->\s+wl_surface[@#](\d+)\.attach\(wl_buffer[@#]\d+")
    if rt_minus_mono_ns is None:
        rt_minus_mono_ns = time.time_ns() - time.monotonic_ns()
    day = 86400 * NS
    utc_midnight = (t0_ns + rt_minus_mono_ns) // day * day
    local_off = time.localtime().tm_gmtoff * NS
    per = {}
    for line in lines:
        m = rx.match(line)
        if not m:
            continue
        stamp = m.group(1)
        if ":" in stamp:
            h, mi, sec = stamp.split(":")
            sod = (int(h) * 3600 + int(mi) * 60) * NS + int(round(float(sec) * NS))
            cands = [utc_midnight + k * day - off + sod for k in (-1, 0, 1) for off in (0, local_off)]
            t = min(cands, key=lambda c: abs(c - rt_minus_mono_ns - t0_ns)) - rt_minus_mono_ns
        else:
            # Sample input, the older libwayland bracket: "[1234567.890]" (CLOCK_REALTIME microseconds modulo 2^32 as milliseconds.microseconds).
            ms_part, _, us_part = stamp.partition(".")
            us = int(ms_part) * 1000 + int(us_part or 0)
            wrap = (1 << 32) * 1000
            base = t0_ns + rt_minus_mono_ns
            q0 = base // wrap
            t = min(((q0 + k) * wrap + us * 1000 for k in (-1, 0, 1)), key=lambda c: abs(c - base)) - rt_minus_mono_ns
        if t0_ns <= t <= t1_ns:
            per.setdefault(m.group(2), []).append(t)
    if not per:
        return None
    ts = sorted(max(per.values(), key=len))
    # The first gap is key to first attach and the last is attach to the end of the window, so both ends are counted.
    edges = [t0_ns] + ts + [t1_ns]
    gaps = sorted((b - a) / 1e6 for a, b in zip(edges, edges[1:]))
    p95 = gaps[min(len(gaps) - 1, int(GAP_P95 * len(gaps)))]
    return {"attaches": len(ts), "max_gap_ms": round(gaps[-1], 1), "p95_gap_ms": round(p95, 1)}


# One arm, one run: launch, wait until quiet, then a fresh search for every length.


def clean_all(leaf=None):
    """End the run's leaf, then everything in KILL_TARGETS, TERM first and KILL after five seconds."""
    if leaf:
        leaf.kill()
    for attempt in range(100):
        left = alive_targets()
        if not left:
            break
        for _, p in left:
            try:
                os.kill(p, signal.SIGTERM if attempt < 50 else signal.SIGKILL)
            except OSError:
                pass
        time.sleep(0.1)
    time.sleep(0.2)


# Every run that passes require_idle ledgers its window here, so a later refusal can say whether it started a leftover.
LEDGER = os.environ.get("FLEA_FIELD_LEDGER") or os.path.join(STATE_ROOT, "runs.jsonl")
_RUN = {}
# A run touches its alive mark this often, so a run killed outright ends at its last touch plus one period.
ALIVE_S = 5


def alive_mark(run_id):
    return os.path.join(os.path.dirname(LEDGER), "alive", run_id)


# Sample input, /proc/<pid>/stat: "1234 (name) S 1 1234 ... 8812345 ..." (field 22, starttime, in clock ticks); /proc/stat: "btime 1729700000".
STARTTIME_AFTER_COMM = 19  # field 22 is the 20th field after the ")" that ends the comm


def process_start(pid):
    """Epoch seconds a pid started, from /proc starttime and the boot time, or None."""
    try:
        with open("/proc/%d/stat" % pid) as f:
            ticks = int(f.read().rsplit(")", 1)[1].split()[STARTTIME_AFTER_COMM])
        with open("/proc/stat") as f:
            boot = next(int(line.split()[1]) for line in f if line.startswith("btime "))
    except (OSError, ValueError, IndexError, StopIteration):
        return None
    return boot + ticks / os.sysconf("SC_CLK_TCK")


# Sample input, runs.jsonl: {"id":"run-1","pid":1234,"start":1729700000.0} then {"id":"run-1","end":1729700060.0}.
def ledger_windows():
    """Recorded runs as {id: {pid, start, end}}; a run with no end never reached its exit hook."""
    runs = {}
    try:
        with open(LEDGER) as f:
            for line in f:
                try:
                    entry = json.loads(line)
                    runs.setdefault(entry["id"], {}).update(entry)
                except (ValueError, KeyError, TypeError):
                    continue
    except OSError:
        pass
    return runs


def ledger_write(entry):
    try:
        os.makedirs(os.path.dirname(LEDGER), exist_ok=True)
        with open(LEDGER, "a") as f:
            f.write(json.dumps(entry) + "\n")
    except OSError as error:
        raise SystemExit("flea-field-search: cannot record harness run in %s: %s" % (LEDGER, error)) from error


def open_run_until(run, next_start):
    """Where a run with no recorded end stops: never while its process lives, else at the last evidence it was alive."""
    began = process_start(run["pid"]) if isinstance(run.get("pid"), int) else None
    if began is not None and began <= run["start"] + 1:
        return next_start
    try:
        seen = os.path.getmtime(alive_mark(run["id"]))
    except (OSError, KeyError):
        seen = run["start"]
    return min(t for t in (seen + ALIVE_S, next_start) if t is not None)


def describe_leftover(comm, pid):
    """One refusal clause: the process, when it started, and whether a recorded harness run covers that start."""
    began = process_start(pid)
    if began is None:
        return "%s pid %d (start time unreadable, so not attributable to this harness)" % (comm, pid)
    when = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(began))
    # Runs only claim the machine once it is idle, so a run killed outright ends where the next run begins.
    runs = sorted((r for r in ledger_windows().values() if "start" in r), key=lambda r: r["start"])
    for i in reversed(range(len(runs))):
        run = runs[i]
        until = run["end"] if "end" in run else open_run_until(run, runs[i + 1]["start"] if i + 1 < len(runs) else None)
        if run["start"] <= began + 1 and (until is None or began <= until + 1):
            begun = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(run["start"]))
            end = "never ended" if run.get("end") is None else "ended " + time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(run["end"]))
            return "%s pid %d started %s, inside this harness's run pid %s begun %s (%s): this harness started it" % (
                comm, pid, when, run.get("pid"), begun, end)
    return "%s pid %d started %s, outside every recorded harness run: this harness did not start it" % (comm, pid, when)


def end_run():
    """Exit hook of a run that passed require_idle: end every target, including an indexer an entrant activated."""
    if _RUN.get("ended"):
        return
    _RUN["ended"] = True
    try:
        clean_all()
    finally:
        ledger_write({"id": _RUN["id"], "end": time.time()})
        try:
            os.unlink(alive_mark(_RUN["id"]))
        except OSError:
            pass


def touch_alive(run_id):
    while not _RUN.get("ended"):
        try:
            os.makedirs(os.path.dirname(alive_mark(run_id)), exist_ok=True)
            with open(alive_mark(run_id), "a"):
                os.utime(alive_mark(run_id))
        except OSError:
            pass
        time.sleep(ALIVE_S)


def claim_run():
    """Called once the machine is idle: ledger the window and make every exit path, signals included, end the targets."""
    if _RUN:
        return
    run_id = uuid.uuid4().hex
    ledger_write({"id": run_id, "pid": os.getpid(), "start": time.time()})
    _RUN.update(id=run_id, ended=False)
    threading.Thread(target=touch_alive, args=(_RUN["id"],), daemon=True).start()
    atexit.register(end_run)
    if threading.current_thread() is threading.main_thread():
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, lambda number, frame: sys.exit(128 + number))


def require_idle():
    left = alive_targets()
    if left:
        raise SystemExit("flea-field-search: %s already running, and this run would end them; refusing to start" % "; ".join(
            describe_leftover(c, p) for c, p in left))
    claim_run()


def type_keys(keys, text, pace_s):
    """Type text at pace_s a key on an absolute schedule; the CLOCK_MONOTONIC ns of each key."""
    times = []
    start = time.monotonic_ns()
    for i, ch in enumerate(text):
        due = start + int(i * pace_s * 1e9)
        while time.monotonic_ns() < due - 2_000_000:
            time.sleep(0.001)
        while time.monotonic_ns() < due:
            pass
        times.append(keys.type_char(ch))
    return times


def run_chords(keys, chords):
    t = None
    for c in chords:
        t = keys.chord(*c)
        time.sleep(0.05)
    return t


def run_arm(arm, fixture, query, ctx, opts):
    """Everything one launch of one arm measures. Returns one dict per query length (and per mode)."""
    spec = entrant_spec(arm)
    keys = ctx["keys"]
    mode = opts.get("mode", "search")
    open_chords = spec["open"] if mode == "search" else spec["filter_open"]
    close_chords = spec["close"] if mode == "search" else spec["filter_close"]
    lengths = opts.get("lengths", [1, 3, 6])
    pace = opts.get("pace_ms", 180) / 1000.0
    leaf = Leaf("%s-%s" % (arm["id"], opts.get("tag", "r")))
    argv, extra = entrant_argv(arm, fixture, ctx)
    env = dict(ENV, **extra)
    errlog = None
    if arm.get("wl_debug"):
        env["WAYLAND_DEBUG"] = "client"
        errlog = open(os.path.join(ctx["out_dir"], "%s-%s.wl" % (arm["id"], opts.get("tag", "r"))), "w")
    clean_all()
    proc = subprocess.Popen(argv, env=env, stdout=subprocess.DEVNULL, stderr=errlog or subprocess.DEVNULL,
                            start_new_session=True, preexec_fn=leaf.join_in_child())
    rows = []
    rec = None
    try:
        win = None
        t0 = time.monotonic()
        while win is None and time.monotonic() - t0 < MAP_WAIT_S:
            owned = set(leaf.pids()) | descendants(proc.pid)
            for c in clients():
                if c.get("class") == spec["cls"] and (c.get("pid") in owned or not leaf.path):
                    win = c
                    break
            time.sleep(0.02)
        if win is None:
            return [{"arm": arm["id"], "error": "no window of class %s mapped in 60 s" % spec["cls"]}]
        focus_window(win["address"])
        park_cursor()
        time.sleep(0.5)
        win = [c for c in clients() if c["address"] == win["address"]][0]
        (wx, wy), (ww, wh) = win["at"], win["size"]
        rx, ry, rw, rh = spec.get("filter_region", spec["region"])(ww, wh) if mode == "filter" else spec["region"](ww, wh)
        region = (wx + rx, wy + ry, rw, rh)
        masks = [(wx + a, wy + b, c, d) for (a, b, c, d) in spec["masks"](ww, wh)]
        dump_dir = os.path.join(ctx["out_dir"], "dump-%s-%s" % (arm["id"], opts.get("tag", "r")))
        os.makedirs(dump_dir, exist_ok=True)
        rec = Recorder(ctx["rec_bin"], region, masks, os.path.join(dump_dir, "d"), (wx, wy, ww, wh))
        # The window is loaded when its results region holds still for LAUNCH_QUIET_NS.
        settled_launch = rec.wait_quiet(LAUNCH_QUIET_NS, time.monotonic_ns(), LAUNCH_CAP_NS)
        pids_now = lambda: set(leaf.pids()) | descendants(proc.pid)
        for length in lengths:
            text = query[:length]
            run_chords(keys, open_chords)
            if open_chords:
                rec.wait_quiet(OPEN_QUIET_NS, time.monotonic_ns(), OPEN_CAP_NS)
            cpu0 = leaf.usage_s() if leaf.path else None
            t_start = time.monotonic_ns()
            key_times = type_keys(keys, text, pace)
            final = key_times[-1]
            quiet_ok = rec.wait_quiet(QUIET_NS, final, SETTLE_CAP_NS)
            end = time.monotonic_ns()
            cpu1 = leaf.usage_s() if leaf.path else None
            frames = rec.snapshot()
            cols = search_columns(frames, key_times, end)
            row = {"arm": arm["id"], "entrant": arm["entrant"], "mode": mode, "tag": opts.get("tag", "r"),
                   "fixture": opts.get("fixture_name", "?"), "length": length, "query": text, "settled_before_search": settled_launch,
                   "region": region, "masks": masks, "cpu_search_s": None if cpu0 is None or cpu1 is None else round(cpu1 - cpu0, 2),
                   "cpu_src": "cgroup" if leaf.path else "refused: no delegated scope", "key_times_ns": key_times, "t_start_ns": t_start}
            row.update(cols)
            if length == lengths[-1] and opts.get("mem", True):
                row["mem_settled"] = mem_snapshot(pids_now())
                if opts.get("evidence"):
                    dumped = rec.dump()
                    if dumped:
                        png = os.path.join(ctx["out_dir"], "%s-%s-%s-L%d.png" % (arm["id"], opts.get("fixture_name", "x"), mode, length))
                        ppm_to_png(dumped, png, rec.boxes(region, masks))
                        row["evidence"] = png
            # Enter baseline: a tag that shows nothing before Enter is timed from the Enter key.
            if mode == "search" and opts.get("enter_baseline") and length == lengths[-1]:
                t_enter = keys.chord("enter")
                rec.wait_quiet(QUIET_NS, t_enter, SETTLE_CAP_NS)
                if opts.get("mem", True):
                    row["mem_enter_settled"] = mem_snapshot(pids_now())
                ec = search_columns(rec.snapshot(), [t_enter], time.monotonic_ns())
                row["enter_first_ms"], row["enter_settled_ms"], row["enter_capped"] = ec["first_ms"], ec["settled_ms"], ec["capped"]
                row["enter_window_ns"] = [t_enter, t_enter + int((ec["settled_ms"] or 0) * MS)]
                if opts.get("evidence"):
                    dumped = rec.dump()
                    if dumped:
                        png = os.path.join(ctx["out_dir"], "%s-%s-enter-L%d.png" % (arm["id"], opts.get("fixture_name", "x"), length))
                        ppm_to_png(dumped, png, rec.boxes(region, masks))
                        row["enter_evidence"] = png
            t_esc = run_chords(keys, close_chords)
            rec.wait_quiet(CLOSE_QUIET_NS, t_esc, CLOSE_CAP_NS)
            if length == lengths[-1] and opts.get("mem", True):
                time.sleep(MEM_SETTLE_SLEEP_S)
                row["mem_after_close"] = mem_snapshot(pids_now())
            rows.append(row)
        if errlog is not None:
            errlog.flush()
            for row in rows:
                with open(errlog.name) as f:
                    if row.get("enter_window_ns"):
                        row["enter_frame_gaps"] = attach_gaps(f, *row["enter_window_ns"])
                    f.seek(0)
                    row["frame_gaps"] = attach_gaps(f, row["t_start_ns"], row["t_start_ns"] + int((row["settled_ms"] or 0) * MS + (row["key_times_ns"][-1] - row["t_start_ns"])))
        return rows
    finally:
        if rec:
            rec.stop()
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except OSError:
            pass
        clean_all(leaf)
        if errlog:
            errlog.close()


# measure and report


def fixture_facts(path):
    """Entry count and depth of a fixture, walked once and recorded beside its numbers."""
    n = deepest = 0
    for cur, dirs, files in os.walk(path):
        rel = os.path.relpath(cur, path)
        depth = 0 if rel == "." else rel.count("/") + 1
        n += len(dirs) + len(files)
        deepest = max(deepest, depth + (1 if files else 0))
    return {"path": path, "entries": n, "max_depth": deepest}


def measure(plan_path):
    """measure PLAN.json: out (.jsonl), runs, query, queries {fixture: query}, mode, lengths, fixtures {name: dir}, arms [{id, entrant, flea_dir, view, typing, enter_baseline, wl_debug, fixtures}]; rounds interleave the arms over every fixture."""
    with open(plan_path) as f:
        plan = json.load(f)
    # A qml arm's qs is matched only by its tree's ui directory, so an arm with no tree could never be ended.
    for a in plan["arms"]:
        if a.get("entrant") == "flea" and Product.frontend(a) == "qml" and not a.get("flea_dir"):
            raise SystemExit("measure refuses arm %s: a qml flea arm needs flea_dir, not flea_bin alone" % a.get("id"))
    out_path = plan["out"]
    if os.path.exists(out_path):
        raise SystemExit("measure refuses an existing out (%s); move it away first" % out_path)
    ensure_scope()
    out_dir = os.path.splitext(out_path)[0] + ".files"
    ctx = make_ctx(out_dir)
    arms = plan["arms"]
    UI_TOKENS[:] = [a["flea_dir"] + "/ui" for a in arms if a.get("flea_dir")]
    GUI_BINARIES[:] = flea_gui_binaries(arms)
    require_idle()
    for a in arms:
        if a["entrant"] not in ENTRANTS:
            raise SystemExit("plan names an entrant the table does not hold: " + a["entrant"])
    facts = {name: fixture_facts(path) for name, path in plan["fixtures"].items()}
    monitor_info = monitor()
    head = {"manifest": {
        "date": time.strftime("%Y-%m-%d %H:%M:%S"), "host": socket.gethostname(), "kernel": platform.release(), "plan": plan, "fixtures": facts,
        "monitor": {k: monitor_info.get(k) for k in ("name", "width", "height", "refreshRate", "scale")},
        "entrants": {a["id"]: {"entrant": a["entrant"], "kind": ENTRANTS[a["entrant"]]["kind"], "filter_kind": ENTRANTS[a["entrant"]]["filter_kind"], "typing": a.get("typing", ""), **arm_identity(a)}
                     for a in arms},
        "recorder": ctx["rec_bin"], "pace_ms": plan.get("pace_ms", 180)}}
    n = len(arms)
    with open(out_path, "a") as out:
        out.write(json.dumps(head) + "\n")
        out.flush()
        for r in range(plan.get("runs", 5)):
            order = arms[r % n:] + arms[:r % n]
            for fixture_name, fixture in plan["fixtures"].items():
                for arm in order:
                    if arm.get("fixtures") and fixture_name not in arm["fixtures"]:
                        continue
                    opts = {"mode": plan.get("mode", "search"), "lengths": plan.get("lengths", [1, 3, 6]),
                            "pace_ms": plan.get("pace_ms", 180), "fixture_name": fixture_name,
                            "evidence": r == 0 and plan.get("evidence", True), "mem": r < 3, "tag": "r%d-%s" % (r, fixture_name),
                            "enter_baseline": bool(arm.get("enter_baseline"))}
                    try:
                        rows = run_arm(arm, fixture, plan.get("queries", {}).get(fixture_name, plan["query"]), ctx, opts)
                    except Exception as e:  # a failed run is a row, never a silent gap
                        rows = [{"arm": arm["id"], "error": "%s: %s" % (type(e).__name__, e)}]
                    for row in rows:
                        row.update({"round": r, "fixture": fixture_name, "arm": arm["id"]})
                        out.write(json.dumps(row) + "\n")
                        out.flush()
                    print("round %d %s %s: %s" % (r, fixture_name, arm["id"],
                                                  ", ".join("L%s first %s settled %s" % (x.get("length"), x.get("first_ms"), x.get("settled_ms"))
                                                            if "length" in x else x.get("error", "?") for x in rows)), flush=True)
    return 0


def rng(vals, digits=0):
    vals = [v for v in vals if v is not None]
    if not vals:
        return "n/a"
    return "%.*f [%.*f..%.*f]" % (digits, statistics.median(vals), digits, min(vals), digits, max(vals))


BAR_RATIO = 0.8  # the ratio check: a subject's median at or under 0.8 of Strata's, its slowest run faster than Strata's fastest


def median_of(vals):
    vals = [v for v in vals if v is not None]
    return statistics.median(vals) if vals else None


def clear_of(mine, theirs):
    """True when my slowest run is faster than their fastest, so the two ranges do not touch."""
    return bool(mine) and bool(theirs) and max(mine) < min(theirs)


def bar_of(mine, theirs):
    """Against one reference entrant, normally Strata: (ratio of medians, 'ok' or 'UNDER'), or (None, 'n/a')."""
    mine, theirs = [v for v in mine if v is not None], [v for v in theirs if v is not None]
    if not mine or not theirs or statistics.median(theirs) == 0:
        return None, "n/a"
    ratio = statistics.median(mine) / statistics.median(theirs)
    return ratio, "ok" if ratio <= BAR_RATIO and clear_of(mine, theirs) else "UNDER"


def status_vs(mine, theirs):
    """Against the next entrant: clear, OVERLAP (faster median, ranges touch) or NOT-FASTER (a tie is not faster)."""
    if not mine or not theirs:
        return "n/a"
    if statistics.median(mine) < statistics.median(theirs):
        return "clear" if clear_of(mine, theirs) else "OVERLAP"
    return "NOT-FASTER"


def subjects_of(manifest):
    """The arm ids the comparison tables treat as subjects: the plan's subjects, else every arm whose id starts with flea-stage."""
    plan = (manifest or {}).get("plan") or {}
    named = plan.get("subjects") or ([plan["subject"]] if plan.get("subject") else None)
    if named:
        return list(named)
    return [a for a in ((manifest or {}).get("entrants") or {}) if a.startswith("flea-stage")]


def col_vals(g, col):
    """A group's readings for a column without the caps: a capped settled_ms is never read as a settle."""
    return [r[col] for r in g if r.get(col) is not None and not (col == "settled_ms" and r.get("capped"))]


def col_caps(g, col):
    return sum(1 for r in g if col == "settled_ms" and r.get("capped"))


def rank_key(vals, nc):
    """A capped group ranks worse than any reading; within a side the median orders."""
    return (1 if nc else 0, statistics.median(vals) if vals else float("inf"))


def verdict_lines(groups, manifest):
    """Comparison tables: per fixture, mode, length and column, the subject's rank, its status vs the next entrant and its ratio to Strata."""
    ents = (manifest or {}).get("entrants") or {}
    subjects = subjects_of(manifest)
    strata = next((a for a, e in ents.items() if e.get("entrant") == "strata"), None)
    out = []
    for fixture in sorted({k[0] for k in groups}):
        for mode in sorted({k[1] for k in groups if k[0] == fixture}):
            rows = []
            notes = []
            noted = set()
            for subject in subjects:
                for length in sorted({k[3] for k in groups if k[0] == fixture and k[1] == mode and k[2] == subject}):
                    for col in ("first_ms", "settled_ms"):
                        g = groups.get((fixture, mode, subject, length), [])
                        mine, mine_nc = col_vals(g, col), col_caps(g, col)
                        if not mine and not mine_nc:
                            continue
                        mine_cell = "capped %d of %d" % (mine_nc, len(g)) if mine_nc else rng(mine)
                        others, caps, baselines, fully_capped = {}, {}, {}, {}
                        for (fx, md, arm, ln), og in groups.items():
                            if (fx, md, ln) != (fixture, mode, length) or arm in subjects:
                                continue
                            e = ents.get(arm, {})
                            vals, nc = col_vals(og, col), col_caps(og, col)
                            if not vals and not nc:
                                continue
                            if e.get("entrant") == "flea":
                                if vals:
                                    baselines[arm] = vals
                                else:
                                    fully_capped[arm] = (nc, len(og))
                            elif e.get("typing", "") == "" and (mode != "filter" or "narrows" in e.get("filter_kind", "")):
                                others[arm], caps[arm] = vals, nc
                        if not others:
                            rows.append("| %s | %s | %d | %s | %s | %s | n/a | n/a | n/a | no other entrant | n/a | n/a | n/a |" % (
                                fixture, mode, length, col, subject, mine_cell))
                            continue
                        runner = min(others, key=lambda a: rank_key(others[a], caps[a]))
                        rank = 1 + sum(1 for a in others if rank_key(others[a], caps[a]) < rank_key(mine, mine_nc))
                        runner_nc = caps[runner]
                        strata_nc = caps.get(strata, 0) if strata else 0
                        if col == "settled_ms" and (mine_nc or strata_nc):
                            ratio_cell, bar = "capped", "capped"
                        else:
                            ratio, bar = bar_of(mine, others.get(strata, [])) if strata else (None, "n/a")
                            ratio_cell = "n/a" if ratio is None else "%.2f" % ratio
                        if col == "settled_ms" and (mine_nc or runner_nc):
                            status = "n/a" if mine_nc else "clear"
                        else:
                            status = status_vs(mine, others[runner])
                        base = ""
                        if baselines and mine:
                            b = min(baselines, key=lambda a: statistics.median(baselines[a]))
                            base = "%s %.2f" % (b, statistics.median(mine) / statistics.median(baselines[b])) if statistics.median(baselines[b]) else b
                        elif fully_capped and not baselines:
                            base = "no baseline, every row capped"
                        for arm, counts in fully_capped.items():
                            if (fixture, mode, arm, length, col) not in noted:
                                noted.add((fixture, mode, arm, length, col))
                                notes.append("- baseline %s L%d %s had every row capped (%d of %d)" % ((arm, length, col) + counts))
                        runner_cell = "capped %d of %d" % (runner_nc, len(groups[(fixture, mode, runner, length)])) if runner_nc else rng(others[runner])
                        rows.append("| %s | %s | %d | %s | %s | %s | %s | %s | %d of %d | %s | %s | %s | %s |" % (
                            fixture, mode, length, col, subject, mine_cell, runner, runner_cell, rank, len(others) + 1,
                            status, ratio_cell, bar, base or "n/a"))
            if rows:
                out.append("### comparison, %s, %s (ms, median [min..max]; ok = ratio at most %.1f and slowest run faster than Strata's fastest)" % (fixture, mode, BAR_RATIO))
                out.append("")
                out.append("| fixture | mode | L | column | subject | subject ms | next | next ms | rank | vs next | x Strata | ratio check | x own baseline |")
                out.append("|---|---|---|---|---|---|---|---|---|---|---|---|---|")
                out.extend(rows)
                # A blank line ends the table, so the notes render as a list and not as table rows.
                if notes:
                    out.append("")
                    out.extend(notes)
                out.append("")
    return out


def report(path):
    """Markdown tables of median [min..max] per arm, fixture and length, and the self-pair spread of a/b arms."""
    rows = []
    manifest = None
    with open(path) as f:
        for line in f:
            d = json.loads(line)
            if "manifest" in d:
                manifest = d["manifest"]
            else:
                rows.append(d)
    groups = {}
    for r in rows:
        if "length" not in r:
            continue
        groups.setdefault((r["fixture"], r.get("mode", "search"), r["arm"], r["length"]), []).append(r)
    # A type-ahead popup's "settled" is its own close timeout, so that column is withheld.
    popup = {k for k, v in ((manifest or {}).get("entrants") or {}).items() if v.get("filter_kind", "").startswith("type-ahead")}
    out = []
    ents = (manifest or {}).get("entrants") or {}
    subjects = subjects_of(manifest)
    strata = next((a for a, e in ents.items() if e.get("entrant") == "strata"), None)

    def strata_ratio(key, col):
        """Median of this row over Strata's median in the same fixture, mode and length, and the bar for a subject."""
        if strata is None or key[2] == strata:
            return "-"
        if col == "settled_ms" and (col_caps(groups[key], col) or col_caps(groups.get((key[0], key[1], strata, key[3]), []), col)):
            return "capped"
        mine = [r.get(col) for r in groups[key]]
        theirs = [r.get(col) for r in groups.get((key[0], key[1], strata, key[3]), [])]
        ratio, bar = bar_of(mine, theirs)
        if ratio is None:
            return "n/a"
        return "%.2f %s" % (ratio, bar) if key[2] in subjects else "%.2f" % ratio

    for fixture in sorted({k[0] for k in groups}):
        for mode in sorted({k[1] for k in groups if k[0] == fixture}):
            out.append("### %s, %s" % (fixture, mode))
            out.append("")
            out.append("| arm | L | runs | first ms | settled ms | x Strata first | x Strata settled | capped | blank frames skipped | cpu s | enter first ms | enter settled ms |")
            out.append("|---|---|---|---|---|---|---|---|---|---|---|---|")
            for key in sorted(k for k in groups if k[0] == fixture and k[1] == mode):
                g = groups[key]
                withheld = key[1] == "filter" and key[2] in popup
                nc = sum(1 for r in g if r.get("capped"))
                ne = sum(1 for r in g if r.get("enter_capped"))
                if withheld:
                    settled = "popup timeout"
                elif nc:
                    settled = "capped %d of %d" % (nc, len(g))
                else:
                    settled = rng([r.get("settled_ms") for r in g])
                enter_settled = "capped %d of %d" % (ne, len(g)) if ne else rng([r.get("enter_settled_ms") for r in g])
                out.append("| %s | %d | %d | %s | %s | %s | %s | %d | %d | %s | %s | %s |" % (
                    key[2], key[3], len(g), rng([r.get("first_ms") for r in g]), settled,
                    strata_ratio(key, "first_ms"), "n/a" if withheld else strata_ratio(key, "settled_ms"),
                    nc, sum(r.get("blank_frames_skipped") or 0 for r in g),
                    rng([r.get("cpu_search_s") for r in g], 2),
                    rng([r.get("enter_first_ms") for r in g]), enter_settled))
            out.append("")
            arms = sorted({k[2] for k in groups if k[0] == fixture and k[1] == mode})
            pairs = [(a, a[:-2] + "-b") for a in arms if a.endswith("-a") and a[:-2] + "-b" in arms]
            for a, b in pairs:
                for length in sorted({k[3] for k in groups if k[2] == a}):
                    ga, gb = groups.get((fixture, mode, a, length), []), groups.get((fixture, mode, b, length), [])
                    for col in ("first_ms", "settled_ms"):
                        va = [r[col] for r in ga if r.get(col) is not None and not (col == "settled_ms" and r.get("capped"))]
                        vb = [r[col] for r in gb if r.get(col) is not None and not (col == "settled_ms" and r.get("capped"))]
                        capped_a, capped_b = col_caps(ga, col), col_caps(gb, col)
                        if va and vb:
                            line = "self-pair %s vs %s L%d %s: medians %.0f and %.0f, spread %.0f ms" % (
                                a, b, length, col, statistics.median(va), statistics.median(vb),
                                abs(statistics.median(va) - statistics.median(vb)))
                            if capped_a or capped_b:
                                line += " (capped %d of %d and %d of %d)" % (capped_a, len(ga), capped_b, len(gb))
                            out.append(line)
                        elif col == "settled_ms" and (capped_a or capped_b):
                            out.append("self-pair %s vs %s L%d %s: capped, no spread" % (a, b, length, col))
            out.append("")
    out.extend(verdict_lines(groups, manifest))
    mem_rows = [r for r in rows if "mem_settled" in r]
    if mem_rows:
        out.append("### memory of the entrant's process tree, kB, median [min..max], at settled results and 3 s after Esc")
        out.append("")
        out.append("| fixture | mode | arm | runs | Pss settled | Pss x Strata | Pss_Anon settled | USS settled | Pss after Esc | USS after Esc | processes |")
        out.append("|---|---|---|---|---|---|---|---|---|---|---|")
        by = {}
        for r in mem_rows:
            by.setdefault((r["fixture"], r.get("mode", "search"), r["arm"] + (" (typed)" if "mem_enter_settled" in r else ""),
                           "mem_settled"), []).append(r)
            if "mem_enter_settled" in r:
                by.setdefault((r["fixture"], r.get("mode", "search"), r["arm"] + " (Enter)", "mem_enter_settled"), []).append(r)
        for key in sorted(by):
            g = by[key]
            after = [r.get("mem_after_close") or {} for r in g]
            # A row that also typed Enter is filed under "<id> (typed)", so Strata is looked up under both filings.
            theirs = [r["mem_settled"]["pss_kb"] for s in ("", " (typed)") for r in by.get((key[0], key[1], strata + s, "mem_settled"), [])] if strata else []
            ratio, bar = bar_of([r[key[3]]["pss_kb"] for r in g], theirs)
            versus = "-" if key[2].split(" ")[0] == strata else "n/a" if ratio is None else "%.2f %s" % (ratio, bar) if key[2].split(" ")[0] in subjects else "%.2f" % ratio
            out.append("| %s | %s | %s | %d | %s | %s | %s | %s | %s | %s | %s |" % (
                key[0], key[1], key[2], len(g), rng([r[key[3]]["pss_kb"] for r in g]), versus,
                rng([r[key[3]]["pss_anon_kb"] for r in g]), rng([r[key[3]]["uss_kb"] for r in g]),
                rng([a.get("pss_kb") for a in after]), rng([a.get("uss_kb") for a in after]),
                ",".join(sorted({p["comm"] for p in g[0][key[3]]["procs"]}))))
        out.append("")
    gap_rows = [r for r in rows if r.get("frame_gaps") or r.get("enter_frame_gaps")]
    if gap_rows:
        out.append("### attach gaps of the busiest surface, ms: first keystroke to settled, and Enter to settled")
        out.append("")
        out.append("| fixture | mode | arm | L | window | attaches | largest | p95 |")
        out.append("|---|---|---|---|---|---|---|---|")
        for r in gap_rows:
            for label, key in (("typing", "frame_gaps"), ("Enter", "enter_frame_gaps")):
                g = r.get(key)
                if g:
                    out.append("| %s | %s | %s | %d | %s | %d | %s | %s |" % (
                        r["fixture"], r.get("mode", "search"), r["arm"], r["length"], label, g["attaches"],
                        g["max_gap_ms"], g["p95_gap_ms"]))
        out.append("")
    errors = [r for r in rows if "error" in r]
    if errors:
        out.append("errors: " + "; ".join("%s r%s: %s" % (e.get("arm"), e.get("round"), e["error"]) for e in errors))
    print("\n".join(out))
    return 0


def is_subsequence(q, text):
    it = iter(text)
    return all(c in it for c in q)


def held_order(root):
    """Names under root in the order Flea's backend sends them: folders first, then natural names."""
    def natkey(n):
        return [int(p) if p.isdigit() else p.lower() for p in re.split(r"(\d+)", n)]
    ordered = lambda ns: sorted(ns, key=lambda n: (natkey(n), n))
    paths = os.listdir(root)
    return ordered([n for n in paths if os.path.isdir(os.path.join(root, n))]) + \
        ordered([n for n in paths if not os.path.isdir(os.path.join(root, n))])


def pickquery(root, flat=False):
    """The fixed 6 character query of a column: the 6-gram at the most depths (tree) or the substring moving the visible rows at 1, 3 and 6 characters (flat)."""
    if flat:
        # Flea's "/" filter keeps backend order (folders first, natural names), so the window is modelled the same way.
        names = held_order(root)
        held = names[:HELD_ROWS]
        def top(q):
            return [n for n in held if q in n.lower()][:VISIBLE_ROWS]
        # A substring of a name, so the match moves the rows: a name's own prefix leaves the head of a sorted list as it was.
        grams = []
        for n in held[len(held) // 3:] + held[:len(held) // 3]:
            low = n.lower()
            for i in range(1, len(low) - 5):
                g = low[i:i + 6]
                if g not in grams and re.fullmatch(r"[a-z0-9._-]{6}", g):
                    grams.append(g)
        for pick in grams:
            # The rows on screen after 0, 1, 3 and 6 characters must be four different lists, the last not empty.
            tops = [top(pick[:k]) for k in (0, 1, 3, 6)]
            if all(tops[i] != tops[i + 1] for i in range(3)) and len(tops[3]) >= 3:
                break
        else:
            raise SystemExit("no 6 character substring changes the visible rows at 1, 3 and 6 characters in the first %d rows of %s" % (HELD_ROWS, root))

        def within(rows, q):
            return sum(1 for n in rows if q in n.lower())
        return {"query": pick, "entries": len(names), "held_rows": len(held),
                "held_after_1": within(held, pick[:1]), "held_after_3": within(held, pick[:3]),
                "held_matches": within(held, pick),
                "substring_matches": within(names, pick),
                "subsequence_matches": sum(1 for n in names if is_subsequence(pick, n.lower())),
                "after_1": within(names, pick[:1]), "after_3": within(names, pick[:3])}
    depth_of, count, rels = {}, {}, []
    for cur, dirs, files in os.walk(root):
        rel = os.path.relpath(cur, root)
        depth = 0 if rel == "." else rel.count("/") + 1
        for name in dirs + files:
            p = os.path.join(rel, name) if rel != "." else name
            rels.append((p[2:] if p.startswith("./") else p).lower())
            low = name.lower()
            for m in {low[i:i + 6] for i in range(len(low) - 5)}:
                if re.fullmatch(r"[a-z0-9]{6}", m):
                    depth_of.setdefault(m, set()).add(depth)
                    count[m] = count.get(m, 0) + 1
    cands = [g for g, d in depth_of.items() if len(d) >= 3 and QUERY_COUNT_MIN <= count[g] <= QUERY_COUNT_MAX]
    if not cands:
        raise SystemExit("no 6-gram sits at three depths with 20 to 2000 substring matches under " + root)
    best = max(cands, key=lambda g: (len(depth_of[g]), count[g], g))
    return {"query": best, "entries": len(rels), "depths": sorted(depth_of[best]), "substring_matches": count[best],
            "subsequence_matches": sum(1 for r in rels if is_subsequence(best, r)),
            "after_1": sum(1 for r in rels if best[:1] in r), "after_3": sum(1 for r in rels if best[:3] in r)}


# calibrate


def calibrate_row(delay_ms, samples, swaps, floor, floor_share, frame_ms):
    # One delay row scored under both rules; the pass flag follows the client swap rule.
    err = [s - floor - delay_ms for s in samples]
    share = [s - c for s, c in zip(samples, swaps)]
    cerr = [sh - floor_share for sh in share]
    return {"delay_ms": delay_ms,
            "error_vs_programmed_ms": [round(e, 1) for e in err],
            "error_vs_client_ms": [round(e, 1) for e in cerr],
            "median_share_ms": round(statistics.median(share), 2),
            "worst_abs_client_error_ms": round(max(abs(e) for e in cerr), 1),
            "within_one_frame": all(abs(e) <= frame_ms for e in cerr)}


def calibrate_score_row(delay_ms, samples, swaps, floor, floor_share, frame_ms):
    # Programmed error needs only the floor; the client score needs matching swaps.
    row = {}
    if floor is not None:
        err = [s - floor - delay_ms for s in samples]
        row["error_vs_programmed_ms"] = [round(e, 1) for e in err]
        row["worst_abs_programmed_error_ms"] = round(max(abs(e) for e in err), 1)
    if floor is not None and floor_share is not None and len(swaps) == len(samples):
        row.update(calibrate_row(delay_ms, samples, swaps, floor, floor_share, frame_ms))
    return row


def calibrate(delays, runs, keep=None):
    """A client that changes its results a known delay after a key; the method must read that delay back."""
    work = tempfile.mkdtemp(prefix="flea-calib-")
    rec_bin = build_recorder(os.path.join(work, "rec"))
    shell_dir = os.path.join(work, "shell")
    os.makedirs(shell_dir)
    with open(os.path.join(REPO, "tests", "search-calib.qml")) as f, open(os.path.join(shell_dir, "shell.qml"), "w") as g:
        g.write(f.read())
    keys = Keys()
    mon = monitor()
    frame_ms = 1000.0 / mon.get("refreshRate", 60.0)
    results = []
    for d in delays:
        samples = []
        swaps = []
        spent = []
        for run in range(runs):
            env = dict(ENV, CALIB_DELAY_MS=str(d), QT_FORCE_STDERR_LOGGING="1")
            logf = open(os.path.join(work, "client-%d-%d.log" % (d, run)), "w")
            client = subprocess.Popen(["qs", "-p", shell_dir, "-n"], env=env, stdout=logf, stderr=subprocess.STDOUT)
            try:
                win = window_by_pid({client.pid} | descendants(client.pid), 20)
                if win is None:
                    raise RuntimeError("the calibration window never mapped")
                focus_window(win["address"])
                park_cursor()
                time.sleep(1.0)
                hide_cursor(keys)
                win = [c for c in clients() if c["address"] == win["address"]][0]
                (x, y), (w, h) = win["at"], win["size"]
                # The masked query line sits inside the watched window, so only the mask keeps it out.
                region = (x, y, w, h)
                masks = [(x, y, w, 48)]
                rec = Recorder(rec_bin, region, masks)
                try:
                    time.sleep(0.6)
                    t_key = keys.chord("a")
                    ok = rec.wait_quiet(1 * NS, t_key, 6 * NS)
                    frames = rec.snapshot()
                    detail = rec.detail_snapshot()
                finally:
                    rec.stop()
                if os.environ.get("CALIB_DEBUG"):
                    print("DEBUG d=%d key=%d region=%s masks=%s" % (d, t_key, region, masks), file=sys.stderr)
                    for pres, recv, rows, first, last, c0, c1, ink in detail:
                        print("DEBUG frame %+.1f ms rows=%d y %d..%d x %d..%d ink=%d recv_lag=%.1f" % (
                            (pres - t_key) / MS, rows, first, last, c0, c1, ink, (recv - pres) / MS), file=sys.stderr)
                t_first = first_change_after(result_changes_of(frames), t_key)
                if t_first is None:
                    raise RuntimeError("no result frame seen after the key (delay %d, run %d)" % (d, run))
                samples.append((t_first - t_key) / MS)
                spent.append(frames_before_result(frames, t_key, t_first))
                logf.flush()
                with open(os.path.join(work, "client-%d-%d.log" % (d, run))) as f:
                    for line in f:
                        # Sample input, one client line: "CALIB swap key=12.3 swapped=45.6" (detector ms, client ms).
                        if "CALIB swap" in line:
                            kv = dict(p.split("=") for p in line.split("CALIB swap")[1].split())
                            swaps.append(float(kv["swapped"]) - float(kv["key"]))
            finally:
                client.terminate()
                try:
                    client.wait(5)
                except subprocess.TimeoutExpired:
                    client.kill()
                logf.close()
                time.sleep(0.5)
        results.append((d, samples, swaps, spent))
    floor = statistics.median(results[0][1]) if results and results[0][0] == 0 else None
    # Median client share on the delay-0 row, the instrument floor under the new rule.
    floor_share = (statistics.median(s - c for s, c in zip(results[0][1], results[0][2]))
                   if results and results[0][0] == 0 and len(results[0][2]) == len(results[0][1]) else None)
    report = {"frame_ms": round(frame_ms, 2), "refresh_hz": mon.get("refreshRate"), "rows": []}
    for d, samples, swaps, spent in results:
        row = {
            "delay_ms": d,
            "runs": len(samples),
            "measured_ms": [round(s, 1) for s in samples],
            "median_ms": round(statistics.median(samples), 1),
            "min_ms": round(min(samples), 1),
            "max_ms": round(max(samples), 1),
            "client_key_to_swap_ms": [round(s, 1) for s in swaps],
            "frames_before_result": spent,
        }
        row.update(calibrate_score_row(d, samples, swaps, floor, floor_share, frame_ms))
        report["rows"].append(row)
    report["floor_ms"] = None if floor is None else round(floor, 1)
    report["floor_share_ms"] = None if floor_share is None else round(floor_share, 1)
    report["workdir"] = work
    print(json.dumps(report, indent=1))
    return report


