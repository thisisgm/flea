#!/bin/bash
# Over the hard cap fails; over the soft budget only warns, see AGENTS.md "File budget".
set -u

soft_rust=250; hard_rust=400
soft_qml=250;  hard_qml=400
soft_js=200;   hard_js=300

# Recorded debts and scoped release exceptions retain exact per-file ceilings; global limits stay unchanged.
known_over_cap="shelf/Model.js 669
shelf/Panel.qml 430
shelf/ShelfCard.qml 443
shelf/ShelfService.qml 481
src/backend/copyfile.rs 491
src/backend/copyfile_tests.rs 412
src/backend/durable.rs 439
src/backend/durable_tests.rs 766
src/backend/fsinforeq.rs 407
src/backend/jump_tests.rs 403
src/backend/renamecompat.rs 447
src/backend/gvfslist.rs 549
src/backend/imagesize.rs 475
src/backend/localsend.rs 403
src/backend/menu_actions.rs 560
src/backend/menu_registry.rs 563
src/backend/meta.rs 436
src/backend/metareq.rs 423
src/backend/movebatch.rs 466
src/backend/movebatch_tests.rs 528
src/backend/opsdispatch.rs 536
src/backend/opsreq.rs 513
src/backend/opsreq/tests.rs 460
src/backend/proto.rs 285
src/backend/run.rs 444
src/backend/thumbs.rs 441
src/backend/thumbworker.rs 953
src/backend/trashbrowse.rs 698
src/backend/trashdelete.rs 901
src/gui.rs 432
src/tui/actions.rs 1021
src/tui/input.rs 449
src/tui/model.rs 1247
src/tui/render.rs 889
src/uistate.rs 442
src/uistore.rs 483
src/vulkan.rs 620
tests/js/focus.js 406
tests/js/mounts.js 383
tests/js/network.js 306
tests/js/ops.js 390
tests/js/status.js 354
ui/Backend.qml 400
ui/ChromeBar.qml 468
ui/ContextMenu.qml 578
ui/ConvertDialog.qml 440
ui/Ipc.qml 801
ui/NetworkDialog.qml 449
ui/NetworkMounts.qml 838
ui/OpenWithDialog.qml 588
ui/Pane.qml 724
ui/PaneMenuActions.qml 404
ui/PaneWire.qml 462
ui/PermissionsDialog.qml 426
ui/PickerWindow.qml 676
ui/PreviewColumn.qml 499
ui/Preview.qml 463
ui/Row.qml 421
ui/SettingsPanel.qml 542
ui/SettingsRow.qml 410
ui/Sidebar.qml 568
ui/StatusBar.qml 451
ui/TrashView.qml 467
ui/WindowBody.qml 546
ui/js/Filter.js 253
ui/js/Focus.js 359
ui/js/Keymap.js 313
ui/js/Menu.js 335
ui/js/Ops.js 371
ui/js/Settings.js 427"

status=0

budget_for() {
  case "$1" in
    *.rs)  echo "$soft_rust $hard_rust" ;;
    *.qml) echo "$soft_qml $hard_qml" ;;
    *.js)  echo "$soft_js $hard_js" ;;
    *)     echo "" ;;
  esac
}

while IFS= read -r file; do
  budgets=$(budget_for "$file")
  [ -z "$budgets" ] && continue
  soft=${budgets% *}
  hard=${budgets#* }
  lines=$(wc -l < "$file")
  if [ "$lines" -gt "$hard" ]; then
    recorded=$(printf '%s\n' "$known_over_cap" | awk -v f="$file" '$1 == f { print $2 }')
    if [ -n "$recorded" ]; then
      if [ "$lines" -gt "$recorded" ]; then
        echo "GREW      $file: $lines lines, recorded $recorded, cap $hard"
        status=1
      else
        echo "known     $file: $lines lines, recorded $recorded, cap $hard"
      fi
      continue
    fi
    echo "OVER CAP  $file: $lines lines, cap $hard"
    status=1
  elif [ "$lines" -gt "$soft" ]; then
    echo "over soft $file: $lines lines, budget $soft, split it"
  fi
done < <(find src ui shelf tests -type f \( -name '*.rs' -o -name '*.qml' -o -name '*.js' \) 2>/dev/null)

exit $status
