tests/js/network.js 306
tests/js/ops.js 390
tests/columnrow-geom.qml 409
tests/columnscost.qml 416
tests/columnsfolder.qml 396
tests/js/status.js 354
ui/Backend.qml 431
ui/ChromeBar.qml 478
ui/ColumnsArea.qml 459
ui/ContextMenu.qml 584
ui/ConvertDialog.qml 440
ui/Ipc.qml 818
ui/NetworkDialog.qml 449
ui/NetworkMounts.qml 838
ui/OpenWithDialog.qml 592
ui/Pane.qml 735
ui/PaneMenuActions.qml 407
ui/PaneWire.qml 468
ui/PermissionsDialog.qml 432
ui/PickerWindow.qml 706
ui/PreviewColumn.qml 499
ui/Preview.qml 463
ui/Row.qml 474
