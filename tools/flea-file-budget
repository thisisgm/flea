status=0

# A file listed twice hands the ceiling lookup two numbers and breaks its comparison.
duplicated=$(printf '%s\n' "$known_over_cap" | awk '{ print $1 }' | sort | uniq -d)
if [ -n "$duplicated" ]; then
  echo "DUPLICATE ceiling: $duplicated"
  status=1
fi

budget_for() {
  case "$1" in
    *.rs)  echo "$soft_rust $hard_rust" ;;
    *.qml) echo "$soft_qml $hard_qml" ;;
    *.js|*.mjs)  echo "$soft_js $hard_js" ;;
    *)     echo "" ;;
  esac
}

while IFS= read -r -d '' file; do
  # Pinned vendor bundles are excluded as generated output; the generated Keymap.js keeps its recorded ceiling.
  case "$file" in
    ui/vendor/*) continue ;;
  esac
  budgets=$(budget_for "$file")
  [ -z "$budgets" ] && continue
  soft=${budgets% *}
  hard=${budgets#* }
  if [ ! -r "$file" ]; then
    echo "UNREADABLE $file: cannot read it, so it has no line count"
    status=1
    continue
  fi
  lines=$(wc -l < "$file")
  recorded=""
  if [[ "$file" = crates/* ]] || [ "$lines" -gt "$hard" ]; then
    # Sample input: known_over_cap lines such as "ui/Preview.qml 724": a path and its exact ceiling.
    recorded=$(printf '%s\n' "$known_over_cap" | awk -v f="$file" '$1 == f { print $2; exit }')
  fi
  # Existing native soft overruns ratchet at their measured record too.
  if [[ "$file" = crates/* && -n "$recorded" && "$lines" -gt "$recorded" ]]; then
    echo "GREW      $file: $lines lines, recorded $recorded, cap $hard"
    status=1
  elif [ "$lines" -gt "$hard" ]; then
    if [ -n "$recorded" ]; then
      if [ "$lines" -gt "$recorded" ]; then
        echo "GREW      $file: $lines lines, recorded $recorded, cap $hard"
        status=1
      else
        echo "known     $file: $lines lines, recorded $recorded, cap $hard"
      fi
      continue
    fi
    echo "OVER CAP  $file: $lines lines, cap $hard"
    status=1
  elif [ "$lines" -gt "$soft" ]; then
    echo "over soft $file: $lines lines, budget $soft, split it"
  fi
done < <(
  find src ui shelf tests -type f \( -name '*.rs' -o -name '*.qml' -o -name '*.js' -o -name '*.mjs' \) -print0 2>/dev/null
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git ls-files --cached --deduplicate -z -- 'crates/*.rs' 2>/dev/null
  else
    find crates -type f -name '*.rs' -print0 2>/dev/null
  fi
)

exit $status
