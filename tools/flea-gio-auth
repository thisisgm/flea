#!/usr/bin/expect -f
# Mounts one GIO URI with one password read from stdin and no secret output.
log_user 0
set timeout 30
if {[info exists env(FLEA_GIO_AUTH_TIMEOUT)]} {
    set timeout $env(FLEA_GIO_AUTH_TIMEOUT)
}

if {$argc != 1 || [gets stdin password] < 0 || $password eq ""} {
    exit 2
}
set uri [lindex $argv 0]
set password_sent 0
# gvfsd-dav asks again only once the server refused the password; elsewhere a second prompt may be a second factor.
set refused_status 1
if {[regexp -nocase {^davs?://} $uri]} {
    # 77 is outside gio mount's 0 to 2, timeout's 124 to 127 and 137, and the shell's 128 and up.
    set refused_status 77
}

# Prompt labels are parsed below, so gettext must not translate them.
set env(LC_ALL) C.UTF-8
unset -nocomplain env(LANGUAGE)
spawn -noecho gio mount $uri
expect {
    -re {Choice: *$} {
        set password ""
        catch {close}
        catch {wait}
        exit 1
    }
    -re {Continue anyway.*y/n} {
        set password ""
        catch {close}
        catch {wait}
        exit 1
    }
    -re {Store password.*never/session/permanent} {
        send -- "never\r"
        exp_continue
    }
    # Issue 98: Domain takes its default empty answer; class "[^]]*" keeps expect's derived gate glob matching.
    -re {(?i)\mDomain \[[^]]*\]: *\r?$} {
        send -- "\r"
        exp_continue
    }
    # The real prompt only: keyword immediately before the colon, so the informational header cannot match.
    -re {(?i)\m(password|passphrase): *\r?$} {
        if {$password_sent} {
            catch {close}
            catch {wait}
            exit $refused_status
        }
        send -- "$password\r"
        set password ""
        set password_sent 1
        exp_continue
    }
    # ssh's encrypted-key prompt keeps the old pattern's passphrase support.
    -re {(?i)\mEnter passphrase for key [^\r\n]*: *\r?$} {
        if {$password_sent} {
            catch {close}
            catch {wait}
            exit $refused_status
        }
        send -- "$password\r"
        set password ""
        set password_sent 1
        exp_continue
    }
    eof {
        set result [wait]
        set password ""
        if {!$password_sent && [lindex $result 3] == 0} {
            exit 1
        }
        exit [lindex $result 3]
    }
    timeout {
        set password ""
        catch {close}
        catch {wait}
        exit 124
    }
}
