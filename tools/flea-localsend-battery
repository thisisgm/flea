def battery(args, lab, root, log):
    wanted = {}
    # Sample --cases: "send-small:5,cancel" runs send-small 5 times and cancel --runs times.
    for item in filter(None, args.cases.split(",")):
        name, _, runs = item.partition(":")
        wanted[name] = int(runs) if runs else args.runs
    unknown = set(wanted) - {name for name, _ in CASES}
    if unknown:
        raise SystemExit("unknown cases: %s" % ", ".join(sorted(unknown)))
    bt = Battery(args, lab, root)
    results = []

    def say(line):
        print(line, flush=True)
        log.write(line + "\n")
        log.flush()

    say("# flea %s, %s, rate %s, large %d MiB, %d small files" % (
        args.flea, run([args.cli, "--version"]).stdout.strip(), args.rate or "unshaped", args.large_mb, args.many))
    for name, fn in CASES:
        if wanted and name not in wanted:
            continue
        runs = wanted.get(name, args.runs)
        bt.runs = runs
        bt.flea = Flea(lab, "a", args.flea, bt.bindir, root)
        oks, reasons = 0, {}
        for i in range(runs):
            t0 = time.time()
            try:
                fn(bt, i)
                oks += 1
                say("%s run %d ok %.1fs" % (name, i + 1, time.time() - t0))
            except Fail as e:
                reasons[str(e)] = reasons.get(str(e), 0) + 1
                say("FAIL %s run %d %.1fs: %s" % (name, i + 1, time.time() - t0, e))
            except Exception as e:  # noqa: BLE001, the battery reports a harness fault as that run's failure
                reasons[repr(e)] = reasons.get(repr(e), 0) + 1
                say("FAIL %s run %d %.1fs: harness: %r" % (name, i + 1, time.time() - t0, e))
            # A failed run can leave a sleeping peer or a link down; the next run starts from the topology.
            for peer in bt.peers.values():
                peer.term.signal(signal.SIGCONT)
        bt.flea.close()
        results.append((name, oks, runs, reasons))
    say("# summary")
    for name, oks, runs, reasons in results:
        say("%-18s %d/%d ok" % (name, oks, runs))
        for reason, n in sorted(reasons.items(), key=lambda kv: -kv[1]):
            say("    %dx %s" % (n, reason))
    for peer in bt.peers.values():
        peer.close()
    return all(oks == runs for _, oks, runs, _ in results)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--flea", help="the flea binary under test")
    ap.add_argument("--cli", help="the localsend-cli binary every node runs")
    ap.add_argument("--runs", type=int, default=20, help="runs per case (default 20)")
    ap.add_argument("--cases", default="", help="comma list, each optionally NAME:RUNS (default all)")
    ap.add_argument("--rate", default="300mbit", help="tc rate on Peer B's link, empty for unshaped (default 300mbit)")
    ap.add_argument("--large-mb", type=int, default=2048, help="size of the large file in MiB (default 2048)")
    ap.add_argument("--many", type=int, default=1000, help="number of small files (default 1000)")
    ap.add_argument("--root", help="an empty directory to work in (default a new mktemp root)")
    ap.add_argument("--log", default="flea-localsend-battery.log", help="the log, appended (default in the cwd)")
    ap.add_argument("--keep", action="store_true", help="keep the work root")
    ap.add_argument("--list", action="store_true", help="print the case names")
    args = ap.parse_args()
    if args.list:
        print("\n".join(name for name, _ in CASES))
        return 0
    if not args.flea or not args.cli:
        ap.error("--flea and --cli are required")
    if args.rate and not parse_rate(args.rate):
        ap.error("--rate takes Nbit, Nkbit, Nmbit or Ngbit, not %r" % args.rate)
    args.flea, args.cli = os.path.abspath(args.flea), os.path.abspath(args.cli)
    args.log = os.path.abspath(args.log)
    if os.environ.get(INNER) != "1":
        env = dict(os.environ, **{INNER: "1"})
        env["PATH"] = env.get("PATH", "/usr/bin:/bin") + ":/usr/sbin:/sbin"
        argv = ["unshare", "-Urn", "--kill-child", sys.executable, "-I", os.path.abspath(__file__)] + sys.argv[1:]
        os.execvpe("unshare", argv, env)
    if args.root:
        root = os.path.abspath(args.root)
        if os.listdir(root):
            raise SystemExit("--root must be empty: %s" % root)
    else:
        root = tempfile.mkdtemp(prefix="flea-localsend-battery.")
    open(os.path.join(root, MARKER), "w").close()
    lab = Lab()
    try:
        with open(args.log, "a") as log:
            ok = battery(args, lab, root, log)
    finally:
        lab.close()
        if not args.keep and os.path.exists(os.path.join(root, MARKER)):
            shutil.rmtree(root)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
