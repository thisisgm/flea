@@ -306,6 +306,43 @@
     if let Some(refused) = super::rowguard::refusal(line, st.generation) {
         say(out, &refused);
         return Control::Continue;
+    }
+    // Bench-only framing and raw identity audit, outside timed product work.
+    match crate::json::field_str(line, "c").as_deref() {
+        Some("benchping") => {
+            say(out, r#"{"t":"pong"}"#);
+            return Control::Continue;
+        }
+        Some("benchaudit") => {
+            if let Some(session) = st.search_session.as_mut() {
+                let gen = crate::json::field_usize(line, "gen").unwrap_or(0);
+                let count = crate::json::field_usize(line, "count").unwrap_or(350);
+                let query = crate::json::field_str(line, "query").unwrap_or_default();
+                let target = crate::json::field_str(line, "target").unwrap_or_default();
+                if let Some(answer) = session.query(gen, &query, count) {
+                    let rank = answer.rows.iter().position(|(path, _)| path == &target).map_or(0, |rank| rank + 1);
+                    writeln!(out, r#"{{"t":"rank","gen":{},"rank":{},"n":{},"complete":{}}}"#, gen, rank, answer.total, answer.rows.len() == answer.total).ok();
+                    out.flush().ok();
+                }
+            }
+            return Control::Continue;
+        }
+        Some("benchinventory") => {
+            if let Some(session) = st.search_session.as_ref() {
+                let index = session.index.lock().unwrap();
+                write!(out, r#"{{"t":"inventory","identities":["#).ok();
+                for row in 0..index.len() {
+                    if row > 0 { write!(out, ",").ok(); }
+                    write!(out, "[\"").ok();
+                    for byte in index.raw(row) { write!(out, "{byte:02x}").ok(); }
+                    write!(out, "\",\"{}\"]", if index.is_dir(row) { "d" } else { "f" }).ok();
+                }
+                writeln!(out, "]}}").ok();
+                out.flush().ok();
+            }
+            return Control::Continue;
+        }
+        _ => {}
     }
     let request = parse_request(line);
