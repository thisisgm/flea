# The closer absorbs the remainder of the target, so the run ends on the mark exactly when the
# voiceover does. A hold longer than one caption turn is split between the two empty folders the
# run has, Scans and the Contact sheet the transfer beat emptied again, so no sentence repeats in place.
run_started_ms=0
beat_closer() {
    local remaining segments each i here
    beat closer "back on the theme stage found; the mark on the empty Desktop, for whatever of the voiceover is left"
    # The last switch of the take is the restore, verified, before the mark takes over.
    theme_wait
    theme_restore
    wait_foreground
    remaining=$(( target_s - ( $(now_ms) - run_started_ms ) / 1000 ))
    if (( remaining < 8 )); then
        printf 'CLOSER the beats ran %s s past the target; holding 8 s, trim before the take\n' "$(( 8 - remaining ))"
        remaining=8
    fi
    segments=$(( (remaining + caption_turn_s - 1) / caption_turn_s ))
    (( segments > 4 )) && segments=4
    each=$(( remaining / segments ))
    printf 'CLOSER %s s left, %s hold(s) of about %s s\n' "$remaining" "$segments" "$each"
    for (( i = 0; i < segments; i++ )); do
        if (( i % 2 == 0 )); then here="$empty_a"; else here="$empty_b"; fi
        goto_path "$here"
        expect_ipc emptyShown true
        # The last hold takes the clock's own remainder, so the transitions above never push past the target.
        if (( i == segments - 1 )); then
            each=$(( target_s - ( $(now_ms) - run_started_ms ) / 1000 ))
            (( each < 3 )) && each=3
        fi
        if (( i == 0 )); then
            shot closer-a
            dwell 0.7
            shot closer-b
        fi
        dwell "$each"
    done
    shot end
}

all_beats="open drag click transfer newfolder views scale quicklook errors search rename trash taildrop dropbox rail keys closer"

run_beats() {
    local beats="${*:-$all_beats}" b started
    load_state
    [[ -n "$(client_json "$addr_a")" ]] || fail "the staged window is gone, run stage again"
    park_pointer
    theme_pool
    started=$(now_ms)
    run_started_ms=$started
    last_switch_ms=$started
    rm -f "$work/rotation"
    for b in $beats; do
        declare -F "beat_$b" >/dev/null || fail "no beat called $b (have: $all_beats)"
        # The opener and the closer belong to the mark on the theme stage found; everything between rotates.
        case "$b" in
            open) rotate_on=0 ;;
            closer) rotate_on=0 ;;
            *) rotate_on=1; rotate_point "before-$b" ;;
        esac
        # A beat that fails is skipped, not fatal: a take missing one beat is worth more than no take.
        if ( "beat_$b" ); then
            :
        else
            printf 'SKIPPED %s after a failure, carrying on\n' "$b"
            recover_after_beat
        fi
        rotation_load
        close_beat
    done
    printf 'SWITCHES %s\n' "$switches"
    printf 'TOTAL %.1f s\n' "$(( $(now_ms) - started ))e-3"
}

# After a failed beat: any second window closed, any menu, dialog or preview dismissed, the pointer parked.
recover_after_beat() {
    local pid
    for pid in $(fixture_instances); do
        (( pid == pid_a )) || { kill "$pid" 2>/dev/null; printf 'RECOVER closed a second window, pid %s\n' "$pid"; }
    done
    ctrl_up
    release
    park_pointer
    key -k Escape; key -k Escape; key -k Escape
    place "$addr_a" "$(rest_x)" "$(rest_y)" "$width" "$height" >/dev/null 2>&1 || true
}

