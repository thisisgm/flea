# Records everything under a path the product just created, files first and directories after, so
# the manifest's backward walk unlinks the files and then removes the emptied directories.
made_tree() {
    local p
    while IFS= read -r p; do made "$p"; done < <(find "$1" -depth -mindepth 1 2>/dev/null | tac)
    made "$1"
}

# The one new entry a directory gained, by name, so a product-named output is recorded without guessing it.
new_entry_in() {
    local dir="$1" before="$2" name
    while IFS= read -r name; do
        grep -qxF -- "$name" <<< "$before" || { printf '%s' "$name"; return 0; }
    done < <(ls -A "$dir")
    return 1
}

