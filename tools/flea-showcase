theme_check() {
    local name tag
    shots=1
    while read -r name; do
        tag=theme-check-$(printf '%s' "$name" | tr 'A-Z ' 'a-z-')
        theme_switch "$name"
        wait_theme_applied "$name"
        theme_wait
        wait_foreground
        surface_tour "$tag"
    done < <(theme_targets)
    theme_restore
    wait_foreground
    surface_tour theme-check-restored
}

# ------------------------------------------------------------------ the recording

recording_path() {
    grep '^recording=' "$state" | cut -d= -f2-
}

# The recorder called directly on the monitor: the stock command reaches only its very_high preset
# and a picker. Native size, constant 60 fps, constant-quality ultra, cursor recorded, the same
# CPU fallback the stock command passes. What it was actually launched with is read back from ps.
cmd_record() {
    local out stamp pid
    load_state
    command -v gpu-screen-recorder >/dev/null || fail "gpu-screen-recorder is missing"
    grep -q '^recording=' "$state" && fail "a recording is already registered: $(recording_path)"
    stamp=$(date +%Y-%m-%d-%H%M)
    mkdir -p "$real_home/Videos"
    out="$real_home/Videos/flea-showcase-$stamp-${stage_w}x${stage_h}.mp4"
    gpu-screen-recorder -w "$monitor" -f "$gsr_fps" -fm cfr -k "$gsr_codec" -q "$gsr_quality" -bm qp \
        -cursor yes -fallback-cpu-encoding yes -o "$out" >"$work/gsr.log" 2>&1 </dev/null 3>&- 4>&- &
    pid=$!
    for _attempt in $(seq 1 100); do
        [[ -s "$out" ]] && break
        kill -0 "$pid" 2>/dev/null || fail "the recorder exited before writing anything: $(tail -3 "$work/gsr.log")"
        sleep 0.1
    done
    [[ -s "$out" ]] || fail "the recorder started but wrote nothing in 10 s: $(tail -3 "$work/gsr.log")"
    printf 'recording=%s\ngsr_pid=%s\n' "$out" "$pid" >> "$state"
    park_pointer
    printf 'GSR %s\n' "$(ps -o args= -p "$pid")"
    printf 'RECORDING %s\n' "$out"
}

# SIGINT is what saves the file, the same signal the stock command sends; then the facts of the
# file itself, read by ffprobe, and never the settings this drive meant to pass.
cmd_stop() {
    local out pid
    load_state
    out=$(recording_path)
    pid=$(grep '^gsr_pid=' "$state" | cut -d= -f2-)
    [[ -n "$out" && -n "$pid" ]] || fail "no recording is registered"
    kill -INT "$pid" 2>/dev/null
    for _attempt in $(seq 1 100); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && fail "the recorder did not exit within 10 s of SIGINT; the file may be unfinished"
    sed -i '/^recording=/d; /^gsr_pid=/d' "$state"
    [[ -s "$out" ]] || fail "no file at $out"
    printf 'FILE %s\n' "$out"
    printf 'SIZE %s bytes\n' "$(stat -c %s "$out")"
    ffprobe -v error -show_entries format=duration:stream=codec_name,width,height,r_frame_rate,pix_fmt -of default=nw=1 "$out"
}

# ------------------------------------------------------------------ the commands

save_state() {
    printf 'theme=%s\nbackground=%s\npid_a=%s\nid_a=%s\naddr_a=%s\nstage_x=%s\nstage_y=%s\nstage_w=%s\nstage_h=%s\nmonitor=%s\n' \
        "$(theme_current)" "$(background_current)" "$pid_a" "$id_a" "$addr_a" \
        "$stage_x" "$stage_y" "$stage_w" "$stage_h" "$monitor" >> "$state"
}

# stage, record, run and stop are separate invocations, so the window and the stage travel through this file.
load_state() {
    [[ -f "$state" ]] || fail "nothing is staged, run stage first"
    pid_a=$(grep '^pid_a=' "$state" | cut -d= -f2-)
    id_a=$(grep '^id_a=' "$state" | cut -d= -f2-)
    addr_a=$(grep '^addr_a=' "$state" | cut -d= -f2-)
    stage_x=$(grep '^stage_x=' "$state" | cut -d= -f2-)
    stage_y=$(grep '^stage_y=' "$state" | cut -d= -f2-)
    stage_w=$(grep '^stage_w=' "$state" | cut -d= -f2-)
    stage_h=$(grep '^stage_h=' "$state" | cut -d= -f2-)
    monitor=$(grep '^monitor=' "$state" | cut -d= -f2-)
    [[ -n "$addr_a" && -n "$id_a" && -n "$monitor" ]] || fail "the state file names no window or monitor"
}

cmd_stage() {
    assert_box_clear
    fixture_build
    mkdir -p "$work"
    : > "$state"
    bar_hide
    dnd_on
    # Read after the bar has gone, so the strut it reserved is not subtracted from the stage.
    read_stage
    read -r pid_a id_a addr_a < <(spawn "$empty_a")
    expect_ipc themeLoaded true
    place "$addr_a" "$(rest_x)" "$(rest_y)" "$width" "$height"
    save_state
    park_pointer
    wait_path "$empty_a"
    expect_ipc emptyShown true
    printf 'STAGE %s %sx%s at %s,%s (the whole monitor is recorded)\n' "$monitor" "$stage_w" "$stage_h" "$stage_x" "$stage_y"
    printf 'STAGED theme=%s background=%s\n' "$(theme_current)" "$(background_current)"
}

cmd_teardown() {
    local trouble=0
    # The trap is disarmed first, so a fail inside a restore cannot start a second teardown.
    trap - EXIT
    printf 'TEARDOWN begins, state %s, manifest %s\n' "$([[ -f "$state" ]] && echo present || echo absent)" "$([[ -f "$manifest" ]] && echo present || echo absent)"
    if [[ -f "$state" ]] && grep -q '^gsr_pid=' "$state"; then
        cmd_stop || trouble=1
    fi
    # The theme first: measured on one run, the bar stayed hidden for 90 s with its flag clear and
    # re-mapped the moment the theme changed, so the theme restore is what wakes the bar. Then quiet.
    printf 'TEARDOWN theme\n'; theme_restore || trouble=1
    printf 'TEARDOWN bar\n';   bar_restore || trouble=1
    printf 'TEARDOWN quiet\n'; dnd_restore || trouble=1
    printf 'TEARDOWN windows\n'; kill_flea
    printf 'TEARDOWN furnishing\n'; fixture_remove || trouble=1
    rm -f "$state"
    if (( trouble == 0 )); then
        printf 'TEARDOWN done\n'
    else
        printf 'TEARDOWN finished with something not restored, see above\n' >&2
        exit 1
    fi
}

case "${1:-}" in
    fixture) fixture_build ;;
    stage) cmd_stage ;;
    record) cmd_record ;;
    run) shift; run_beats "$@" ;;
    stop) cmd_stop ;;
    dry-run)
        shift
        shots=1
        trap cmd_teardown EXIT
        cmd_stage
        run_beats "$@"
        theme_check
        ;;
    theme-check)
        trap cmd_teardown EXIT
        cmd_stage
        theme_check
        ;;
    teardown) cmd_teardown ;;
    *)
        sed -n '2,12p' "$0" | cut -c3-
        exit 2
        ;;
esac
