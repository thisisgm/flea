# Two real, empty directories of the operator's for the mark: the opener and the closer.
empty_a="$HOME/Desktop"
empty_b="$HOME/Public"

# Climbs to the home from anywhere inside it, one h at a time, never above it.
goto_home() {
    local attempt
    for attempt in $(seq 1 8); do
        [[ "$(ipc path)" == "$fixture" ]] && return 0
        [[ "$(ipc path)" == "$fixture"/* ]] || fail "the pane is at $(ipc path), outside the home"
        key h
        settle
    done
    fail "could not climb to the home, the pane is at $(ipc path)"
}

# Opens a path under the home by walking rows, so every step is on camera and nothing is typed.
goto_path() {
    local target="$1" rel part next
    goto_home
    rel=${target#"$fixture"/}
    [[ "$rel" != "$target" ]] || fail "$target is not under the home"
    while [[ -n "$rel" ]]; do
        part=${rel%%/*}
        [[ "$part" == "$rel" ]] && rel="" || rel=${rel#*/}
        # The destination is computed before Enter: read after it, the pane has already moved.
        next="$(ipc path)/$part"
        seek_row "$part"
        key -k Return
        wait_path "$next"
    done
}

# The opener: the mark painting itself into the empty folder, held under one caption turn, then up
# into the home, nine entries somebody's working files have, and a slow walk down five rows.
beat_open() {
    beat open "the mark paints into the empty Desktop; up into the home, a walk down five rows and back"
    wait_path "$empty_a"
    expect_ipc emptyShown true
    # Three shots 0.7 s apart inside the hold, so the dry run can tell a mark mid-stroke from one settled.
    dwell 4
    shot open-mark-a
    dwell 0.7
    shot open-mark-b
    dwell 0.7
    shot open-mark-c
    dwell $(( opener_s - 6 ))
    key h
    wait_path "$fixture"
    dwell 2.5
    shot open
    local i
    for i in 1 2 3 4 5; do
        step_down "$i"
        dwell 0.5
    done
    dwell 1.5
    key g
    expect_ipc cursor 0
    dwell 0.8
}

# Drag out to another application and back in: the second window is a second Flea process, so both
# drops arrive over the compositor's data device as text/uri-list, the way any application's would.
beat_drag() {
    local sx sy tx ty from_b to_a
    beat drag "into the Iceland photos; the window makes room, a second one opens; a photo out onto a folder, a PDF back in"
    goto_path "$iceland"
    dwell 1
    place "$addr_a" "$(pair_x)" "$(pair_y)" "$pair_w" "$height"
    dwell 0.5
    read -r pid_b id_b addr_b < <(spawn "$docs")
    place "$addr_b" "$(side_x)" "$(pair_y)" "$pair_w" "$height"
    expect "second window path" "$docs" ipc_b path
    omarchy-drive focus "$addr_a" >/dev/null
    dwell 2
    shot drag-two-windows

    # A drop transfers only over a folder row (tests/drag.sh R1), so the photo lands on notes in the
    # second window, with ctrl held so it is a copy and the album keeps its frame.
    seek_row 'basalt columns.jpg'
    read -r sx sy < <(row_screen_centre ipc "$addr_a" "$(ipc cursor)")
    read -r tx ty < <(row_screen_centre ipc_b "$addr_b" "$(ipc_b_row_index notes)")
    printf 'DRAG out from %s,%s to %s,%s (B at %s)\n' "$sx" "$sy" "$tx" "$ty" "$(client_geometry "$addr_b")"
    ctrl_down
    drag "$sx" "$sy" "$tx" "$ty"
    ctrl_up
    sleep 1
    shot drag-out-released
    printf 'DRAG out result: A says [%s] B says [%s] pointer %s\n' "$(ipc lastMessage)" "$(ipc_b lastMessage)" "$(cursor_pos)"
    made "$docs/notes/basalt columns.jpg"
    expect_file "$docs/notes/basalt columns.jpg"
    expect_message_has_b "z undoes"
    dwell 2.5
    shot drag-out

    # Back the other way: a document out of the second window onto an album folder in the first, then undone.
    key h
    wait_path "$photos"
    dwell 0.5
    from_b=$(ipc_b_row_index 'invoice-0142.pdf')
    to_a=$(row_index_matching 'Studio sessions')
    (( to_a >= 0 )) || fail "no Studio sessions folder to drop onto"
    read -r sx sy < <(row_screen_centre ipc_b "$addr_b" "$from_b")
    read -r tx ty < <(row_screen_centre ipc "$addr_a" "$to_a")
    printf 'DRAG in from %s,%s to %s,%s (A at %s)\n' "$sx" "$sy" "$tx" "$ty" "$(client_geometry "$addr_a")"
    ctrl_down
    drag "$sx" "$sy" "$tx" "$ty"
    ctrl_up
    sleep 1
    shot drag-in-released
    printf 'DRAG in result: A says [%s] B says [%s] pointer %s\n' "$(ipc lastMessage)" "$(ipc_b lastMessage)" "$(cursor_pos)"
    made "$photos/Studio sessions/invoice-0142.pdf"
    expect_file "$photos/Studio sessions/invoice-0142.pdf"
    expect_message_has "z undoes"
    dwell 2.5
    shot drag-in
    park_pointer
    key z
    expect_message_has "Undid the"
    expect_no_file "$photos/Studio sessions/invoice-0142.pdf"
    dwell 1.5

    close_window "$addr_b"
    pid_b=0; id_b=""; addr_b=""
    dwell 0.5
    place "$addr_a" "$(rest_x)" "$(rest_y)" "$width" "$height"
    rotate_point drag-end
    dwell 1
}

# The second window's own row lookup, the same glob walk as row_index_matching over ipc_b.
ipc_b_row_index() {
    local want="$1" i total name
    total=$(ipc_b total)
    for (( i = 0; i < total && i < 200; i++ )); do
        name=$(ipc_b rowAt "$i")
        name=${name%%|*}
        [[ "$name" == $want ]] && { printf '%s' "$i"; return; }
    done
    fail "the second window lists no $want"
}

