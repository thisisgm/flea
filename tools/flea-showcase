    beat errors "Enter on a dead link, then on a closed folder: a sentence each time, never a dump"
    goto_path "$docs"
    seek_row 'Archive drive'
    before=$(ipc lastMessage)
    key -k Return
    settle
    # Whichever surface answers, it is read and printed: the pane's state line or the status bar.
    printf 'DEAD LINK state=%s stateMessage=%s bar=%s\n' "$(ipc state)" "$(ipc stateMessage)" "$(ipc lastMessage)"
    [[ "$(ipc state)" != "listed" || "$(ipc lastMessage)" != "$before" ]] \
        || fail "Enter on the dead link changed nothing the seam can see"
    dwell 3.5
    shot errors-dead-link
    [[ "$(ipc path)" == "$docs" ]] || { key h; wait_path "$docs"; }
    key -k Escape
    seek_row 'Client vault'
    key -k Return
    settle
    printf 'CLOSED state=%s stateMessage=%s bar=%s\n' "$(ipc state)" "$(ipc stateMessage)" "$(ipc lastMessage)"
    [[ "$(ipc state)" != "listed" ]] || fail "Enter on the closed folder listed something"
    dwell 3.5
    shot errors-closed
    [[ "$(ipc path)" == "$docs" ]] || { key h; wait_path "$docs"; }
    dwell 1
}

