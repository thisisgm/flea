#!/usr/bin/env bash
# The showcase drive: a stage-set home, the whole monitor as the stage, and the beats of
# showcase-script.md (in .superpowers/sdd/2026-09-01-flea-1to1-buildout/) choreographed inside it.
#   tools/flea-showcase fixture               build the stage-set home and list it, no window
#   tools/flea-showcase stage                 fixture, then the window inside the stage; prints the region
#   tools/flea-showcase record                record the whole monitor at native size, 60 fps, QP ultra
#   tools/flea-showcase run [beat ...]        play the beats against the staged window
#   tools/flea-showcase stop                  stop the recording; prints size, duration, resolution and codec
#   tools/flea-showcase dry-run [beat ...]    stage, run with a shot per beat, theme-check, teardown
#   tools/flea-showcase theme-check           stage, switch themes and shoot every surface under each, teardown
#   tools/flea-showcase teardown              windows closed; bar, quiet and theme restored and verified; fixture deleted
# Beats: open drag click transfer newfolder views scale quicklook errors extract compress convert search rename trash taildrop dropbox rail keys closer
# The theme rotates about every 20 s under the beats, at named switch points only (see rotate_point).
# The take is timed to the operator's voiceover: the closer holds on the empty-state mark for whatever
# of target_s the beats before it left, so the run ends on the brand drawing itself, exactly on time.
# Every key is followed by a read of its consequence over IPC: a clean exit from the drive tool is
# not evidence that a key arrived, and one form of it has already passed while pressing nothing.
# The operator ruled that the take runs as their own instance: their home, their rail, their
# hostname. Their user directories are empty, so the take furnishes four of them with hard links
# into the stage set, and every path it creates is written to a manifest and removed by that
# manifest, one entry at a time, never by a recursive delete. A directory that is not empty at
# stage time is refused, so nothing of theirs is ever mixed with the set.
set -u
set -o pipefail

repo=$(cd "$(dirname "$0")/.." && pwd) || exit 1
ui=$repo/ui
bin=${FLEA_BIN:-$repo/target/release/flea}
# The operator's own home is the instance; these four are furnished from the stage set for the take.
fixture=$HOME
furnished=("$HOME/Pictures" "$HOME/Documents" "$HOME/Music" "$HOME/Projects")
# The stage set the folders are hard-linked from: tools/flea-showcase-content's studio, built from
# nothing and safe for a public timeline. Re-pointed here and nowhere else.
stage_src=${FLEA_SHOWCASE_SRC:-/home/flea-sandbox/flea-showcase-content/studio}
# The camera roll on camera is this many frames, the last of the stage set's 8,000: the content lane
# measured 300 items in 505 ms through the backend, so 2,400 is a four-second progress line in the
# transfer beat, and at some 540 KB a frame it is 1.3 GB of copy that the undo removes again.
roll_batch=2400
# The stage is the whole monitor, recorded at its native size with the bar hidden for the take, so
# stage_w and stage_h are read from the compositor and never assumed.
stage_w=0
stage_h=0
# The main window at rest: wide enough to fill the frame without the name column running empty,
# tall enough for the whole rail. Read against the boards at the dry run, not assumed right.
width=1280
height=860
# The drag pair: both windows the same size, side by side with this gap, centred as a pair.
pair_w=1180
gap=24
# The grid beat grows the window to this; nothing here ever goes below 1000 wide, because the
# column collapse under about 659 px is deferred to v0.1.1 and stays off camera.
grow_w=1720
grow_h=1000
# The recorder, called directly: the stock command reaches only its very_high preset and a picker.
gsr_codec=${FLEA_SHOWCASE_CODEC:-h264}
gsr_quality=ultra
gsr_fps=60
# Pinned like tests/ui.sh's evidence paths: a path the environment can move is a path nothing checks.
work=/tmp/flea-showcase
state=$work/state
evidence=$work/evidence
flea_log=$work/flea.log
# Every path the furnishing creates, deepest last, so removal walks it backwards.
manifest=$work/furnished.list
# The window's PATH starts here: a gio that logs an open, so a mis-fired open never lands an application on the take.
shim_dir=$work/bin
# A typed query lands at a reading pace rather than all at once.
type_ms=90
# The pointer parks in the screen corner, outside the stage, so the recording shows it only when a beat brings it in.
park_x=2559
park_y=1439
# The backend's own DRAIN_LIMIT is 25 s, the same wait tests/ui.sh gives it.
drain_wait_s=30
# The status bar clears a transient after 4000 ms, so a line meant to be read is dwelt on for less.
read_s=3
# The window coalescer is 16 ms and a refill is a round trip, the same settle tests/ui.sh uses.
settle_s=0.4
# The empty-state mark paints in over 0.2 + 1.8 s and the caption turns every 2.8 s (ui/FleaMark.qml,
# ui/EmptyState.qml), so a dwell of one full turn shows the whole stroke and the finished mark.
mark_turn_s=3.0
# The home root holds about a hundred thousand numbered entries today, so the home itself is the
# scale beat; its exact row count is read at run time and 7777 is the query that streams in.
home_rows=0
# The voiceover's length in seconds, measured off the operator's file (384.192 s); the run ends on it.
target_s=${FLEA_SHOWCASE_TARGET_S:-384}
# The empty-state caption turns through eight sentences at 2,800 ms, so a hold longer than one turn
# shows a sentence twice; the closer splits a long hold across two empty folders at this length.
caption_turn_s=22
# The opener: the recording begins on the mark already painting, held under one caption turn.
opener_s=12
shots=${SHOTS:-0}
flea_window_class=com.thisisgm.flea

fail() {
    printf 'flea-showcase: [%s] %s\n' "${FUNCNAME[1]:-main}" "$*" >&2
    exit 1
}

export PATH="$HOME/.local/bin:$PATH"
command -v omarchy-drive >/dev/null || fail "omarchy-drive is not on PATH"
eval "$(omarchy-drive env)"

# omarchy-drive env omits the Qt platform theme, without which no row icon resolves; the same
# three-step recovery tests/ui.sh uses, ending at a live client's own environment.
platform_theme() {
    systemctl --user show-environment | grep '^QT_QPA_PLATFORMTHEME=' | cut -d= -f2-
}
platform_theme_from_a_live_client() {
    local pid
    pid=$(pgrep -x quickshell | head -1)
    [[ -n "$pid" ]] || return 0
    tr '\0' '\n' < "/proc/$pid/environ" | grep '^QT_QPA_PLATFORMTHEME=' | cut -d= -f2-
}
[[ -n "${QT_QPA_PLATFORMTHEME:-}" ]] || export QT_QPA_PLATFORMTHEME="$(platform_theme)"
[[ -n "$QT_QPA_PLATFORMTHEME" ]] || export QT_QPA_PLATFORMTHEME="$(platform_theme_from_a_live_client)"
[[ -n "$QT_QPA_PLATFORMTHEME" ]] || fail "nothing published QT_QPA_PLATFORMTHEME, so no row would draw an icon"

# The real home, read before anything below points HOME at the fixture.
real_home=$HOME
real_state=$real_home/.local/state/omarchy/current
real_shell_toml=$real_home/.config/omarchy/shell.toml

# ------------------------------------------------------------------ the stage geometry

# Sample input, hyprctl monitors -j, one monitor: {"name":"DP-2","width":2560,"height":1440,"x":0,"y":0,"reserved":[0,30,0,0],...}
# corner: one monitor at scale 1 on this box, so logical pixels are physical pixels and nothing divides.
# With the bar hidden the strut is 0 and the stage is the whole monitor; if it stays, the windows
# keep out from under it and the recording still covers the monitor.
stage_x=0
stage_y=0
monitor=""
read_stage() {
    local mon_w mon_h mon_x mon_y top
    read -r monitor mon_w mon_h mon_x mon_y top < <(hyprctl monitors -j | jq -r '.[0] | "\(.name) \(.width) \(.height) \(.x) \(.y) \(.reserved[1])"')
    [[ -n "$top" ]] || fail "hyprctl monitors answered nothing, so there is no stage to place"
    stage_x=$mon_x
    stage_y=$(( mon_y + top ))
    stage_w=$mon_w
    stage_h=$(( mon_h - top ))
}

# Where the main window rests: centred in the stage.
rest_x() { printf '%s' $(( stage_x + (stage_w - width) / 2 )); }
rest_y() { printf '%s' $(( stage_y + (stage_h - height) / 2 )); }
# The drag pair, centred as a pair: the main window shrinks to pair_w and slides left, the second sits right.
pair_x() { printf '%s' $(( stage_x + (stage_w - 2 * pair_w - gap) / 2 )); }
side_x() { printf '%s' $(( $(pair_x) + pair_w + gap )); }
pair_y() { printf '%s' $(( stage_y + (stage_h - height) / 2 )); }
grow_x() { printf '%s' $(( stage_x + (stage_w - grow_w) / 2 )); }
grow_y() { printf '%s' $(( stage_y + (stage_h - grow_h) / 2 )); }

# ------------------------------------------------------------------ the bar

# omarchy toggle bar drives a flag called bar-off, so "on" hides the bar and "off" shows it; the
# layer stays listed either way, so the read-back is the strut the bar reserves at the top of the
# monitor: 30 here when shown, 0 when hidden, measured. The bar takes a few seconds to come back.
bar_flag=$real_home/.local/state/omarchy/toggles/bar-off
bar_strut() {
    hyprctl monitors -j | jq -r '.[0].reserved[1]'
}
bar_shown() {
    [[ ! -e "$bar_flag" ]] && (( $(bar_strut) > 0 ))
}
bar_hidden() {
    [[ -e "$bar_flag" ]] && (( $(bar_strut) == 0 ))
}
bar_wait_s=10

# Workspaces, clock, weather, tray and every presence widget live in the bar, and the take is
# public, so it goes for the take through Omarchy's own toggle and comes back only if it was there.
bar_hide() {
    if bar_shown; then
        printf 'bar=shown\n' >> "$state"
        omarchy toggle bar on >/dev/null 2>&1
        for _attempt in $(seq 1 $((bar_wait_s * 10))); do
            bar_hidden && { printf 'BAR hidden, strut %s\n' "$(bar_strut)"; return 0; }
            sleep 0.1
        done
        fail "the bar would not hide; the flag is $([[ -e "$bar_flag" ]] && echo set || echo unset) and the strut is $(bar_strut)"
    else
        printf 'bar=hidden\n' >> "$state"
    fi
}

bar_restore() {
    [[ -f "$state" ]] || return 0
    grep -qx 'bar=shown' "$state" || return 0
    [[ -e "$bar_flag" ]] && omarchy toggle bar off >/dev/null 2>&1
    # Three times the hide's wait: after a theme set the shell is still reloading and the bar
    # re-mapped 12 s late on one run; the stock script's own nudge is repeated at ten seconds.
    for _attempt in $(seq 1 $((bar_wait_s * 90))); do
        bar_shown && { printf 'BAR restored after %s s, verified: flag clear, strut %s\n' "$(( _attempt / 10 ))" "$(bar_strut)"; return 0; }
        # Measured: the flag alone brought the bar back late or not at all, and a theme apply woke it at
        # once, so after ten seconds the current theme is set again, which the shell treats as a full refresh.
        (( _attempt == bar_wait_s * 10 )) && omarchy theme set "$(theme_slug "$(theme_current)")" >/dev/null 2>&1
        sleep 0.1
    done
    printf 'flea-showcase: THE BAR DID NOT COME BACK in 90 s (flag %s, strut %s); run: omarchy toggle bar off\n' \
        "$([[ -e "$bar_flag" ]] && echo set || echo clear)" "$(bar_strut)" >&2
    return 1
}

# ------------------------------------------------------------------ notifications

# The shell's own answer, measured on this box as the words "on" and "off" (not true/false); anything
# else means the shell did not answer, and a toggle issued on a guess is the one way to invert the
# operator's setting, so an unreadable state is a refusal.
dnd_state() {
    local seen
    seen=$(omarchy-shell notifications isDnd 2>/dev/null)
    case "$seen" in
        on|off) printf '%s' "$seen" ;;
        *) fail "the shell answered '$seen' for do-not-disturb, not on or off, so nothing is toggled" ;;
    esac
}

# A toast mid-take is a wasted take and somebody's name in the frame, so do-not-disturb goes on
# through the stock toggle, recorded, verified, and undone only if this drive turned it on.
dnd_on() {
    if [[ "$(dnd_state)" == "on" ]]; then
        printf 'dnd=was_on\n' >> "$state"
        printf 'DND was already on, left alone\n'
        return 0
    fi
    printf 'dnd=turned_on\n' >> "$state"
    printf 'DND turned on for the take\n'
    omarchy toggle notification silencing >/dev/null 2>&1
    for _attempt in $(seq 1 60); do
        [[ "$(dnd_state)" == "on" ]] && return 0
        sleep 0.05
    done
    fail "do-not-disturb did not turn on; the shell answers '$(dnd_state)'"
}

# The shell may be mid-reload when this runs, so an unreadable answer is polled through, never fatal.
dnd_restore() {
    local seen
    [[ -f "$state" ]] || return 0
    grep -qx 'dnd=turned_on' "$state" || { printf 'DND was not changed by this run\n'; return 0; }
    seen=$(omarchy-shell notifications isDnd 2>/dev/null)
    [[ "$seen" == "on" ]] && omarchy toggle notification silencing >/dev/null 2>&1
    for _attempt in $(seq 1 300); do
        seen=$(omarchy-shell notifications isDnd 2>/dev/null)
        [[ "$seen" == "off" ]] && { printf 'DND restored, verified off\n'; return 0; }
        sleep 0.1
    done
    printf 'flea-showcase: DO-NOT-DISTURB IS STILL ON; run: omarchy toggle notification silencing\n' >&2
    return 1
}

# ------------------------------------------------------------------ the furnishing

# Records one created path; removal reads this file backwards and touches nothing else.
made() {
    printf '%s\n' "$1" >> "$manifest"
}

# Hard-links one stage-set entry under a furnished directory, every created path recorded.
furnish_tree() {
    local src="$1" dst="$2" entry name
    if [[ -L "$src" ]]; then
        cp -P "$src" "$dst" || fail "could not copy the link $src"
        made "$dst"
        return
    fi
    if [[ -d "$src" ]]; then
        if [[ ! -r "$src" ]]; then
            # The closed folder cannot be read to link its contents, and it has none: it is remade closed.
            mkdir "$dst" || fail "could not make $dst"
            made "$dst"
            touch -r "$src" "$dst" 2>/dev/null || true
            chmod 0000 "$dst"
            return
        fi
        mkdir "$dst" || fail "could not make $dst"
        made "$dst"
        touch -r "$src" "$dst"
        for entry in "$src"/* "$src"/.[!.]*; do
            [[ -e "$entry" || -L "$entry" ]] || continue
            name=${entry##*/}
            [[ "$name" == ".flea-test-sandbox" ]] && continue
            furnish_tree "$entry" "$dst/$name"
        done
        touch -r "$src" "$dst"
        return
    fi
    ln "$src" "$dst" || fail "could not link $src"
    made "$dst"
}

fixture_build() {
    local dir name
    [[ -d "$stage_src" ]] || fail "the stage set is missing at $stage_src; run tools/flea-showcase-content build"
    [[ -f "$manifest" ]] && fail "a furnishing is already recorded at $manifest; run teardown first"
    for dir in "${furnished[@]}"; do
        [[ -d "$dir" ]] || fail "$dir does not exist, so nothing is furnished"
        [[ -z "$(ls -A "$dir")" ]] || fail "$dir is not empty, so nothing of it is touched and nothing is furnished"
    done
    mkdir -p "$work" "$shim_dir"
    : > "$manifest"
    # Pictures: the two albums and the camera roll, the last roll_batch frames under their own names.
    furnish_tree "$stage_src/Photos/Iceland, March" "$HOME/Pictures/Iceland, March"
    furnish_tree "$stage_src/Photos/Studio sessions" "$HOME/Pictures/Studio sessions"
    mkdir "$HOME/Pictures/Camera roll" || fail "could not make the camera roll"
    made "$HOME/Pictures/Camera roll"
    ls "$stage_src/Photos/Camera roll" | sort | tail -n "$roll_batch" | while IFS= read -r name; do
        ln "$stage_src/Photos/Camera roll/$name" "$HOME/Pictures/Camera roll/$name" || exit 1
        printf '%s\n' "$HOME/Pictures/Camera roll/$name" >> "$manifest"
    done || fail "could not link the camera roll"
    touch -d '2026-09-01 18:40' "$HOME/Pictures/Camera roll"
    # Documents: the stage set's documents, its archives, its log over the preview cap, and the two error states.
    for name in "Consulting agreement, countersigned.pdf" "invoice-0142.pdf" notes; do
        furnish_tree "$stage_src/Documents/$name" "$HOME/Documents/$name"
    done
    furnish_tree "$stage_src/Archives" "$HOME/Documents/Archives"
    furnish_tree "$stage_src/Downloads/server.log" "$HOME/Documents/server.log"
    furnish_tree "$stage_src/Archive drive" "$HOME/Documents/Archive drive"
    furnish_tree "$stage_src/Client vault" "$HOME/Documents/Client vault"
    # Quick Look walks one listing, so the clip, a recording, a source file and an archive sit here too.
    furnish_tree "$stage_src/Recordings/interview with the harbour master.m4a" "$HOME/Documents/interview with the harbour master.m4a"
    furnish_tree "$stage_src/Recordings/walk to the lighthouse.mp4" "$HOME/Documents/walk to the lighthouse.mp4"
    furnish_tree "$stage_src/Projects/Lantern/src/main.rs" "$HOME/Documents/main.rs"
    # The two files the share beats act on, made for the purpose and named as demo material.
    printf 'Sent from Flea with Taildrop during the showcase recording. Safe to delete.\n' > "$HOME/Documents/notes/flea demo, sent with Taildrop.txt"
    made "$HOME/Documents/notes/flea demo, sent with Taildrop.txt"
    printf 'Moved to Dropbox by Flea during the showcase recording. Safe to delete.\n' > "$HOME/Documents/notes/flea demo, shared from Dropbox.txt"
    made "$HOME/Documents/notes/flea demo, shared from Dropbox.txt"
    made "$HOME/Dropbox/flea demo, shared from Dropbox.txt"
    touch -r "$stage_src/Documents" "$HOME/Documents"
    # Music: the recordings. Projects: the Lantern tree.
    for name in "$stage_src"/Recordings/*; do
        furnish_tree "$name" "$HOME/Music/${name##*/}"
    done
    furnish_tree "$stage_src/Projects/Lantern" "$HOME/Projects/Lantern"
    # The window's gio logs an open instead of opening; every other subcommand is the real one, so
    # the rail's own mount calls are untouched. Nothing in the beats opens a file on purpose.
    {
      printf '#!/bin/sh\n'
      printf '[ "$1" = open ] || exec /usr/bin/gio "$@"\n'
      printf 'printf %%s\\\\n "$2" >> "%s/opened.log"\n' "$work"
    } > "$shim_dir/gio"
    chmod +x "$shim_dir/gio"
    printf 'FURNISHED %s paths under %s\n' "$(wc -l < "$manifest")" "${furnished[*]}"
    ls -A "$HOME/Pictures" "$HOME/Documents" "$HOME/Music" "$HOME/Projects"
}

# Removal by the manifest, backwards: files unlinked, directories removed empty. A path outside
# the four furnished directories, or one that is not in the manifest, is never touched. The
# beats' own creations (the contact sheet folder, the culled folder and its link) are recorded
# as they happen, so they leave with the rest.
fixture_remove() {
    local path dir ok kept=0
    local removable=("${furnished[@]}" "$HOME/Dropbox")
    [[ -f "$manifest" ]] || { printf 'nothing furnished\n'; return 0; }
    tac "$manifest" | while IFS= read -r path; do
        ok=0
        for dir in "${removable[@]}"; do
            [[ "$path" == "$dir"/* ]] && ok=1
        done
        [[ "$ok" == 1 ]] || { printf 'REFUSED to remove %s: outside the furnished directories\n' "$path" >&2; continue; }
        if [[ -L "$path" || -f "$path" ]]; then
            rm -- "$path" || printf 'could not remove %s\n' "$path" >&2
        elif [[ -d "$path" ]]; then
            chmod u+rwx "$path" 2>/dev/null
            rmdir -- "$path" 2>/dev/null || printf 'left %s: not empty\n' "$path" >&2
        fi
    done
    for dir in "${furnished[@]}"; do
        [[ -z "$(ls -A "$dir")" ]] || { printf 'flea-showcase: %s IS NOT EMPTY after removal, left for a hand check: %s\n' "$dir" "$(ls -A "$dir" | head -3 | tr '\n' ' ')" >&2; kept=1; }
    done
    rm -f "$manifest"
    (( kept == 0 )) && { printf 'UNFURNISHED, the four directories are empty again\n'; return 0; }
    return 1
}

# ------------------------------------------------------------------ instances and windows

# The main window and the drag beat's second one, each pinned by pid: two instances share one
# config path, so a path is not an instance selector and a class is not a window selector.
pid_a=0; id_a=""; addr_a=""
pid_b=0; id_b=""; addr_b=""

# Sample input, qs list --all --json, one entry: {"config_path":"/home/gm/Work/claude/flea/ui/shell.qml","id":"c0o12e9frkt","pid":3437004,...}
instance_id_of_pid() {
    qs list --all --json 2>/dev/null | jq -r --argjson p "$1" '.[] | select(.pid == $p) | .id'
}

ipc() {
    qs ipc -i "$id_a" call flea "$@" 2>/dev/null
}

ipc_b() {
    qs ipc -i "$id_b" call flea "$@" 2>/dev/null
}

# Sample input, one hyprctl client: {"address":"0x5a1c","pid":3437004,"at":[780,385],"size":[1000,700],"floating":true,...}
client_json() {
    hyprctl clients -j | jq -c --arg a "$1" '.[] | select(.address == $a)'
}

client_geometry() {
    client_json "$1" | jq -r '"\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"'
}

# Keystrokes land on whatever holds focus, so a foreign window on the box is a reason to stop and
# not to work around. The Omarchy bar is a layer surface and never appears here.
# corner: the real state directory is the theme's; real_state already points at it.
assert_box_clear() {
    local others
    others=$(hyprctl clients -j | jq -r '.[] | .class' | sort -u | tr '\n' ' ')
    [[ -z "$others" ]] || fail "another lane holds the display, these windows are open: $others"
}

# The product's own launcher under the fixture home, with both seams on the launch line so a packaged
# /usr/share/flea/ui can never outrank this tree. 3>&- 4>&- so a detached qs inherits no lock
# descriptor from whatever called this drive. Prints "pid id address".
spawn() {
    local dir="$1" pid id="" addr=""
    [[ -x "$bin" ]] || fail "no binary at $bin, build it first"
    mkdir -p "$work" "$evidence"
    PATH="$shim_dir:$PATH" FLEA_UI="$ui" FLEA_BIN="$bin" setsid nohup "$bin" --gui "$dir" >>"$flea_log" 2>&1 </dev/null 3>&- 4>&- &
    pid=$!
    for _attempt in $(seq 1 300); do
        addr=$(hyprctl clients -j | jq -r --arg c "$flea_window_class" --argjson p "$pid" '.[] | select(.class == $c and .pid == $p) | .address')
        [[ -n "$addr" ]] && break
        sleep 0.05
    done
    [[ -n "$addr" ]] || fail "no Flea window for pid $pid appeared in 15 s"
    for _attempt in $(seq 1 100); do
        id=$(instance_id_of_pid "$pid")
        [[ -n "$id" ]] && break
        sleep 0.05
    done
    [[ -n "$id" ]] || fail "qs list never named an instance for pid $pid"
    printf '%s %s %s\n' "$pid" "$id" "$addr"
}

dispatch() {
    hyprctl dispatch "$1" >/dev/null
}

# Float, size and place one window, then read the compositor back: hyprctl exits 0 on error, so the
# geometry is the only evidence anything took. The resize falls back to a delta and the move to a
# relative one, because the exact and absolute forms are read back rather than trusted.
place() {
    local addr="$1" x="$2" y="$3" w="$4" h="$5" wx wy ww wh
    if [[ "$(client_json "$addr" | jq -r '.floating')" != "true" ]]; then
        dispatch "hl.dsp.window.float({ window = \"address:$addr\" })"
        settle
    fi
    [[ "$(client_json "$addr" | jq -r '.floating')" == "true" ]] || fail "window $addr would not float"
    dispatch "hl.dsp.window.resize({ x = $w, y = $h, exact = true, window = \"address:$addr\" })"
    settle
    read -r wx wy ww wh < <(client_geometry "$addr")
    if (( ww != w || wh != h )); then
        dispatch "hl.dsp.window.resize({ x = $((w - ww)), y = $((h - wh)), window = \"address:$addr\" })"
        settle
    fi
    dispatch "hl.dsp.window.move({ x = $x, y = $y, window = \"address:$addr\" })"
    settle
    read -r wx wy ww wh < <(client_geometry "$addr")
    if (( wx != x || wy != y )); then
        dispatch "hl.dsp.window.move({ x = $((x - wx)), y = $((y - wy)), relative = true, window = \"address:$addr\" })"
        settle
    fi
    read -r wx wy ww wh < <(client_geometry "$addr")
    (( ww == w && wh == h && wx == x && wy == y )) \
        || fail "window $addr is ${ww}x${wh} at $wx,$wy, not ${w}x${h} at $x,$y"
    printf 'WINDOW %s %sx%s at %s,%s\n' "$addr" "$ww" "$wh" "$wx" "$wy"
}

close_window() {
    local addr="$1"
    dispatch "hl.dsp.window.close({ window = \"address:$addr\" })"
    for _attempt in $(seq 1 100); do
        [[ -z "$(client_json "$addr")" ]] && return
        sleep 0.05
    done
    fail "window $addr did not close"
}

flea_pids() {
    local pid
    for pid in $(pgrep -x qs || true); do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        if tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | grep -Fq "$ui"; then
            printf '%s\n' "$pid"
        fi
    done
}

backend_pids() {
    local pid
    for pid in $(pgrep -x flea || true); do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        if tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | grep -Fq -- "$bin --backend"; then
            printf '%s\n' "$pid"
        fi
    done
}

# Every qs whose PATH starts with this drive's shim directory, which is exactly the set this drive
# launched and nothing another lane did: the environment is read, not the command line.
fixture_instances() {
    local pid
    for pid in $(pgrep -x qs || true); do
        [[ -r "/proc/$pid/environ" ]] || continue
        if tr '\0' '\n' 2>/dev/null < "/proc/$pid/environ" | grep -q "^PATH=$shim_dir:"; then
            printf '%s\n' "$pid"
        fi
    done
}

# kill -0 0 would ask after this shell's own process group, so an unset pid is never signalled.
alive() {
    (( ${1:-0} > 0 )) && kill -0 "$1" 2>/dev/null
}

kill_flea() {
    local pid waited
    for pid in $(fixture_instances); do
        kill "$pid" 2>/dev/null
    done
    for waited in $(seq 1 $((drain_wait_s * 20))); do
        [[ -z "$(fixture_instances)$(backend_pids)" ]] && return
        sleep 0.05
    done
    fail "a backend was still draining after $drain_wait_s s"
}

# ------------------------------------------------------------------ keys and their proof

settle() {
    sleep "$settle_s"
}

dwell() {
    sleep "$1"
}

# Plain keys and text go through wtype, aimed at the main window by address, which focuses it first.
# Never with a leading "--": omarchy-drive key --window flea -- z exits clean and presses nothing.
key() {
    [[ "$1" != -- ]] || fail "key: a -- argument is silently dropped, pass the text bare"
    omarchy-drive key --window "$addr_a" "$@" >/dev/null
}

# A query typed at a reading pace; wtype's -d is the gap between characters.
type_text() {
    [[ "$1" != -* ]] || fail "type_text: '$1' would be read as a flag"
    key -d "$type_ms" "$1"
}

# A modifier chord through wtype, the one route a lane has watched deliver a chord on this box:
# send_shortcut's keysym lookup fails for letters and digits alike, and --global is a compositor
# key press. Released in reverse order, the way a hand comes off a chord.
# Sample call: chord ctrl+shift n  ->  omarchy-drive key --window <addr> -M ctrl -M shift n -m shift -m ctrl
chord() {
    local mods="$1" k="$2" parts pre=() post=() i
    IFS='+' read -ra parts <<< "$mods"
    for i in "${parts[@]}"; do pre+=(-M "$i"); done
    for (( i=${#parts[@]} - 1; i >= 0; i-- )); do post+=(-m "${parts[i]}"); done
    key "${pre[@]}" "$k" "${post[@]}"
}

# Polls one seam until it answers the wanted value: the proof a key landed, where an exit status is not.
expect() {
    local label="$1" want="$2" seen
    shift 2
    for _attempt in $(seq 1 100); do
        seen=$("$@" 2>/dev/null)
        [[ "$seen" == "$want" ]] && return 0
        sleep 0.05
    done
    fail "$label: expected '$want', got '$seen'"
}

expect_ipc() {
    local method="$1" want="$2"
    shift 2
    expect "ipc $method" "$want" ipc "$method" "$@"
}

# The status bar's line, matched on a substring because the counts and names in it belong to the fixture.
expect_message_has() {
    local want="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc lastMessage 2>/dev/null)
        [[ "$seen" == *"$want"* ]] && { printf 'BAR %s\n' "$seen"; return 0; }
        sleep 0.05
    done
    fail "status bar: expected it to say '$want', it says '$seen'"
}

expect_message_has_b() {
    local want="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc_b lastMessage 2>/dev/null)
        [[ "$seen" == *"$want"* ]] && { printf 'BAR(b) %s\n' "$seen"; return 0; }
        sleep 0.05
    done
    fail "second window's status bar: expected '$want', it says '$seen'"
}

expect_selection_past() {
    local floor="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc selectionCount 2>/dev/null)
        [[ "$seen" =~ ^[0-9]+$ ]] && (( seen > floor )) && return 0
        sleep 0.05
    done
    fail "selection: expected more than $floor rows, it holds '$seen'"
}

expect_cursor_past() {
    local floor="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc cursor 2>/dev/null)
        [[ "$seen" =~ ^[0-9]+$ ]] && (( seen > floor )) && return 0
        sleep 0.05
    done
    fail "cursor: expected past $floor, it is '$seen'"
}

# The row under the cursor, by a name pattern, polled because a rename lands on a round trip.
expect_cursor_row() {
    local want="$1" seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc rowAt "$(ipc cursor 2>/dev/null)" 2>/dev/null)
        [[ "${seen%%|*}" == $want ]] && return 0
        sleep 0.05
    done
    fail "cursor row: expected $want, got '$seen'"
}

expect_file() {
    for _attempt in $(seq 1 300); do
        [[ -e "$1" ]] && return 0
        sleep 0.05
    done
    fail "no file appeared at $1"
}

expect_no_file() {
    for _attempt in $(seq 1 300); do
        [[ -e "$1" ]] || return 0
        sleep 0.05
    done
    fail "$1 is still there"
}

# A transfer crosses a process boundary and lands on disk row by row, so its total gets a longer wait.
transfer_wait_s=60
wait_total() {
    local want="$1" seen
    for _attempt in $(seq 1 $((transfer_wait_s * 10))); do
        seen=$(ipc total 2>/dev/null)
        [[ "$seen" == "$want" ]] && return 0
        sleep 0.1
    done
    fail "the listing never reached $want rows, it is at '$seen'"
}

# The preview column draws a thumbnail the sandboxed thumbnailer may still be making on first
# sight, so it gets a long wait and the state it settled on is printed rather than demanded.
wait_preview_column() {
    local seen
    for _attempt in $(seq 1 120); do
        seen=$(ipc previewColumnState 2>/dev/null)
        [[ -n "$seen" && "$seen" != "loading" ]] && { printf 'PREVIEW column settled on %s\n' "$seen"; return 0; }
        sleep 0.1
    done
    # A take is not lost to a slow thumbnail: the shot shows what the column drew, and this line says so.
    printf 'WARN the preview column was still loading after 12 s\n'
    return 0
}

# The rename field opens on a round trip, so a key typed at once would land on the list instead.
wait_renaming() {
    local seen
    for _attempt in $(seq 1 100); do
        seen=$(ipc renamingIndex 2>/dev/null)
        [[ "$seen" =~ ^[0-9]+$ ]] && return 0
        sleep 0.05
    done
    fail "no rename field opened, renamingIndex is '$seen'"
}

wait_listing() {
    local want="$1" total row
    for _attempt in $(seq 1 600); do
        total=$(ipc total 2>/dev/null || printf unavailable)
        row=$(ipc rowAt 0 2>/dev/null || printf loading)
        [[ "$total" == "$want" && "$row" != "loading" ]] && return
        sleep 0.05
    done
    fail "the listing never reached $want rows, it is at total=$total row=$row"
}

# The pane's own state word: listed, empty or error all mean it has answered; only loading does not.
# rowAt 0 answers "loading" on an empty listing forever, measured, so it is never the signal here.
wait_listed() {
    local state
    for _attempt in $(seq 1 600); do
        state=$(ipc state 2>/dev/null)
        [[ -n "$state" && "$state" != "loading" ]] && return
        sleep 0.05
    done
    fail "the listing never settled, state is '$state'"
}

wait_path() {
    expect "pane path" "$1" ipc path
    wait_listed
}

# The listing index of the first row whose name matches a glob, or -1: names belong to the stage
# set and can change under this drive, so beats ask for "*.pdf" rather than a file they remember.
row_index_matching() {
    local want="$1" i total name
    total=$(ipc total)
    [[ "$total" =~ ^[0-9]+$ ]] || { printf -- -1; return; }
    for (( i = 0; i < total && i < 200; i++ )); do
        name=$(ipc rowAt "$i")
        name=${name%%|*}
        [[ "$name" == $want ]] && { printf '%s' "$i"; return; }
    done
    printf -- -1
}

# One j, proven by the cursor. A key the drive tool reports sent can still fail to land (measured once
# in eleven runs on a 100,000-row listing), so a step that did not move is pressed once more and said so.
step_down() {
    local want="$1" seen
    key j
    for _attempt in $(seq 1 20); do
        seen=$(ipc cursor 2>/dev/null)
        [[ "$seen" == "$want" ]] && return 0
        sleep 0.05
    done
    printf 'WARN j did not land (cursor %s, wanted %s), pressed again\n' "$seen" "$want"
    key j
    expect_ipc cursor "$want"
}

# Walks the cursor to the first row matching a glob, from the top, one visible step at a time.
seek_row() {
    local want="$1" target i seen round
    target=$(row_index_matching "$want")
    (( target >= 0 )) || fail "no row matches $want in $(ipc path)"
    key g
    expect_ipc cursor 0
    # Pressed as a burst and read once: an IPC round trip costs more than a keypress here, and a
    # per-step read turned a twelve-row walk into six seconds. A lost key is topped up, and said.
    for round in 1 2 3; do
        seen=$(ipc cursor)
        [[ "$seen" =~ ^[0-9]+$ ]] || seen=0
        (( seen == target )) && return 0
        (( seen > target )) && { key g; expect_ipc cursor 0; seen=0; }
        (( round > 1 )) && printf 'WARN seek to %s reached %s of %s, pressing the rest\n' "$want" "$seen" "$target"
        for (( i = seen; i < target; i++ )); do
            key j
        done
        sleep 0.3
    done
    expect_ipc cursor "$target"
}

# ------------------------------------------------------------------ the pointer

# Motion goes through uinput and never through hl.dsp.cursor.move once a button is down: that warp
# emits motion with no frame and Qt dispatches pointer events only on frame, so a drag driven by it
# is never seen by the application. tests/drag.sh measured it: 24 motions, 0 frames.
warp()     { dispatch "hl.dsp.cursor.move({ x = $1, y = $2 })"; }
move_rel() { ydotool mousemove -x "$1" -y "$2" >/dev/null 2>&1; }
press()    { ydotool click 0x40 >/dev/null 2>&1; }
release()  { ydotool click 0x80 >/dev/null 2>&1; }
# evdev KEY_LEFTCTRL, held through ydotool so the drag is a copy: a plain drag is a move (tests/drag.sh R2, R3).
ctrl_down() { ydotool key 29:1 >/dev/null 2>&1; }
ctrl_up()   { ydotool key 29:0 >/dev/null 2>&1; }

cursor_pos() {
    hyprctl cursorpos | tr -d ','
}

# Converges on an absolute target with real frame-carrying motion, which is also what a viewer
# sees as the pointer travelling: libinput accelerates about 2x here, so each step is half the
# remaining distance and re-read, never trusted, then single pixels until it is exact.
glide_to() {
    local tx="$1" ty="$2" i cx cy dx dy
    for i in $(seq 1 24); do
        read -r cx cy < <(cursor_pos)
        dx=$(( tx - cx )); dy=$(( ty - cy ))
        (( dx == 0 && dy == 0 )) && return 0
        if (( dx > -5 && dx < 5 && dy > -5 && dy < 5 )); then
            move_rel "$(( dx > 0 ? 1 : dx < 0 ? -1 : 0 ))" "$(( dy > 0 ? 1 : dy < 0 ? -1 : 0 ))"
        else
            move_rel $(( dx / 2 )) $(( dy / 2 ))
        fi
        sleep 0.05
    done
    read -r cx cy < <(cursor_pos)
    (( cx == tx && cy == ty )) || fail "the pointer settled at $cx,$cy, not $tx,$ty"
}

park_pointer() {
    warp "$park_x" "$park_y"
}

# The screen position of a row's centre in one window: the seam answers window coordinates.
row_screen_centre() {
    local ipcfn="$1" addr="$2" index="$3" cx cy wx wy
    read -r cx cy <<< "$("$ipcfn" rowCentre "$index")"
    [[ -n "$cy" ]] || fail "row $index has no on-screen centre"
    read -r wx wy _ww _wh < <(client_geometry "$addr")
    printf '%s %s\n' "$((cx + wx))" "$((cy + wy))"
}

# Empty list area below the last row of a window, for a drop that means "into this directory".
# The row pitch is the gap between two consecutive row centres, read off the window itself.
list_blank_spot() {
    local ipcfn="$1" addr="$2" last cx cy px py pitch wx wy ww wh
    last=$(( $("$ipcfn" total) - 1 ))
    (( last >= 1 )) || fail "the window lists fewer than two rows, so no pitch can be read"
    read -r cx cy < <(row_screen_centre "$ipcfn" "$addr" "$last")
    read -r px py < <(row_screen_centre "$ipcfn" "$addr" $((last - 1)))
    pitch=$(( cy - py ))
    (( pitch > 10 && pitch < 100 )) || fail "row pitch read as $pitch px, which is not a row"
    read -r wx wy ww wh < <(client_geometry "$addr")
    cy=$(( cy + 2 * pitch ))
    (( cy < wy + wh - pitch )) || fail "the blank spot $cx,$cy is below the window ($wy+$wh)"
    printf '%s %s\n' "$cx" "$cy"
}

click_at() {
    omarchy-drive click "$1" "$2" "${@:3}" >/dev/null
}

# A drag from one screen point to another through a held left button, at a pace a viewer can follow.
drag() {
    local sx="$1" sy="$2" tx="$3" ty="$4"
    glide_to "$sx" "$sy"
    sleep 0.4
    press
    sleep 0.3
    glide_to "$tx" "$ty"
    sleep 0.5
    release
}

# ------------------------------------------------------------------ the theme

theme_current() {
    omarchy theme current
}

# omarchy theme list prints display names and omarchy theme dir echoes them back unresolved, so the
# directory and the set both take the slug: "Tokyo Night" is the directory tokyo-night, measured.
theme_slug() {
    printf '%s' "$1" | tr 'A-Z ' 'a-z-'
}

background_current() {
    readlink "$real_state/background"
}

# Two themes that are not the one the box is on, read at run time: the box has been switched under
# a running lane before, and a switch to the current theme would show no re-skin at all.
theme_targets() {
    local current name picked=0
    current=$(theme_current)
    for name in "Tokyo Night" "Catppuccin Latte" "Rose Pine"; do
        [[ "${name,,}" == "${current,,}" ]] && continue
        printf '%s\n' "$name"
        picked=$((picked + 1))
        (( picked == 2 )) && return
    done
}

# Sample input, one line of the live colors.toml:
# background        = "#0e1112"   # window ground
# The ground's luminance decides which way the beat switches: a dark box goes to a light theme and
# a light box to a dark one, so the change is unmistakable on a timeline thumbnail.
live_background_is_dark() {
    local hex r g b
    hex=$(grep -E '^background' "$real_state/theme/colors.toml" | grep -oE '#[0-9A-Fa-f]{6}' | head -1)
    [[ -n "$hex" ]] || fail "no background in the live colors.toml"
    r=$((16#${hex:1:2})); g=$((16#${hex:3:2})); b=$((16#${hex:5:2}))
    # Rec. 601 luma, integer weights that sum to 1000; half of 255 is the line between dark and light.
    (( (299 * r + 587 * g + 114 * b) / 1000 < 128 ))
}

theme_contrast_target() {
    local current name candidates
    current=$(theme_current)
    if live_background_is_dark; then
        candidates=("Catppuccin Latte" "Flexoki Light")
    else
        candidates=("Tokyo Night" "Vernier")
    fi
    for name in "${candidates[@]}"; do
        [[ "${name,,}" == "${current,,}" ]] && continue
        printf '%s\n' "$name"
        return
    done
    fail "no contrasting theme differs from the current one, $current"
}

# ------------------------------------------------------------------ the rotation

# The operator's instruction: rotate the theme about every 20 s through the take, so the whole
# frame re-skins under the beats and the follows-your-system point is made continuously. Switches
# happen only at named points where nothing is moving or being read, never on a timer, and never
# during the opener or the closer, which the mark carries on the theme stage found.
rotate_min_s=${FLEA_SHOWCASE_ROTATE_S:-18}
rotate_on=0
last_switch_ms=0
switches=0
theme_order=()
theme_index=0

# Sample input, two lines of a theme's colors.toml:
# background = "#1a1b26"
# accent     = "#7aa2f7"
theme_colours() {
    local dir bg accent
    dir=$(omarchy theme dir "$(theme_slug "$1")" 2>/dev/null) || return 1
    [[ -f "$dir/colors.toml" ]] || return 1
    bg=$(grep -E '^background' "$dir/colors.toml" 2>/dev/null | grep -oE '#[0-9A-Fa-f]{6}' | head -1)
    accent=$(grep -E '^accent' "$dir/colors.toml" 2>/dev/null | grep -oE '#[0-9A-Fa-f]{6}' | head -1)
    [[ -n "$bg" ]] || return 1
    printf '%s|%s|%s\n' "$1" "$bg" "${accent:-$bg}"
}

# The rotation set, per the operator: every stock theme plus their own vernier, and ordered for the
# largest contrast between neighbours. The first entry is the one farthest from the theme the box is
# on, each next is the unused one farthest from the last, and vernier goes last so the sequence
# leads with stock and lands beside the restore. Distance is the background luma gap plus the
# accent hue gap, computed in python because hue in integer shell is a page of arithmetic nobody
# should have to read; the numbers are printed so the contrast is a measurement, not an impression.
theme_pool() {
    local current name line
    current=$(theme_current)
    theme_order=()
    # Sample line from the python below: "251 213 Flexoki Light", background luma, accent hue, name.
    while IFS= read -r line; do
        theme_order+=("$(printf '%s' "$line" | cut -c9-)")
        printf 'ROTATION luma %s hue %s %s\n' "${line:0:3}" "${line:4:3}" "${line:8}"
    done < <(
        {
            theme_colours "$current" | sed 's/^/current|/'
            while IFS= read -r name; do
                theme_colours "$name" | sed 's/^/pool|/'
            done < <(omarchy theme list)
        } | python3 -c '
import sys, colorsys
def rgb(h): return tuple(int(h[i:i+2], 16) for i in (1, 3, 5))
def luma(c): return (299*c[0] + 587*c[1] + 114*c[2]) // 1000
def hue(c): return colorsys.rgb_to_hsv(*(x/255 for x in c))[0] * 360
def sat(c): return colorsys.rgb_to_hsv(*(x/255 for x in c))[1]
# Dark on dark: the accent is what a viewer sees change, so its hue leads, a grey accent against a
# saturated one counts as a change too, and the background luma gap is the tiebreak.
def dist(a, b):
    dh = abs(hue(a["ac"]) - hue(b["ac"])); dh = min(dh, 360 - dh)
    ds = abs(sat(a["ac"]) - sat(b["ac"]))
    dl = abs(luma(a["bg"]) - luma(b["bg"]))
    return dh * 255 / 180 + ds * 128 + dl * 0.5
dark_below = 128
current = None; pool = []; dropped = []
for raw in sys.stdin:
    kind, name, bg, ac = raw.rstrip("\n").split("|")
    entry = {"name": name, "bg": rgb(bg), "ac": rgb(ac)}
    if kind == "current": current = entry; continue
    if luma(entry["bg"]) >= dark_below:
        dropped.append(entry); continue
    if name.lower() == "vernier" or name.lower() != (current["name"].lower() if current else ""): pool.append(entry)
for e in dropped:
    sys.stderr.write("DROPPED light theme luma %3d %s\n" % (luma(e["bg"]), e["name"]))
tail = [e for e in pool if e["name"].lower() == "vernier"]
pool = [e for e in pool if e["name"].lower() != "vernier"]
order = []; last = current or pool[0]
while pool:
    nxt = max(pool, key=lambda e: dist(last, e)); pool.remove(nxt); order.append(nxt); last = nxt
order += tail
for e in order:
    print("%3d %3d %s" % (luma(e["bg"]), hue(e["ac"]), e["name"]))
sys.stderr.write("ROTATION %d dark themes, light ones dropped by luma >= %d\n" % (len(order), dark_below))
'
    )
    (( ${#theme_order[@]} >= 8 )) || fail "only ${#theme_order[@]} themes came back for the rotation"
    # The python's stderr carried the dropped list, which lands in the log beside the order.
}

# A switch point: fires only when the cadence is due, waits for the previous set's hooks first,
# and measures the switch as the time until the window paints the new foreground, plus one IPC
# round trip straight after, which is the one proxy this drive has for a window that stalled.
rotate_point() {
    local label="$1" name started ms probe_started probe_ms
    (( rotate_on == 1 )) || return 0
    (( ${#theme_order[@]} > 0 )) || return 0
    (( $(now_ms) - last_switch_ms >= rotate_min_s * 1000 )) || return 0
    theme_wait
    name=${theme_order[theme_index]}
    theme_index=$(( (theme_index + 1) % ${#theme_order[@]} ))
    started=$(now_ms)
    theme_switch "$name"
    wait_theme_applied "$name"
    wait_foreground >/dev/null
    ms=$(( $(now_ms) - started ))
    probe_started=$(now_ms)
    ipc themeForeground >/dev/null
    probe_ms=$(( $(now_ms) - probe_started ))
    last_switch_ms=$(now_ms)
    switches=$((switches + 1))
    printf '%s %s %s\n' "$theme_index" "$switches" "$last_switch_ms" > "$work/rotation"
    printf 'SWITCH %-2s %-18s at %-9s %5s ms to repaint, ipc after %4s ms\n' "$switches" "$name" "$label" "$ms" "$probe_ms"
}

rotation_load() {
    [[ -f "$work/rotation" ]] || return 0
    read -r theme_index switches last_switch_ms < "$work/rotation"
}

# Restores what stage found, name then background, because a theme set cycles the theme's backgrounds.
theme_restore() {
    local name bg
    [[ -f "$state" ]] || return 0
    name=$(grep '^theme=' "$state" | cut -d= -f2-)
    bg=$(grep '^background=' "$state" | cut -d= -f2-)
    [[ -n "$name" ]] || return 0
    if [[ "$(theme_slug "$(theme_current)")" != "$(theme_slug "$name")" ]]; then
        omarchy theme set "$(theme_slug "$name")" >/dev/null 2>&1
        wait_theme_applied "$name"
    fi
    if [[ -n "$bg" && -f "$bg" && "$(background_current)" != "$bg" ]]; then
        omarchy theme bg set "$bg" >/dev/null 2>&1
    fi
    printf 'THEME restored to %s\n' "$(theme_current)"
}

# The switch runs in the background so its terminal and browser hooks never stall the drive's clock.
# Waited on by pid, never by a bare wait: the windows are jobs of this shell too.
theme_pid=0
theme_switch() {
    omarchy theme set "$(theme_slug "$1")" >/dev/null 2>&1 &
    theme_pid=$!
}

theme_wait() {
    (( theme_pid > 0 )) && wait "$theme_pid"
    theme_pid=0
}

# Sample input, one line of the live colors.toml:
# foreground        = "#c8ccd0"   # content ink
live_foreground() {
    grep -E '^foreground' "$real_state/theme/colors.toml" | grep -oE '#[0-9A-Fa-f]{6}'
}

# omarchy theme set writes theme.name last, after swapping the theme directory, so the name file
# reading the target is what says colors.toml is the new theme's. Read before the window is judged.
theme_wait_s=20
wait_theme_applied() {
    local want seen
    want=$(theme_slug "$1")
    for _attempt in $(seq 1 $((theme_wait_s * 10))); do
        seen=$(cat "$real_state/theme.name" 2>/dev/null)
        [[ "$(theme_slug "$seen")" == "$want" ]] && return 0
        sleep 0.1
    done
    fail "omarchy theme set $want never landed; theme.name still reads '$seen'"
}

# The window's own palette against the file the theme set just wrote, polled because the watch
# fires on theme.name and the reload is a round trip behind it. Call wait_theme_applied first.
wait_foreground() {
    local want seen
    want=$(live_foreground)
    [[ -n "$want" ]] || fail "no foreground in the live colors.toml"
    # Case-insensitive: a theme file may write #100F0F where the window reports #100f0f, measured.
    for _attempt in $(seq 1 200); do
        seen=$(ipc themeForeground 2>/dev/null)
        [[ "${seen,,}" == "${want,,}" ]] && { printf 'FOREGROUND %s (window agrees with colors.toml)\n' "$seen"; return; }
        sleep 0.05
    done
    fail "the window still paints foreground '$seen' while colors.toml says $want, so the live re-skin did not land"
}

# ------------------------------------------------------------------ the beats

beat_started=0
beat_name=""

now_ms() {
    date +%s%3N
}

# Opens a beat's clock; the runner closes it, because the beat body runs in a subshell.
beat() {
    beat_name="$1"
    beat_started=$(now_ms)
    printf '%s %s\n' "$beat_name" "$beat_started" > "$work/beat"
    printf 'BEAT %-10s %s\n' "$1" "$2"
}

close_beat() {
    [[ -f "$work/beat" ]] || return 0
    read -r beat_name beat_started < "$work/beat"
    printf 'TIME %-10s %5.1f s\n' "$beat_name" "$(( $(now_ms) - beat_started ))e-3"
    rm -f "$work/beat"
}

# A shot of the stage at the beat's peak, only on a dry run: the evidence a visual claim needs.
shot() {
    [[ "$shots" == 1 ]] || return 0
    grim -g "${stage_x},${stage_y} ${stage_w}x${stage_h}" "$evidence/$1.png" || fail "grim failed on $1"
    printf 'SHOT %s\n' "$evidence/$1.png"
}

# Steps the open menu's cursor onto a row by its label, so a beat survives rows landing between the
# ones it cares about. Sample entries: Open|Rename|Duplicate|Compress|Convert|Send with Taildrop|...
menu_seek() {
    local want="$1" entries target=-1 i=0 label cursor
    entries=$(ipc contextMenuEntries)
    IFS='|' read -ra labels <<< "$entries"
    for label in "${labels[@]}"; do
        [[ "$label" == "$want" ]] && { target=$i; break; }
        i=$((i + 1))
    done
    (( target >= 0 )) || fail "menu_seek: no row labelled $want in $entries"
    for _attempt in $(seq 1 16); do
        cursor=$(ipc contextMenuCursor)
        [[ "$cursor" == "$target" ]] && return 0
        key j
        sleep 0.3
    done
    fail "menu_seek: could not reach $want, the cursor stalled at $(ipc contextMenuCursor)"
}

# Ctrl+1/2/3 are the Finder view chords keys.toml binds (90cd964), so no view needs the pointer.
view() {
    case "$1" in
        list) chord ctrl 1 ;;
        columns) chord ctrl 2 ;;
        grid) chord ctrl 3 ;;
    esac
    expect_ipc viewMode "$1"
}

