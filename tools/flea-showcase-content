#!/usr/bin/env bash
# The stage set for the showcase video: a directory that looks like somebody's working files, built
# from nothing, reproducible, and reachable by every surface and state Flea can draw.
#   tools/flea-showcase-content build      make the stage set, print the tree and what it weighs
#   tools/flea-showcase-content list       print the tree of a stage set already built
#   tools/flea-showcase-content montage    montage the photographs at the sizes Flea actually draws
#   tools/flea-showcase-content remove     delete it
# Nothing here is downloaded and nothing is copied from a real directory: every photograph, page,
# frame and sample is generated by this file, so the whole set is safe to put on a public timeline.
# Hard rule 9: every write and delete is inside a sandbox tools/flea-sandbox-guard made and marked.
set -u
set -o pipefail

# This tool reads machine output and launches no application for the user.
export LC_ALL=C.UTF-8
unset LANGUAGE
. "$(dirname "$0")/../tools/flea-sandbox-guard"

# The sandbox carries the guard's marker; the stage is one level inside it, so the marker never
# appears in a listing on camera even with hidden files shown.
sandbox=$FIXTURE_ROOT/flea-showcase-content
stage=$sandbox/studio
denied="$stage/Client vault"

# The camera roll is what makes the listing crawl and scroll. Reflink clones, not hard links: btrfs
# shares the extents so they cost almost nothing, and unlike a hard link each clone carries its own
# mtime, which is what keeps the date column from repeating.
roll_count=${FLEA_ROLL_COUNT:-8000}
# One magick per photograph, each single-threaded, as many at once as the box has cores.
jobs=${FLEA_SHOWCASE_JOBS:-10}
# The scene is composed at this width and enlarged once at the end. Every costly operator here is a
# blur or a plasma and both cost per pixel, so composing small is what takes a photograph from 11 s
# to under 2 s. Flea never draws a full-resolution image anyway: the largest it ever shows is the
# 256 px freedesktop thumbnail in the preview column.
compose_width=800
# The largest single file on the set, so the size column has a real number on it. It is NOT the way
# to demonstrate transfer progress: measured through the backend, copying 120 MB of it took 81 ms and
# emitted one progress line, because Flea does not fsync and the write lands in page cache at roughly
# 1.5 GB/s. Byte progress on one file would need a multi-GB file. What does run visibly is a
# multi-select: 300 files copied in 505 ms with 300 item lines, so about 2000 rows of the camera roll
# is the three-second shot.
big_file_mb=${FLEA_BIG_FILE_MB:-48}

fail() {
    printf 'flea-showcase-content: %s\n' "$*" >&2
    exit 1
}

# ------------------------------------------------------------------ the photograph generator

# Twelve skies. Each names its own silhouette profile, because a city skyline under a noon sky reads
# as a diagram and a treeline under a sunset reads as a photograph. Columns: name, sky top, sky
# bottom, glow, silhouette ink, profile.
palettes=(
    "alpine   #2f5f96 #cfe3ee #ffffff #1b2733 ridge"
    "sunset   #17335e #ffb877 #ffe4a8 #120f14 ridge"
    "dunes    #8a5f2e #f4d29a #fff0c0 #3a220f dune"
    "pine     #93a893 #e6efe6 #ffffff #16241a treeline"
    "dusk     #101a3a #e8845a #ffd9a0 #0b0d16 city"
    "dawn     #3a3f6b #f6c9b0 #ffe9d0 #181a24 ridge"
    "mist     #5c7a86 #dfe9ec #ffffff #1e2a2e treeline"
    "storm    #2b3138 #8e9aa4 #c9d3da #10151a ridge"
    "harbour  #14304a #d9b48a #ffe3b8 #0d141c city"
    "meadow   #6f8f5a #dfe7c8 #fffbe0 #24301c treeline"
    "glacier  #3b6f8f #e2f0f5 #ffffff #17262e ridge"
    "ember    #40202c #f0a070 #ffd0a0 #180d12 dune"
)
# Four shapes of frame, so an album is not twelve identical rectangles.
aspects=(3x2 4x3 16x9 2x3)

# Blend two #rrggbb colours; pct is how much of the first survives. A distant ridge takes more of
# the sky than a near one, which is the whole of aerial perspective and the reason a ridge reads
# as far away rather than as a shape sitting on top of the picture.
mix_hex() {
    local a=${1#\#} b=${2#\#} pct=$3
    printf '#%02x%02x%02x' \
        $(( (16#${a:0:2} * pct + 16#${b:0:2} * (100 - pct)) / 100 )) \
        $(( (16#${a:2:2} * pct + 16#${b:2:2} * (100 - pct)) / 100 )) \
        $(( (16#${a:4:2} * pct + 16#${b:4:2} * (100 - pct)) / 100 ))
}

# One silhouette, as a polygon closed down to the bottom edge. The walk is mean-reverting: a plain
# random walk drifts, and a drifted ridge is one cartoon mega-peak instead of a skyline.
ridge_points() {
    local profile=$1 base=$2 amp=$3 step=$4 w=$5 h=$6
    local x=0 advance deviate roof
    local y=$base
    local points="0,$h 0,$y"
    while [ "$x" -lt "$w" ]; do
        advance=$(( step + RANDOM % (step / 2 + 1) ))
        x=$(( x + advance ))
        [ "$x" -gt "$w" ] && x=$w
        if [ "$profile" = city ]; then
            roof=$(( base - RANDOM % amp ))
            [ "$roof" -lt $((h / 16)) ] && roof=$((h / 16))
            points="$points $x,$y $x,$roof"
            y=$roof
        else
            deviate=$(( RANDOM % (2 * amp + 1) - amp ))
            # The pull back toward base is what stops the walk drifting off the frame.
            y=$(( y + deviate - (y - base) / 3 ))
            [ "$y" -lt $((h / 12)) ] && y=$((h / 12))
            [ "$y" -gt $((h - h / 9)) ] && y=$((h - h / 9))
            points="$points $x,$y"
        fi
    done
    printf '%s %s,%s %s,%s' "$points" "$w" "$y" "$w" "$h"
}

# One photograph. Sky gradient, a blurred glow for the sun, plasma cloud texture, then silhouette
# layers from far to near, optional water, and finally grain and a vignette at full size. The grain
# is not decoration: a smooth synthetic gradient compresses to almost nothing, and a photograph that
# weighs 30 KB gives the size column away.
render_photo() {
    local out=$1 palette_index=$2 variant=$3
    local name top bottom glow ink profile
    read -r name top bottom glow ink profile <<<"${palettes[palette_index]}"

    # Seeded from the two indices, so a rebuild between takes produces the same stage set.
    RANDOM=$(( palette_index * 977 + variant * 31 + 7 ))

    local aspect=${aspects[$(( variant % ${#aspects[@]} ))]}
    local full_w full_h
    case $aspect in
        3x2)  full_w=2400; full_h=1600 ;;
        4x3)  full_w=2048; full_h=1536 ;;
        16x9) full_w=2560; full_h=1440 ;;
        2x3)  full_w=1600; full_h=2400 ;;
    esac
    local w=$compose_width
    local h=$(( compose_width * full_h / full_w ))
    local work=$out.build

    # Where the sun sits, and how many ridges: the two things that make one palette look like five
    # different afternoons. The glow is composed at a quarter scale and enlarged, so its blur is four
    # times wider for a sixteenth of the cost, and it reads as haze rather than as a pasted-on disc.
    # It is dimmed before it is screened on: a full-strength glow that wide takes a pale sky to white.
    local glow_x=$(( w * (18 + (variant * 17 + palette_index * 7) % 65) / 100 ))
    local glow_y=$(( h * (30 + (variant * 23) % 30) / 100 ))
    local layers=$(( 3 + (variant + palette_index) % 3 ))
    local water=no
    [ $(( (variant + palette_index) % 3 )) -eq 0 ] && water=yes

    magick -size ${w}x${h} gradient:"${top}-${bottom}" \
        \( -size $(( w / 4 ))x$(( h / 4 )) xc:black -fill "$glow" \
           -draw "circle $(( glow_x / 4 )),$(( glow_y / 4 )) $(( glow_x / 4 )),$(( glow_y / 4 - w / 26 ))" \
           -blur 0x$(( w / 20 )) -evaluate multiply 0.55 -resize ${w}x${h}! \) \
        -compose screen -composite \
        \( -size ${w}x${h} plasma:fractal -colorspace gray -blur 0x$(( w / 60 )) -contrast-stretch 6%x6% \) \
        -compose softlight -composite "$work.png" || fail "magick failed on $out"

    local i base amp step weight blur points colour denominator
    denominator=$(( layers > 1 ? layers - 1 : 1 ))
    for (( i = 0; i < layers; i++ )); do
        base=$(( h * (54 + i * 9) / 100 ))
        amp=$(( h * (3 + i * 2) / 100 ))
        step=$(( w * (13 - i * 3) / 100 ))
        case $profile in
            treeline) amp=$(( h * (2 + i) / 100 )); step=$(( w * (3 - i) / 100 )) ;;
            dune)     amp=$(( h * (3 + i * 2) / 100 )); step=$(( w * (18 - i * 4) / 100 )) ;;
            city)     amp=$(( h * (20 + i * 12) / 100 )); step=$(( w * (9 - i * 2) / 100 )) ;;
        esac
        [ "$step" -lt 3 ] && step=3
        [ "$amp" -lt 2 ] && amp=2
        weight=$(( 34 + i * 66 / denominator ))
        colour=$(mix_hex "$ink" "$bottom" "$weight")
        blur=$(( layers - 1 - i ))
        points=$(ridge_points "$profile" "$base" "$amp" "$step" "$w" "$h")
        magick "$work.png" \
            \( -size ${w}x${h} xc:none -fill "$colour" -draw "polygon $points" -blur 0x${blur}.4 \) \
            -compose over -composite "$work.next.png" || fail "magick failed on a ridge of $out"
        mv "$work.next.png" "$work.png"
    done

    if [ "$water" = yes ]; then
        # What the water reflects is the band immediately above the shoreline, not the top of the
        # frame: reflecting the zenith puts the sun's brightest, most saturated pixels into the lake
        # and reads as a neon puddle rather than as water.
        # The smear is a squash of one axis and a stretch back. -motion-blur draws the same thing and
        # costs 7 s a frame here, which is the whole build budget for one reflection.
        local sea_h=$(( h * 30 / 100 ))
        magick "$work.png" -crop ${w}x${sea_h}+0+$(( h - 2 * sea_h )) +repage -flip -modulate 76,58 \
            -resize 10%x100%! -resize 1000%x100%! -resize ${w}x${sea_h}! -blur 0x1 "$work.sea.png" \
            || fail "magick failed on the water of $out"
        magick "$work.png" "$work.sea.png" -gravity south -compose over -composite "$work.next.png" \
            || fail "magick failed compositing the water of $out"
        mv "$work.next.png" "$work.png"
    fi

    magick "$work.png" -resize ${full_w}x${full_h}! \
        -attenuate 0.42 +noise Gaussian \
        \( -size ${full_w}x${full_h} radial-gradient:white-"#7a7a7a" \) -compose multiply -composite \
        -modulate 100,106 -quality 88 "$out" || fail "magick failed writing $out"
    rm -f "$work".*.png "$work.png"
}

