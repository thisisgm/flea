# ------------------------------------------------------------------ documents

# A typeset multi-page contract. groff -ms is already on the box for man pages, so this needs
# nothing installed. Both parties are roles rather than names: this goes on a public timeline.
write_contract() {
    local out=$1 clause
    local source=$out.ms
    {
        printf '.TL\nAgreement for Design Services\n'
        printf '.LP\nThis agreement is made between the Studio, which provides design and production\n'
        printf 'services, and the Client, which commissions them. It takes effect on the date the\n'
        printf 'last party signs it and continues until the work described in Schedule A is\n'
        printf 'delivered and accepted, or until either party ends it under clause 9.\n'
        for clause in \
            "Scope of work:The Studio will carry out the work set out in Schedule A. Anything not\nlisted there is outside the scope of this agreement and is quoted separately.\n.PP\nWhere the Client asks for work beyond the schedule, the Studio will provide a\nwritten estimate before starting, and neither party is committed to that work\nuntil the estimate is accepted in writing." \
            "Fees and invoicing:Fees are as stated in Schedule B. The Studio invoices on delivery of each\nmilestone, and invoices fall due thirty days after the date of issue.\n.PP\nExpenses agreed in advance are recharged at cost, with receipts attached to the\ninvoice that carries them." \
            "Revisions:Each milestone includes two rounds of revision. Further rounds are charged at\nthe hourly rate in Schedule B.\n.PP\nA revision request is counted from the date the Client sends it in writing,\ncollected into a single list rather than as individual messages." \
            "Delivery:The Studio delivers source files and exported assets in the formats listed in\nSchedule A, by a transfer link that stays live for ninety days.\n.PP\nThe Client is responsible for keeping its own copy of delivered files after that\nperiod. The Studio keeps an archive copy for twelve months as a courtesy and not\nas an obligation." \
            "Ownership:On payment in full, the Client owns the delivered work. Until then the Studio\nretains ownership, and the Client may not publish or distribute it.\n.PP\nThe Studio keeps ownership of its own tools, templates and working files, and of\nany component it developed before this agreement began." \
            "Credit and portfolio:The Studio may show the delivered work in its portfolio and in submissions to\nawards, unless the Client asks otherwise in writing.\n.PP\nNeither party may imply an endorsement by the other beyond the fact that the work\nwas carried out." \
            "Confidentiality:Each party keeps the other's non-public information confidential, uses it only\nfor this engagement, and returns or destroys it on request.\n.PP\nThis obligation survives the end of the agreement by three years, and does not\ncover information that is already public through no fault of the receiving party." \
            "Liability:Neither party is liable to the other for indirect or consequential loss. The\nStudio's total liability is limited to the fees paid under this agreement.\n.PP\nNothing in this clause limits liability that cannot be limited by law." \
            "Ending the agreement:Either party may end this agreement by giving thirty days' written notice.\n.PP\nOn notice, the Client pays for work completed and for work in progress up to the\nnotice date, and the Studio delivers what has been paid for." \
            "Governing terms:This agreement is the whole of what has been agreed and replaces any earlier\nunderstanding between the parties.\n.PP\nA change to it is effective only when both parties record it in writing." \
        ; do
            printf '.NH\n%s\n.LP\n%b\n' "${clause%%:*}" "${clause#*:}"
        done
        printf '.NH\nSignatures\n.LP\nSigned for the Studio, and signed for the Client, each by an authorised\nrepresentative on the date written beside their signature.\n'
        printf '.sp 3\n.LP\n\\l\x27 2.5i\x27\\h\x271i\x27\\l\x27 2.5i\x27\n.LP\nfor the Studio\\h\x272.1i\x27for the Client\n'
        # The schedules start on their own page, which is also what takes the document past two
        # pages, so the page chevrons and the "n / m" readout have something to move through.
        printf '.bp\n.NH\nSchedule A: scope of work\n.LP\nThe Studio will deliver, in three milestones:\n'
        printf '.IP \\(bu 2\nA primary mark and a wordmark, each in a dark and a light variant, as\nvector source and as exported raster at four sizes.\n'
        printf '.IP \\(bu 2\nA colour palette of seven values, specified for screen and for coated and\nuncoated stock, with the conversions recorded rather than left to the printer.\n'
        printf '.IP \\(bu 2\nTwo days of photography, one in studio and one on location, delivered as\nforty retouched frames from a selection the Client approves.\n'
        printf '.IP \\(bu 2\nApplication templates for correspondence, presentation and social formats.\n'
        printf '.IP \\(bu 2\nA written guideline document covering spacing, minimum sizes, misuse, and\nthe photographic treatment.\n'
        printf '.LP\nNot included: motion work, copywriting, web implementation, and any print\nbuying. Each of these is available and is quoted separately.\n'
        printf '.NH\nSchedule B: fees\n.LP\nMilestone one, on acceptance of the marks: 4,800. Milestone two, on acceptance\nof the palette and templates: 3,200. Milestone three, on delivery of the\nphotography and the guideline document: 3,360.\n'
        printf '.PP\nWork beyond the schedule is charged at 95 an hour, estimated in writing before\nit starts. Expenses agreed in advance are recharged at cost.\n'
        printf '.PP\nAll figures exclude tax, which is added at the rate in force on the invoice\ndate.\n'
    } > "$source"
    groff -ms -T pdf "$source" > "$out" 2>/dev/null || fail "groff could not typeset $out"
    rm -f "$source"
}

# A one-page invoice, laid out with tbl so it reads as a real document rather than a wall of text.
write_invoice() {
    local out=$1
    local source=$out.ms
    {
        printf '.TL\nInvoice 0142\n'
        printf '.LP\nIssued 12 August 2026, due 11 September 2026.\n.sp\n'
        printf '.TS\nallbox tab(|);\nlb lb rb\nl l r.\n'
        printf 'Item|Detail|Amount\n'
        printf 'Identity, phase one|Marks, wordmark, colour|4,800.00\n'
        printf 'Identity, phase two|Application and templates|3,200.00\n'
        printf 'Photography|Two days, studio and location|2,400.00\n'
        printf 'Retouching|Forty frames|960.00\n'
        printf 'Print supervision|One press check|450.00\n'
        printf 'Expenses|Travel and materials, at cost|318.40\n'
        printf '|Total|12,128.40\n'
        printf '.TE\n.sp\n.LP\nPayable by transfer to the account on file. Please quote the invoice number.\n'
    } > "$source"
    groff -t -ms -T pdf "$source" > "$out" 2>/dev/null || fail "groff could not typeset $out"
    rm -f "$source"
}

# ------------------------------------------------------------------ media

# Audio carrying a cover image, because ffmpegthumbnailer's audio entry extracts embedded art and
# that is the only way an audio row draws a picture rather than a glyph.
write_audio() {
    local out=$1 seconds=$2 rate=$3 cover=$4 tone=$5
    ffmpeg -loglevel error -y \
        -f lavfi -i "sine=frequency=${tone}:sample_rate=${rate}:duration=${seconds}" \
        -f lavfi -i "anoisesrc=amplitude=0.02:sample_rate=${rate}:duration=${seconds}" \
        -i "$cover" \
        -filter_complex "[0:a][1:a]amix=inputs=2:duration=shortest,volume=0.25[a]" \
        -map "[a]" -map 2:v -c:v mjpeg -disposition:v attached_pic \
        "$out" || fail "ffmpeg could not write $out"
}

# A video whose first frame is one of the photographs, so the thumbnailer extracts something worth
# looking at instead of a black frame.
write_video() {
    local out=$1 still=$2 seconds=$3
    ffmpeg -loglevel error -y -loop 1 -i "$still" \
        -f lavfi -i "sine=frequency=180:sample_rate=48000:duration=${seconds}" \
        -t "$seconds" -vf "scale=1920:-2,format=yuv420p" -r 30 \
        -c:v libx264 -preset veryfast -crf 26 -c:a aac -b:a 128k -shortest \
        "$out" || fail "ffmpeg could not write $out"
}

# ------------------------------------------------------------------ building the stage

require_tools() {
    local tool
    for tool in magick ffmpeg bsdtar zip 7z groff; do
        command -v "$tool" >/dev/null || fail "$tool is missing, so the stage set cannot be built"
    done
}

# The denied directory is made unreadable on purpose, so it has to be opened again before anything
# can walk into it to remove it. Guarded like every other path here, and never with sudo: it is
# owned by whoever ran the build, so a plain chmod is enough.
unlock_denied() {
    [ -e "$denied" ] || return 0
    sandbox_require "$denied"
    chmod 0700 "$SANDBOX_PATH" || fail "could not reopen $SANDBOX_PATH"
}

# Every photograph, rendered in parallel. Each worker is a fresh run of this file in scene mode with
# MAGICK_THREAD_LIMIT=1, because magick threads internally and oversubscribing 12 cores with 12
# threads each is slower than running ten single-threaded renders.
render_all_photos() {
    local index=0 palette_index variant
    local plan=$sandbox/.render-plan
    : > "$plan"
    for (( index = 0; index < photo_count; index++ )); do
        palette_index=$(( index % ${#palettes[@]} ))
        variant=$(( index / ${#palettes[@]} ))
        printf '%s %s %s\n' "$photo_dir/$index.jpg" "$palette_index" "$variant" >> "$plan"
    done
    MAGICK_THREAD_LIMIT=1 xargs -P "$jobs" -L 1 "$self" scene < "$plan" \
        || fail "at least one photograph failed to render"
    rm -f "$plan"
}

# A photograph placed under the name a person would have given it. Reflink, so the album and the
# camera roll can share extents and still carry their own dates.
place_photo() {
    local index=$1 destination=$2
    cp --reflink=auto "$photo_dir/$(( index % photo_count )).jpg" "$destination" \
        || fail "could not place $destination"
}

# The path of one rendered photograph, wrapped into the set that actually exists. A fixed index here
# breaks every build that lowers FLEA_PHOTO_COUNT, which is what a fast rebuild between takes does.
photo_at() {
    printf '%s/%s.jpg' "$photo_dir" "$(( $1 % photo_count ))"
}

# Dates every file directly inside one directory, walking forward from a start. A copy carries the
# time it was made, so without this every album is a column of identical timestamps dated today,
# which is the single fastest way to make a real directory look like a fixture.
spread_dates() {
    local directory=$1 start=$2 step_minutes=$3
    local epoch index=0 entry
    epoch=$(date -d "$start" +%s) || fail "could not read the start date $start"
    for entry in "$directory"/*; do
        [ -e "$entry" ] || continue
        touch -d "@$(( epoch + index * step_minutes * 60 ))" "$entry" \
            || fail "could not date $entry"
        index=$(( index + 1 ))
    done
}

build_projects() {
    local base="$stage/Projects/Lantern"
    mkdir -p "$base/brand/icons" "$base/shots" "$base/src"

    local i
    for i in "${!shot_names[@]}"; do
        place_photo $(( 24 + i )) "$base/shots/${shot_names[i]}"
    done

    # Flat graphics rather than scenes: a logo is not a photograph and drawing one as a scene would
    # be the tell. These also give the grid something that is not a landscape.
    magick -size 1200x1200 xc:"#0e1112" -fill "#b38956" \
        -draw "polygon 600,180 980,820 220,820" -draw "circle 600,700 600,560" \
        "$base/brand/lantern-logo-dark.png"
    magick -size 1200x1200 xc:"#f4f1ea" -fill "#1b1a17" \
        -draw "polygon 600,180 980,820 220,820" -draw "circle 600,700 600,560" \
        "$base/brand/lantern-logo-light.png"
    magick -size 1400x400 xc:"#f4f1ea" \
        -fill "#b38956" -draw "rectangle 0,0 200,400" \
        -fill "#7a6a52" -draw "rectangle 200,0 400,400" \
        -fill "#3f4a3a" -draw "rectangle 400,0 600,400" \
        -fill "#26303a" -draw "rectangle 600,0 800,400" \
        -fill "#1b1a17" -draw "rectangle 800,0 1000,400" \
        -fill "#c9c2b4" -draw "rectangle 1000,0 1200,400" \
        -fill "#e8e3d8" -draw "rectangle 1200,0 1400,400" \
        "$base/brand/palette.png"
    for i in 16 32 64 128; do
        magick "$base/brand/lantern-logo-dark.png" -resize ${i}x${i} "$base/brand/icons/lantern-mark-${i}.png"
    done

    cat > "$base/src/main.rs" <<'RUST'
use crate::render::{Frame, Renderer};
use std::path::PathBuf;

// The entry point does three things and delegates the rest: read the config, build a renderer,
// and hand it every frame the config asked for.
fn main() -> Result<(), Box<dyn std::error::Error>> {
    let config = Config::load(PathBuf::from("config.toml"))?;
    let mut renderer = Renderer::new(config.width, config.height);

    for index in 0..config.frames {
        let frame = Frame::at(index, config.step);
        renderer.draw(&frame)?;
        renderer.write(&config.output.join(format!("frame-{index:04}.png")))?;
    }

    println!("wrote {} frames", config.frames);
    Ok(())
}
RUST
    cat > "$base/src/render.rs" <<'RUST'
// One job: turn a frame description into pixels. Nothing here touches the filesystem except write.
pub struct Renderer {
    width: u32,
    height: u32,
    buffer: Vec<u8>,
}

impl Renderer {
    pub fn new(width: u32, height: u32) -> Self {
        let buffer = vec![0u8; (width * height * 4) as usize];
        Self { width, height, buffer }
    }

    pub fn draw(&mut self, frame: &Frame) -> Result<(), RenderError> {
        if frame.is_empty() {
            return Err(RenderError::EmptyFrame);
        }
        self.clear();
        for shape in frame.shapes() {
            self.fill(shape);
        }
        Ok(())
    }
}
