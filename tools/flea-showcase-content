    done

    spread_dates "$stage/Photos/Iceland, March" "2025-10-02 09:26" 37
    spread_dates "$stage/Photos/Studio sessions" "2026-04-19 12:03" 21

    # The camera roll: enough rows that the listing takes long enough to draw the crawl, and long
    # enough to scroll for as long as a shot needs. Consecutive frames repeat a scene the way a
    # burst on a real camera does.
    local roll="$stage/Photos/Camera roll"
    for (( i = 0; i < roll_count; i++ )); do
        cp --reflink=auto "$photo_dir/$(( i % photo_count )).jpg" \
            "$roll/$(printf 'IMG_%04d.jpg' $(( 1000 + i )))" || fail "could not build the camera roll"
    done

    # Dates walk forward across the roll so the date column reads as a year of shooting rather than
    # as one instant. Eight frames share a timestamp, which is both what a burst on a real camera
    # looks like and what lets one touch date eight files: per-file, this loop spawned 8000.
    local epoch group_epoch burst=8
    epoch=$(date -d "2025-09-14 08:12" +%s) || fail "could not read the camera roll start date"
    local batch=()
    for (( i = 0; i < roll_count; i++ )); do
        batch+=( "$roll/$(printf 'IMG_%04d.jpg' $(( 1000 + i )))" )
        if [ ${#batch[@]} -eq "$burst" ] || [ $(( i + 1 )) -eq "$roll_count" ]; then
            group_epoch=$(( epoch + (i / burst) * 151 * 60 ))
            touch -d "@$group_epoch" "${batch[@]}" || fail "could not date the camera roll"
            batch=()
        fi
    done
}

