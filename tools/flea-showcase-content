# ------------------------------------------------------------------ reporting

show_tree() {
    [ -d "$stage" ] || fail "no stage set at $stage; run build first"
    printf 'STAGE %s\n\n' "$stage"
    # The camera roll is thousands of rows, so it is summarised rather than printed. The denied
    # directory refuses find as designed, so its error is dropped and it is reported by name below.
    ( cd "$stage" && find . -maxdepth 2 -not -path './Photos/Camera roll/*' 2>/dev/null \
        | sort | sed 's|^\./||' )
    printf '\nPhotos/Camera roll: %s entries\n' "$(ls -A "$stage/Photos/Camera roll" | wc -l)"
    printf 'Client vault:       %s (unreadable on purpose)\n' "$(stat -c '%A' "$denied")"
    printf 'Archive drive:      %s\n' "$(readlink "$stage/Archive drive") (a target that is not there)"
}

show_weight() {
    printf '\napparent size, du -sh --apparent-size: %s\n' \
        "$(du -sh --apparent-size "$sandbox" 2>/dev/null | cut -f1)"
    # du reads st_blocks and charges every reflink clone for extents it only shares, so on a set
    # that is mostly clones du is not the weight. What deleting it gives back is what btrfs calls
    # exclusive plus the shared set counted once, which is the line below.
    if command -v btrfs >/dev/null; then
        printf 'on disk, btrfs filesystem du -s:\n'
        btrfs filesystem du -s "$sandbox" 2>/dev/null | sed 's/^/  /'
    fi
    printf 'distinct photographs rendered:         %s\n' "$photo_count"
    printf 'files in the stage set:                %s\n' "$(find "$stage" 2>/dev/null | wc -l)"
}

# The check that was asked for and the only one that settles it: look at the photographs at the
# sizes Flea actually draws them. Theme.grid.iconSize is 46 and a list row's mark is 23; the 256 is
# the freedesktop cache the preview column draws, which is the largest Flea ever shows an image.
build_montage() {
    [ -d "$photo_dir" ] || fail "no photographs at $photo_dir; run build first"
    local out=$sandbox/montage
    mkdir -p "$out"
    local size
    for size in 23 46 256; do
        magick montage "$photo_dir"/*.jpg -tile 12x -geometry ${size}x${size}+3+3 \
            -background "#0e1112" "$out/photos-${size}px.png" || fail "montage failed at ${size}px"
    done
    printf 'MONTAGE %s\n' "$out"
    ls -l "$out"
}

