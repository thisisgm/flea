def require(condition, message):
    if not condition:
        raise ValueError(message)


def monitor_geometry(monitors):
    rows = []
    for monitor in monitors:
        missing = [key for key in MONITOR_GEOMETRY if key not in monitor]
        require(not missing, "hyprctl -j monitors: monitor %s lacks %s" % (monitor.get("name", "<unnamed>"), ", ".join(missing)))
        rows.append({key: monitor[key] for key in MONITOR_GEOMETRY})
    return rows


def load_module(name, path):
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def root_path(value):
    p = Path(value)
    require(p.is_absolute() and p == p.resolve(strict=True), "ROOT must be absolute and canonical")
    require(p.is_dir() and (p / MARKER).is_file() and not (p / MARKER).is_symlink(),
            "ROOT needs its own regular sandbox marker")
    require(p != Path.home() and p != Path("/"), "ROOT cannot be HOME or /")
    return p


def write_json(path, value, replace=False):
    destination = path.with_name("." + path.name + "." + str(time.time_ns())) if replace else path
    with destination.open("x") as out:
        json.dump(value, out, indent=2, allow_nan=False)
        out.write("\n")
    if replace:
        destination.replace(path)


def sha(path):
    h = hashlib.sha256()
    with Path(path).open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def command(args, **kwargs):
    return subprocess.run([str(a) for a in args], check=True, timeout=kwargs.pop("timeout", 30),
                          **kwargs)


def output(args):
    try:
        return command(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True).stdout.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return "UNAVAILABLE: " + str(e)


