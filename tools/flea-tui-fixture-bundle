#!/usr/bin/env python3
"""Build the native terminal battery's read-only fixture bundle beneath a marked mktemp root.

  flea-tui-fixture-bundle OUTPUT_DIR [--seed BENCH_WORK_DIR] [--without-rasters]

OUTPUT_DIR must be new and beneath a directory holding a nonempty .flea-test-sandbox marker, the
battery's own guard. The bundle's manifest.json follows tests/tui_battery/README.md "Fixture bundle".
"""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tests"))
from tui_battery.bundle.build import main

if __name__ == "__main__":
    sys.exit(main())
